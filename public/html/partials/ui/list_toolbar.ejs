<%#
  Standard list toolbar: search, Filter toggle, Columns, Export, Add.
  Goes first inside <form class="list-filter-form" method="get">, followed
  by the page's own <div class="collapse" id="<filtersId>"> filter panel.
  include('../../partials/ui/list_toolbar', {
    search,                               // current search text
    searchPlaceholder: 'Search by name...', // English i18n key
    filtersId: 'systemFilters',           // omit when the page has no filters
    activeFilterCount,
    columns: { tableId, storageKey, list: COLUMNS },  // omit for no chooser
    exportUrl,                            // omit for no export
    importModal,                          // id of a partials/ui/import_modal.ejs dialog, omit for no import
    addUrl, addLabel,                     // omit (or null) when not allowed
  })
%>
<div class="card-header list-toolbar">
  <div class="input-group list-search">
    <input class="form-control" type="search" name="search" value="<%= locals.search || '' %>" placeholder="<%= t(locals.searchPlaceholder || 'Search...') %>" aria-label="<%= t('Search') %>">
    <button class="btn btn-outline-secondary" type="submit" title="<%= t('Search') %>"><i class="bi bi-search"></i></button>
  </div>
  <% if (locals.filtersId) { %>
    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#<%= filtersId %>" aria-expanded="<%= !!locals.activeFilterCount %>">
      <i class="bi bi-funnel"></i> <%= t('Filter') %><% if (locals.activeFilterCount) { %> <span class="badge rounded-pill"><%= activeFilterCount %></span><% } %>
    </button>
  <% } %>
  <div class="list-actions">
    <% if (locals.columns) { %>
      <%- include('columns_menu', { tableId: columns.tableId, storageKey: columns.storageKey, columns: columns.list }) %>
    <% } %>
    <% if (locals.exportUrl) { %>
      <a href="<%= exportUrl %>" class="btn btn-outline-secondary" data-export-link title="<%= t('Export') %>"><i class="bi bi-download"></i><span class="btn-text"> <%= t('Export') %></span></a>
    <% } %>
    <% if (locals.importModal) { %>
      <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#<%= importModal %>" title="<%= t('Import') %>"><i class="bi bi-upload"></i><span class="btn-text"> <%= t('Import') %></span></button>
    <% } %>
    <% if (locals.addUrl) { %>
      <a href="<%= addUrl %>" class="btn btn-primary"><i class="bi bi-plus-lg"></i> <%= t(locals.addLabel || 'Add') %></a>
    <% } %>
  </div>
</div>
