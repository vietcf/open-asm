<%#
  Delete confirmation that asks what to do with the record's IP addresses
  (servers, devices). A delete form opts in with data-delete-ip="<record name>"
  and a hidden <input name="delete_ip">; public/js/ui-kit.js shows this dialog
  and fills delete_ip with "false" (release to Reserved) or "true" (delete).
%>
<div class="modal fade" id="deleteIpModal" tabindex="-1" aria-labelledby="deleteIpModalTitle" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteIpModalTitle"><%= t('Confirm Delete') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
      </div>
      <div class="modal-body">
        <p><%= t('Delete') %> <strong data-delete-ip-name></strong>?</p>
        <p class="mb-2"><%= t('What should happen to its IP address(es)?') %></p>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="deleteIpChoice" id="deleteIpReserve" value="false" checked>
          <label class="form-check-label" for="deleteIpReserve"><%= t('Release IP(s) back to') %> <strong><%= t('Reserved') %></strong> <%= t('status (default)') %></label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="deleteIpChoice" id="deleteIpDelete" value="true">
          <label class="form-check-label" for="deleteIpDelete"><%= t('Delete the IP address(es) permanently') %></label>
        </div>
        <div class="form-text"><%= t('IP addresses still used by another server or device are kept.') %></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Cancel') %></button>
        <button type="button" class="btn btn-danger btn-sm" data-delete-ip-confirm><%= t('Delete') %></button>
      </div>
    </div>
  </div>
</div>
