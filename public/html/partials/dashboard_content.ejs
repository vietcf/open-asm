<%
// Fixed label -> color mapping (never re-assigned by rank/index) so the
// same status always reads the same color across renders.
const IP_STATUS_COLORS = { 'Assigned': 'primary', 'Reserved': 'warning', 'Inactive': 'secondary', 'Unset': 'secondary' };
const CATEGORICAL_COLORS = ['primary', 'info', 'warning', 'success', 'secondary', 'dark'];

const statTiles = stats ? [
  { label: 'Systems', count: stats.counts.systems, icon: 'bi-hdd-stack', url: '/system/system', perm: 'system.read' },
  { label: 'Servers', count: stats.counts.servers, icon: 'bi-hdd-network', url: '/server/server/list', perm: 'server.read' },
  { label: 'Devices', count: stats.counts.devices, icon: 'bi-cpu', url: '/device/device', perm: 'device.read' },
  { label: 'IP Addresses', count: stats.counts.ipAddresses, icon: 'bi-diagram-3', url: '/network/ip-address', perm: 'ip_address.read' },
  { label: 'Subnets', count: stats.counts.subnets, icon: 'bi-diagram-2', url: '/network/subnet-address', perm: 'subnet.read' },
  { label: 'Domains', count: stats.counts.domains, icon: 'bi-globe', url: '/network/domain', perm: 'domain.read' },
  { label: 'Contacts', count: stats.counts.contacts, icon: 'bi-people', url: '/organize/contact', perm: 'contact.read' },
  { label: 'Firewall Rules', count: stats.counts.rules, icon: 'bi-shield-exclamation', url: '/firewall/rule', perm: 'rule.read' }
] : [];
%>
<!--begin::App Content Header-->
<div class="app-content-header" style="min-height:32px;"></div>
<div class="app-content">
  <div class="container-fluid">

    <% if (!stats) { %>
      <div class="alert alert-warning"><%= t('Unable to load dashboard statistics right now.') %></div>
    <% } else { %>

      <!-- ==========================================
           STAT TILES
           ========================================== -->
      <div class="row g-3 mb-1">
        <% statTiles.forEach(function(tile) { %>
          <% if (hasPermission && hasPermission(tile.perm)) { %>
            <div class="col-6 col-sm-4 col-lg-3">
              <a href="<%= tile.url %>" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100 dashboard-tile">
                  <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="dashboard-tile-icon flex-shrink-0">
                      <i class="bi <%= tile.icon %>"></i>
                    </div>
                    <div class="min-w-0">
                      <div class="fs-4 fw-bold text-dark"><%= tile.count.toLocaleString() %></div>
                      <div class="text-muted small text-truncate"><%= tile.label %></div>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          <% } %>
        <% }) %>
      </div>

      <div class="row g-3 mt-1">
        <!-- ==========================================
             IP ADDRESS STATUS BREAKDOWN
             ========================================== -->
        <% if (hasPermission && hasPermission('ip_address.read')) { %>
          <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-header bg-white border-0 pb-0">
                <strong><%= t('IP Address Status') %></strong>
                <span class="text-muted small ms-1"><%= t('({1} total)', { 1: stats.counts.ipAddresses.toLocaleString() }) %></span>
              </div>
              <div class="card-body">
                <% if (stats.ipStatusBreakdown.length === 0) { %>
                  <div class="text-muted small"><%= t('No IP addresses yet.') %></div>
                <% } else { %>
                  <% stats.ipStatusBreakdown.forEach(function(row) { %>
                    <% const color = IP_STATUS_COLORS[row.label] || 'secondary'; %>
                    <div class="dashboard-bar-row mb-2">
                      <div class="d-flex justify-content-between small mb-1">
                        <span><%= row.label %></span>
                        <span class="text-muted"><%= row.count.toLocaleString() %> (<%= row.pct %>%)</span>
                      </div>
                      <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-<%= color %>" role="progressbar" style="width: <%= row.pct %>%;" aria-valuenow="<%= row.pct %>" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                    </div>
                  <% }) %>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>

        <!-- ==========================================
             DEVICE TYPE BREAKDOWN
             ========================================== -->
        <% if (hasPermission && hasPermission('device.read')) { %>
          <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-header bg-white border-0 pb-0">
                <strong><%= t('Devices by Type') %></strong>
                <span class="text-muted small ms-1"><%= t('({1} total)', { 1: stats.counts.devices.toLocaleString() }) %></span>
              </div>
              <div class="card-body">
                <% if (stats.deviceTypeBreakdown.length === 0) { %>
                  <div class="text-muted small"><%= t('No devices yet.') %></div>
                <% } else { %>
                  <% stats.deviceTypeBreakdown.forEach(function(row, idx) { %>
                    <% const color = CATEGORICAL_COLORS[idx % CATEGORICAL_COLORS.length]; %>
                    <div class="dashboard-bar-row mb-2">
                      <div class="d-flex justify-content-between small mb-1">
                        <span><%= row.label %></span>
                        <span class="text-muted"><%= row.count.toLocaleString() %> (<%= row.pct %>%)</span>
                      </div>
                      <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-<%= color %>" role="progressbar" style="width: <%= row.pct %>%;" aria-valuenow="<%= row.pct %>" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                    </div>
                  <% }) %>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <!-- ==========================================
           SUBNET UTILIZATION
           ========================================== -->
      <% if (hasPermission && hasPermission('subnet.read')) { %>
        <div class="row g-3 mt-1">
          <div class="col-12">
            <div class="card shadow-sm border-0">
              <div class="card-header bg-white border-0 pb-0">
                <strong><%= t('Subnet Utilization') %></strong>
                <span class="text-muted small ms-1"><%= t('(highest usage first)') %></span>
              </div>
              <div class="card-body">
                <% if (stats.subnetUsage.length === 0) { %>
                  <div class="text-muted small"><%= t('No subnets yet.') %></div>
                <% } else { %>
                  <% stats.subnetUsage.forEach(function(sn) { %>
                    <div class="dashboard-bar-row mb-2">
                      <div class="d-flex justify-content-between small mb-1">
                        <span>
                          <a href="/network/subnet-address?page=1&search=<%= encodeURIComponent(sn.address) %>&pageSize=5" class="text-decoration-none"><%= sn.address %></a>
                          <% if (sn.description) { %><span class="text-muted"> — <%= sn.description %></span><% } %>
                        </span>
                        <span class="text-muted"><%= sn.usedCount.toLocaleString() %> / <%= sn.totalIPs.toLocaleString() %> (<%= sn.pct %>%)</span>
                      </div>
                      <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-<%= sn.color %>" role="progressbar" style="width: <%= sn.pct %>%;" aria-valuenow="<%= sn.pct %>" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                    </div>
                  <% }) %>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>

    <% } %>
  </div>
</div>
<!--end::App Content Header-->

<style>
.dashboard-tile {
  transition: transform .12s ease, box-shadow .12s ease;
}
.dashboard-tile:hover {
  transform: translateY(-2px);
  box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
}
.dashboard-tile-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 110, 253, 0.1);
  color: #0d6efd;
  font-size: 1.15rem;
}
.dashboard-bar-row:last-child {
  margin-bottom: 0 !important;
}
</style>
