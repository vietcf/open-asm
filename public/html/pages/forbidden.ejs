<div class="container py-5 text-center">
  <h1 class="display-4 text-danger mb-3">
    <i class="bi bi-shield-lock"></i> <%= t('Access Denied') %>
  </h1>
  <p class="lead mb-4"><%= t('You do not have permission to access this feature.') %></p>
  <a href="<%= redirectUrl %>" class="btn btn-primary"><%= t('Go back') %></a>
</div>
<script>
  setTimeout(function() {
    window.location.href = "<%= redirectUrl %>";
  }, 3000);
</script>
