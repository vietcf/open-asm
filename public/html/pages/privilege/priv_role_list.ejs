                            </div>
          <div class="mb-3">
            <label for="editRoleDescription" class="form-label"><%= t('Description') %></label>
            <textarea class="form-control" id="editRoleDescription" name="description" placeholder="<%= t('Description') %>" rows="2"></textarea>
                            </div>
          <div class="mb-3">
            <label for="editRoleSystem" class="form-label"><%= t('System') %> <span class="text-danger">*</span></label>
