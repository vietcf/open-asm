<%
  const activeFilterCount = filter.system_id ? 1 : 0;
  const COLUMNS = [
    { key: 'name', label: 'Role Name', def: true, fixed: true },
    { key: 'system', label: 'System', def: true },
    { key: 'permissions', label: 'Permissions', def: true },
    { key: 'accounts', label: 'Accounts', def: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (r, key) => ({
    name: ui.esc(r.name),
    system: ui.text(r.system?.name),
    permissions: ui.chips(r.permissions.map(p => p.name)),
    accounts: r.account_count ? `<a href="/priv-account/account?search=${encodeURIComponent(r.name)}"><span class="badge tag">${r.account_count}</span></a>` : ui.dash,
    description: ui.clip(r.description),
    updated: ui.date(r.updated_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Privileged Account', href: '/priv-account/account' }, { label: 'Privileged Role List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/priv-account/role">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by role, description, permission...',
              filtersId: 'roleFilters', activeFilterCount,
              columns: { tableId: 'roleTable', storageKey: 'openasm.privRoleList.columns', list: COLUMNS },
              exportUrl: '/priv-account/role/export' + currentQuery,
              addUrl: hasPermission('priv_role.create') ? '/priv-account/role/add' : null, addLabel: 'Add Privileged Role' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="roleFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label small"><%= t('System') %></label>
                <select name="system_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(filter.system_id ? [filter.system_id] : []) %>'></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="roleTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (list.length) { %>
              <% list.forEach(function (r, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(r, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <% if (hasPermission('priv_role.update')) { %>
                        <a href="/priv-account/role/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('priv_role.delete')) { %>
                        <form action="/priv-account/role/<%= r.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: r.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-person-badge', message: 'No privileged roles found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/priv-account/role',
                      actionUrl: hasPermission('priv_role.create') ? '/priv-account/role/add' : null, actionLabel: 'Add Privileged Role' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: list.length, summary: 'Showing {1} - {2} of {3} roles' }) %>
    </div>
  </div>
</div>
