                        </form>
                  </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Cancel') %></button>
        <button type="submit" class="btn btn-primary btn-sm" form="editPrivRoleForm"><%= t('Save Changes') %></button>
      </div>
    </div>
  </div>
                  </div>
                  
<!-- Filter Modal -->
<div class="modal fade" id="filterPrivRoleModal" tabindex="-1" aria-labelledby="filterPrivRoleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filterPrivRoleModalLabel"><%= t('Filter Privileged Roles') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
      </div>
      <form method="get" action="/priv-account/role">
        <div class="modal-body">
          <div class="mb-3">
            <label for="filterRoleSystemId" class="form-label"><%= t('System') %></label>
            <select id="filterRoleSystemId" name="system_id" class="form-control" style="width:100%"></select>
                  </div>
                  </div>
        <div class="modal-footer d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Cancel') %></button>
          <button type="button" class="btn btn-warning btn-sm" id="clearPrivRoleFilterBtn"><%= t('Clear Filter') %></button>
          <button type="submit" class="btn btn-primary btn-sm"><%= t('Apply Filter') %></button>
        </div>
      </form>
    </div>
          </div>
        </div>
        
<script>
function showToast(msg, type) {
  const toast = document.createElement('div');
  toast.className = `alert alert-${type}`;
  toast.style.position = 'fixed';
  toast.style.top = '16px';
  toast.style.right = '16px';
  toast.style.zIndex = 9999;
  toast.style.minWidth = '200px';
  toast.innerText = msg;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
}

function showRoleDetail(roleId) {
  console.log('showRoleDetail called with roleId:', roleId);
  
  // Get role data from button (specifically the show button)
  const button = document.querySelector(`button[data-role-id="${roleId}"][title="Show"]`);
  if (!button) {
    console.error('Button not found for roleId:', roleId);
    return;
  }
  
  console.log('Button found:', button);
  
  const roleData = button.getAttribute('data-role');
  if (!roleData) {
    console.error('No role data found for roleId:', roleId);
    return;
  }
  
  let role;
  try {
    role = JSON.parse(roleData);
  } catch (e) {
    console.error('Error parsing role data:', e);
    return;
  }
  
  // Create modal HTML
  const modalId = `roleDetailModal-${roleId}`;
  const modalHtml = `
    <div class="modal fade" id="${modalId}" tabindex="-1" aria-labelledby="${modalId}Label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="${modalId}Label">Privileged Role Information</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
      <div class="modal-body">
            <dl class="row detail-dl">
              <dt class="col-sm-4">Role Name</dt>
              <dd class="col-sm-8">${role.name || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Description</dt>
              <dd class="col-sm-8">${role.description || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Permissions</dt>
              <dd class="col-sm-8">
                ${role.permissions && role.permissions.length > 0 
                  ? role.permissions.map(perm => `<div class="text-lowercase">${perm.name ? perm.name.toLowerCase() : ''}</div>`).join('')
                  : '<span class="text-muted">No permission</span>'
                }
              </dd>
              <dt class="col-sm-4">System</dt>
              <dd class="col-sm-8">${role.system && role.system.name ? role.system.name : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Created At</dt>
              <dd class="col-sm-8">${role.created_at ? new Date(role.created_at).toLocaleString() : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Updated At</dt>
              <dd class="col-sm-8">${role.updated_date ? new Date(role.updated_date).toLocaleString() : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Updated By</dt>
              <dd class="col-sm-8">${role.updated_by || '<span class="text-muted">No data</span>'}</dd>
            </dl>
    </div>
      <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
  </div>
</div>
  </div>
</div>
  `;
  
  // Remove existing modal if any
  const existingModal = document.getElementById(modalId);
  if (existingModal) {
    existingModal.remove();
  }
  
  // Add modal to body
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  
  // Show modal
  const modal = new bootstrap.Modal(document.getElementById(modalId));
  modal.show();
  
  // Remove modal from DOM when hidden
  document.getElementById(modalId).addEventListener('hidden.bs.modal', function() {
    this.remove();
  });
}

function confirmDeleteRole(form, roleName) {
  return confirm(`Are you sure you want to delete role "${roleName}"?`);
}
</script>

<% if (success) { %>
<script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= t(success) %>', 'success');
    });
  </script>
<% } %>
<% if (error) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= t(error) %>', 'danger');
    });
  </script>
<% } %>

<script>
$(function() {
  // Add Privileged Role Modal: System select2
  $('#privRoleSystem').select2({
      theme: 'bootstrap-5',
    placeholder: t('Select system'),
      width: '100%',
    allowClear: true,
    dropdownParent: $('#addPrivRoleModal'),
      ajax: {
      url: '/system/api/system',
        dataType: 'json',
        delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
        cache: true
      }
    });

  // When system is selected, load permissions
  $('#privRoleSystem').on('change', function() {
    const systemId = $(this).val();
    if (systemId) {
      $.ajax({
        url: '/priv-account/api/permissions',
        data: { system_id: systemId },
        dataType: 'json',
        success: function(perms) {
          let html = '';
          if (perms && perms.length) {
            perms.forEach(function(perm) {
              html += '<div class="form-check form-check-inline">';
              html += '<input class="form-check-input" type="checkbox" name="permissions" value="' + perm.id + '">';
              html += '<label class="form-check-label">' + perm.name + '</label>';
              html += '</div>';
            });
            $('#privRolePermissionsWrapper').show();
          } else {
            html = '<span class="text-muted">No permission</span>';
            $('#privRolePermissionsWrapper').show();
          }
          $('#privRolePermissions').html(html);
        },
        error: function() {
          $('#privRolePermissions').html('<span class="text-danger">Failed to load permissions</span>');
          $('#privRolePermissionsWrapper').show();
        }
      });
    } else {
      $('#privRolePermissions').html('');
      $('#privRolePermissionsWrapper').hide();
    }
  });
  
  // Hide permissions when opening new modal
  $('#addPrivRoleModal').on('show.bs.modal', function() {
    $('#privRolePermissions').html('');
    $('#privRolePermissionsWrapper').hide();
    $('#privRoleSystem').val(null).trigger('change');
  });
  
  // Edit Privileged Role Modal: System select2
  $('#editRoleSystem').select2({
            theme: 'bootstrap-5',
    placeholder: t('Select system'),
            width: '100%',
    allowClear: true,
    dropdownParent: $('#editPrivRoleModal'),
            ajax: {
      url: '/system/api/system',
              dataType: 'json',
      delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
      cache: true
    }
  });
  
  // When Edit button is clicked, populate the edit modal
  $(document).on('click', '[data-bs-target="#editPrivRoleModal"]', function() {
    const roleId = $(this).data('role-id');
    const roleName = $(this).data('role-name');
    const roleDescription = $(this).data('role-description');
    const roleSystem = $(this).data('role-system');
    const rolePermissions = $(this).data('role-permissions');
    
    // Populate form fields
    $('#editRoleId').val(roleId);
    $('#editRoleName').val(roleName);
    $('#editRoleDescription').val(roleDescription);
    
    // Set form action
    $('#editPrivRoleForm').attr('action', '/priv-account/role/' + roleId + '?_method=PUT');
    
    // Clear and populate system select
    const $systemSelect = $('#editRoleSystem');
    $systemSelect.val(null).trigger('change');
    $systemSelect.find('option').remove();
    if (roleSystem && roleSystem.id && roleSystem.name) {
      const option = new Option(roleSystem.name, roleSystem.id, true, true);
      $systemSelect.append(option).trigger('change');
    }
    
    // Load permissions
    loadEditRolePermissions(roleSystem ? roleSystem.id : '', rolePermissions ? rolePermissions.map(p => p.id) : []);
  });
  
  // When system changes in edit modal, reload permissions
  $('#editRoleSystem').on('change', function() {
    const systemId = $(this).val();
    loadEditRolePermissions(systemId, []);
  });
  
  function loadEditRolePermissions(systemId, checkedIds) {
    const $permDiv = $('#editRolePermissions');
    $permDiv.html('<span class="text-muted">Loading...</span>');
    if (!systemId) {
      $permDiv.html('<span class="text-muted">Select a system first</span>');
      return;
    }
    $.ajax({
      url: '/priv-account/api/permissions',
      data: { system_id: systemId },
              dataType: 'json',
      success: function(perms) {
        let html = '';
        if (perms && perms.length) {
          perms.forEach(function(perm) {
            const checked = checkedIds && checkedIds.includes(perm.id) ? 'checked' : '';
            html += '<div class="form-check form-check-inline">';
            html += '<input class="form-check-input" type="checkbox" name="permissions" value="' + perm.id + '" ' + checked + ' id="editPerm-' + perm.id + '">';
            html += '<label class="form-check-label" for="editPerm-' + perm.id + '">' + perm.name + '</label>';
            html += '</div>';
          });
        } else {
          html = '<span class="text-muted">No permissions for this system</span>';
        }
        $permDiv.html(html);
      },
      error: function() {
        $permDiv.html('<span class="text-danger">Failed to load permissions</span>');
      }
    });
  }
  
  // Validate before submit
  $('#editPrivRoleForm').on('submit', function(e) {
    const checked = $(this).find('input[name="permissions"]:checked');
    if (checked.length === 0) {
      alert(t('You must select at least one permission!'));
      e.preventDefault();
      return false;
    }
  });
  
  // Filter modal: system select2
  $('#filterRoleSystemId').select2({
            theme: 'bootstrap-5',
    placeholder: t('Select system'),
            width: '100%',
    allowClear: true,
    dropdownParent: $('#filterPrivRoleModal'),
            ajax: {
      url: '/system/api/system',
              dataType: 'json',
              delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
              cache: true
            }
          });

  // Persist filter values when opening modal
  $('#filterPrivRoleModal').on('shown.bs.modal', function() {
    const systemId = '<%= typeof system_id !== "undefined" ? system_id : "" %>';
    const systemName = '<%= typeof system_name !== "undefined" ? system_name : "" %>';
    if (systemId && systemName) {
      const option = new Option(systemName, systemId, true, true);
      $('#filterRoleSystemId').empty().append(option).trigger('change');
    } else {
      $('#filterRoleSystemId').val(null).trigger('change');
    }
  });
  
  // Clear filter button
  $('#clearPrivRoleFilterBtn').on('click', function() {
    $('#filterRoleSystemId').val(null).trigger('change');
    window.location.href = '/priv-account/role';
  });
});
</script>

