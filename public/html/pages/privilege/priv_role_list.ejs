        <button type="submit" class="btn btn-primary btn-sm" form="addPrivRoleForm"><%= t('Add Role') %></button>
                        </div>
                      </div>
                    </div>
                  </div>

<!-- Edit Privileged Role Modal -->
<div class="modal fade" id="editPrivRoleModal" tabindex="-1" aria-labelledby="editPrivRoleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
        <h5 class="modal-title" id="editPrivRoleModalLabel"><%= t('Edit Privileged Role') %></h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
                        </div>
                          <div class="modal-body">
        <form id="editPrivRoleForm" method="POST" autocomplete="off">
          <input type="hidden" id="editRoleId" name="id">
