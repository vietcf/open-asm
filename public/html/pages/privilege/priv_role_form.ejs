<%#
  Add / Edit Privileged Role.  mode, record (role), canGlobal (may tick "All systems").
  Permissions: those of the chosen system and the "All systems" ones; any for an "All systems" role (AJAX picker).
%>
<% const isEdit = mode === 'edit'; const r = locals.record || {}; %>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'Privileged Role List', href: '/priv-account/role' }, { label: isEdit ? 'Edit Privileged Role' : 'Add Privileged Role' }
] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>
    <form class="card form-card" method="POST" action="<%= isEdit ? '/priv-account/role/' + r.id + '/edit' : '/priv-account/role/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit Privileged Role' : 'Add Privileged Role') %></h3>
      </div>
      <div class="card-body">
        <section class="form-section">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-name"><%= t('Role Name') %> <span class="text-danger">*</span></label>
              <input type="text" id="f-name" name="name" data-unique="priv_role.name" data-unique-exclude="<%= r.id || '' %>" data-unique-scope='{"system_id":"#f-system"}' class="form-control" value="<%= r.name || '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-system"><%= t('System') %> <span class="text-danger">*</span></label>
              <div id="f-system-box"<%- r.all_systems ? ' class="d-none"' : '' %>>
                <select id="f-system" name="system_id" class="form-select js-select" <%= r.all_systems ? '' : 'required' %> data-placeholder="<%= t('Select system') %>"
                        data-ajax-url="/priv-account/api/systems" data-selected="<%= JSON.stringify(r.system ? [{ id: r.system.id, text: r.system.name }] : []) %>"></select>
              </div>
              <% if (canGlobal) { %>
                <div class="form-check mt-2">
                  <input class="form-check-input" type="checkbox" id="f-all-systems" name="all_systems" <%= r.all_systems ? 'checked' : '' %>>
                  <label class="form-check-label" for="f-all-systems"><%= t('All systems') %></label>
                </div>
                <div class="form-text"><%= t('Can be picked for any system. Only administrators can tick it.') %></div>
              <% } %>
              <input type="hidden" id="f-all-flag" value="<%= r.all_systems ? 'on' : '' %>">
            </div>
            <div class="col-12">
              <label class="form-label" for="f-permissions"><%= t('Permissions') %></label>
              <select id="f-permissions" name="permissions" class="form-select js-select" multiple data-placeholder="<%= t('Select system first') %>"
                      data-ajax-url="/priv-account/api/permissions" data-ajax-with='{"system_id":"#f-system","all_systems":"#f-all-flag"}'
                      data-selected="<%= JSON.stringify((r.permissions || []).map(p => ({ id: p.id, text: p.name }))) %>"></select>
              <div class="form-text"><%= t('Permissions of the selected system and "All systems" permissions; any permission for an "All systems" role') %></div>
            </div>
            <div class="col-12">
              <label class="form-label" for="f-description"><%= t('Description') %></label>
              <textarea id="f-description" name="description" class="form-control" rows="3"><%= r.description || '' %></textarea>
            </div>
          </div>
        </section>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/priv-account/role', submitLabel: isEdit ? 'Save Changes' : 'Add Privileged Role', record: r }) %>
    </form>
  </div>
</div>

<script>
  // permissions depend on the system: clear them when the system changes
  $('#f-system').on('change', () => $('#f-permissions').val(null).trigger('change'));
  // "All systems": no system; the picker then offers every permission
  $('#f-all-systems').on('change', function () {
    const all = this.checked;
    $('#f-all-flag').val(all ? 'on' : '');
    $('#f-system-box').toggleClass('d-none', all);
    $('#f-system').prop('required', !all);
    if (all) $('#f-system').val(null).trigger('change');
  });
</script>
