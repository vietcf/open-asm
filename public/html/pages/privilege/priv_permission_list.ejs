<%
  const activeFilterCount = filter.system_id ? 1 : 0;
  const COLUMNS = [
    { key: 'name', label: 'Permission Name', def: true, fixed: true },
    { key: 'system', label: 'System', def: true },
    { key: 'roles', label: 'Roles', def: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (p, key) => ({
    name: ui.esc(p.name),
    system: ui.text(p.system?.name),
    roles: p.role_count ? `<span class="badge tag">${p.role_count}</span>` : ui.dash,
    description: ui.clip(p.description),
    updated: ui.date(p.updated_date),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Privileged Account', href: '/priv-account/account' }, { label: 'Privileged Permission List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/priv-account/permission">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name or description...',
              filtersId: 'permissionFilters', activeFilterCount,
              columns: { tableId: 'permissionTable', storageKey: 'openasm.privPermissionList.columns', list: COLUMNS },
              exportUrl: '/priv-account/permission/export' + currentQuery,
              addUrl: hasPermission('priv_permission.create') ? '/priv-account/permission/add' : null, addLabel: 'Add Privileged Permission' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="permissionFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label small"><%= t('System') %></label>
                <select name="system_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(filter.system_id ? [filter.system_id] : []) %>'></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="permissionTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (list.length) { %>
              <% list.forEach(function (p, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(p, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <% if (hasPermission('priv_permission.update')) { %>
                        <a href="/priv-account/permission/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('priv_permission.delete')) { %>
                        <form action="/priv-account/permission/<%= p.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: p.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-key', message: 'No privileged permissions found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/priv-account/permission',
                      actionUrl: hasPermission('priv_permission.create') ? '/priv-account/permission/add' : null, actionLabel: 'Add Privileged Permission' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: list.length, summary: 'Showing {1} - {2} of {3} permissions' }) %>
    </div>
  </div>
</div>
