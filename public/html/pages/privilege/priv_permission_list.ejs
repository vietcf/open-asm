<!-- Filter Modal -->
<div class="modal fade" id="filterPrivPermissionModal" tabindex="-1" aria-labelledby="filterPrivPermissionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filterPrivPermissionModalLabel">Filter Privileged Permissions</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="get" action="/priv-account/permission">
        <div class="modal-body">
          <div class="mb-3">
            <label for="filterSystemId" class="form-label">System</label>
            <select id="filterSystemId" name="system_id" class="form-control" style="width:100%"></select>
                  </div>
                  </div>
        <div class="modal-footer d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-warning btn-sm" id="clearPrivPermissionFilterBtn">Clear Filter</button>
          <button type="submit" class="btn btn-primary btn-sm">Apply Filter</button>
        </div>
      </form>
    </div>
          </div>
        </div>
        
<script>
function showToast(msg, type) {
  const toast = document.createElement('div');
  toast.className = `alert alert-${type}`;
  toast.style.position = 'fixed';
  toast.style.top = '16px';
  toast.style.right = '16px';
  toast.style.zIndex = 9999;
  toast.style.minWidth = '200px';
  toast.innerText = msg;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
}

function showPermissionDetail(permissionId) {
  console.log('showPermissionDetail called with permissionId:', permissionId);
  
  // Get permission data from button (specifically the show button)
  const button = document.querySelector(`button[data-permission-id="${permissionId}"][title="Show"]`);
  if (!button) {
    console.error('Button not found for permissionId:', permissionId);
    return;
  }
  
  console.log('Button found:', button);
  
  const permissionData = button.getAttribute('data-permission');
  if (!permissionData) {
    console.error('No permission data found for permissionId:', permissionId);
    return;
  }
  
  let permission;
  try {
    permission = JSON.parse(permissionData);
  } catch (e) {
    console.error('Error parsing permission data:', e);
    return;
  }
  
  // Create modal HTML
  const modalId = `permissionDetailModal-${permissionId}`;
  const modalHtml = `
    <div class="modal fade" id="${modalId}" tabindex="-1" aria-labelledby="${modalId}Label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="${modalId}Label">Privileged Permission Information</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
      <div class="modal-body">
            <dl class="row mb-0">
              <dt class="col-sm-4">Permission Name</dt>
              <dd class="col-sm-8">${permission.name || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Description</dt>
              <dd class="col-sm-8">${permission.description || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">System</dt>
              <dd class="col-sm-8">${permission.system && permission.system.name ? permission.system.name : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Created At</dt>
              <dd class="col-sm-8">${permission.created_at ? new Date(permission.created_at).toLocaleString() : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Updated At</dt>
              <dd class="col-sm-8">${permission.updated_date ? new Date(permission.updated_date).toLocaleString() : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Updated By</dt>
              <dd class="col-sm-8">${permission.updated_by || '<span class="text-muted">No data</span>'}</dd>
            </dl>
    </div>
      <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
  </div>
</div>
  </div>
</div>
  `;
  
  // Remove existing modal if any
  const existingModal = document.getElementById(modalId);
  if (existingModal) {
    existingModal.remove();
  }
  
  // Add modal to body
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  
  // Show modal
  const modal = new bootstrap.Modal(document.getElementById(modalId));
  modal.show();
  
  // Remove modal from DOM when hidden
  document.getElementById(modalId).addEventListener('hidden.bs.modal', function() {
    this.remove();
  });
}

function confirmDeletePermission(form, permissionName) {
  return confirm(`Are you sure you want to delete permission "${permissionName}"?`);
}
</script>

<% if (success) { %>
<script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= success %>', 'success');
    });
  </script>
<% } %>
<% if (error) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= error %>', 'danger');
    });
  </script>
<% } %>

<script>
$(function() {
  // Add Privileged Permission Modal: System select2
  $('#privPermissionSystem').select2({
      theme: 'bootstrap-5',
    placeholder: 'Select system',
      width: '100%',
    allowClear: true,
    dropdownParent: $('#addPrivPermissionModal'),
    dropdownPosition: 'below',
      ajax: {
      url: '/system/api/system',
        dataType: 'json',
        delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
        cache: true
      }
    });

  // Edit Privileged Permission Modal: System select2
  $('#editPermissionSystem').select2({
      theme: 'bootstrap-5',
    placeholder: 'Select system',
      width: '100%',
    allowClear: true,
    dropdownParent: $('#editPrivPermissionModal'),
      ajax: {
      url: '/system/api/system',
        dataType: 'json',
        delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
        cache: true
      }
    });
  
  // When Edit button is clicked, populate the edit modal
  $(document).on('click', '[data-bs-target="#editPrivPermissionModal"]', function() {
    const permissionId = $(this).data('permission-id');
    const permissionName = $(this).data('permission-name');
    const permissionDescription = $(this).data('permission-description');
    const permissionSystem = $(this).data('permission-system');
    
    // Populate form fields
    $('#editPermissionId').val(permissionId);
    $('#editPermissionName').val(permissionName);
    $('#editPermissionDescription').val(permissionDescription);
    
    // Set form action
    $('#editPrivPermissionForm').attr('action', '/priv-account/permission/' + permissionId + '?_method=PUT');
    
    // Clear and populate system select
    const $systemSelect = $('#editPermissionSystem');
    $systemSelect.val(null).trigger('change');
    $systemSelect.find('option').remove();
    if (permissionSystem && permissionSystem.id && permissionSystem.name) {
      const option = new Option(permissionSystem.name, permissionSystem.id, true, true);
      $systemSelect.append(option).trigger('change');
    }
  });
  
  // Filter modal: system select2
  $('#filterSystemId').select2({
            theme: 'bootstrap-5',
    placeholder: 'Select system',
            width: '100%',
            allowClear: true,
    dropdownParent: $('#filterPrivPermissionModal'),
            ajax: {
      url: '/system/api/system',
              dataType: 'json',
              delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
              cache: true
            }
          });

  // Persist filter values when opening modal
  $('#filterPrivPermissionModal').on('shown.bs.modal', function() {
    const systemId = '<%= typeof system_id !== "undefined" ? system_id : "" %>';
    const systemName = '<%= typeof system_name !== "undefined" ? system_name : "" %>';
    if (systemId && systemName) {
      const option = new Option(systemName, systemId, true, true);
      $('#filterSystemId').empty().append(option).trigger('change');
    } else {
      $('#filterSystemId').val(null).trigger('change');
    }
  });
  
  // Clear filter button
  $('#clearPrivPermissionFilterBtn').on('click', function() {
    $('#filterSystemId').val(null).trigger('change');
    window.location.href = '/priv-account/permission';
  });
});
</script>

