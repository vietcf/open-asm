                                </div>
          <div class="mb-3">
            <label for="privPermissionDescription" class="form-label">Description</label>
            <textarea class="form-control" id="privPermissionDescription" name="description" placeholder="Description" rows="2"></textarea>
                            </div>
          <div class="mb-3">
            <label for="privPermissionSystem" class="form-label">System <span class="text-danger">*</span></label>
            <select id="privPermissionSystem" name="system_id" class="form-control" required style="width:100%"></select>
              </div>
        </form>
                        </div>
                        <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary btn-sm" form="addPrivPermissionForm">Add Permission</button>
                        </div>
                      </div>
                    </div>
                  </div>

<!-- Edit Privileged Permission Modal -->
<div class="modal fade" id="editPrivPermissionModal" tabindex="-1" aria-labelledby="editPrivPermissionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
        <h5 class="modal-title" id="editPrivPermissionModalLabel">Edit Privileged Permission</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                          <div class="modal-body">
        <form id="editPrivPermissionForm" method="POST" autocomplete="off">
          <input type="hidden" id="editPermissionId" name="id">
