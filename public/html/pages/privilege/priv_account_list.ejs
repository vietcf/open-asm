<%
// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  // Add organize_id filter if exists
  if (typeof organize_id !== 'undefined' && organize_id) {
    params.set('organize_id', organize_id);
  }
  
  // Add system_ids filter if exists
  if (typeof system_ids !== 'undefined' && system_ids && system_ids.length) {
    system_ids.forEach(function(id) {
      params.append('system_ids[]', id);
    });
  }
  
  // Add contact_ids filter if exists
  if (typeof contact_ids !== 'undefined' && contact_ids && contact_ids.length) {
    contact_ids.forEach(function(id) {
      params.append('contact_ids[]', id);
    });
  }
  
  return '?' + params.toString();
}

// Helper function to build export URL with all query parameters
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add organize_id filter if exists
  if (typeof organize_id !== 'undefined' && organize_id) {
    params.set('organize_id', organize_id);
  }
  
  // Add system_ids filter if exists
  if (typeof system_ids !== 'undefined' && system_ids && system_ids.length) {
    system_ids.forEach(function(id) {
      params.append('system_ids[]', id);
    });
  }
  
  // Add contact_ids filter if exists
  if (typeof contact_ids !== 'undefined' && contact_ids && contact_ids.length) {
    contact_ids.forEach(function(id) {
      params.append('contact_ids[]', id);
    });
  }
  
  return '/priv-account/account/export' + (params.toString() ? '?' + params.toString() : '');
}
%>

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item active"><%= t('Privileged Account List') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/priv-account/account">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            <% if (typeof organize_id !== 'undefined' && organize_id) { %>
              <input type="hidden" name="organize_id" value="<%= organize_id %>">
            <% } %>
            <% if (typeof system_ids !== 'undefined' && system_ids && system_ids.length) { %>
              <% system_ids.forEach(function(id) { %>
                <input type="hidden" name="system_ids[]" value="<%= id %>">
              <% }) %>
            <% } %>
            <% if (typeof contact_ids !== 'undefined' && contact_ids && contact_ids.length) { %>
              <% contact_ids.forEach(function(id) { %>
                <input type="hidden" name="contact_ids[]" value="<%= id %>">
              <% }) %>
            <% } %>
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="<%= t('Search Account or Description...') %>" aria-label="<%= t('Search') %>" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted"><%= t('Show:') %></label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission('priv_account.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPrivUserModal">
              <i class="bi bi-plus"></i> <%= t('Add Privileged Account') %>
            </button>
          <% } %>
          <%
            const hasActivePrivAccountFilter = !!(
              (system_ids && system_ids.length > 0) ||
              (organize_id && organize_id !== '') ||
              (contact_ids && contact_ids.length > 0)
            );
          %>
          <button type="button" class="btn btn-sm <%= hasActivePrivAccountFilter ? 'btn-primary' : 'btn-outline-secondary' %>" data-bs-toggle="modal" data-bs-target="#filterPrivAccountModal">
            <i class="bi bi-funnel<%= hasActivePrivAccountFilter ? '-fill' : '' %>"></i> <%= t('Filter{1}', { 1: hasActivePrivAccountFilter ? ' (Filtered)' : '' }) %>
          </button>
          <% if (hasPermission('priv_account.read')) { %>
            <a href="<%= buildExportUrl() %>" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> <%= t('Export') %>
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Filter values for JS -->
    <div id="filter-account-data"
          data-organize-id='<%= JSON.stringify(organize_id || '') %>'
          data-system-ids='<%= JSON.stringify(system_ids || []) %>'
          data-contact-ids='<%= JSON.stringify(contact_ids || []) %>' style="display:none"></div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= t(successMessage) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
      </div>
      <script>
      // Auto-hide success message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
      </script>
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= t(errorMessage) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
      </div>
      <script>
      // Auto-hide error message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
      </script>
    <% } %>

    <!-- Data Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0"><%= t('Privileged Account List') %></h3>
          </div>
          <div class="card-body table-responsive p-0" style="max-height: 70vh; overflow-y: auto; overflow-x: auto;">
            <table class="table table-hover" id="privAccountTable" style="table-layout: fixed; min-width: 800px;">
              <thead>
                <tr>
                  <th><%= t('No.') %></th>
                  <th data-sort-type="text"><%= t('Account Name') %></th>
                  <th data-sort-type="text"><%= t('Description') %></th>
                  <th data-sort-type="text"><%= t('Systems') %></th>
                  <th data-sort-type="date"><%= t('Created At') %></th>
                  <th class="text-end"><%= t('Actions') %></th>
                </tr>
              </thead>
              <tbody>
                <% if (privUserList && privUserList.length > 0) { %>
                  <% privUserList.forEach(function(account, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= account.username %></td>
                      <td><%= account.description %></td>
                      <td>
                        <% if (account.systems && account.systems.length) { %>
                          <%= account.systems.map(s => s.name).join(', ') %>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      <td data-sort-value="<%= account.created_at || '' %>"><%= account.created_at ? account.created_at.toLocaleString() : '' %></td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm" title="<%= t('Show') %>" onclick="showAccountDetail('<%= account.id %>')" data-account-id="<%= account.id %>" data-account='<%= JSON.stringify(account) %>'><i class="bi bi-eye"></i></button>
                        <% if (hasPermission('priv_account.update')) { %>
                        <button type="button" class="btn btn-warning btn-sm" title="<%= t('Edit') %>" 
                                data-bs-toggle="modal" data-bs-target="#editPrivAccountModal"
                                data-account-id="<%= account.id %>"
                                data-account-username="<%= account.username %>"
                                data-account-description="<%= account.description || '' %>"
                                data-account-contacts="<%= JSON.stringify(account.contacts || []) %>"
                                data-account-organize="<%= JSON.stringify(account.organize || {}) %>"
                                data-account-type="<%= account.account_type %>"
                                data-account-servers="<%= JSON.stringify(account.servers || []) %>"
                                data-account-app-url="<%= account.app_url || '' %>"
                                data-account-systems="<%= JSON.stringify(account.systems || []) %>"
                                data-account-manage-type="<%= account.manage_type %>"
                                data-account-role="<%= JSON.stringify(account.role || {}) %>">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <% } %>
                        <% if (hasPermission('priv_account.delete')) { %>
                        <form action="/priv-account/account/<%= account.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteAccount(this, '<%= account.username %>')">
                          <button type="submit" class="btn btn-danger btn-sm" title="<%= t('Delete') %>">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="6" class="text-center"><%= t('No data') %></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <span><%= t('Showing {1} - {2} of {3} accounts', { 1: startItem, 2: endItem, 3: totalCount }) %></span>
              </div>
              <ul class="pagination pagination-sm m-0">
                <% 
                  let startPage = 1;
                  let endPage = totalPages;
                  if (totalPages > 10) {
                    if (page <= 6) {
                      startPage = 1;
                      endPage = 10;
                    } else if (page + 4 >= totalPages) {
                      startPage = totalPages - 9;
                      endPage = totalPages;
                    } else {
                      startPage = page - 5;
                      endPage = page + 4;
                    }
                  }
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= buildPaginationUrl(page - 1) %>"><%= t('Previous') %></a>
                </li>
                <% if (startPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="<%= buildPaginationUrl(1) %>">1</a></li>
                  <% if (startPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = startPage; i <= endPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="<%= buildPaginationUrl(i) %>"><%= i %></a></li>
                <% } %>
                <% if (endPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="<%= buildPaginationUrl(totalPages) %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= buildPaginationUrl(page + 1) %>"><%= t('Next') %></a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

