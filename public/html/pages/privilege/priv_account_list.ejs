<script>
function showToast(msg, type) {
  const toast = document.createElement('div');
  toast.className = `alert alert-${type}`;
  toast.style.position = 'fixed';
  toast.style.top = '16px';
  toast.style.right = '16px';
  toast.style.zIndex = 9999;
  toast.style.minWidth = '200px';
  toast.innerText = msg;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
}

function showAccountDetail(accountId) {
  console.log('showAccountDetail called with accountId:', accountId);
  
  // Get account data from button (specifically the show button)
  const button = document.querySelector(`button[data-account-id="${accountId}"][title="Show"]`);
  if (!button) {
    console.error('Button not found for accountId:', accountId);
    return;
  }
  
  console.log('Button found:', button);
  
  const accountData = button.getAttribute('data-account');
  if (!accountData) {
    console.error('No account data found for accountId:', accountId);
    return;
  }
  
  let account;
  try {
    account = JSON.parse(accountData);
  } catch (e) {
    console.error('Error parsing account data:', e);
    return;
  }
  
  // Create modal HTML
  const modalId = `accountDetailModal-${accountId}`;
  const modalHtml = `
    <div class="modal fade" id="${modalId}" tabindex="-1" aria-labelledby="${modalId}Label" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="${modalId}Label">Privileged Account Information</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <dl class="row detail-dl">
              <dt class="col-sm-4">Account Name</dt>
              <dd class="col-sm-8">${account.username || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Description</dt>
              <dd class="col-sm-8">${account.description || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Contacts</dt>
              <dd class="col-sm-8">
                ${account.contacts && account.contacts.length 
                  ? account.contacts.map(c => {
                      const name = c.name || c.text || '';
                      const email = c.email || '';
                      if (email) {
                        const shortEmail = email.split('@')[0];
                        return `${name} (${shortEmail})`;
                      }
                      return name;
                    }).join('<br>')
                  : '<span class="text-muted">N/A</span>'
                }
              </dd>
              <dt class="col-sm-4">Organize Unit</dt>
              <dd class="col-sm-8">${account.organize ? (account.organize.name || account.organize.text) : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Account Type</dt>
              <dd class="col-sm-8">${account.account_type || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Server(s)</dt>
              <dd class="col-sm-8">
                ${account.servers && account.servers.length 
                  ? account.servers.map(s => s.name || s.text).join('<br>')
                  : '<span class="text-muted">N/A</span>'
                }
              </dd>
              <dt class="col-sm-4">Application URL</dt>
              <dd class="col-sm-8">${account.app_url || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">System(s)</dt>
              <dd class="col-sm-8">
                ${account.systems && account.systems.length 
                  ? account.systems.map(s => s.name || s.text).join('<br>')
                  : '<span class="text-muted">N/A</span>'
                }
              </dd>
              <dt class="col-sm-4">Management Method</dt>
              <dd class="col-sm-8">${account.manage_type || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Role</dt>
              <dd class="col-sm-8">${account.role ? (account.role.name || account.role.text) : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Created At</dt>
              <dd class="col-sm-8">${account.created_at ? new Date(account.created_at).toLocaleString() : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Updated At</dt>
              <dd class="col-sm-8">${account.updated_date ? new Date(account.updated_date).toLocaleString() : '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Updated By</dt>
              <dd class="col-sm-8">${account.updated_by || '<span class="text-muted">No data</span>'}</dd>
            </dl>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  `;
  
  // Remove existing modal if any
  const existingModal = document.getElementById(modalId);
  if (existingModal) {
    existingModal.remove();
  }
  
  // Add modal to body
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  
  // Show modal
  const modal = new bootstrap.Modal(document.getElementById(modalId));
  modal.show();
  
  // Remove modal from DOM when hidden
  document.getElementById(modalId).addEventListener('hidden.bs.modal', function() {
    this.remove();
  });
}

function confirmDeleteAccount(form, accountName) {
  return confirm(`Are you sure you want to delete account "${accountName}"?`);
}
</script>

<% if (success) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= t(success) %>', 'success');
    });
  </script>
<% } %>
<% if (error) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= t(error) %>', 'danger');
    });
  </script>
<% } %>

<script>
$(function() {
  // Utility Functions
  function showToast(msg, type) {
    const toast = document.createElement('div');
    toast.className = `alert alert-${type}`;
    toast.style.position = 'fixed';
    toast.style.top = '16px';
    toast.style.right = '16px';
    toast.style.zIndex = 9999;
    toast.style.minWidth = '200px';
    toast.innerText = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  // Initialize Select2 with common options
  function initSelect2(selector, options) {
    const defaultOptions = {
      theme: 'bootstrap-5',
      width: '100%',
      allowClear: true,
      delay: 250,
      cache: true
    };
    return $(selector).select2({...defaultOptions, ...options});
  }

  // Pre-populate select2 with data
  function prePopulateSelect2(selector, data) {
    if (!data || !data.length) return;
    
    const $select = $(selector);
    data.forEach(item => {
      const option = new Option(item.text || item.name, item.id, true, true);
      $select.append(option);
    });
    $select.trigger('change');
  }

  // AJAX endpoints configuration
  const API_ENDPOINTS = {
    system: '/system/api/system',
    server: '/server/api/server',
    contact: '/organize/api/contact',
    unit: '/organize/api/unit',
    roleBySystem: '/priv-account/api/role/by-system'
  };

  // Initialize System select2
  function initSystemSelect2(selector, modalParent) {
    return initSelect2(selector, {
      placeholder: t('Select system(s)'),
      multiple: true,
      dropdownParent: modalParent,
      ajax: {
        url: API_ENDPOINTS.system,
        dataType: 'json',
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data })
      }
    });
  }

  // Initialize Server select2
  function initServerSelect2(selector, modalParent) {
    return initSelect2(selector, {
      placeholder: t('Select server(s)'),
      multiple: true,
      dropdownParent: modalParent,
      ajax: {
        url: API_ENDPOINTS.server,
        dataType: 'json',
        data: params => ({ search: params.term }),
        processResults: function(data) {
          if (Array.isArray(data)) return { results: data };
          if (Array.isArray(data.results)) {
            return { results: data.results.map(x => ({ id: x.id, text: x.text || x.name })) };
          }
          return { results: [] };
        }
      }
    });
  }

  // Initialize Contact select2
  function initContactSelect2(selector, modalParent) {
    return initSelect2(selector, {
      placeholder: t('Select contact(s)'),
      multiple: true,
      dropdownParent: modalParent,
      ajax: {
        url: API_ENDPOINTS.contact,
        dataType: 'json',
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data })
      }
    });
  }

  // Initialize Organize Unit select2
  function initOrganizeSelect2(selector, modalParent) {
    return initSelect2(selector, {
      placeholder: t('Select organize unit'),
      dropdownParent: modalParent,
      ajax: {
        url: API_ENDPOINTS.unit,
        dataType: 'json',
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data })
      }
    });
  }

  // Initialize Role select2 (only by system)
  function initRoleSelect2(selector, modalParent, systemSelector) {
    if ($(selector).hasClass('select2-hidden-accessible')) {
      $(selector).select2('destroy');
    }

    return initSelect2(selector, {
      placeholder: t('Select role'),
      dropdownParent: modalParent,
      ajax: {
        url: API_ENDPOINTS.roleBySystem,
        type: 'POST',
        contentType: 'application/json',
        dataType: 'json',
        data: function(params) {
          const systemIds = $(systemSelector).val()?.filter(Boolean) || [];
          if (!systemIds.length) {
            return JSON.stringify({ system_ids: [] });
          }
          return JSON.stringify({ system_ids: systemIds });
        },
        processResults: data => ({ results: data })
      }
    });
  }

  // Add Privileged Account Modal Functionality
  function initAddPrivAccountModal() {
    const modalElement = $('#addPrivUserModal');
    const modalContent = modalElement.find('.modal-content');

    // Initialize select2 components
    initSystemSelect2('#privUserSystem', modalElement);
    initServerSelect2('#privUserServers', modalElement);
    initContactSelect2('#privUserContacts', modalElement);
    initOrganizeSelect2('#privUserOrganize', modalElement);
    initSelect2('#privUserType', { placeholder: t('Select account type'), dropdownParent: modalElement });
    initSelect2('#privUserManageType', { placeholder: t('Select management method'), dropdownParent: modalElement });

    // Initialize and handle Role select2
    function initPrivUserRoleSelect2() {
      initRoleSelect2('#privUserRole', modalContent, '#privUserSystem');
    }

    // Handle system selection change
    $('#privUserSystem').on('change', function() {
      $('#privUserRole').val(null).trigger('change');
      initPrivUserRoleSelect2();
      // Force reload options
      setTimeout(() => {
        $('#privUserRole').select2('open');
        setTimeout(() => $('#privUserRole').select2('close'), 0);
      }, 0);
    });

    // Initialize role select2
    initPrivUserRoleSelect2();

    // Handle account type changes
    function updateAccountTypeFields() {
      const val = $('#privUserType').val();
      const isOSorDB = val === 'OS' || val === 'DB';
      const isAPP = val === 'APP';

      // Toggle server fields
      $('#privUserServerGroup').toggleClass('d-none', !isOSorDB);
      $('#privUserServers').prop('required', isOSorDB);

      // Toggle app URL fields
      $('#privUserAppUrlGroup').toggleClass('d-none', !isAPP);
      $('#privUserAppUrl').prop('required', isAPP);
    }

    $('#privUserType').on('change', updateAccountTypeFields);
    updateAccountTypeFields(); // Initial state
  }

  // Filter Modal Functionality
  function initFilterModal() {
    const modalElement = $('#filterPrivAccountModal');

    // Initialize select2 components
    initSystemSelect2('#filterSystem', modalElement);
    initOrganizeSelect2('#filterOrganize', modalElement);
    initContactSelect2('#filterContacts', modalElement);

    // When modal filter is opened, clear and append selected options if any
    modalElement.on('shown.bs.modal', function() {
      // Get filter data from hidden div
      const filterData = document.getElementById('filter-account-data');
      if (!filterData) return;
      
      // SYSTEMS
      $('#filterSystem').val(null).empty().trigger('change');
      const systemIds = filterData.getAttribute('data-system-ids');
      if (systemIds && systemIds !== '[]') {
        try {
          const systemIdsArray = JSON.parse(systemIds);
          if (systemIdsArray && systemIdsArray.length) {
            // Load systems by IDs
            systemIdsArray.forEach(systemId => {
              $.ajax({
                url: '/system/api/system',
                data: { id: systemId },
                dataType: 'json',
                success: function(systems) {
                  if (systems && systems.length) {
                    const system = systems[0];
                    const option = new Option(system.text || system.name, system.id, true, true);
                    $('#filterSystem').append(option).trigger('change');
                  }
                }
              });
            });
          }
        } catch (e) {
          console.error('Error parsing system IDs:', e);
        }
      }
      
      // ORGANIZE
      $('#filterOrganize').val(null).empty().trigger('change');
      const organizeId = filterData.getAttribute('data-organize-id');
      if (organizeId && organizeId !== '""' && organizeId !== '') {
        try {
          const organizeIdValue = JSON.parse(organizeId);
          if (organizeIdValue) {
            $.ajax({
              url: '/organize/api/unit',
              data: { id: organizeIdValue },
              dataType: 'json',
              success: function(units) {
                if (units && units.length) {
                  const unit = units[0];
                  const option = new Option(unit.text || unit.name, unit.id, true, true);
                  $('#filterOrganize').append(option).trigger('change');
                }
              }
            });
          }
        } catch (e) {
          console.error('Error parsing organize ID:', e);
        }
      }
      
      // CONTACTS
      $('#filterContacts').val(null).empty().trigger('change');
      const contactIds = filterData.getAttribute('data-contact-ids');
      if (contactIds && contactIds !== '[]') {
        try {
          const contactIdsArray = JSON.parse(contactIds);
          if (contactIdsArray && contactIdsArray.length) {
            // Load contacts by IDs
            contactIdsArray.forEach(contactId => {
              $.ajax({
                url: '/organize/api/contact',
                data: { id: contactId },
                dataType: 'json',
                success: function(contacts) {
                  if (contacts && contacts.length) {
                    const contact = contacts[0];
                    const option = new Option(contact.text || contact.name, contact.id, true, true);
                    $('#filterContacts').append(option).trigger('change');
                  }
                }
              });
            });
          }
        } catch (e) {
          console.error('Error parsing contact IDs:', e);
        }
      }
    });
  }

  // Edit Modal Functionality
  function initEditPrivAccountModal() {
    const modalElement = $('#editPrivAccountModal');
    const modalContent = modalElement.find('.modal-content');

    // Initialize all select2 components
    const systemSelect = initSystemSelect2('#editAccountSystem', modalElement);
    const serverSelect = initServerSelect2('#editAccountServers', modalElement);
    const contactSelect = initContactSelect2('#editAccountContacts', modalElement);
    const organizeSelect = initOrganizeSelect2('#editAccountOrganize', modalElement);
    const roleSelect = initRoleSelect2('#editAccountRole', modalContent, '#editAccountSystem');
    initSelect2('#editAccountType', { placeholder: t('Select account type'), dropdownParent: modalElement });
    initSelect2('#editAccountManageType', { placeholder: t('Select management method'), dropdownParent: modalElement });

    // Handle account type changes
    function updateEditModalFields() {
      const val = $('#editAccountType').val();
      const serverGroup = $('#editAccountServerGroup');
      const appUrlGroup = $('#editAccountAppUrlGroup');
      const servers = $('#editAccountServers');
      const appUrl = $('#editAccountAppUrl');

      if (val === 'OS' || val === 'DB') {
        serverGroup.removeClass('d-none');
        appUrlGroup.addClass('d-none');
        servers.prop('required', true);
        appUrl.prop('required', false);
      } else if (val === 'APP') {
        serverGroup.addClass('d-none');
        appUrlGroup.removeClass('d-none');
        servers.prop('required', false);
        appUrl.prop('required', true);
      } else {
        serverGroup.addClass('d-none');
        appUrlGroup.addClass('d-none');
        servers.prop('required', false);
        appUrl.prop('required', false);
      }
    }

    // Bind events
    $('#editAccountType').on('change', updateEditModalFields);
    
    // Handle system selection change for role updates
    $('#editAccountSystem').on('change', function() {
      $('#editAccountRole').val(null).trigger('change');
      roleSelect.trigger('change');
    });

    // When Edit button is clicked, populate the edit modal
    $(document).on('click', '[data-bs-target="#editPrivAccountModal"]', function() {
      const accountId = $(this).data('account-id');
      const accountUsername = $(this).data('account-username');
      const accountDescription = $(this).data('account-description');
      const accountContacts = $(this).data('account-contacts');
      const accountOrganize = $(this).data('account-organize');
      const accountType = $(this).data('account-type');
      const accountServers = $(this).data('account-servers');
      const accountAppUrl = $(this).data('account-app-url');
      const accountSystems = $(this).data('account-systems');
      const accountManageType = $(this).data('account-manage-type');
      const accountRole = $(this).data('account-role');
      
      // Populate form fields
      $('#editAccountId').val(accountId);
      $('#editAccountUsername').val(accountUsername);
      $('#editAccountDescription').val(accountDescription);
      $('#editAccountType').val(accountType).trigger('change');
      $('#editAccountAppUrl').val(accountAppUrl);
      $('#editAccountManageType').val(accountManageType).trigger('change');
      
      // Set form action
      $('#editPrivAccountForm').attr('action', '/priv-account/account/' + accountId + '?_method=PUT');
      
      // Clear and populate system select
      const $systemSelect = $('#editAccountSystem');
      $systemSelect.val(null).trigger('change');
      $systemSelect.find('option').remove();
      if (accountSystems && accountSystems.length) {
        prePopulateSelect2('#editAccountSystem', 
          accountSystems.map(sys => ({ id: sys.id, text: sys.name }))
        );
      }

      // Clear and populate server select
      const $serverSelect = $('#editAccountServers');
      $serverSelect.val(null).trigger('change');
      $serverSelect.find('option').remove();
      if (accountServers && accountServers.length) {
        prePopulateSelect2('#editAccountServers', 
          accountServers.map(srv => ({ id: srv.id, text: srv.name }))
        );
      }

      // Clear and populate contact select
      const $contactSelect = $('#editAccountContacts');
      $contactSelect.val(null).trigger('change');
      $contactSelect.find('option').remove();
      if (accountContacts && accountContacts.length) {
        prePopulateSelect2('#editAccountContacts', 
          accountContacts.map(contact => ({ id: contact.id, text: contact.name }))
        );
      }

      // Clear and populate organize select
      const $organizeSelect = $('#editAccountOrganize');
      $organizeSelect.val(null).trigger('change');
      $organizeSelect.find('option').remove();
      if (accountOrganize && accountOrganize.id && accountOrganize.name) {
        prePopulateSelect2('#editAccountOrganize', [{
          id: accountOrganize.id,
          text: accountOrganize.name
        }]);
      }

      // Clear and populate role select
      const $roleSelect = $('#editAccountRole');
      $roleSelect.val(null).trigger('change');
      $roleSelect.find('option').remove();
      if (accountRole && accountRole.id && accountRole.name) {
        prePopulateSelect2('#editAccountRole', [{
          id: accountRole.id,
          text: accountRole.name
        }]);
      }

      // Update fields visibility based on account type
      updateEditModalFields();
    });
  }

  // Initialize everything
  initAddPrivAccountModal();
  initFilterModal();
  initEditPrivAccountModal();

  // Clear filter button
  $('#clearPrivAccountFilterBtn').on('click', function() {
    window.location.href = '/priv-account/account';
  });
});
</script>

