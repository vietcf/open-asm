<%
  const f = filter;
  const activeFilterCount = [f.system_ids.length, f.contact_ids.length, f.organize_id, f.account_type.length, f.manage_type.length].filter(Boolean).length;
  const COLUMNS = [
    { key: 'username', label: 'Account Name', def: true, fixed: true },
    { key: 'account_type', label: 'Account Type', def: true },
    { key: 'manage_type', label: 'Management Method', def: true },
    { key: 'role', label: 'Role', def: true },
    { key: 'systems', label: 'Systems', def: true },
    { key: 'target', label: 'Servers / URL', def: true },
    { key: 'organize', label: 'Organize Unit' },
    { key: 'contacts', label: 'Contacts' },
    { key: 'description', label: 'Description' },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (a, key) => ({
    username: ui.esc(a.username),
    account_type: ui.chips([ui.optionLabel(accountTypes, a.account_type)]),
    manage_type: ui.text(ui.optionLabel(manageTypes, a.manage_type)),
    role: ui.text(a.role?.name),
    systems: ui.chips(a.systems.map(x => x.name)),
    target: a.servers.length ? ui.chips(a.servers.map(x => x.name)) : (a.app_url ? ui.clip(a.app_url) : ui.dash),
    organize: ui.text(a.organize?.name),
    contacts: ui.chips(a.contacts.map(x => x.name)),
    description: ui.clip(a.description),
    updated: ui.date(a.updated_date),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Privileged Account' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/priv-account/account">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by account, description, role, server, URL...',
              filtersId: 'accountFilters', activeFilterCount,
              columns: { tableId: 'accountTable', storageKey: 'openasm.privAccountList.columns', list: COLUMNS },
              exportUrl: '/priv-account/account/export' + currentQuery,
              addUrl: hasPermission('priv_account.create') ? '/priv-account/account/add' : null, addLabel: 'Add Privileged Account' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="accountFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label small"><%= t('Account Type') %></label>
                <select name="account_type" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(accountTypes, f.account_type) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Management Method') %></label>
                <select name="manage_type" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(manageTypes, f.manage_type) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Organize Unit') %></label>
                <select name="organize_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(unitOptions, f.organize_id ? [f.organize_id] : []) %></select>
              </div>
              <div class="col-md-6">
                <label class="form-label small"><%= t('Systems') %></label>
                <select name="system_ids" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(f.system_ids) %>'></select>
              </div>
              <div class="col-md-6">
                <label class="form-label small"><%= t('Contacts') %></label>
                <select name="contact_ids" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"
                        data-ajax-url="/organize/api/contact" data-ids-url="/organize/api/contact/ids" data-selected='<%= JSON.stringify(f.contact_ids) %>'></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="accountTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (accountList.length) { %>
              <% accountList.forEach(function (a, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'username' ? ' class="fw-medium"' : '' %>><%- cell(a, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showAccountDetail(this)" data-record='<%= JSON.stringify(a) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('priv_account.update')) { %>
                        <a href="/priv-account/account/<%= a.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('priv_account.delete')) { %>
                        <form action="/priv-account/account/<%= a.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: a.username }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-person-lock', message: 'No privileged accounts found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/priv-account/account',
                      actionUrl: hasPermission('priv_account.create') ? '/priv-account/account/add' : null, actionLabel: 'Add Privileged Account' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: accountList.length, summary: 'Showing {1} - {2} of {3} accounts' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'accountDetailModal' }) %>

<script>
  const ACCOUNT_TYPES = <%- jsonSafe(accountTypes) %>;
  const MANAGE_TYPES = <%- jsonSafe(manageTypes) %>;
  function showAccountDetail(button) {
    const a = DV.record(button);
    if (!a) return;
    let body = DV.section('Overview', DV.rows(
      DV.field('Account Type', DV.esc(DV.optionLabel(ACCOUNT_TYPES, a.account_type))),
      DV.field('Management Method', DV.esc(DV.optionLabel(MANAGE_TYPES, a.manage_type))),
      DV.field('Role', DV.text(a.role && a.role.name) || DV.EMPTY),
      DV.field('Organize Unit', DV.text(a.organize && a.organize.name) || DV.EMPTY),
      a.app_url ? DV.field('Application URL', DV.urlList([a.app_url])) : '',
      DV.multiline(a.description) ? DV.field('Description', DV.multiline(a.description)) : ''
    ));
    body += DV.section('Links', DV.rows(
      DV.field('Systems', DV.linkChips(a.systems || [], (s) => '/system/system?search=' + encodeURIComponent(s.name))),
      (a.servers || []).length ? DV.field('Servers', DV.linkChips(a.servers, (s) => '/server/server?search=' + encodeURIComponent(s.name))) : '',
      DV.field('Contacts', DV.contacts(a.contacts || []))
    ));
    body += DV.meta({ ...a, updated_at: a.updated_date });
    DV.open('accountDetailModal', { title: a.username, body, recordId: a.id });
  }
</script>
