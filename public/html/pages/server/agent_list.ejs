<!-- Modal Buttons Custom CSS -->
<link rel="stylesheet" href="/css/modal-buttons.css">

<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) {
    filterSystems.forEach(system => {
      params.append('systems[]', system.id);
    });
  }
  
  // Add contacts filter if exists
  if (typeof filterContacts !== 'undefined' && filterContacts && filterContacts.length > 0) {
    filterContacts.forEach(contact => {
      params.append('contacts[]', contact.id);
    });
  }
  
  return '?' + params.toString();
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Agent List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/server/agent">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Agent Name..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('server.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAgentModal">
              <i class="bi bi-plus"></i> Add Agent
            </button>
          <% } %>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#filterAgentModal">
            <i class="bi bi-funnel"></i> Filter
          </button>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Filter values for JS (an toàn cho EJS strict, giống System List) -->
    <div id="filter-agent-data" style="display:none"></div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- AGENT LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Agent List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Agent List</h3>
          </div>
          <div class="card-body table-responsive" style="overflow-x: auto;">
            <table class="table table-hover" id="agentTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Agent Name</th>
                  <th>Version</th>
                  <th>Description</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (agentList && agentList.length > 0) { %>
                  <% agentList.forEach(function(agent, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= agent.name %></td>
                      <td><%= agent.version || '-' %></td>
                      <td><%= agent.description || '-' %></td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm" title="Show" onclick="showAgentDetail('<%= agent.id %>')" data-agent='<%= JSON.stringify(agent) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        <% if (hasPermission('server.update')) { %>
                          <a href="/server/agent/<%= agent.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                            <i class="bi bi-pencil"></i>
                          </a>
                        <% } %>
                        <% if (hasPermission('server.delete')) { %>
                          <form action="/server/agent/<%= agent.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteAgent(this, '<%= agent.name %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center">No agents found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range like system list
                  const agentStartItem = (page - 1) * pageSize + 1;
                  const agentEndItem = Math.min(page * pageSize, totalCount || 0);
                  const agentStartPage = Math.max(1, page - 2);
                  const agentEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= agentStartItem %> - <%= agentEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> agents</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildAgentFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const agentFilterQuery = buildAgentFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (agentStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= agentFilterQuery ? '&' + agentFilterQuery : '' %>">1</a></li>
                  <% if (agentStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = agentStartPage; i <= agentEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (agentEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    <!-- ========================================== -->
    <!-- MODALS SECTION -->
    <!-- ========================================== -->
    
    <!-- Add Agent Modal -->
    <div class="modal fade" id="addAgentModal" tabindex="-1" aria-labelledby="addAgentModalLabel">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="addAgentForm" method="POST" action="/server/agent">
            <div class="modal-header">
              <h5 class="modal-title" id="addAgentModalLabel">Add Agent</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="agentName" class="form-label">Agent Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="agentName" name="name" required placeholder="Enter agent name">
                </div>
                <div class="col-12">
                  <label for="agentVersion" class="form-label">Version</label>
                  <input type="text" class="form-control" id="agentVersion" name="version" placeholder="Enter agent version">
                </div>
                <div class="col-12">
                  <label for="agentDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="agentDescription" name="description" rows="3" placeholder="Enter agent description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex flex-column flex-lg-row gap-2">
              <button type="button" class="btn btn-secondary w-100 order-2 order-lg-1" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary w-100 order-1 order-lg-2">Add Agent</button>
            </div>
          </form>
        </div>
      </div>
    </div>
