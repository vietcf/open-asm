
<!-- Custom CSS for disabled buttons -->
<style>
.btn-disabled-modal {
  opacity: 0.5 !important;
  pointer-events: none !important;
  cursor: not-allowed !important;
  filter: grayscale(50%) !important;
}

.btn-disabled-modal:hover {
  opacity: 0.5 !important;
  transform: none !important;
}
</style>

<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '?' + params.toString();
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Agent List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/server/agent/list">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Agent Name..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('agent.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAgentModal">
              <i class="bi bi-plus"></i> Add Agent
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= t(success) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= t(error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- ========================================== -->
    <!-- AGENT LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Agent List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Agent List</h3>
          </div>
          <div class="card-body table-responsive p-0" style="overflow-x: auto;">
            <table class="table table-hover" id="agentTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th data-sort-type="text">Agent Name</th>
                  <th data-sort-type="text">Version</th>
                  <th data-sort-type="text">Description</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof agentList !== 'undefined' && agentList && agentList.length > 0) { %>
                  <% agentList.forEach(function(agent, index) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + index + 1 %></td>
                      <td><%= agent.name %></td>
                      <td><%= agent.version || '-' %></td>
                      <td><%= agent.description || '-' %></td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm me-1" title="Show" onclick="showAgentDetail('<%= agent.id %>')" data-agent='<%= JSON.stringify(agent) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        <% if (hasPermission('agent.update')) { %>
                          <button type="button" class="btn btn-warning btn-sm me-1" title="Edit" data-bs-toggle="modal" data-bs-target="#editAgentModal" 
                                  data-agent-id="<%= agent.id %>" data-agent-name="<%= agent.name %>" data-agent-version="<%= agent.version || '' %>" data-agent-description="<%= agent.description || '' %>">
                            <i class="bi bi-pencil"></i>
                          </button>
                        <% } %>
                        <% if (hasPermission('agent.delete')) { %>
                          <form action="/server/agent/<%= agent.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteAgent(this, '<%= agent.name %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center">No agents found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <%
                  // Calculate pagination range like system list
                  const agentStartItem = (page - 1) * pageSize + 1;
                  const agentEndItem = Math.min(page * pageSize, totalCount || 0);
                  const agentStartPage = Math.max(1, page - 2);
                  const agentEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= agentStartItem %> - <%= agentEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> agents</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildAgentFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const agentFilterQuery = buildAgentFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (agentStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= agentFilterQuery ? '&' + agentFilterQuery : '' %>">1</a></li>
                  <% if (agentStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = agentStartPage; i <= agentEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (agentEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= agentFilterQuery ? '&' + agentFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    <!-- ========================================== -->
    <!-- MODALS SECTION -->
    <!-- ========================================== -->
    
    <!-- Add Agent Modal -->
    <div class="modal fade" id="addAgentModal" tabindex="-1" aria-labelledby="addAgentModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="addAgentForm" method="POST" action="/server/agent/add">
            <div class="modal-header">
              <h5 class="modal-title" id="addAgentModalLabel">Add Agent</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="agentName" class="form-label">Agent Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="agentName" name="name" required placeholder="Enter agent name">
                </div>
                <div class="col-12">
                  <label for="agentVersion" class="form-label">Version</label>
                  <input type="text" class="form-control" id="agentVersion" name="version" placeholder="Enter agent version">
                </div>
                <div class="col-12">
                  <label for="agentDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="agentDescription" name="description" rows="3" placeholder="Enter agent description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Add Agent</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Agent Modal -->
    <div class="modal fade" id="editAgentModal" tabindex="-1" aria-labelledby="editAgentModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="editAgentForm" method="POST" action="">
            <div class="modal-header">
              <h5 class="modal-title" id="editAgentModalLabel">Edit Agent</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="editAgentName" class="form-label">Agent Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="editAgentName" name="name" required placeholder="Enter agent name">
                </div>
                <div class="col-12">
                  <label for="editAgentVersion" class="form-label">Version</label>
                  <input type="text" class="form-control" id="editAgentVersion" name="version" placeholder="Enter agent version">
                </div>
                <div class="col-12">
                  <label for="editAgentDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="editAgentDescription" name="description" rows="3" placeholder="Enter agent description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Update Agent</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Agent Detail Modal -->
    <div class="modal fade" id="agentDetailModal" tabindex="-1" aria-labelledby="agentDetailModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="agentDetailModalLabel">Agent Detail</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="agentDetailContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

<script>
// Function to show agent detail
// name/version/description are free text not HTML-stripped server-side —
// must be escaped before going into innerHTML.
function escapeHtml(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

function showAgentDetail(agentId) {
  const button = document.querySelector(`[data-agent='${JSON.stringify({id: agentId})}']`) || 
                 document.querySelector(`button[onclick="showAgentDetail('${agentId}')"]`);
  
  if (!button || !button.dataset.agent) {
    alert('Agent data not found');
    return;
  }
  
  let agent;
  try {
    agent = JSON.parse(button.dataset.agent);
  } catch (error) {
    console.error('Error parsing agent data:', error);
    alert('Error loading agent details');
    return;
  }
  
  const modalElement = document.getElementById('agentDetailModal');
  const modal = new bootstrap.Modal(modalElement);
  const content = document.getElementById('agentDetailContent');
  
  let html = '<dl class="row detail-dl">';
  html += '<dt class="col-sm-4">Agent ID</dt><dd class="col-sm-8">' + escapeHtml(agent.id || 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Agent Name</dt><dd class="col-sm-8">' + escapeHtml(agent.name || 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Version</dt><dd class="col-sm-8">' + escapeHtml(agent.version || 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Created At</dt><dd class="col-sm-8">' + (agent.created_at ? new Date(agent.created_at).toLocaleString() : 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Updated At</dt><dd class="col-sm-8">' + (agent.updated_at ? new Date(agent.updated_at).toLocaleString() : 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Updated By</dt><dd class="col-sm-8">' + escapeHtml(agent.updated_by || 'N/A') + '</dd>';

  if (agent.description && agent.description.trim() !== '') {
    html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8"><div style="white-space: pre-wrap; word-wrap: break-word; max-width: 100%;">' + escapeHtml(agent.description) + '</div></dd>';
  } else {
    html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8">N/A</dd>';
  }
  html += '</dl>';
  
  content.innerHTML = html;
  modal.show();
}

// Confirm delete agent function
function confirmDeleteAgent(form, agentName) {
  if (confirm(`Are you sure you want to delete agent "${agentName}"?`)) {
    return true;
  } else {
    return false;
  }
}

$(document).ready(function() {
  // Wait for Bootstrap to be fully loaded
  setTimeout(function() {
    // Function to disable all action buttons
    function disableActionButtons() {
      console.log('Disabling action buttons...');
      $('#agentTable .btn').prop('disabled', true).addClass('disabled btn-disabled-modal');
      console.log('Action buttons disabled');
    }
    
    // Function to enable all action buttons
    function enableActionButtons() {
      console.log('Enabling action buttons...');
      $('#agentTable .btn').prop('disabled', false).removeClass('disabled btn-disabled-modal');
      console.log('Action buttons enabled');
    }

    // Add Agent Modal
    $('#addAgentModal').on('show.bs.modal', function() {
      console.log('Add Agent Modal opening...');
      disableActionButtons();
    });
    
    $('#addAgentModal').on('hidden.bs.modal', function() {
      console.log('Add Agent Modal closing...');
      enableActionButtons();
    });

    // Edit Agent Modal
    $('#editAgentModal').on('show.bs.modal', function(event) {
      console.log('Edit Agent Modal opening...');
      disableActionButtons();
      
      const button = $(event.relatedTarget);
      const agentId = button.data('agent-id');
      const agentName = button.data('agent-name');
      const agentVersion = button.data('agent-version');
      const agentDescription = button.data('agent-description');

      console.log('Edit Agent Modal opened with data:', {
        agentId, agentName, agentVersion, agentDescription
      });

      const actionUrl = `/server/agent/${agentId}?_method=PUT`;
      $('#editAgentForm').attr('action', actionUrl);
      console.log('Form action set to:', actionUrl);

      $('#editAgentName').val(agentName);
      $('#editAgentVersion').val(agentVersion);
      $('#editAgentDescription').val(agentDescription);
    });

    $('#editAgentModal').on('hidden.bs.modal', function() {
      console.log('Edit Agent Modal closing...');
      enableActionButtons();
      $('#editAgentForm')[0].reset();
    });

    // Agent Detail Modal
    $('#agentDetailModal').on('show.bs.modal', function() {
      console.log('Agent Detail Modal opening...');
      disableActionButtons();
    });
    
    $('#agentDetailModal').on('hidden.bs.modal', function() {
      console.log('Agent Detail Modal closing...');
      enableActionButtons();
    });

    $('#editAgentForm').on('submit', function(e) {
      console.log('Edit Agent Form submitting...');
      const submitBtn = $(this).find('button[type="submit"]');
      submitBtn.prop('disabled', true).html('<i class="spinner-border spinner-border-sm me-1"></i>Updating...');
    });

    // Additional event delegation to ensure buttons are disabled
    $(document).on('click', '#agentTable .btn', function(e) {
      if ($(this).hasClass('btn-disabled-modal')) {
        e.preventDefault();
        e.stopPropagation();
        console.log('Button click prevented - modal is open');
        return false;
      }
    });
  }, 100);
});
</script>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#agentTable {
  table-layout: fixed;
  min-width: 800px;
}
#agentTable thead th {
  white-space: nowrap;
}
#agentTable th:nth-child(1), #agentTable td:nth-child(1) { width: 6%; }
#agentTable th:nth-child(2), #agentTable td:nth-child(2) { width: 20%; }
#agentTable th:nth-child(3), #agentTable td:nth-child(3) { width: 12%; }
#agentTable th:nth-child(4), #agentTable td:nth-child(4) { width: 37%; }
#agentTable th:nth-child(5), #agentTable td:nth-child(5) { width: 25%; }

#agentTable td:nth-child(4) {
  overflow-wrap: break-word;
}
#agentTable td:nth-child(5) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>
