
<!-- Custom CSS for disabled buttons -->
<style>
.btn-disabled-modal {
  opacity: 0.5 !important;
  pointer-events: none !important;
  cursor: not-allowed !important;
  filter: grayscale(50%) !important;
}

.btn-disabled-modal:hover {
  opacity: 0.5 !important;
  transform: none !important;
}
</style>


<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '?' + params.toString();
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Service List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/server/service/list">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Service Name..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('server.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addServiceModal">
              <i class="bi bi-plus"></i> Add Service
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Filter values for JS (an toàn cho EJS strict, giống System List) -->
    <div id="filter-service-data" style="display:none"></div>

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= t(success) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= t(error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- SERVICE LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Service List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Service List</h3>
          </div>
          <div class="card-body table-responsive p-0" style="overflow-x: auto;">
            <table class="table table-hover" id="serviceTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th data-sort-type="text">Service Name</th>
                  <th data-sort-type="text">Description</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (serviceList && serviceList.length > 0) { %>
                  <% serviceList.forEach(function(service, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= service.name %></td>
                      <td><%= service.description || '-' %></td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm me-1" title="Show" onclick="showServiceDetail('<%= service.id %>')" data-service='<%= JSON.stringify(service) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        <% if (hasPermission('service.update')) { %>
                          <button type="button" class="btn btn-warning btn-sm me-1" title="Edit" data-bs-toggle="modal" data-bs-target="#editServiceModal" 
                                  data-service-id="<%= service.id %>" data-service-name="<%= service.name %>" data-service-description="<%= service.description || '' %>">
                            <i class="bi bi-pencil"></i>
                          </button>
                        <% } %>
                        <% if (hasPermission('service.delete')) { %>
                          <form action="/server/service/<%= service.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteService(this, '<%= service.name %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center">No services found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range like system list
                  const serviceStartItem = (page - 1) * pageSize + 1;
                  const serviceEndItem = Math.min(page * pageSize, totalCount || 0);
                  const serviceStartPage = Math.max(1, page - 2);
                  const serviceEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= serviceStartItem %> - <%= serviceEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> services</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildServiceFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const serviceFilterQuery = buildServiceFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (serviceStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>">1</a></li>
                  <% if (serviceStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = serviceStartPage; i <= serviceEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (serviceEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    <!-- ========================================== -->
    <!-- MODALS SECTION -->
    <!-- ========================================== -->
    
    <!-- Add Service Modal -->
    <div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="addServiceForm" method="POST" action="/server/service/add">
            <div class="modal-header">
              <h5 class="modal-title" id="addServiceModalLabel">Add Service</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="serviceName" class="form-label">Service Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="serviceName" name="name" required placeholder="Enter service name">
                </div>
                <div class="col-12">
                  <label for="serviceDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="serviceDescription" name="description" rows="3" placeholder="Enter service description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Add Service</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Service Modal -->
    <div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="editServiceForm" method="POST" action="">
            <div class="modal-header">
              <h5 class="modal-title" id="editServiceModalLabel">Edit Service</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="editServiceName" class="form-label">Service Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="editServiceName" name="name" required placeholder="Enter service name">
                </div>
                <div class="col-12">
                  <label for="editServiceDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="editServiceDescription" name="description" rows="3" placeholder="Enter service description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Update Service</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Service Detail Modal -->
    <div class="modal fade" id="serviceDetailModal" tabindex="-1" aria-labelledby="serviceDetailModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="serviceDetailModalLabel">Service Detail</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="serviceDetailContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

<script>
$(document).ready(function() {
  // Function to disable all action buttons
  function disableActionButtons() {
    console.log('Disabling action buttons...');
    $('#serviceTable .btn').prop('disabled', true).addClass('disabled btn-disabled-modal');
    console.log('Action buttons disabled');
  }
  
  // Function to enable all action buttons
  function enableActionButtons() {
    console.log('Enabling action buttons...');
    $('#serviceTable .btn').prop('disabled', false).removeClass('disabled btn-disabled-modal');
    console.log('Action buttons enabled');
  }

  // Add Service Modal
  $('#addServiceModal').on('show.bs.modal', function() {
    console.log('Add Service Modal opening...');
    disableActionButtons();
  });
  
  $('#addServiceModal').on('hidden.bs.modal', function() {
    console.log('Add Service Modal closing...');
    enableActionButtons();
  });

  // Edit Service Modal - Load data when opened
  $('#editServiceModal').on('show.bs.modal', function(event) {
    console.log('Edit Service Modal opening...');
    disableActionButtons();
    
    const button = $(event.relatedTarget);
    const serviceId = button.data('service-id');
    const serviceName = button.data('service-name');
    const serviceDescription = button.data('service-description');

    console.log('Edit Service Modal opened with data:', {
      serviceId, serviceName, serviceDescription
    });

    // Set form action URL
    const actionUrl = `/server/service/${serviceId}?_method=PUT`;
    $('#editServiceForm').attr('action', actionUrl);
    console.log('Form action set to:', actionUrl);

    // Populate form fields
    $('#editServiceName').val(serviceName);
    $('#editServiceDescription').val(serviceDescription);
  });

  // Edit Service Modal - Reset form when hidden
  $('#editServiceModal').on('hidden.bs.modal', function() {
    console.log('Edit Service Modal closing...');
    enableActionButtons();
    $('#editServiceForm')[0].reset();
  });

  // Service Detail Modal
  $('#serviceDetailModal').on('show.bs.modal', function() {
    console.log('Service Detail Modal opening...');
    disableActionButtons();
  });
  
  $('#serviceDetailModal').on('hidden.bs.modal', function() {
    console.log('Service Detail Modal closing...');
    enableActionButtons();
  });

  // Edit Service Form submission
  $('#editServiceForm').on('submit', function(e) {
    console.log('Edit Service Form submitting...');
    
    // Get Service ID from form action
    const currentAction = $(this).attr('action');
    const serviceId = currentAction.split('/').pop();
    
    console.log('Form action:', currentAction);
    console.log('Service ID:', serviceId);
    console.log('Form method:', $(this).attr('method'));

    // Allow normal form submission - backend handles redirect
    const submitBtn = $(this).find('button[type="submit"]');
    submitBtn.prop('disabled', true).html('<i class="spinner-border spinner-border-sm me-1"></i>Updating...');
  });

  // Additional event delegation to ensure buttons are disabled
  $(document).on('click', '#serviceTable .btn', function(e) {
    if ($(this).hasClass('btn-disabled-modal')) {
      e.preventDefault();
      e.stopPropagation();
      console.log('Button click prevented - modal is open');
      return false;
    }
  });
});

// Function to show service detail
// name/description are free text not HTML-stripped server-side — must be
// escaped before going into innerHTML.
function escapeHtml(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

function showServiceDetail(serviceId) {
  const button = document.querySelector(`[data-service='${JSON.stringify({id: serviceId})}']`) || 
                 document.querySelector(`button[onclick="showServiceDetail('${serviceId}')"]`);
  
  if (!button || !button.dataset.service) {
    alert('Service data not found');
    return;
  }
  
  let service;
  try {
    service = JSON.parse(button.dataset.service);
  } catch (error) {
    console.error('Error parsing service data:', error);
    alert('Error loading service details');
    return;
  }
  
  const modalElement = document.getElementById('serviceDetailModal');
  const modal = new bootstrap.Modal(modalElement);
  const content = document.getElementById('serviceDetailContent');
  
  let html = '<dl class="row detail-dl">';
  html += '<dt class="col-sm-4">Service ID</dt><dd class="col-sm-8">' + escapeHtml(service.id || 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Service Name</dt><dd class="col-sm-8">' + escapeHtml(service.name || 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Created At</dt><dd class="col-sm-8">' + (service.created_at ? new Date(service.created_at).toLocaleString() : 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Updated At</dt><dd class="col-sm-8">' + (service.updated_at ? new Date(service.updated_at).toLocaleString() : 'N/A') + '</dd>';
  html += '<dt class="col-sm-4">Updated By</dt><dd class="col-sm-8">' + escapeHtml(service.updated_by || 'N/A') + '</dd>';

  if (service.description && service.description.trim() !== '') {
    html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8"><div style="white-space: pre-wrap; word-wrap: break-word; max-width: 100%;">' + escapeHtml(service.description) + '</div></dd>';
  } else {
    html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8">N/A</dd>';
  }
  html += '</dl>';
  
  content.innerHTML = html;
  modal.show();
}

// Function to confirm delete service
function confirmDeleteService(form, serviceName) {
  return confirm('Are you sure you want to delete the service: ' + serviceName + '?');
}
</script>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#serviceTable {
  table-layout: fixed;
  min-width: 700px;
}
#serviceTable thead th {
  white-space: nowrap;
}
#serviceTable th:nth-child(1), #serviceTable td:nth-child(1) { width: 8%; }
#serviceTable th:nth-child(2), #serviceTable td:nth-child(2) { width: 27%; }
#serviceTable th:nth-child(3), #serviceTable td:nth-child(3) { width: 40%; }
#serviceTable th:nth-child(4), #serviceTable td:nth-child(4) { width: 25%; }

#serviceTable td:nth-child(3) {
  overflow-wrap: break-word;
}
#serviceTable td:nth-child(4) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>
