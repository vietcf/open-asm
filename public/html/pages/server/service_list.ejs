<!-- Modal Buttons Custom CSS -->
<link rel="stylesheet" href="/css/modal-buttons.css">

<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '?' + params.toString();
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Service List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/server/service">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Service Name..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('server.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addServiceModal">
              <i class="bi bi-plus"></i> Add Service
            </button>
          <% } %>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#filterServiceModal">
            <i class="bi bi-funnel"></i> Filter
          </button>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Filter values for JS (an toàn cho EJS strict, giống System List) -->
    <div id="filter-service-data" style="display:none"></div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- SERVICE LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Service List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Service List</h3>
          </div>
          <div class="card-body table-responsive" style="overflow-x: auto;">
            <table class="table table-hover" id="serviceTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Service Name</th>
                  <th>Description</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (serviceList && serviceList.length > 0) { %>
                  <% serviceList.forEach(function(service, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= service.name %></td>
                      <td><%= service.description || '-' %></td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm" title="Show" onclick="showServiceDetail('<%= service.id %>')" data-service='<%= JSON.stringify(service) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        <% if (hasPermission('server.update')) { %>
                          <a href="/server/service/<%= service.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                            <i class="bi bi-pencil"></i>
                          </a>
                        <% } %>
                        <% if (hasPermission('server.delete')) { %>
                          <form action="/server/service/<%= service.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteService(this, '<%= service.name %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center">No services found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range like system list
                  const serviceStartItem = (page - 1) * pageSize + 1;
                  const serviceEndItem = Math.min(page * pageSize, totalCount || 0);
                  const serviceStartPage = Math.max(1, page - 2);
                  const serviceEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= serviceStartItem %> - <%= serviceEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> services</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildServiceFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const serviceFilterQuery = buildServiceFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (serviceStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>">1</a></li>
                  <% if (serviceStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = serviceStartPage; i <= serviceEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (serviceEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= serviceFilterQuery ? '&' + serviceFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    <!-- ========================================== -->
    <!-- MODALS SECTION -->
    <!-- ========================================== -->
    
    <!-- Add Service Modal -->
    <div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="addServiceForm" method="POST" action="/server/service">
            <div class="modal-header">
              <h5 class="modal-title" id="addServiceModalLabel">Add Service</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="serviceName" class="form-label">Service Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="serviceName" name="name" required placeholder="Enter service name">
                </div>
                <div class="col-12">
                  <label for="serviceDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="serviceDescription" name="description" rows="3" placeholder="Enter service description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex flex-column flex-lg-row gap-2">
              <button type="button" class="btn btn-secondary w-100 order-2 order-lg-1" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary w-100 order-1 order-lg-2">Add Service</button>
            </div>
          </form>
        </div>
      </div>
    </div>
