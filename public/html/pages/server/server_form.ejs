<%#
  Add / Edit Server.  mode: 'add' | 'edit', server, selected: { ips, vips, os, managers, systems, agents, services, tags } as [{id, text}],
  statusOptions, typesOptions, locations
%>
<%
  const isEdit = mode === 'edit';
  const s = server || {};
  const sel = selected || {};
  const optionSelect = (name, label, opts, placeholder) => ({ name, label, opts, placeholder });
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'Server Management' }, { label: 'Server List', href: '/server/server' }, { label: isEdit ? 'Edit Server' : 'Add Server' }
] }) %>

<div class="app-content">
  <div class="container-fluid">
    <form class="card form-card" method="POST" action="<%= isEdit ? '/server/server/' + s.id + '/edit' : '/server/server/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit Server' : 'Add Server') %></h3>
      </div>
      <div class="card-body">
        <section class="form-section">
          <h4 class="form-section-title"><%= t('General information') %></h4>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-name"><%= t('Server Name') %> <span class="text-danger">*</span></label>
              <input type="text" id="f-name" name="name" class="form-control" value="<%= s.name || '' %>" maxlength="255" placeholder="<%= t('Enter server name') %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-os"><%= t('Platform') %></label>
              <select id="f-os" name="os" class="form-select js-select"
                      data-placeholder="<%= t('Select platform') %>"><option value=""></option><%- ui.options(platformOptions, sel.os || []) %></select>
            </div>
            <% [optionSelect('status', 'Status', statusOptions, 'Select status'), optionSelect('type', 'Type', typesOptions, 'Select type'), optionSelect('location', 'Location', locations, 'Select location')].forEach(function (o) { %>
              <div class="col-md-4">
                <label class="form-label" for="f-<%= o.name %>"><%= t(o.label) %></label>
                <select id="f-<%= o.name %>" name="<%= o.name %>" class="form-select js-select" data-placeholder="<%= t(o.placeholder) %>">
                  <option value=""></option>
                  <% (o.opts || []).forEach(function (opt) { %>
                    <option value="<%= opt.id %>" <%= String(s[o.name]) === String(opt.id) ? 'selected' : '' %>><%= opt.text %></option>
                  <% }) %>
                </select>
              </div>
            <% }) %>
            <div class="col-12">
              <label class="form-label" for="f-description"><%= t('Description') %></label>
              <textarea id="f-description" name="description" class="form-control" rows="3" placeholder="<%= t('Enter server description and details') %>"><%= s.description || '' %></textarea>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h4 class="form-section-title"><%= t('Network') %></h4>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-ips"><%= t('IP Address(es)') %> <span class="text-danger">*</span></label>
              <select id="f-ips" name="ip_addresses[]" class="form-select js-select" multiple required data-ajax-url="/network/api/ip-addresses/unassigned"
                      data-placeholder="<%= t('Select IP addresses') %>" data-selected="<%= JSON.stringify(sel.ips || []) %>"></select>
              <div class="form-text"><%= t('Unassigned addresses only.') %> <a href="/network/ip-address/add" target="_blank" rel="noopener"><%= t('Add IP') %></a></div>
            </div>
            <% if (isEdit) { %>
              <div class="col-md-6">
                <label class="form-label" for="f-vips"><%= t('VIP IP Address(es)') %></label>
                <select id="f-vips" name="vip_ip_addresses[]" class="form-select js-select" multiple data-ajax-url="/network/api/ip-addresses/search-all"
                        data-placeholder="<%= t('Select IP addresses') %>" data-selected="<%= JSON.stringify(sel.vips || []) %>"></select>
                <div class="form-text"><%= t('(shared with other devices/servers)') %></div>
              </div>
            <% } %>
          </div>
        </section>

        <section class="form-section">
          <h4 class="form-section-title"><%= t('Ownership & software') %></h4>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-managers"><%= t('Managers') %></label>
              <select id="f-managers" name="managers[]" class="form-select js-select" multiple data-ajax-url="/organize/api/contact"
                      data-placeholder="<%= t('Select managers') %>" data-selected="<%= JSON.stringify(sel.managers || []) %>"></select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-systems"><%= t('Systems') %></label>
              <select id="f-systems" name="systems[]" class="form-select js-select" multiple data-ajax-url="/system/api/system"
                      data-placeholder="<%= t('Select systems') %>" data-selected="<%= JSON.stringify(sel.systems || []) %>"></select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-services"><%= t('Services') %></label>
              <select id="f-services" name="services[]" class="form-select js-select" multiple
                      data-placeholder="<%= t('Select services') %>"><%- ui.options(serviceOptions, sel.services || []) %></select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-agents"><%= t('Agents') %></label>
              <select id="f-agents" name="agents[]" class="form-select js-select" multiple
                      data-placeholder="<%= t('Select agents') %>"><%- ui.options(agentOptions, sel.agents || []) %></select>
            </div>
            <div class="col-12">
              <label class="form-label" for="f-tags"><%= t('Tags') %></label>
              <select id="f-tags" name="tags[]" class="form-select js-select" multiple
                      data-placeholder="<%= t('Select tags') %>"><%- ui.options(tagOptions, sel.tags || []) %></select>
            </div>
          </div>
        </section>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/server/server', submitLabel: isEdit ? 'Save Changes' : 'Add Server', record: s }) %>
    </form>
  </div>
</div>
