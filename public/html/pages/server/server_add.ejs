
<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item"><a href="/server/server/list"><%= t('Server List') %></a></li>
          <li class="breadcrumb-item active"><%= t('Add Server') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<section class="app-content">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10 col-sm-12">
      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><%= t('Add Server') %></h5>
        </div>
        <form action="/server/server/add" method="POST">
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label"><%= t('Server Name') %> <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="<%= t('Enter server name') %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Description') %></label>
              <textarea name="description" class="form-control" rows="3" placeholder="<%= t('Enter server description and details') %>"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('IP Address(es)') %></label>
              <div class="d-flex align-items-center gap-2">
                <select id="ip-select" name="ip_addresses[]" class="form-control flex-grow-1" multiple required></select>
                <button type="button" class="btn btn-outline-success btn-sm" id="add-ip-btn" title="<%= t('Add new IP') %>"><i class="bi bi-plus-circle"></i> <%= t('Add IP') %></button>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Type') %></label>
              <select name="type" class="form-select" data-placeholder="<%= t('Select type') %>">
                <option value="">-- <%= t('Select type --') %></option>
                <% (typesOptions || []).forEach(function(tp) { %>
                  <option value="<%= tp.value %>"><%= tp.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Status') %></label>
              <select name="status" class="form-select" data-placeholder="<%= t('Select status') %>">
                <option value="">-- <%= t('Select Status --') %></option>
                <% (statusOptions || []).forEach(function(st) { %>
                  <option value="<%= st.value %>"><%= st.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Location') %></label>
              <select name="location" class="form-select" data-placeholder="<%= t('Select location') %>">
                <option value="">-- <%= t('Select location --') %></option>
                <% (locations || []).forEach(function(loc) { %>
                  <option value="<%= loc.value %>"><%= loc.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Platform (OS)') %></label>
              <select id="platform-select" name="os" class="form-select" data-placeholder="<%= t('Select platform') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Managers') %></label>
              <select id="manager-select" name="managers[]" class="form-select" multiple data-placeholder="<%= t('Select managers') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Systems') %></label>
              <select id="system-select" name="systems[]" class="form-select" multiple data-placeholder="<%= t('Select systems') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Agents') %></label>
              <select id="agent-select" name="agents[]" class="form-select" multiple data-placeholder="<%= t('Select agents') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Services') %></label>
              <select id="service-select" name="services[]" class="form-select" multiple data-placeholder="<%= t('Select services') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Tags') %></label>
              <select id="tag-select" name="tags[]" class="form-select" multiple data-placeholder="<%= t('Select tags') %>"></select>
            </div>
          </div>
          <div class="card-footer d-flex justify-content-end">
            <a href="/server/server/list" class="btn btn-secondary btn-sm me-2"><%= t('Cancel') %></a>
            <button type="submit" class="btn btn-primary btn-sm"><%= t('Add Server') %></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
/* Match Add IP Address modal: stack action buttons full-width on mobile,
   with the primary action above Cancel. */
@media (max-width: 991.98px) {
  .card-footer.d-flex.justify-content-end {
    flex-direction: column !important;
    gap: 0.5rem !important;
    align-items: stretch !important;
  }
  .card-footer.d-flex.justify-content-end .btn {
    width: 100% !important;
    margin: 0 !important;
  }
  .card-footer.d-flex.justify-content-end .btn:first-child {
    order: 2 !important;
  }
  .card-footer.d-flex.justify-content-end .btn:last-child {
    order: 1 !important;
  }
}
</style>

<script src="/vendor/jquery-3.6.0.min.js"></script>
<link href="/css/select2.min.css" rel="stylesheet" />
<link href="/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="/vendor/select2.min.js"></script>
<script src="/vendor/bootstrap.min.js"></script>
<link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />

<script>
  $(function() {
    // IP Address select2 AJAX - Bootstrap 5 theme
    $('#ip-select').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select IP address(es)'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/network/api/ip-addresses/unassigned',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      },
      minimumInputLength: 0
    });

    // Manager select2 AJAX - Bootstrap 5 theme
    $('#manager-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#manager-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/organize/api/contact',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // System select2 AJAX - Bootstrap 5 theme
    $('#system-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#system-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/system/api/system',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Agent select2 AJAX - Bootstrap 5 theme
    $('#agent-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#agent-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/server/api/agent',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Service select2 AJAX - Bootstrap 5 theme
    $('#service-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#service-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/server/api/service',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Type select2 - Bootstrap 5 theme
    $('select[name="type"]').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select type'),
      allowClear: true,
      width: '100%'
    });

    // Status select2 - Bootstrap 5 theme
    $('select[name="status"]').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select status'),
      allowClear: true,
      width: '100%'
    });

    // Location select2 - Bootstrap 5 theme
    $('select[name="location"]').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select location'),
      allowClear: true,
      width: '100%'
    });

    // Platform (OS) select2 AJAX - Bootstrap 5 theme
    $('#platform-select').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select platform (OS)'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/device/api/platform',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Tag select2 AJAX - Bootstrap 5 theme
    $('#tag-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#tag-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/organize/api/tag',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Auto-fill server name if empty when OS and IP are selected, and convert to lowercase
    function autoFillServerName() {
      var nameInput = $("input[name='name']");
      var osText = $('#platform-select').find('option:selected').text() || $('#platform-select').select2('data')[0]?.text || '';
      var ipData = $('#ip-select').select2('data');
      var firstIp = ipData && ipData.length > 0 ? ipData[0].text : '';
      if (nameInput.val().trim() === '' && osText && firstIp) {
        // Clean platform: lowercase, replace spaces with underscores
        var cleanPlatform = osText.toLowerCase().replace(/\s+/g, '_');
        var autoName = cleanPlatform + '_' + firstIp;
        nameInput.val(autoName);
      }
    }
    $('#platform-select').on('change', autoFillServerName);
    $('#ip-select').on('change', autoFillServerName);
    $("input[name='name']").on('input', function() {
      // Always convert to lowercase on manual input
      var val = $(this).val();
      $(this).val(val.toLowerCase());
    });

    // Add IP button: navigate to the Add IP Address page (same tab)
    $('#add-ip-btn').off('click').on('click', function(e) {
      e.preventDefault();
      window.location.href = '/network/ip-address?add=1';
    });

    // Fix: Remove blank <option> after select2 is initialized to avoid select2 placeholder bug
    setTimeout(function() {
      $('#manager-select, #system-select, #agent-select, #service-select, #tag-select').each(function() {
        $(this).find('option').filter(function() { return !$(this).val(); }).remove();
      });
    }, 100);
  });
</script>