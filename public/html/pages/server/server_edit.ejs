
<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/server/server/list">Server List</a></li>
          <li class="breadcrumb-item active">Edit Server</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<section class="app-content">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10 col-sm-12">
      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Edit Server</h5>
        </div>
        <form id="editServerForm" action="/server/server/<%= server.id %>/edit" method="POST">
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Server Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" value="<%= server.name %>" placeholder="Enter server name" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="3" placeholder="Enter server description and details"><%= server.description || '' %></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">IP Address(es)</label>
              <div class="d-flex align-items-center gap-2">
                <select id="ip-select" name="ip_addresses[]" class="form-control flex-grow-1" multiple required></select>
                <button type="button" class="btn btn-outline-success btn-sm" id="add-ip-btn" title="Add new IP"><i class="bi bi-plus-circle"></i> Add IP</button>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Type</label>
              <select name="type" class="form-select" data-placeholder="Select type">
                <option value="">-- Select type --</option>
                <% (typesOptions || []).forEach(function(tp) { %>
                  <option value="<%= tp.value %>" <%= server.type == tp.value ? 'selected' : '' %>><%= tp.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Status</label>
              <select name="status" class="form-select" data-placeholder="Select status">
                <option value="">-- Select Status --</option>
                <% (statusOptions || []).forEach(function(st) { %>
                  <option value="<%= st.value %>" <%= server.status == st.value ? 'selected' : '' %>><%= st.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Location</label>
              <select name="location" class="form-select" data-placeholder="Select location">
                <option value="">-- Select location --</option>
                <% (locations || []).forEach(function(loc) { %>
                  <option value="<%= loc.value %>" <%= server.location == loc.value ? 'selected' : '' %>><%= loc.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Platform (OS)</label>
              <select id="platform-select" name="os" class="form-select" data-placeholder="Select platform"></select>
            </div>
            <div class="mb-3">
              <label class="form-label">Managers</label>
              <select id="manager-select" name="managers[]" class="form-select" multiple data-placeholder="Select managers"></select>
            </div>
            <div class="mb-3">
              <label class="form-label">Systems</label>
              <select id="system-select" name="systems[]" class="form-select" multiple data-placeholder="Select systems"></select>
            </div>
            <div class="mb-3">
              <label class="form-label">Agents</label>
              <select id="agent-select" name="agents[]" class="form-select" multiple data-placeholder="Select agents"></select>
            </div>
            <div class="mb-3">
              <label class="form-label">Services</label>
              <select id="service-select" name="services[]" class="form-select" multiple data-placeholder="Select services"></select>
            </div>
            <div class="mb-3">
              <label class="form-label">Tags</label>
              <select id="tag-select" name="tags[]" class="form-select" multiple data-placeholder="Select tags"></select>
            </div>
            <!-- Server data for JavaScript -->
            <div id="server-data" 
                 data-ip='<%= JSON.stringify(server.ip || []) %>'
                 data-tags='<%= JSON.stringify(server.tags || []) %>'
                 data-systems='<%= JSON.stringify(server.systems || []) %>'
                 data-managers='<%= JSON.stringify(server.managers || []) %>'
                 data-agents='<%= JSON.stringify(server.agents || []) %>'
                 data-services='<%= JSON.stringify(server.services || []) %>'
                 data-os='<%= JSON.stringify(server.os || null) %>'
                 style="display:none"></div>
          </div>
          <div class="card-footer d-flex justify-content-end">
            <a href="/server/server/list" class="btn btn-outline-secondary btn-sm me-2">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script src="/vendor/jquery-3.6.0.min.js"></script>
<link href="/css/select2.min.css" rel="stylesheet" />
<link href="/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="/vendor/select2.min.js"></script>
<script src="/vendor/bootstrap.min.js"></script>
<link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />

<script>
  window.selectedTags = JSON.parse('<%- JSON.stringify(selectedTags || []) %>');
</script>

<script>
  $(function() {
    // IP Address select2 AJAX - Bootstrap 5 theme
    $('#ip-select').select2({
      theme: 'bootstrap-5',
      placeholder: 'Select IP address(es)',
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/network/api/ip-addresses/unassigned',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      },
      minimumInputLength: 0
    });

    // Manager select2 AJAX - Bootstrap 5 theme
    $('#manager-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#manager-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/organize/api/contact',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // System select2 AJAX - Bootstrap 5 theme
    $('#system-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#system-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/system/api/system',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Agent select2 AJAX - Bootstrap 5 theme
    $('#agent-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#agent-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/server/api/agent',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Service select2 AJAX - Bootstrap 5 theme
    $('#service-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#service-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/server/api/service',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Type select2 - Bootstrap 5 theme
    $('select[name="type"]').select2({
      theme: 'bootstrap-5',
      placeholder: 'Select type',
      allowClear: true,
      width: '100%'
    });

    // Status select2 - Bootstrap 5 theme
    $('select[name="status"]').select2({
      theme: 'bootstrap-5',
      placeholder: 'Select status',
      allowClear: true,
      width: '100%'
    });

    // Location select2 - Bootstrap 5 theme
    $('select[name="location"]').select2({
      theme: 'bootstrap-5',
      placeholder: 'Select location',
      allowClear: true,
      width: '100%'
    });

    // Platform (OS) select2 AJAX - Bootstrap 5 theme
    $('#platform-select').select2({
      theme: 'bootstrap-5',
      placeholder: 'Select platform (OS)',
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/device/api/platform',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Tag select2 AJAX - Bootstrap 5 theme
    $('#tag-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#tag-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/organize/api/tag',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Tags will be loaded by loadServerExistingValues() function

    // Add IP button: open new tab to IP management page
    $('#add-ip-btn').off('click').on('click', function(e) {
      e.preventDefault();
      window.open('/network/ip-address?add=1', '_blank');
    });

    // Load existing server data into Select2 fields
    setTimeout(function() {
      loadServerExistingValues();
    }, 200);

    // Fix: Remove blank <option> after select2 is initialized to avoid select2 placeholder bug
    setTimeout(function() {
      $('#manager-select, #system-select, #agent-select, #service-select, #tag-select').each(function() {
        $(this).find('option').filter(function() { return !$(this).val(); }).remove();
      });
    }, 100);
  });

// Function to load existing server data into Select2 fields
function loadServerExistingValues() {
  try {
    const serverDataEl = document.getElementById('server-data');
    if (!serverDataEl) {
      console.log('Server data element not found');
      return;
    }

    const serverData = {
      ip: JSON.parse(serverDataEl.dataset.ip || '[]'),
      tags: JSON.parse(serverDataEl.dataset.tags || '[]'),
      systems: JSON.parse(serverDataEl.dataset.systems || '[]'),
      managers: JSON.parse(serverDataEl.dataset.managers || '[]'),
      agents: JSON.parse(serverDataEl.dataset.agents || '[]'),
      services: JSON.parse(serverDataEl.dataset.services || '[]'),
      os: JSON.parse(serverDataEl.dataset.os || 'null')
    };

    console.log('Loading server data:', serverData);

    // Load IP addresses
    if (serverData.ip && serverData.ip.length > 0) {
      // Clear existing IPs first to avoid duplicates
      $('#ip-select').empty();
      serverData.ip.forEach(ip => {
        const option = new Option(ip.ip_address, ip.id, true, true);
        $('#ip-select').append(option);
      });
      $('#ip-select').trigger('change');
    }

    // Load Tags
    if (serverData.tags && serverData.tags.length > 0) {
      // Clear existing tags first to avoid duplicates
      $('#tag-select').empty();
      serverData.tags.forEach(tag => {
        const option = new Option(tag.name, tag.id, true, true);
        $('#tag-select').append(option);
      });
      $('#tag-select').trigger('change');
    }

    // Load Systems
    if (serverData.systems && serverData.systems.length > 0) {
      // Clear existing systems first to avoid duplicates
      $('#system-select').empty();
      serverData.systems.forEach(system => {
        const option = new Option(system.name, system.id, true, true);
        $('#system-select').append(option);
      });
      $('#system-select').trigger('change');
    }

    // Load Managers
    if (serverData.managers && serverData.managers.length > 0) {
      // Clear existing managers first to avoid duplicates
      $('#manager-select').empty();
      serverData.managers.forEach(manager => {
        const displayText = manager.email ? `${manager.name} (${manager.email})` : manager.name;
        const option = new Option(displayText, manager.id, true, true);
        $('#manager-select').append(option);
      });
      $('#manager-select').trigger('change');
    }

    // Load Agents
    if (serverData.agents && serverData.agents.length > 0) {
      // Clear existing agents first to avoid duplicates
      $('#agent-select').empty();
      serverData.agents.forEach(agent => {
        const option = new Option(agent.name, agent.id, true, true);
        $('#agent-select').append(option);
      });
      $('#agent-select').trigger('change');
    }

    // Load Services
    if (serverData.services && serverData.services.length > 0) {
      // Clear existing services first to avoid duplicates
      $('#service-select').empty();
      serverData.services.forEach(service => {
        const option = new Option(service.name, service.id, true, true);
        $('#service-select').append(option);
      });
      $('#service-select').trigger('change');
    }

    // Load Platform (OS) - need to fetch platform data first
    if (serverData.os) {
      // For now, just set the value directly if it's a simple value
      // You might need to fetch platform data via AJAX if it's an object
      $('#platform-select').val(serverData.os).trigger('change');
    }

  } catch (e) {
    console.error('Error loading server existing values:', e);
  }
}
</script>
