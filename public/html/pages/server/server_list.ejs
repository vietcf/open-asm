<!--
==========================================
SERVER LIST PAGE - EJS TEMPLATE
==========================================
This template renders the server list page with search, filter, pagination,
and CRUD operations for server management.
-->

<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  // Add status filter if exists
  if (typeof filterStatus !== 'undefined' && filterStatus) {
    params.set('status', filterStatus);
  }
  
  // Add tags filter if exists
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => {
      params.append('tags[]', tag.id);
    });
  }
  
  // Add systems filter if exists
  if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) {
    filterSystems.forEach(system => {
      params.append('systems[]', system.id);
    });
  }
  
  return '?' + params.toString();
}

// Helper function to build export URL with all query parameters
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add status filter if exists
  if (typeof filterStatus !== 'undefined' && filterStatus) {
    params.set('status', filterStatus);
  }
  
  // Add type filter if exists
  if (typeof filterType !== 'undefined' && filterType) {
    params.set('type', filterType);
  }
  
  // Add location filter if exists
  if (typeof filterLocation !== 'undefined' && filterLocation) {
    params.set('location', filterLocation);
  }
  
  // Add tags filter if exists
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => {
      params.append('tags[]', tag.id);
    });
  }
  
  // Add systems filter if exists
  if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) {
    filterSystems.forEach(system => {
      params.append('systems[]', system.id);
    });
  }
  
  // Add contacts filter if exists
  if (typeof filterManager !== 'undefined' && filterManager && filterManager.length > 0) {
    filterManager.forEach(contact => {
      params.append('contacts[]', contact.id);
    });
  }
  
  // Add services filter if exists
  if (typeof filterServices !== 'undefined' && filterServices && filterServices.length > 0) {
    filterServices.forEach(service => {
      params.append('services[]', service.id);
    });
  }
  
  // Add OS filter if exists
  if (typeof filterOs !== 'undefined' && filterOs) {
    params.set('os', filterOs);
  }
  
  return '/server/server/export' + (params.toString() ? '?' + params.toString() : '');
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Server List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/server/server/list">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            <% if (typeof filterStatus !== 'undefined' && filterStatus) { %>
              <input type="hidden" name="status" value="<%= filterStatus %>">
            <% } %>
            <% if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) { %>
              <% filterTags.forEach(function(tag) { %>
                <input type="hidden" name="tags[]" value="<%= tag.id %>">
              <% }); %>
            <% } %>
            <% if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) { %>
              <% filterSystems.forEach(function(system) { %>
                <input type="hidden" name="systems[]" value="<%= system.id %>">
              <% }); %>
            <% } %>
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Server Name, IP or OS..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('server.create')) { %>
            <a href="/server/server/add" class="btn btn-primary btn-sm">
              <i class="bi bi-plus"></i> Add Server
            </a>
          <% } %>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#filterServerModal">
            <i class="bi bi-funnel"></i> Filter
          </button>
          <% if (hasPermission && hasPermission('server.read')) { %>
            <a href="<%= buildExportUrl() %>" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> Export
            </a>
          <% } %>
          <% if (hasPermission && hasPermission('server.create')) { %>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#importServerModal">
              <i class="bi bi-upload"></i> Import Server
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Filter values for JS (an toàn cho EJS strict, giống System List) -->
    <div id="filter-server-data"
         data-tags='<%= JSON.stringify(filterTags || []) %>'
         data-systems='<%= JSON.stringify(filterSystems || []) %>'
         data-status='<%= filterStatus || '' %>'
         data-manager='<%= JSON.stringify(filterManager || []) %>'
         data-services='<%= JSON.stringify(filterServices || []) %>'
         data-os='<%= filterOs || '' %>'
         data-type='<%= filterType || '' %>'
         data-location='<%= filterLocation || '' %>'
         style="display:none"></div>

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- SERVER LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Server List Table -->
    <div class="row">
      <div class="col-12">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title mb-0">Server List</h3>
            </div>
            <div class="card-body table-responsive" style="overflow-x: auto;">
              <table class="table table-hover" id="serverTable">
                <thead>
                  <tr>
                    <th>No.</th>
                    <th>Server Name</th>
                    <th>Description</th>
                    <th>IP Address</th>
                    <th>Systems</th>
                    <th>Type</th>
                    <th>Tags</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (serverList && serverList.length > 0) { %>
                    <% serverList.forEach(function(server, idx) { %>
                      <tr>
                        <td><%= (page - 1) * pageSize + idx + 1 %></td>
                        <td><%= server.name %></td>
                        <td>
                          <%
                            const description = server.description || '-';
                            const cleanDescription = description.trim();
                            const shortDescription = cleanDescription.length > 50 ? cleanDescription.substring(0, 50) + '…' : cleanDescription;
                          %>
                          <span data-bs-toggle="tooltip" data-bs-placement="top" title="<%= cleanDescription %>" style="cursor: help; word-break: break-word;"><%= shortDescription %></span>
                        </td>
                        <td>
                          <% if (server.ip && server.ip.length > 0) { %>
                            <% server.ip.forEach(function(ip) { %>
                              <span class="badge bg-success me-1"><%= typeof ip === 'string' ? ip : ip.ip_address %></span>
                            <% }) %>
                          <% } else { %>
                            <span class="text-muted">No IP</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (server.systems && server.systems.length > 0) { %>
                            <% server.systems.forEach(function(system) { %>
                              <span class="badge bg-info me-1"><%= typeof system === 'string' ? system : system.name %></span>
                            <% }) %>
                          <% } else { %>
                            <span class="text-muted">No systems</span>
                          <% } %>
                        </td>
                        <td><%= server.type || '-' %></td>
                        <td>
                          <% if (server.tags && server.tags.length > 0) { %>
                            <% server.tags.forEach(function(tag) { %>
                              <span class="badge bg-primary me-1"><%= typeof tag === 'string' ? tag : tag.name %></span>
                            <% }) %>
                          <% } else { %>
                            <span class="text-muted">No tags</span>
                          <% } %>
                        </td>
                        <td class="text-end">
                          <button type="button" class="btn btn-info btn-sm" title="Show" onclick="showServerDetail('<%= server.id %>')" data-server='<%= JSON.stringify(server) %>'>
                            <i class="bi bi-eye"></i>
                          </button>
                          <% if (hasPermission('server.update')) { %>
                            <a href="/server/server/<%= server.id %>/edit" class="btn btn-warning btn-sm" title="Edit">
                              <i class="bi bi-pencil"></i>
                            </a>
                          <% } %>
                          <% if (hasPermission('server.delete')) { %>
                            <form action="/server/server/<%= server.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteServer(this, '<%= server.name %>')">
                              <input type="hidden" name="delete_ip" value="false">
                              <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                <i class="bi bi-trash"></i>
                              </button>
                            </form>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="8" class="text-center">No servers found</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            <div class="card-footer clearfix">
              <div class="d-flex justify-content-between align-items-center px-3 py-2">
                <div>
                  <% 
                    // Calculate pagination range like system list
                    const serverStartItem = (page - 1) * pageSize + 1;
                    const serverEndItem = Math.min(page * pageSize, totalCount || 0);
                    const serverStartPage = Math.max(1, page - 2);
                    const serverEndPage = Math.min(totalPages, page + 2);
                  %>
                  <span>Showing <%= serverStartItem %> - <%= serverEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> servers</span>
                </div>
                <ul class="pagination pagination-sm m-0 float-end">
                  <% 
                    function buildServerFilterQuery() {
                      let params = [];
                      if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                      if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                      if (typeof filterTags !== 'undefined' && filterTags.length) filterTags.forEach(function(tag) { params.push('tags[]=' + encodeURIComponent(tag.id || tag)); });
                      if (typeof filterStatus !== 'undefined' && filterStatus) params.push('status=' + encodeURIComponent(filterStatus));
                      if (typeof filterSystems !== 'undefined' && filterSystems.length) filterSystems.forEach(function(system) { params.push('systems[]=' + encodeURIComponent(system.id || system)); });
                      return params.join('&');
                    }
                    const serverFilterQuery = buildServerFilterQuery();
                  %>
                  <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= page - 1 %><%= serverFilterQuery ? '&' + serverFilterQuery : '' %>" tabindex="-1">Previous</a>
                  </li>
                  <% if (serverStartPage > 1) { %>
                    <li class="page-item"><a class="page-link" href="?page=1<%= serverFilterQuery ? '&' + serverFilterQuery : '' %>">1</a></li>
                    <% if (serverStartPage > 2) { %>
                      <li class="page-item disabled"><span class="page-link">...</span></li>
                    <% } %>
                  <% } %>
                  <% for (let i = serverStartPage; i <= serverEndPage; i++) { %>
                    <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= serverFilterQuery ? '&' + serverFilterQuery : '' %>"><%= i %></a></li>
                  <% } %>
                  <% if (serverEndPage < totalPages) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= serverFilterQuery ? '&' + serverFilterQuery : '' %>"><%= totalPages %></a></li>
                  <% } %>
                  <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= page + 1 %><%= serverFilterQuery ? '&' + serverFilterQuery : '' %>">Next</a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- MODALS SECTION -->
    <!-- ========================================== -->
    
    <!-- Server Detail Modal -->
    <div class="modal fade" id="serverDetailModal" tabindex="-1" aria-labelledby="serverDetailModalLabel">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="serverDetailModalLabel">Server Detail</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="serverDetailContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Delete Server Modal -->
    <div class="modal fade" id="deleteServerModal" tabindex="-1" aria-labelledby="deleteServerModalLabel">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="deleteServerModalLabel">Delete Server</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p>Are you sure you want to delete the server <strong id="deleteServerName"></strong>?</p>
            <p class="mb-2">What should happen to its IP address(es)?</p>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="deleteServerIpChoice" id="deleteServerIpReserve" value="false" checked>
              <label class="form-check-label" for="deleteServerIpReserve">
                Release IP(s) back to <strong>Reserved</strong> status (default)
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="deleteServerIpChoice" id="deleteServerIpDelete" value="true">
              <label class="form-check-label" for="deleteServerIpDelete">
                Delete the IP address(es) permanently
              </label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger btn-sm" id="deleteServerConfirmBtn">Delete</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Server Modal -->
    <div class="modal fade" id="filterServerModal" tabindex="-1" aria-labelledby="filterServerModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filterServerModalLabel">Filter Servers</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="GET" action="/server/server/list" id="filterServerForm">
        <input type="hidden" name="page" value="1">
        <% if (typeof pageSize !== 'undefined' && pageSize) { %>
          <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <% } %>
        <div class="modal-body">
          <div class="row g-2">
            <!-- Status Filter -->
            <div class="col-12 mb-2">
              <label for="filterServerStatus" class="form-label">Status</label>
              <select class="form-control" id="filterServerStatus" name="status">
                <option value="">All Status</option>
                <% if (typeof statusOptions !== 'undefined' && statusOptions.length > 0) { %>
                  <% statusOptions.forEach(function(option) { %>
                    <option value="<%= option.value %>" <%= filterStatus === option.value ? 'selected' : '' %>><%= option.label %></option>
                  <% }); %>
                      <% } else { %>
                  <option value="active" <%= filterStatus === 'active' ? 'selected' : '' %>>Active</option>
                  <option value="inactive" <%= filterStatus === 'inactive' ? 'selected' : '' %>>Inactive</option>
                  <option value="reserved" <%= filterStatus === 'reserved' ? 'selected' : '' %>>Reserved</option>
                      <% } %>
              </select>
                  </div>
                  
            <!-- Tags Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Tags</label>
              <select id="filterServerTags" name="tags[]" class="form-control" multiple></select>
                  </div>
                  
            <!-- Systems Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Systems</label>
              <select id="filterServerSystems" name="systems[]" class="form-control" multiple></select>
                  </div>
                  
            <!-- Contacts Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Contacts</label>
              <select id="filterServerContacts" name="contacts[]" class="form-control" multiple></select>
                  </div>
                  
            <!-- Services Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Services</label>
              <select id="filterServerServices" name="services[]" class="form-control" multiple></select>
                  </div>
                  
            <!-- OS/Platform Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">OS/Platform</label>
              <select id="filterServerOs" name="os" class="form-control">
                <option value="">All OS/Platform</option>
                <!-- Options will be loaded via AJAX -->
              </select>
                  </div>
                  
            <!-- Type Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Type</label>
              <select id="filterServerType" name="type" class="form-control">
                <option value="">All Types</option>
                <% if (typeof typesOptions !== 'undefined' && typesOptions.length > 0) { %>
                  <% typesOptions.forEach(function(option) { %>
                    <option value="<%= option.value %>" <%= filterType === option.value ? 'selected' : '' %>><%= option.label %></option>
                  <% }); %>
                <% } %>
              </select>
                  </div>
                  
            <!-- Location Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Location</label>
              <select id="filterServerLocation" name="location" class="form-control">
                <option value="">All Locations</option>
                <% if (typeof locations !== 'undefined' && locations.length > 0) { %>
                  <% locations.forEach(function(option) { %>
                    <option value="<%= option.value %>" <%= filterLocation === option.value ? 'selected' : '' %>><%= option.label %></option>
                  <% }); %>
                <% } %>
              </select>
                  </div>
                </div>
                </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-outline-danger" id="clearFilterBtnServer">Clear All Filters</button>
          <div>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
              </div>
        </div>
      </form>
    </div>
          </div>
        </div>
        
<!-- Import Server Modal -->
<div class="modal fade" id="importServerModal" tabindex="-1" aria-labelledby="importServerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importServerModalLabel">Import Servers</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
      <div class="modal-body">
        <form id="importServerForm" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="serverImportFile" class="form-label">Select File <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="file" class="form-control" id="serverImportFile" name="file" accept=".csv,.xlsx,.xls" required>
              <a href="/server/server/template" class="btn btn-outline-info" download>
                <i class="bi bi-download"></i> Download Template
              </a>
            </div>
            <div class="form-text">Supported formats: CSV, Excel (.xlsx, .xls). Maximum file size: 10MB</div>
          </div>
          
          <div class="mb-3">
            <div class="alert alert-info">
              <h6><i class="bi bi-info-circle"></i> Import Instructions:</h6>
              <ul class="mb-0">
                <li>Click "Download Template" to get the Excel template with correct format</li>
                <li>Fill the template with your server data</li>
                <li>IPAddress (Required, comma-separated if multiple) is required and must be valid IP format</li>
                <li>Name is optional (auto-generated if empty using format: platform_firstIP)</li>
                <li>OS, Status, Location, Type are optional</li>
                <li>Manager, System, Agent, Service, Tag are optional and can be comma-separated if multiple</li>
                <li>Description is optional</li>
                <li>Select your filled template file and validate before importing</li>
            </ul>
          </div>
        </div>
          
          <!-- Progress bar -->
          <div id="serverImportProgress" class="progress mb-3" style="display: none;">
            <div class="progress-bar" role="progressbar" style="width: 0%"></div>
          </div>
          
          <!-- Results display -->
          <div id="serverImportResults" class="alert" style="display: none;"></div>
        </form>
    </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning btn-sm" id="validateServerBtn">Validate File</button>
        <button type="button" class="btn btn-success btn-sm" id="importServerBtn" style="display: none;">Import Servers</button>
  </div>
</div>
  </div>
</div>
        
<style>
/* Fix Select2 dropdown z-index in modal */
  .select2-dropdown {
  z-index: 9999 !important;
}

.select2-container--bootstrap-5 .select2-dropdown {
  z-index: 9999 !important;
}

.modal .select2-dropdown {
  z-index: 9999 !important;
}

/* Ensure dropdown is visible above modal backdrop */
.select2-container--open .select2-dropdown {
  z-index: 9999 !important;
