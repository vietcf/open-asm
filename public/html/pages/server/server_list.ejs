<script>
  // Initialize window variables for Select2
  window.selectedTags = <%- JSON.stringify(selectedTags || []) %>;
  window.selectedSystems = <%- JSON.stringify(selectedSystems || []) %>;
  window.selectedManagers = <%- JSON.stringify(selectedManagers || []) %>;
  window.selectedServices = <%- JSON.stringify(selectedServices || []) %>;
  window.selectedOS = <%- JSON.stringify(selectedOS || null) %>;
  
  $(function() {
  console.log('Initializing Select2...');
  





  // Filter IP Modal - Initialize Select2
  $('#filterServerTags').select2({
            theme: 'bootstrap-5',
            placeholder: 'Select tag(s)',
            allowClear: true,
            width: '100%',
    dropdownParent: $('#filterServerModal'),
            ajax: {
              url: '/organize/api/tag',
              dataType: 'json',
              delay: 250,
      data: function(params) {
        return { search: params.term };
      },
      processResults: function(data) {
        return { results: data };
      },
              cache: true
    }
  });

  $('#filterServerSystems').select2({
            theme: 'bootstrap-5',
    placeholder: 'Select system(s)',
            allowClear: true,
            width: '100%',
    dropdownParent: $('#filterServerModal'),
            ajax: {
      url: '/system/api/system',
              dataType: 'json',
              delay: 250,
      data: function(params) {
        return { search: params.term };
      },
      processResults: function(data) {
        return { results: data };
      },
              cache: true
    }
  });

  $('#filterServerContacts').select2({
            theme: 'bootstrap-5',
    placeholder: 'Select contact(s)',
            allowClear: true,
            width: '100%',
    dropdownParent: $('#filterServerModal'),
            ajax: {
              url: '/organize/api/contact',
              dataType: 'json',
              delay: 250,
      data: function(params) {
        return { search: params.term };
      },
      processResults: function(data) {
        return { results: data };
      },
              cache: true
            }
          });

  $('#filterServerServices').select2({
            theme: 'bootstrap-5',
    placeholder: 'Select service(s)',
            allowClear: true,
            width: '100%',
    dropdownParent: $('#filterServerModal'),
            ajax: {
              url: '/server/api/service',
              dataType: 'json',
              delay: 250,
      data: function(params) {
        return { search: params.term };
      },
      processResults: function(data) {
        return { results: data };
      },
              cache: true
            }
          });

  // OS/Platform select2 AJAX - Bootstrap 5 theme
  $('#filterServerOs').select2({
            theme: 'bootstrap-5',
    placeholder: 'Select OS/Platform',
            allowClear: true,
            width: '100%',
    dropdownParent: $('#filterServerModal'),
            ajax: {
      url: '/device/api/platform',
              dataType: 'json',
              delay: 250,
      data: function(params) {
        return { search: params.term };
      },
      processResults: function(data) {
        return { results: data };
      },
              cache: true
            }
          });

  // Filter IP Modal - Load existing filter values when opened
  $('#filterServerModal').on('show.bs.modal', function() {
    console.log('Filter IP Modal opened');
    
    // Load existing filter values
    setTimeout(() => {
      loadFilterExistingValues();
    }, 100);
  });

  // Filter Server Modal - Reset form when hidden
  $('#filterServerModal').on('hidden.bs.modal', function() {
    console.log('Filter Server Modal hidden, resetting form');
    $('#filterServerForm')[0].reset();
    $('#filterServerTags, #filterServerSystems, #filterServerContacts, #filterServerServices, #filterServerOs').val(null).trigger('change');
  });

  // Clear All Filters button
  $('#clearFilterBtnServer').on('click', function() {
    // Clear all select2 values
    $('#filterServerTags').val(null).trigger('change');
    $('#filterServerSystems').val(null).trigger('change');
    $('#filterServerContacts').val(null).trigger('change');
    $('#filterServerServices').val(null).trigger('change');
    $('#filterServerOs').val(null).trigger('change');
    $('#filterServerStatus').val('');
    $('#filterServerType').val('');
    $('#filterServerLocation').val('');
    
    // Close modal
    $('#filterServerModal').modal('hide');
    
    // Redirect to clean URL but preserve pageSize and search
    const currentPageSize = $('select[name="pageSize"]').val() || '10';
    const currentSearch = $('input[name="search"]').val() || '';
    let cleanUrl = '/server/server/list';
    const params = [];
    if (currentPageSize && currentPageSize !== '10') params.push('pageSize=' + encodeURIComponent(currentPageSize));
    if (currentSearch) params.push('search=' + encodeURIComponent(currentSearch));
    if (params.length > 0) cleanUrl += '?' + params.join('&');
    window.location.href = cleanUrl;
  });
});

function loadFilterExistingValues() {
  console.log('Loading existing filter values...');
  
  // Get filter data from hidden div
  const filterDataEl = document.getElementById('filter-server-data');
  if (!filterDataEl) {
    console.log('Filter data element not found');
    return;
  }
  
  try {
    const filterTags = JSON.parse(filterDataEl.dataset.tags || '[]');
    const filterSystems = JSON.parse(filterDataEl.dataset.systems || '[]');
    const filterStatus = filterDataEl.dataset.status || '';
    const filterManagers = JSON.parse(filterDataEl.dataset.manager || '[]');
    const filterServices = JSON.parse(filterDataEl.dataset.services || '[]');
    const filterOS = filterDataEl.dataset.os || '';
    const filterType = filterDataEl.dataset.type || '';
    const filterLocation = filterDataEl.dataset.location || '';
    
    console.log('Filter data:', { filterTags, filterSystems, filterStatus, filterManagers, filterServices, filterOS, filterType, filterLocation });
    console.log('Window selectedManagers:', window.selectedManagers);
    console.log('Window selectedOS:', window.selectedOS);
    
    // Clear existing options first to avoid duplicates
    $('#filterServerTags').find('option').remove();
    $('#filterServerSystems').find('option').remove();
    $('#filterServerContacts').find('option').remove();
    $('#filterServerServices').find('option').remove();
    $('#filterServerOs').find('option').remove();
    
    // Add default option back for OS
    $('#filterServerOs').append('<option value="">All OS/Platform</option>');
    
    // Load status
    if (filterStatus) {
      $('#filterServerStatus').val(filterStatus);
    }
    
    // Load tags from window variables (more reliable)
    if (window.selectedTags && window.selectedTags.length > 0) {
      window.selectedTags.forEach(tag => {
        const option = new Option(tag.name, tag.id, true, true);
        $('#filterServerTags').append(option);
      });
      $('#filterServerTags').trigger('change');
    }
    
    // Load systems from window variables
    if (window.selectedSystems && window.selectedSystems.length > 0) {
      window.selectedSystems.forEach(system => {
        const option = new Option(system.name, system.id, true, true);
        $('#filterServerSystems').append(option);
      });
      $('#filterServerSystems').trigger('change');
    }
    
    // Load Managers from window variables
    console.log('Loading Managers:', window.selectedManagers);
    if (window.selectedManagers && window.selectedManagers.length > 0) {
      window.selectedManagers.forEach(manager => {
        console.log('Adding manager option:', manager);
        const option = new Option(manager.name, manager.id, true, true);
        $('#filterServerContacts').append(option);
      });
      $('#filterServerContacts').trigger('change');
    }
    
    // Load Services from window variables
    if (window.selectedServices && window.selectedServices.length > 0) {
      window.selectedServices.forEach(service => {
        const option = new Option(service.name, service.id, true, true);
        $('#filterServerServices').append(option);
      });
      $('#filterServerServices').trigger('change');
    }
    
    // Load OS from window variable
    console.log('Loading OS:', window.selectedOS);
    if (window.selectedOS && window.selectedOS.id) {
      console.log('Setting OS value to:', window.selectedOS.id);
      // For Select2, we need to add the option first, then set the value
      const option = new Option(window.selectedOS.text, window.selectedOS.id, true, true);
      $('#filterServerOs').append(option).trigger('change');
    }
    
    // Load Type
    if (filterType) {
      $('#filterServerType').val(filterType);
    }
    
    // Load Location
    if (filterLocation) {
      $('#filterServerLocation').val(filterLocation);
    }
    
    } catch (e) {
    console.error('Error loading filter values:', e);
  }
}




        
let pendingDeleteServerForm = null;
function confirmDeleteServer(form, server) {
  pendingDeleteServerForm = form;
  document.getElementById('deleteServerName').textContent = server;
  document.getElementById('deleteServerIpReserve').checked = true;
  const modal = new bootstrap.Modal(document.getElementById('deleteServerModal'));
  modal.show();
  return false;
}

document.getElementById('deleteServerConfirmBtn').addEventListener('click', function () {
  if (!pendingDeleteServerForm) return;
  const deleteIp = document.querySelector('input[name="deleteServerIpChoice"]:checked').value;
  pendingDeleteServerForm.querySelector('input[name="delete_ip"]').value = deleteIp;
  bootstrap.Modal.getInstance(document.getElementById('deleteServerModal')).hide();
  pendingDeleteServerForm.submit();
});


function showServerDetail(serverId) {
  const buttons = document.querySelectorAll('button[data-server]');
  let targetButton = null;
  
  for (let button of buttons) {
    const data = button.getAttribute('data-server');
    if (data) {
      try {
        const server = JSON.parse(data);
        if (server.id == serverId) {
          targetButton = button;
                break;
              }
      } catch (e) {
        console.error('Error parsing server data:', e);
      }
    }
  }
  
  if (!targetButton) {
    alert('Server data not found');
    return;
  }
  
  const serverData = targetButton.getAttribute('data-server');
  let server;
  try {
    server = JSON.parse(serverData);
  } catch (e) {
    alert('Error parsing server data: ' + e.message);
    return;
  }
  
  const modalElement = document.getElementById('serverDetailModal');
  const modal = new bootstrap.Modal(modalElement);
  const content = document.getElementById('serverDetailContent');
  
  let html = '<dl class="row detail-dl">';
  html += '<dt class="col-sm-4">Server Name</dt><dd class="col-sm-8">' + String(server.name || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8"><span style="white-space: pre-wrap;">' + String(server.description || 'N/A').trim() + '</span></dd>';
  html += '<dt class="col-sm-4">Status</dt><dd class="col-sm-8">' + String(server.status || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Type</dt><dd class="col-sm-8">' + String(server.type || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Location</dt><dd class="col-sm-8">' + String(server.location || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Operating System</dt><dd class="col-sm-8">' + String(server.platform_name || server.os || 'N/A').trim() + '</dd>';

  html += '<dt class="col-sm-4">IP Addresses</dt><dd class="col-sm-8">';
  if (server.ip && server.ip.length > 0) {
    server.ip.forEach(function(ip) {
      const ipValue = (typeof ip === 'string' ? ip : ip.ip_address);
      const searchUrl = '/network/ip-address?page=1&search=' + encodeURIComponent(ipValue);
      html += '<div><a href="' + searchUrl + '" class="text-primary text-decoration-underline">' + String(ipValue).trim() + '</a></div>';
    });
  } else {
    html += 'N/A';
  }
  html += '</dd>';

  if (server.tags && server.tags.length > 0) {
    html += '<dt class="col-sm-4">Tags</dt><dd class="col-sm-8">';
    server.tags.forEach(function(tag) {
      const tagValue = (typeof tag === 'string' ? tag : tag.name);
      html += '<span class="badge bg-primary me-1 mb-1">' + String(tagValue).trim() + '</span>';
    });
    html += '</dd>';
  }

  if (server.systems && server.systems.length > 0) {
    html += '<dt class="col-sm-4">Systems</dt><dd class="col-sm-8"><ul class="mb-0 ps-3">';
    server.systems.forEach(function(system) {
      const systemValue = (typeof system === 'string' ? system : system.name);
      const searchUrl = '/system/system?search=' + encodeURIComponent(systemValue) + '&pageSize=2';
      html += '<li><a href="' + searchUrl + '" class="text-primary text-decoration-underline">' +
              String(systemValue).trim() + '</a></li>';
    });
    html += '</ul></dd>';
  }

  if (server.managers && server.managers.length > 0) {
    html += '<dt class="col-sm-4">Managers</dt><dd class="col-sm-8">';
    server.managers.forEach(function(manager) {
      const managerName = (typeof manager === 'string' ? manager : manager.name);
      const managerEmail = (typeof manager === 'string' ? '' : manager.email);
      const searchUrl = '/organize/contact?page=1&search=' + encodeURIComponent(managerName);
      html += '<div><a href="' + searchUrl + '" class="text-primary text-decoration-underline">' + String(managerName).trim();
      if (managerEmail) {
        const emailUsername = managerEmail.split('@')[0];
        html += ' (' + String(emailUsername).trim() + ')';
      }
      html += '</a></div>';
    });
    html += '</dd>';
  }

  if (server.services && server.services.length > 0) {
    html += '<dt class="col-sm-4">Services</dt><dd class="col-sm-8">';
    server.services.forEach(function(service) {
      const serviceValue = (typeof service === 'string' ? service : service.name);
      html += '<span class="badge bg-warning text-dark me-1 mb-1">' + String(serviceValue).trim() + '</span>';
    });
    html += '</dd>';
  }

  if (server.agents && server.agents.length > 0) {
    html += '<dt class="col-sm-4">Agents</dt><dd class="col-sm-8">';
    server.agents.forEach(function(agent) {
      const agentName = (typeof agent === 'string' ? agent : agent.name);
      html += '<span class="badge bg-secondary me-1 mb-1">' + String(agentName).trim() + '</span>';
    });
    html += '</dd>';
  }
  html += '</dl>';
  content.innerHTML = html;
  modal.show();
}

// Import Server functionality
let selectedServerFile = null;

// Handle file selection
$(document).on('change', '#serverImportFile', function() {
  selectedServerFile = this.files[0];
  if (selectedServerFile) {
    console.log('Server file selected:', selectedServerFile.name);
    $('#validateServerBtn').prop('disabled', false);
  } else {
    $('#validateServerBtn').prop('disabled', true);
    $('#importServerBtn').hide();
  }
});

// Handle validate button click
$(document).on('click', '#validateServerBtn', function() {
  if (!selectedServerFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedServerFile);
  
  // Show progress
  $('#serverImportProgress').show();
  $('#serverImportResults').text('Validating file...');
  $('.progress-bar').css('width', '30%');
  
  $.ajax({
    url: '/server/server/validate-import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      const xhr = new window.XMLHttpRequest();
      xhr.responseType = 'blob'; // Important for file download
      return xhr;
    },
    success: function(data, status, xhr) {
      $('.progress-bar').css('width', '100%');
      
      // Handle file download
      const contentType = xhr.getResponseHeader('Content-Type');
      const contentDisposition = xhr.getResponseHeader('Content-Disposition');
      
      if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
        $('#serverImportResults').text('Validation complete! Downloading results...');
        // Create blob and download file
        const blob = new Blob([data], { type: contentType });
        const url = window.URL.createObjectURL(blob);
        
        // Extract filename from Content-Disposition header
        let filename = 'server_validation_results.xlsx';
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(/filename="(.+)"/);
          if (filenameMatch) {
            filename = filenameMatch[1];
          }
        }
        
        // Create download link
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Clean up
        window.URL.revokeObjectURL(url);
      } else if (contentType && contentType.includes('application/json')) {
        // Handle JSON error response
        let errorMessage = 'Unknown error occurred';
        try {
          const errorData = typeof data === 'string' ? JSON.parse(data) : data;
          errorMessage = errorData.error || errorData.message || 'Validation failed';
        } catch (e) {
          errorMessage = 'Failed to parse error response';
        }
        
        $('#serverImportResults').removeClass('alert-success').addClass('alert-danger')
          .html('<strong>Validation Error!</strong><br>' + errorMessage)
          .show();
        return;
      } else {
        // Handle other response types
        $('#serverImportResults').removeClass('alert-success').addClass('alert-danger')
          .html('<strong>Validation Error!</strong><br>Unexpected response type: ' + contentType)
          .show();
        return;
      }
      
      // Check validation results from header
      const validationSummary = xhr.getResponseHeader('X-Validation-Summary');
      if (validationSummary) {
        try {
          const summary = JSON.parse(validationSummary);
          const resultsDiv = $('#serverImportResults');
          resultsDiv.removeClass('alert-danger').addClass('alert-success')
            .html(`<strong>Validation Complete!</strong><br>
                   <small>Total: ${summary.total}, Passed: ${summary.passed}, Failed: ${summary.failed}</small><br>
                   <small>Validation file downloaded. Review results before importing.</small>`);
          resultsDiv.show();
          
          // Show import button if validation passed
          if (summary.allPassed) {
            $('#importServerBtn').show();
          }
        } catch (e) {
          // Fallback if header parsing fails
          const resultsDiv = $('#serverImportResults');
          resultsDiv.removeClass('alert-danger').addClass('alert-success')
            .html(`<strong>Validation Complete!</strong><br>
                   <small>Validation file downloaded. Review results before importing.</small>`);
          resultsDiv.show();
          $('#importServerBtn').show();
        }
      }
    },
    error: function(xhr, status, error) {
      console.error('Server validation error:', xhr);
      console.error('Status:', xhr.status);
      console.error('Error:', error);
      
      $('.progress-bar').css('width', '100%').text('Validation Failed');
      
      let errorMessage = 'Unknown error occurred';
      try {
        // Try to parse JSON response
        if (xhr.responseJSON && xhr.responseJSON.error) {
          errorMessage = xhr.responseJSON.error;
        } else if (xhr.responseText && typeof xhr.responseText === 'string') {
          errorMessage = xhr.responseText;
        } else if (xhr.response && typeof xhr.response === 'string') {
          errorMessage = xhr.response;
        }
      } catch (e) {
        console.error('Error parsing response:', e);
        errorMessage = `HTTP ${xhr.status}: ${error}`;
      }
      
      $('#serverImportResults').removeClass('alert-success').addClass('alert-danger')
        .html('<strong>Validation Error!</strong><br>' + errorMessage)
        .show();
    },
    complete: function() {
      $('#validateServerBtn').prop('disabled', false);
      setTimeout(() => {
        $('#serverImportProgress').hide();
      }, 2000);
    }
  });
});

// Handle import button click
$(document).on('click', '#importServerBtn', function() {
  if (!selectedServerFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedServerFile);
  
  // Show progress
  $('#serverImportProgress').show();
  $('#serverImportResults').text('Importing servers...');
  $('.progress-bar').css('width', '30%').text('Importing...');
  $('#importServerBtn').prop('disabled', true);
  
  $.ajax({
    url: '/server/server/import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      const xhr = new window.XMLHttpRequest();
      xhr.responseType = 'blob'; // Important for file download
      return xhr;
    },
    success: function(data, status, xhr) {
      $('#serverImportProgress .progress-bar').css('width', '100%').text('Import Complete');
      
      // Handle file download
      const contentType = xhr.getResponseHeader('Content-Type');
      const contentDisposition = xhr.getResponseHeader('Content-Disposition');
      
      if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
        // Create blob and download file
        const blob = new Blob([data], { type: contentType });
        const url = window.URL.createObjectURL(blob);
        
        // Extract filename from Content-Disposition header
        let filename = 'server_import_results.xlsx';
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(/filename="(.+)"/);
          if (filenameMatch) {
            filename = filenameMatch[1];
          }
        }
        
        // Create download link
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Clean up
        window.URL.revokeObjectURL(url);
      }
      
      // Show results
      const resultsDiv = $('#serverImportResults');
      resultsDiv.removeClass('alert-danger').addClass('alert-success')
        .html('<strong>Import Complete!</strong><br><small>Import results file downloaded. Page will refresh in 2 seconds...</small>')
        .show();

      // Refresh page after delay (same 2s as IP/Subnet/Device import)
      setTimeout(() => {
        window.location.reload();
      }, 2000);
    },
    error: function(xhr, status, error) {
      console.error('Server import error:', xhr);
      console.error('Status:', xhr.status);
      console.error('Error:', error);
      
      $('.progress-bar').css('width', '100%').text('Import Failed');
      
      let errorMessage = 'Unknown error occurred';
      try {
        // Try to parse JSON response
        if (xhr.responseJSON && xhr.responseJSON.error) {
          errorMessage = xhr.responseJSON.error;
        } else if (xhr.responseText && typeof xhr.responseText === 'string') {
          errorMessage = xhr.responseText;
        } else if (xhr.response && typeof xhr.response === 'string') {
          errorMessage = xhr.response;
        }
      } catch (e) {
        console.error('Error parsing response:', e);
        errorMessage = `HTTP ${xhr.status}: ${error}`;
      }
      
      $('#serverImportResults').removeClass('alert-success').addClass('alert-danger')
        .html('<strong>Import Error!</strong><br>' + errorMessage)
        .show();
    },
    complete: function() {
      $('#importServerBtn').prop('disabled', false);
      setTimeout(() => {
        $('#serverImportProgress').hide();
      }, 2000);
    }
  });
});

