<%
  const f = filter;
  const activeFilterCount = [f.status, f.type, f.location, f.tags.length, f.manager.length, f.systems.length, f.services.length, f.os.length].filter(Boolean).length;
  const COLUMNS = [
    { key: 'name', label: 'Server Name', def: true, fixed: true },
    { key: 'ips', label: 'IP Address', def: true },
    { key: 'status', label: 'Status', def: true },
    { key: 'type', label: 'Type', def: true },
    { key: 'systems', label: 'Systems', def: true },
    { key: 'tags', label: 'Tags', def: true },
    { key: 'description', label: 'Description' },
    { key: 'location', label: 'Location' },
    { key: 'platform', label: 'Platform' },
    { key: 'managers', label: 'Managers' },
    { key: 'services', label: 'Services' },
    { key: 'agents', label: 'Agents' },
    { key: 'updated', label: 'Updated' },
  ];
  const names = (list) => (list || []).map(x => x.name);
  const cell = (s, key) => ({
    name: ui.esc(s.name),
    ips: ui.mono(s.ip_addresses.map(ip => ip.ip_address + (ip.role === 'vip' ? ' (VIP)' : ''))),
    status: s.status ? `<span class="badge tag">${ui.esc(ui.optionLabel(statusOptions, s.status))}</span>` : ui.dash,
    type: s.type ? ui.esc(ui.optionLabel(typesOptions, s.type)) : ui.dash,
    systems: ui.chips(names(s.systems)),
    tags: ui.chips(names(s.tags)),
    description: ui.clip(s.description),
    location: s.location ? ui.esc(ui.optionLabel(locations, s.location)) : ui.dash,
    platform: ui.text(s.platform_name),
    managers: ui.text(names(s.managers).join(', ')),
    services: ui.chips(names(s.services)),
    agents: ui.chips(names(s.agents)),
    updated: ui.date(s.updated_at),
  })[key];
  const singleSelect = (name, label, opts, value, placeholder) => ({ name, label, opts, value, placeholder });
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Server Management' }, { label: 'Server List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/server/server">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name, IP, description...',
              filtersId: 'serverFilters', activeFilterCount,
              columns: { tableId: 'serverTable', storageKey: 'openasm.serverList.columns', list: COLUMNS },
              exportUrl: '/server/server/export' + currentQuery,
              importModal: hasPermission('server.create') ? 'serverImportModal' : null,
              addUrl: hasPermission('server.create') ? '/server/server/add' : null, addLabel: 'Add Server' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="serverFilters">
          <div class="list-filters">
            <div class="row g-2">
              <% [singleSelect('status', 'Status', statusOptions, f.status), singleSelect('type', 'Type', typesOptions, f.type), singleSelect('location', 'Location', locations, f.location)].forEach(function (s) { %>
                <div class="col-md-4 col-xl-3">
                  <label class="form-label small"><%= t(s.label) %></label>
                  <select name="<%= s.name %>" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                    <option value=""></option>
                    <% if (s.name !== 'status') { %><option value="__none__" <%= s.value === '__none__' ? 'selected' : '' %>><%= t('(Not set)') %></option><% } %>
                    <% (s.opts || []).forEach(function (o) { %>
                      <option value="<%= o.id %>" <%= s.value === o.id ? 'selected' : '' %>><%= o.text %></option>
                    <% }) %>
                  </select>
                </div>
              <% }) %>
              <div class="col-md-4 col-xl-3">
                <label class="form-label small"><%= t('Platform') %></label>
                <select name="os[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options([{ id: '__none__', text: t('(Not set)') }, ...platformOptions], f.os) %></select>
              </div>
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('Systems') %></label>
                <select name="systems[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(f.systems) %>'></select>
              </div>
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('Managers') %></label>
                <select name="contacts[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/organize/api/contact" data-ids-url="/organize/api/contact/ids" data-selected='<%= JSON.stringify(f.manager) %>'></select>
              </div>
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('Services') %></label>
                <select name="services[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(serviceOptions, f.services) %></select>
              </div>
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(tagOptions, f.tags) %></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="serverTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (serverList && serverList.length) { %>
              <% serverList.forEach(function (server, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(server, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showServerDetail(this)" data-record='<%= JSON.stringify(server) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('server.create')) { %>
                        <a href="/server/server/<%= server.id %>/duplicate" class="btn btn-sm btn-outline-secondary" title="<%= t('Duplicate') %>"><i class="bi bi-copy"></i></a>
                      <% } %>
                      <% if (hasPermission('server.update')) { %>
                        <a href="/server/server/<%= server.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('server.delete')) { %>
                        <form action="/server/server/<%= server.id %>/delete" method="POST" data-delete-ip="<%= server.name %>">
                          <input type="hidden" name="delete_ip" value="false">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-hdd-network', message: 'No servers found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/server/server',
                      actionUrl: hasPermission('server.create') ? '/server/server/add' : null, actionLabel: 'Add Server' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (serverList || []).length, summary: 'Showing {1} - {2} of {3} servers' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'serverDetailModal', pentestType: 'server' }) %>
<%- include('../../partials/ui/pentest_quick_view') %>
<%- include('../../partials/ui/delete_ip_modal') %>
<% if (hasPermission('server.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'serverImportModal', title: 'Import Servers', baseUrl: '/server/server',
        instructions: ['IP addresses are required; unknown IPs are created as Reserved and assigned to the server', 'OS, managers (email), systems, agents, services and tags must already exist', 'A row whose name or IP is already used is skipped'] }) %>
<% } %>

<script>
  const SERVER_OPTIONS = { status: <%- jsonSafe(statusOptions || []) %>, type: <%- jsonSafe(typesOptions || []) %>, location: <%- jsonSafe(locations || []) %> };

  function showServerDetail(button) {
    const s = DV.record(button);
    if (!s) return;
    const ips = s.ip_addresses || [];
    const opt = (key) => (s[key] ? DV.optionLabel(SERVER_OPTIONS[key], s[key]) : '');
    let body = DV.section('Overview', DV.rows(
      DV.multiline(s.description) ? DV.field('Description', DV.multiline(s.description)) : '',
      DV.field('Status', DV.text(opt('status'))),
      DV.field('Type', DV.text(opt('type'))),
      DV.field('Location', DV.text(opt('location'))),
      DV.field('Platform', DV.text(s.platform_name)),
      DV.field('Tags', DV.chips((s.tags || []).map((tg) => tg.name))),
      DV.field('Managers', DV.contacts(s.managers))
    ));
    body += DV.section('Network', DV.rows(
      DV.field('IP Addresses', DV.ipLinks(ips.filter((ip) => ip.role !== 'vip'))),
      DV.field('VIP IP Address(es)', DV.ipLinks(ips.filter((ip) => ip.role === 'vip')))
    ), ' <span class="badge tag ms-1">' + ips.length + '</span>');
    body += DV.section('Software', DV.rows(
      DV.field('Systems', DV.linkChips(s.systems || [], (x) => '/system/system?search=' + encodeURIComponent(x.name))),
      DV.field('Services', DV.chips((s.services || []).map((x) => x.name))),
      DV.field('Agents', DV.chips((s.agents || []).map((a) => a.version ? a.name + ' (' + a.version + ')' : a.name)))
    ));
    body += DV.meta(s);
    DV.open('serverDetailModal', {
      title: s.name,
      subtitle: (s.platform_name ? DV.esc(s.platform_name) : '') + (s.status ? ' <span class="badge tag ms-1">' + DV.esc(opt('status')) + '</span>' : ''),
      body,
      recordId: s.id,
    });
  }
</script>
