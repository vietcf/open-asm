<style>
  /* Named class so this button row isn't caught by the generic
     .d-flex.gap-2 mobile override (layout.ejs) meant for filter bars —
     that rule forces flex-direction:column !important, which combined
     with w-50 left each button at half width once stacked. */
  .change-password-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .change-password-actions .btn {
    width: 100%;
  }
  @media (min-width: 576px) {
    .change-password-actions {
      flex-direction: row;
    }
    .change-password-actions .btn {
      flex: 1 1 0;
      width: auto;
    }
  }
</style>
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center">
          <h5 class="mb-0"><%= t('Change Password') %></h5>
        </div>
        <div class="card-body">
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= t(error) %></div>
          <% } %>
          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><%= t(success) %></div>
          <% } %>
          <form method="POST" action="/change-password">
            <div class="mb-3">
              <label for="currentPassword" class="form-label"><%= t('Current Password') %></label>
              <input type="password" class="form-control" id="currentPassword" name="currentPassword" placeholder="<%= t('Enter current password') %>" required autocomplete="current-password">
            </div>
            <div class="mb-3">
              <label for="newPassword" class="form-label"><%= t('New Password') %></label>
              <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder="<%= t('Enter new password') %>" required autocomplete="new-password">
              <div class="form-text"><%= t('Password must be at least 8 characters and include uppercase, lowercase, and a number.') %></div>
            </div>
            <div class="mb-3">
              <label for="confirmPassword" class="form-label"><%= t('Confirm New Password') %></label>
              <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="<%= t('Re-enter new password') %>" required autocomplete="new-password">
            </div>
            <div class="change-password-actions">
              <button type="submit" class="btn btn-primary"><%= t('Change Password') %></button>
              <a href="/dashboard" class="btn btn-secondary"><%= t('Close') %></a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
