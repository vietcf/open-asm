<!-- Modal Buttons Custom CSS -->
<link rel="stylesheet" href="/css/modal-buttons.css">

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/device/device">Device List</a></li>
          <li class="breadcrumb-item active">Edit Device</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<section class="app-content">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10 col-sm-12">
      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Edit Device</h5>
        </div>
        <form id="editDeviceForm" action="/device/<%= device.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label">Device Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control form-control-sm" value="<%= device.name %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Device description"><%= device.description || '' %></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">IP Address(es)</label>
              <div class="d-flex align-items-center gap-2">
                <select id="ip-select" name="ip_addresses[]" class="form-control flex-grow-1" multiple></select>
                <button type="button" class="btn btn-outline-success btn-sm" id="add-ip-btn" title="Add new IP"><i class="bi bi-plus-circle"></i> Add IP</button>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Type</label>
              <select name="type" class="form-select" data-placeholder="Select type">
                <option value="">-- Select type --</option>
                <% if (typeof typesOptions !== 'undefined' && typesOptions) { %>
                  <% typesOptions.forEach(function(tp) { %>
                    <option value="<%= tp.value %>" <%= device.type === tp.value ? 'selected' : '' %>><%= tp.label %></option>
                  <% }) %>
                <% } else { %>
                  <option value="server" <%= device.type === 'server' ? 'selected' : '' %>>Server</option>
                  <option value="network" <%= device.type === 'network' ? 'selected' : '' %>>Network</option>
                  <option value="storage" <%= device.type === 'storage' ? 'selected' : '' %>>Storage</option>
                <% } %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Status</label>
              <select name="status" class="form-select" data-placeholder="Select status">
                <option value="">-- Select Status --</option>
                <% if (typeof statusOptions !== 'undefined' && statusOptions) { %>
                  <% statusOptions.forEach(function(st) { %>
                    <option value="<%= st.value %>" <%= device.status === st.value ? 'selected' : '' %>><%= st.label %></option>
                  <% }) %>
                <% } else { %>
                  <option value="active" <%= device.status === 'active' ? 'selected' : '' %>>Active</option>
                  <option value="inactive" <%= device.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                  <option value="reserved" <%= device.status === 'reserved' ? 'selected' : '' %>>Reserved</option>
                <% } %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Location</label>
              <select name="location" class="form-select" data-placeholder="Select location">
                <option value="">-- Select Location --</option>
                <% if (typeof locationOptions !== 'undefined' && locationOptions) { %>
                  <% locationOptions.forEach(function(loc) { %>
                    <option value="<%= loc.value %>" <%= device.location === loc.value ? 'selected' : '' %>><%= loc.label %></option>
                  <% }) %>
                <% } else { %>
                  <option value="datacenter" <%= device.location === 'datacenter' ? 'selected' : '' %>>Data Center</option>
                  <option value="office" <%= device.location === 'office' ? 'selected' : '' %>>Office</option>
                  <option value="remote" <%= device.location === 'remote' ? 'selected' : '' %>>Remote</option>
                <% } %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Platform (OS)</label>
              <select id="platform-select" name="platform" class="form-select" data-placeholder="Select platform">
                <option value="">-- Select Platform --</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Managers</label>
              <select id="manager-select" name="managers[]" class="form-control" multiple data-placeholder="Select managers">
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Systems</label>
              <select id="system-select" name="systems[]" class="form-control" multiple data-placeholder="Select systems">
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Agents</label>
              <select id="agent-select" name="agents[]" class="form-control" multiple data-placeholder="Select agents">
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Services</label>
              <select id="service-select" name="services[]" class="form-control" multiple data-placeholder="Select services">
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Tags</label>
              <select id="tag-select" name="tags[]" class="form-control" multiple data-placeholder="Select tags">
              </select>
            </div>
          </div>
          <div class="card-footer d-flex flex-column flex-lg-row justify-content-lg-end gap-2">
            <button type="submit" class="btn btn-primary w-100 order-1 order-lg-2">Update Device</button>
            <a href="/device/device" class="btn btn-secondary w-100 order-2 order-lg-1">Cancel</a>
          </div>
        </form>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
$(document).ready(function() {
  // Initialize Select2 for all select elements
  $('.form-control').select2({
    theme: 'bootstrap-5',
    placeholder: function() {
      return $(this).data('placeholder') || 'Select...';
    },
    allowClear: true,
    width: '100%'
  });

  // Type select2 - Bootstrap 5 theme
  $('select[name="type"]').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select type',
    allowClear: true,
    width: '100%'
  });

  // Status select2 - Bootstrap 5 theme
  $('select[name="status"]').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select status',
    allowClear: true,
    width: '100%'
  });

  // Location select2 - Bootstrap 5 theme
  $('select[name="location"]').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select location',
    allowClear: true,
    width: '100%'
  });

  // IP Address Select2 with AJAX
  $('#ip-select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select IP addresses',
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/device/api/ip-addresses',
      dataType: 'json',
      delay: 250,
      data: function (params) {
        return {
          search: params.term,
          page: params.page || 1
        };
      },
      processResults: function (data) {
        return {
          results: data.map(function(item) {
            return {
              id: item.id,
              text: item.ip_address + (item.description ? ' - ' + item.description : '')
            };
          })
        };
      },
      cache: true
    }
  });

  // Manager Select2 with AJAX
  $('#manager-select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select managers',
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/device/api/contacts',
      dataType: 'json',
      delay: 250,
      data: function (params) {
        return {
          search: params.term,
          page: params.page || 1
        };
      },
      processResults: function (data) {
        return {
          results: data.map(function(item) {
            return {
              id: item.id,
              text: item.name + ' (' + item.email + ')'
            };
          })
        };
      },
      cache: true
    }
  });

  // System Select2 with AJAX
  $('#system-select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select systems',
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/device/api/systems',
      dataType: 'json',
      delay: 250,
      data: function (params) {
        return {
          search: params.term,
          page: params.page || 1
        };
      },
      processResults: function (data) {
        return {
          results: data.map(function(item) {
            return {
              id: item.id,
              text: item.name
            };
          })
        };
      },
      cache: true
    }
  });

  // Agent Select2 with AJAX
  $('#agent-select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select agents',
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/device/api/agents',
      dataType: 'json',
      delay: 250,
      data: function (params) {
        return {
          search: params.term,
          page: params.page || 1
        };
      },
      processResults: function (data) {
        return {
          results: data.map(function(item) {
            return {
              id: item.id,
              text: item.name
            };
          })
        };
      },
      cache: true
    }
  });

  // Service Select2 with AJAX
  $('#service-select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select services',
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/device/api/services',
      dataType: 'json',
      delay: 250,
      data: function (params) {
        return {
          search: params.term,
          page: params.page || 1
        };
      },
      processResults: function (data) {
        return {
          results: data.map(function(item) {
            return {
              id: item.id,
              text: item.name
            };
          })
        };
      },
      cache: true
    }
  });

  // Tag Select2 with AJAX
  $('#tag-select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select tags',
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/device/api/tags',
      dataType: 'json',
      delay: 250,
      data: function (params) {
        return {
          search: params.term,
          page: params.page || 1
        };
      },
      processResults: function (data) {
        return {
          results: data.map(function(item) {
            return {
              id: item.id,
              text: item.name
            };
          })
        };
      },
      cache: true
    }
  });

  // Platform Select2 with AJAX
  $('#platform-select').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select platform',
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/device/api/platform',
      dataType: 'json',
      delay: 250,
      data: function (params) {
        return {
          search: params.term,
          page: params.page || 1
        };
      },
      processResults: function (data) {
        return {
          results: data.map(function(item) {
            return {
              id: item.id,
              text: item.name
            };
          })
        };
      },
      cache: true
    }
  });

  // Add IP button: open new tab to IP management page
  $('#add-ip-btn').click(function() {
    window.open('/network/ip_address', '_blank');
  });
});
</script>