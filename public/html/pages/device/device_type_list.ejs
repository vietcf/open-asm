
<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '?' + params.toString();
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Device Type List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/device/type">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Device Type Name..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('device_type.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addDeviceTypeModal">
              <i class="bi bi-plus"></i> Add Device Type
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- DEVICE TYPE LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Device Type List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Device Type List</h3>
          </div>
          <div class="card-body table-responsive p-0" style="overflow-x: auto;">
            <table class="table table-hover" id="deviceTypeTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th data-sort-type="text">Device Type Name</th>
                  <th data-sort-type="text">Description</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (deviceTypeList && deviceTypeList.length > 0) { %>
                  <% deviceTypeList.forEach(function(deviceType, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= deviceType.name %></td>
                      <td><%= deviceType.description || '-' %></td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm me-1" title="Show" onclick="showDeviceTypeDetail('<%= deviceType.id %>')" data-device-type='<%= JSON.stringify(deviceType) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        <% if (hasPermission('device_type.update')) { %>
                          <button type="button" class="btn btn-warning btn-sm me-1" data-bs-toggle="modal" data-bs-target="#editDeviceTypeModal" data-device-type-id="<%= deviceType.id %>" data-device-type-name="<%= deviceType.name %>" data-device-type-description="<%= deviceType.description || '' %>" title="Edit">
                            <i class="bi bi-pencil"></i>
                          </button>
                        <% } %>
                        <% if (hasPermission('device_type.delete') || (user && (user.role_name === 'superadmin' || user.role_name === 'admin'))) { %>
                          <form action="/device/type/<%= deviceType.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteDeviceType(this, '<%= deviceType.name %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete" style="display: inline-block !important; visibility: visible !important;">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center">No device types found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range
                  const deviceTypeStartItem = (page - 1) * pageSize + 1;
                  const deviceTypeEndItem = Math.min(page * pageSize, totalCount || 0);
                  const deviceTypeStartPage = Math.max(1, page - 2);
                  const deviceTypeEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= deviceTypeStartItem %> - <%= deviceTypeEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> device types</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildDeviceTypeFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const deviceTypeFilterQuery = buildDeviceTypeFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= deviceTypeFilterQuery ? '&' + deviceTypeFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (deviceTypeStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= deviceTypeFilterQuery ? '&' + deviceTypeFilterQuery : '' %>">1</a></li>
                  <% if (deviceTypeStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = deviceTypeStartPage; i <= deviceTypeEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= deviceTypeFilterQuery ? '&' + deviceTypeFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (deviceTypeEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= deviceTypeFilterQuery ? '&' + deviceTypeFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= deviceTypeFilterQuery ? '&' + deviceTypeFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODALS SECTION -->
<!-- ========================================== -->

<!-- Add Device Type Modal -->
<div class="modal fade" id="addDeviceTypeModal" tabindex="-1" aria-labelledby="addDeviceTypeModalLabel">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addDeviceTypeModalLabel">Add Device Type</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/device/type" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="deviceTypeName" class="form-label">Device Type Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="deviceTypeName" name="name" placeholder="Enter device type name" required>
          </div>
          <div class="mb-3">
            <label for="deviceTypeDescription" class="form-label">Description</label>
            <textarea class="form-control" id="deviceTypeDescription" name="description" rows="3" placeholder="Enter device type description"></textarea>
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-end">
          <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Add Device Type</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Device Type Modal -->
<div class="modal fade" id="editDeviceTypeModal" tabindex="-1" aria-labelledby="editDeviceTypeModalLabel">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editDeviceTypeModalLabel">Edit Device Type</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editDeviceTypeForm" action="" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="editDeviceTypeName" class="form-label">Device Type Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editDeviceTypeName" name="name" placeholder="Enter device type name" required>
          </div>
          <div class="mb-3">
            <label for="editDeviceTypeDescription" class="form-label">Description</label>
            <textarea class="form-control" id="editDeviceTypeDescription" name="description" rows="3" placeholder="Enter device type description"></textarea>
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-end">
          <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Update Device Type</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Device Type Detail Modal -->
<div class="modal fade" id="deviceTypeDetailModal" tabindex="-1" aria-labelledby="deviceTypeDetailModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deviceTypeDetailModalLabel">Device Type Detail</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="deviceTypeDetailContent">
        <!-- Content will be loaded here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>


<script>
// ==========================================
// JAVASCRIPT FUNCTIONS
// ==========================================

// name/description are free-text and not HTML-stripped server-side — must
// be escaped before going into innerHTML.
function escapeHtml(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

// Device Type Detail Modal Handler
function showDeviceTypeDetail(deviceTypeId) {
  const button = document.querySelector(`button[onclick="showDeviceTypeDetail('${deviceTypeId}')"]`);
  const deviceTypeData = JSON.parse(button.getAttribute('data-device-type'));

  const modalElement = document.getElementById('deviceTypeDetailModal');
  const content = document.getElementById('deviceTypeDetailContent');

  let html = '<dl class="row detail-dl">';
  html += '<dt class="col-sm-4">Device Type ID</dt><dd class="col-sm-8">' + (deviceTypeData.id || '-') + '</dd>';
  html += '<dt class="col-sm-4">Device Type Name</dt><dd class="col-sm-8">' + escapeHtml(deviceTypeData.name || '-') + '</dd>';
  html += '<dt class="col-sm-4">Created</dt><dd class="col-sm-8">' + (deviceTypeData.created_at ? new Date(deviceTypeData.created_at).toLocaleDateString() : '-') + '</dd>';
  html += '<dt class="col-sm-4">Updated</dt><dd class="col-sm-8">' + (deviceTypeData.updated_at ? new Date(deviceTypeData.updated_at).toLocaleDateString() : '-') + '</dd>';
  html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8">' + (deviceTypeData.description ? '<div style="white-space: pre-wrap; word-wrap: break-word; max-width: 100%;">' + escapeHtml(deviceTypeData.description) + '</div>' : '-') + '</dd>';
  html += '</dl>';
  
  content.innerHTML = html;
  const modal = new bootstrap.Modal(modalElement);
  modal.show();
}

// Edit device type function
function editDeviceType(id, name, description) {
  document.getElementById('editDeviceTypeForm').action = '/device/type/' + id + '?_method=PUT';
  document.getElementById('editDeviceTypeName').value = name;
  document.getElementById('editDeviceTypeDescription').value = description;
}

// Handle edit button click
$(document).on('click', 'button[data-bs-target="#editDeviceTypeModal"]', function() {
  const id = $(this).data('device-type-id');
  const name = $(this).data('device-type-name');
  const description = $(this).data('device-type-description');
  editDeviceType(id, name, description);
});

// Confirm delete device type
function confirmDeleteDeviceType(form, deviceTypeName) {
  return confirm(`Are you sure you want to delete device type "${deviceTypeName}"? This action cannot be undone.`);
}

// Helper function to build export URL
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '/device/type/export' + (params.toString() ? '?' + params.toString() : '');
}
</script>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#deviceTypeTable {
  table-layout: fixed;
  min-width: 700px;
}
#deviceTypeTable thead th {
  white-space: nowrap;
}
#deviceTypeTable th:nth-child(1), #deviceTypeTable td:nth-child(1) { width: 8%; }
#deviceTypeTable th:nth-child(2), #deviceTypeTable td:nth-child(2) { width: 27%; }
#deviceTypeTable th:nth-child(3), #deviceTypeTable td:nth-child(3) { width: 40%; }
#deviceTypeTable th:nth-child(4), #deviceTypeTable td:nth-child(4) { width: 25%; }

#deviceTypeTable td:nth-child(3) {
  overflow-wrap: break-word;
}
#deviceTypeTable td:nth-child(4) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>