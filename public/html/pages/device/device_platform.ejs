<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '?' + params.toString();
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Platform List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/device/platform">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Platform..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('platform.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPlatformModal">
              <i class="bi bi-plus"></i> Add Platform
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Filter values for JS (an toàn cho EJS strict, giống System List) -->
    <div id="filter-platform-data" style="display:none"></div>

    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- PLATFORM LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Platform List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Platform List</h3>
          </div>
          <div class="card-body table-responsive" style="overflow-x: auto;">
            <table class="table table-hover" id="platformTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Platform Name</th>
                  <th>Description</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (platformList && platformList.length > 0) { %>
                  <% platformList.forEach(function(platform, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= platform.name %></td>
                      <td><%= platform.description || '-' %></td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm me-1" title="Show" onclick="showPlatformDetail('<%= platform.id %>')" data-platform='<%= JSON.stringify(platform) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        <% if (hasPermission('platform.update')) { %>
                          <button type="button" class="btn btn-warning btn-sm me-1" title="Edit" data-bs-toggle="modal" data-bs-target="#editPlatformModal" data-platform-id="<%= platform.id %>" data-platform-name="<%= platform.name %>" data-platform-description="<%= platform.description || '' %>">
                            <i class="bi bi-pencil"></i>
                          </button>
                        <% } %>
                        <% if (hasPermission('platform.delete') || (user && (user.role_name === 'superadmin' || user.role_name === 'admin'))) { %>
                          <form action="/device/platform/<%= platform.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeletePlatform(this, '<%= platform.name %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete" style="display: inline-block !important; visibility: visible !important;">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center">No platforms found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range like system list
                  const platformStartItem = (page - 1) * pageSize + 1;
                  const platformEndItem = Math.min(page * pageSize, totalCount || 0);
                  const platformStartPage = Math.max(1, page - 2);
                  const platformEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= platformStartItem %> - <%= platformEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> platforms</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildPlatformFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const platformFilterQuery = buildPlatformFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= platformFilterQuery ? '&' + platformFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (platformStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= platformFilterQuery ? '&' + platformFilterQuery : '' %>">1</a></li>
                  <% if (platformStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = platformStartPage; i <= platformEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= platformFilterQuery ? '&' + platformFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (platformEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= platformFilterQuery ? '&' + platformFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= platformFilterQuery ? '&' + platformFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    <!-- ========================================== -->
    <!-- MODALS SECTION -->
    <!-- ========================================== -->
    
    <!-- Add Platform Modal -->
    <div class="modal fade" id="addPlatformModal" tabindex="-1" aria-labelledby="addPlatformModalLabel">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="addPlatformForm" method="POST" action="/device/platform">
            <div class="modal-header">
              <h5 class="modal-title" id="addPlatformModalLabel">Add Platform</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="platformName" class="form-label">Platform Name <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="platformName" name="name" required placeholder="Enter platform name">
                </div>
                <div class="col-12">
                  <label for="platformDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="platformDescription" name="description" rows="3" placeholder="Enter platform description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Add Platform</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Platform Modal -->
    <div class="modal fade" id="editPlatformModal" tabindex="-1" aria-labelledby="editPlatformModalLabel">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <form id="editPlatformForm" method="POST" action="">
            <div class="modal-header">
              <h5 class="modal-title" id="editPlatformModalLabel">Edit Platform</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12">
                  <label for="editPlatformName" class="form-label">Platform Name</label>
                  <input type="text" class="form-control" id="editPlatformName" name="name" readonly>
                </div>
                <div class="col-12">
                  <label for="editPlatformDescription" class="form-label">Description</label>
                  <textarea class="form-control" id="editPlatformDescription" name="description" rows="3" placeholder="Enter platform description"></textarea>
                </div>
              </div>
            </div>
            <div class="modal-footer d-flex justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm">Update Platform</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Platform Detail Modal -->
    <div class="modal fade" id="platformDetailModal" tabindex="-1" aria-labelledby="platformDetailModalLabel">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="platformDetailModalLabel">Platform Detail</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="platformDetailContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>



<script>
// name/description are free-text and not HTML-stripped server-side — must
// be escaped before going into innerHTML.
function escapeHtml(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

// Platform Detail Modal Handler
function showPlatformDetail(platformId) {
  const button = document.querySelector(`button[onclick="showPlatformDetail('${platformId}')"]`);
  const platformData = JSON.parse(button.getAttribute('data-platform'));

  const modalElement = document.getElementById('platformDetailModal');
  const content = document.getElementById('platformDetailContent');

  let html = '<dl class="row detail-dl">';
  html += '<dt class="col-sm-4">Platform ID</dt><dd class="col-sm-8">' + (platformData.id || '-') + '</dd>';
  html += '<dt class="col-sm-4">Platform Name</dt><dd class="col-sm-8">' + escapeHtml(platformData.name || '-') + '</dd>';
  html += '<dt class="col-sm-4">Created</dt><dd class="col-sm-8">' + (platformData.created_at ? new Date(platformData.created_at).toLocaleDateString() : '-') + '</dd>';
  html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8">' + (platformData.description ? '<div style="white-space: pre-wrap; word-wrap: break-word; max-width: 100%;">' + escapeHtml(platformData.description) + '</div>' : '-') + '</dd>';
  html += '</dl>';
  
  content.innerHTML = html;
  const modal = new bootstrap.Modal(modalElement);
  modal.show();
}

// Edit Platform Modal Handler
$(document).on('click', 'button[data-bs-target="#editPlatformModal"]', function() {
  const id = $(this).data('platform-id');
  const name = $(this).data('platform-name');
  const description = $(this).data('platform-description');
  
  $('#editPlatformForm').attr('action', '/device/platform/' + id + '?_method=PUT');
  $('#editPlatformName').val(name);
  $('#editPlatformDescription').val(description);
});

// Confirm Delete Platform
function confirmDeletePlatform(form, platformName) {
  if (confirm(`Are you sure you want to delete platform "${platformName}"?`)) {
    return true;
  } else {
    return false;
  }
}
</script>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#platformTable {
  table-layout: fixed;
  min-width: 700px;
}
#platformTable thead th {
  white-space: nowrap;
}
#platformTable th:nth-child(1), #platformTable td:nth-child(1) { width: 8%; }
#platformTable th:nth-child(2), #platformTable td:nth-child(2) { width: 27%; }
#platformTable th:nth-child(3), #platformTable td:nth-child(3) { width: 40%; }
#platformTable th:nth-child(4), #platformTable td:nth-child(4) { width: 25%; }

#platformTable td:nth-child(3) {
  overflow-wrap: break-word;
}
#platformTable td:nth-child(4) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>