<%
  const f = filter;
  const activeFilterCount = [f.protocol, f.provider, f.device_id].filter(Boolean).length;
  const COLUMNS = [
    { key: 'name', label: 'Name', def: true, fixed: true },
    { key: 'domain', label: 'Domain', def: true },
    { key: 'endpoint', label: 'Endpoint', def: true },
    { key: 'provider', label: 'Provider', def: true },
    { key: 'device', label: 'Device', def: true },
    { key: 'members', label: 'Backend Servers', def: true },
    { key: 'description', label: 'Description' },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (vs, key) => ({
    name: ui.esc(vs.name),
    domain: vs.domain ? `<span class="font-monospace small">${ui.esc(vs.domain)}</span>` : ui.dash,
    endpoint: `<span class="font-monospace small">${ui.esc(vs.ip_address)}:${vs.port}</span> <span class="badge tag">${ui.esc(vs.protocol)}</span>`,
    provider: vs.provider ? `<span class="badge tag">${ui.esc(vs.provider)}</span>` : ui.dash,
    device: vs.device_name ? ui.esc(vs.device_name) : ui.dash,
    members: vs.members.length ? `<span class="badge tag">${vs.members.length}</span> ` + ui.mono(vs.members.slice(0, 3).map(m => m.server_name + (m.port ? ':' + m.port : '')).concat(vs.members.length > 3 ? ['…'] : [])) : ui.dash,
    description: ui.clip(vs.description),
    updated: ui.date(vs.updated_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Device Management' }, { label: 'Virtual Server' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/device/virtual-server">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name, domain, IP, device, server...',
              filtersId: 'vsFilters', activeFilterCount,
              columns: { tableId: 'vsTable', storageKey: 'openasm.virtualServerList.columns', list: COLUMNS },
              exportUrl: '/device/virtual-server/export' + currentQuery,
              importModal: hasPermission('virtual_server.create') ? 'vsImportModal' : null,
              addUrl: hasPermission('virtual_server.create') ? '/device/virtual-server/add' : null, addLabel: 'Add Virtual Server' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="vsFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label small"><%= t('Protocol') %></label>
                <select name="protocol" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                  <option value=""></option>
                  <% (protocolOptions || []).forEach(function (p) { %>
                    <option value="<%= p %>" <%= f.protocol === p ? 'selected' : '' %>><%= p %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Provider') %></label>
                <select name="provider" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                  <option value=""></option>
                  <% (providerOptions || []).forEach(function (p) { %>
                    <option value="<%= p %>" <%= f.provider === p ? 'selected' : '' %>><%= p %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Device') %></label>
                <select name="device_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"
                        data-ajax-url="/device/api/device" data-ids-url="/device/api/device/ids" data-selected='<%= JSON.stringify(f.device_id ? [f.device_id] : []) %>'></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="vsTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (vsList && vsList.length) { %>
              <% vsList.forEach(function (vs, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(vs, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showVsDetail(this)" data-record='<%= JSON.stringify(vs) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('virtual_server.update')) { %>
                        <a href="/device/virtual-server/<%= vs.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('virtual_server.delete')) { %>
                        <form action="/device/virtual-server/<%= vs.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: vs.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-hdd-network', message: 'No virtual servers found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/device/virtual-server',
                      actionUrl: hasPermission('virtual_server.create') ? '/device/virtual-server/add' : null, actionLabel: 'Add Virtual Server' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (vsList || []).length, summary: 'Showing {1} - {2} of {3} virtual servers' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'vsDetailModal' }) %>
<% if (hasPermission('virtual_server.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'vsImportModal', title: 'Import Virtual Servers', baseUrl: '/device/virtual-server',
        instructions: ['IP address and port are required', 'Device and backend servers are looked up by exact name', 'Backend format: server_name:port, comma-separated'] }) %>
<% } %>

<script>
  function showVsDetail(button) {
    const vs = DV.record(button);
    if (!vs) return;
    let body = DV.section('Overview', DV.rows(
      DV.multiline(vs.description) ? DV.field('Description', DV.multiline(vs.description)) : '',
      DV.field('Domain', DV.text(vs.domain)),
      DV.field('Provider', vs.provider ? DV.chips([vs.provider]) : ''),
      DV.field('IP Address', DV.text(vs.ip_address)),
      DV.field('Port', DV.text(vs.port)),
      DV.field('Protocol', DV.chips([vs.protocol])),
      DV.field('Device', DV.text(vs.device_name))
    ));
    const members = vs.members || [];
    if (members.length) {
      const rows = members.map(m =>
        `<tr><td>${DV.esc(m.server_name)}</td><td>${m.port || ''}</td><td>${m.weight || 1}</td><td><span class="badge tag">${DV.esc(m.status || 'active')}</span></td></tr>`
      ).join('');
      body += DV.section('Backend Servers',
        `<table class="table table-sm mb-0"><thead><tr><th>${t('Server')}</th><th>${t('Port')}</th><th>${t('Weight')}</th><th>${t('Status')}</th></tr></thead><tbody>${rows}</tbody></table>`,
        ' <span class="badge tag ms-1">' + members.length + '</span>');
    }
    body += DV.meta(vs);
    DV.open('vsDetailModal', { title: vs.name, subtitle: vs.domain ? '<span class="font-monospace small">' + DV.esc(vs.domain) + '</span>' : '', body });
  }
</script>
