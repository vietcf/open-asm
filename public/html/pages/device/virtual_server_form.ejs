<%#
  Add / Edit Virtual Server.  mode: 'add' | 'edit', vs, providerOptions, protocolOptions, statusOptions,
  selected: { device [{id, text}], members [{id, text, port, weight, status}] }
  Provider accepts new values (typed).
%>
<% const isEdit = mode === 'edit'; const v = vs || {}; const sel = selected || {}; %>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'Device Management' }, { label: 'Virtual Server', href: '/device/virtual-server' }, { label: isEdit ? 'Edit Virtual Server' : 'Add Virtual Server' }
] }) %>

<div class="app-content">
  <div class="container-fluid">
    <form id="vsForm" class="card form-card" method="POST" action="<%= isEdit ? '/device/virtual-server/' + v.id + '/edit' : '/device/virtual-server/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit Virtual Server' : 'Add Virtual Server') %></h3>
      </div>
      <div class="card-body">
        <section class="form-section">
          <h4 class="form-section-title"><%= t('General information') %></h4>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-name"><%= t('Name') %></label>
              <input type="text" id="f-name" name="name" class="form-control" value="<%= v.name || '' %>" maxlength="255" placeholder="<%= t('Auto-generated from domain:port if empty') %>">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-domain"><%= t('Domain') %></label>
              <input type="text" id="f-domain" name="domain" class="form-control" value="<%= v.domain || '' %>" maxlength="255" placeholder="<%= t('e.g. app.example.com') %>">
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f-ip"><%= t('IP Address') %> <span class="text-danger">*</span></label>
              <input type="text" id="f-ip" name="ip_address" class="form-control" value="<%= v.ip_address || '' %>" maxlength="45" placeholder="<%= t('Origin / VIP IP') %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f-port"><%= t('Port') %> <span class="text-danger">*</span></label>
              <input type="number" id="f-port" name="port" class="form-control" value="<%= v.port || '' %>" min="1" max="65535" placeholder="443" required>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f-protocol"><%= t('Protocol') %> <span class="text-danger">*</span></label>
              <select id="f-protocol" name="protocol" class="form-select" required>
                <% (protocolOptions || []).forEach(function (p) { %>
                  <option value="<%= p %>" <%= (v.protocol || 'HTTPS') === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-provider"><%= t('Provider') %></label>
              <select id="f-provider" name="provider" class="form-select js-select" data-tags="true" data-ajax-url="/device/api/provider"
                      data-placeholder="<%= t('e.g. Akamai, Cloudflare, direct') %>"
                      data-selected="<%= JSON.stringify(v.provider ? [{ id: v.provider, text: v.provider }] : []) %>"></select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-device"><%= t('Device') %></label>
              <select id="f-device" name="device_id" class="form-select js-select" data-ajax-url="/device/api/device"
                      data-placeholder="<%= t('Select LB / Proxy device') %>" data-selected="<%= JSON.stringify(sel.device || []) %>"></select>
            </div>
            <div class="col-12">
              <label class="form-label" for="f-description"><%= t('Description') %></label>
              <textarea id="f-description" name="description" class="form-control" rows="3" placeholder="<%= t('Enter description') %>"><%= v.description || '' %></textarea>
            </div>
          </div>
        </section>

        <section class="form-section" data-repeater id="vsMembers">
          <h4 class="form-section-title"><%= t('Backend Servers') %></h4>
          <div class="vstack gap-2" data-repeater-rows>
            <% (sel.members || []).forEach(function (m) { %>
              <div class="d-flex gap-2 align-items-start">
                <select name="server_id" class="form-select js-select" data-ajax-url="/server/api/server" data-placeholder="<%= t('Select server') %>"
                        data-selected="<%= JSON.stringify([{ id: m.id, text: m.text }]) %>" style="flex:3"></select>
                <input type="number" name="member_port" class="form-control" value="<%= m.port || '' %>" min="1" max="65535" placeholder="<%= t('Port') %>" style="flex:1">
                <input type="number" name="member_weight" class="form-control" value="<%= m.weight || 1 %>" min="0" max="256" placeholder="<%= t('Weight') %>" style="flex:1">
                <select name="member_status" class="form-select" style="flex:1">
                  <% statusOptions.forEach(function (s) { %>
                    <option value="<%= s %>" <%= (m.status || 'active') === s ? 'selected' : '' %>><%= t(s.charAt(0).toUpperCase() + s.slice(1)) %></option>
                  <% }) %>
                </select>
                <button type="button" class="btn btn-outline-secondary" data-repeater-remove title="<%= t('Remove') %>"><i class="bi bi-x-lg"></i></button>
              </div>
            <% }) %>
          </div>
          <template data-repeater-template>
            <div class="d-flex gap-2 align-items-start">
              <select name="server_id" class="form-select js-select" data-ajax-url="/server/api/server" data-placeholder="<%= t('Select server') %>" style="flex:3"></select>
              <input type="number" name="member_port" class="form-control" min="1" max="65535" placeholder="<%= t('Port') %>" style="flex:1">
              <input type="number" name="member_weight" class="form-control" value="1" min="0" max="256" placeholder="<%= t('Weight') %>" style="flex:1">
              <select name="member_status" class="form-select" style="flex:1">
                <% statusOptions.forEach(function (s) { %>
                  <option value="<%= s %>"><%= t(s.charAt(0).toUpperCase() + s.slice(1)) %></option>
                <% }) %>
              </select>
              <button type="button" class="btn btn-outline-secondary" data-repeater-remove title="<%= t('Remove') %>"><i class="bi bi-x-lg"></i></button>
            </div>
          </template>
          <div class="mt-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-repeater-add><i class="bi bi-plus-lg"></i> <%= t('Add server') %></button>
          </div>
        </section>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/device/virtual-server', submitLabel: isEdit ? 'Save Changes' : 'Add Virtual Server' }) %>
    </form>
  </div>
</div>
