// Handle validate button click
console.log('Binding validate button click handler');
$(document).on('click', '#validateDeviceBtn', function() {
  console.log('Validate button clicked');
  console.log('Selected file:', selectedDeviceFile);
  
  if (!selectedDeviceFile) {
    console.log('No file selected, showing alert');
    alert('Please select a file first');
    return;
  }
  
  console.log('Creating FormData with file:', selectedDeviceFile.name);
  const formData = new FormData();
  formData.append('file', selectedDeviceFile);
  
  // Show progress
  console.log('Showing progress bar');
  $('#deviceImportProgress').show();
  $('#deviceImportResults').text('Validating file...');
  $('.progress-bar').css('width', '30%');
  
  console.log('Starting AJAX request to:', '/device/device/validate-import');
  $.ajax({
    url: '/device/device/validate-import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      console.log('Creating XHR with blob response type');
      const xhr = new window.XMLHttpRequest();
      xhr.responseType = 'blob'; // Important for file download
      return xhr;
    },
    success: function(data, status, xhr) {
      console.log('AJAX success - Validation completed');
      console.log('Response status:', status);
      console.log('Response data type:', typeof data);
      console.log('Response data size:', data ? data.size : 'no data');
      
      $('#deviceImportProgress .progress-bar').css('width', '100%').text('Validation Complete');
      
      // Handle file download
      const contentType = xhr.getResponseHeader('Content-Type');
      const contentDisposition = xhr.getResponseHeader('Content-Disposition');
      console.log('Content-Type:', contentType);
      console.log('Content-Disposition:', contentDisposition);
      
      if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
        // Create blob link and trigger download
        const blob = new Blob([data], { type: contentType });
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        
        // Extract filename from Content-Disposition header
        let filename = 'device_validation_results.xlsx';
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(/filename="(.+)"/);
          if (filenameMatch) {
            filename = filenameMatch[1];
          }
        }
        
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.URL.revokeObjectURL(url);
        
        // Show success message
        const resultsDiv = $('#deviceImportResults');
        resultsDiv.removeClass('alert-danger').addClass('alert-success')
          .html(`<strong>Validation Complete!</strong><br>
                 <small>Validation file downloaded. Review results before importing.</small>`);
        resultsDiv.show();
        
        // Try to get validation summary from response headers
        try {
          const summaryHeader = xhr.getResponseHeader('X-Validation-Summary');
          console.log('Raw validation summary header:', summaryHeader);
          
          if (summaryHeader) {
            const summary = JSON.parse(summaryHeader);
            console.log('Parsed validation summary:', summary);
            
            // Show import button if validation passed
            if (summary.allPassed) {
              console.log('All validation passed, showing import button');
              $('#importDeviceBtn').show();
            } else {
              console.log('Some validation failed, not showing import button');
            }
          } else {
            console.log('No validation summary header found, using fallback');
            // Fallback if header parsing fails
            const resultsDiv = $('#deviceImportResults');
            resultsDiv.removeClass('alert-danger').addClass('alert-success')
              .html(`<strong>Validation Complete!</strong><br>
                     <small>Validation file downloaded. Review results before importing.</small>`);
            resultsDiv.show();
            $('#importDeviceBtn').show();
          }
        } catch (e) {
          console.error('Error parsing validation summary header:', e);
          // Fallback if header parsing fails
          const resultsDiv = $('#deviceImportResults');
          resultsDiv.removeClass('alert-danger').addClass('alert-success')
            .html(`<strong>Validation Complete!</strong><br>
                   <small>Validation file downloaded. Review results before importing.</small>`);
          resultsDiv.show();
          $('#importDeviceBtn').show();
        }
      }
    },
    error: function(xhr, status, error) {
      console.error('AJAX error - Device validation failed');
      console.error('XHR object:', xhr);
      console.error('Status:', status);
      console.error('Error:', error);
      console.error('Response status:', xhr.status);
      console.error('Response text:', xhr.responseText);
      console.error('Response JSON:', xhr.responseJSON);
      
      $('.progress-bar').css('width', '100%').text('Validation Failed');
      
      let errorMessage = 'Unknown error occurred';
      try {
        // Try to parse JSON response
        if (xhr.responseJSON && xhr.responseJSON.error) {
          errorMessage = xhr.responseJSON.error;
        } else if (xhr.responseText && typeof xhr.responseText === 'string') {
          errorMessage = xhr.responseText;
        } else if (xhr.response && typeof xhr.response === 'string') {
          errorMessage = xhr.response;
        }
      } catch (e) {
        console.error('Error parsing error response:', e);
      }
      
      const resultsDiv = $('#deviceImportResults');
      resultsDiv.removeClass('alert-success').addClass('alert-danger')
        .html(`<strong>Validation Failed!</strong><br>${errorMessage}`);
      resultsDiv.show();
    },
    complete: function() {
      console.log('AJAX complete - Validation request finished');
      $('#validateDeviceBtn').prop('disabled', false);
      setTimeout(() => {
        console.log('Hiding progress bar');
        $('#deviceImportProgress').hide();
      }, 2000);
    }
  });
});

