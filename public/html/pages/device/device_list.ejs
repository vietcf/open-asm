<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  // Add status filter if exists
  if (typeof filterStatus !== 'undefined' && filterStatus) {
    params.set('status', filterStatus);
  }
  
  // Add type filter if exists
  if (typeof filterType !== 'undefined' && filterType) {
    params.set('type', filterType);
  }
  
  // Add location filter if exists
  if (typeof filterLocation !== 'undefined' && filterLocation) {
    params.set('location', filterLocation);
  }
  
  return '?' + params.toString();
}

// Helper function to build export URL with all query parameters
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add device_type_id filter if exists
  if (typeof device_type_id !== 'undefined' && device_type_id) {
    params.set('device_type_id', device_type_id);
  }
  
  // Add tags filter if exists
  if (typeof tags !== 'undefined' && tags && tags.length > 0) {
    tags.forEach(tag => params.append('tags[]', tag));
  }
  
  // Add platform_id filter if exists
  if (typeof platform_id !== 'undefined' && platform_id) {
    params.set('platform_id', platform_id);
  }
  
  // Add location filter if exists
  if (typeof location !== 'undefined' && location) {
    params.set('location', location);
  }
  
  // Add manufacturer filter if exists
  if (typeof manufacturer !== 'undefined' && manufacturer) {
    params.set('manufacturer', manufacturer);
  }
  
  // Add device_role filter if exists
  if (typeof device_role !== 'undefined' && device_role) {
    params.set('device_role', device_role);
  }
  
  return '/device/device/export' + (params.toString() ? '?' + params.toString() : '');
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Device List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/device/device">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            <% if (typeof filterStatus !== 'undefined' && filterStatus) { %>
              <input type="hidden" name="status" value="<%= filterStatus %>">
            <% } %>
            <% if (typeof filterType !== 'undefined' && filterType) { %>
              <input type="hidden" name="type" value="<%= filterType %>">
            <% } %>
            <% if (typeof filterLocation !== 'undefined' && filterLocation) { %>
              <input type="hidden" name="location" value="<%= filterLocation %>">
            <% } %>
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Device Name..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('device.create')) { %>
            <a href="/device/device/add" class="btn btn-primary btn-sm">
              <i class="bi bi-plus"></i> Add Device
            </a>
          <% } %>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#filterDeviceModal">
            <i class="bi bi-funnel"></i> Filter
          </button>
          <% if (hasPermission && hasPermission('device.read')) { %>
            <a href="<%= buildExportUrl() %>" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> Export
            </a>
          <% } %>
          <% if (hasPermission && hasPermission('device.create')) { %>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#importDeviceModal">
              <i class="bi bi-upload"></i> Import Device
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Filter values for JS -->
    <div id="filter-device-data"
         data-device-type-id='<%= typeof device_type_id !== 'undefined' ? device_type_id : '' %>'
         data-tags='<%= JSON.stringify(selectedTags || []) %>'
         data-platform-id='<%= typeof platform_id !== 'undefined' ? platform_id : '' %>'
         data-location='<%= typeof location !== 'undefined' ? location : '' %>'
         data-manufacturer='<%= typeof manufacturer !== 'undefined' ? manufacturer : '' %>'
         data-device-role='<%= typeof device_role !== 'undefined' ? device_role : '' %>'
         style="display:none"></div>
    
    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- DEVICE LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Device List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Device List</h3>
          </div>
          <div class="card-body table-responsive" style="overflow-x: auto;">
            <table class="table table-hover" id="deviceTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Device Name</th>
                  <th>Description</th>
                  <th>Device Type</th>
                  <th>Location</th>
                  <th>IP Address(es)</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (deviceList && deviceList.length > 0) { %>
                  <% deviceList.forEach(function(device, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= device.name %></td>
                      <td>
                        <%
                          const cleanDescription = (device.description || '-').trim();
                          const shortDescription = cleanDescription.length > 50 ? cleanDescription.substring(0, 50) + '…' : cleanDescription;
                        %>
                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="<%= cleanDescription %>" style="cursor: help; word-break: break-word;"><%= shortDescription %></span>
                      </td>
                      <td><%= device.device_type_name || '-' %></td>
                      <td><%= device.location || '-' %></td>
                      <td>
                        <% if (device.ip_addresses && device.ip_addresses.length > 0) { %>
                          <% device.ip_addresses.slice(0, 3).forEach(function(ip, index) { %>
                            <%= ip.ip_address %><% if (index < Math.min(device.ip_addresses.length, 3) - 1) { %>, <% } %>
                          <% }) %>
                          <% if (device.ip_addresses.length > 3) { %>
                            <br><small class="text-muted">+<%= device.ip_addresses.length - 3 %> more</small>
                          <% } %>
                        <% } else { %>
                          -
                        <% } %>
                      </td>
                      <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm" title="Show" onclick="showDeviceDetail('<%= device.id %>')" data-device='<%= JSON.stringify(device) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        <% if (hasPermission('device.update')) { %>
                          <a href="/device/device/edit/<%= device.id %>" class="btn btn-warning btn-sm" title="Edit">
                            <i class="bi bi-pencil"></i>
                          </a>
                        <% } %>
                        <% if (hasPermission('device.delete')) { %>
                          <form action="/device/device/<%= device.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteDevice(this, '<%= device.name %>')">
                            <input type="hidden" name="delete_ip" value="false">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="7" class="text-center">No devices found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range
                  const deviceStartItem = (page - 1) * pageSize + 1;
                  const deviceEndItem = Math.min(page * pageSize, totalCount || 0);
                  const deviceStartPage = Math.max(1, page - 2);
                  const deviceEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= deviceStartItem %> - <%= deviceEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> devices</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildDeviceFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    if (typeof filterStatus !== 'undefined' && filterStatus) params.push('status=' + encodeURIComponent(filterStatus));
                    if (typeof filterType !== 'undefined' && filterType) params.push('type=' + encodeURIComponent(filterType));
                    if (typeof filterLocation !== 'undefined' && filterLocation) params.push('location=' + encodeURIComponent(filterLocation));
                    return params.join('&');
                  }
                  const deviceFilterQuery = buildDeviceFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= deviceFilterQuery ? '&' + deviceFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (deviceStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= deviceFilterQuery ? '&' + deviceFilterQuery : '' %>">1</a></li>
                  <% if (deviceStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = deviceStartPage; i <= deviceEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= deviceFilterQuery ? '&' + deviceFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (deviceEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= deviceFilterQuery ? '&' + deviceFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= deviceFilterQuery ? '&' + deviceFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODALS SECTION -->
<!-- ========================================== -->

<!-- Device Detail Modal -->
<div class="modal fade" id="deviceDetailModal" tabindex="-1" aria-labelledby="deviceDetailModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deviceDetailModalLabel">Device Detail</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="deviceDetailContent">
        <!-- Content will be loaded here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete Device Modal -->
<div class="modal fade" id="deleteDeviceModal" tabindex="-1" aria-labelledby="deleteDeviceModalLabel">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteDeviceModalLabel">Delete Device</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete the device <strong id="deleteDeviceName"></strong>?</p>
        <p class="mb-2">What should happen to its IP address(es)?</p>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="deleteDeviceIpChoice" id="deleteDeviceIpReserve" value="false" checked>
          <label class="form-check-label" for="deleteDeviceIpReserve">
            Release IP(s) back to <strong>Reserved</strong> status (default)
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="deleteDeviceIpChoice" id="deleteDeviceIpDelete" value="true">
          <label class="form-check-label" for="deleteDeviceIpDelete">
            Delete the IP address(es) permanently
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm" id="deleteDeviceConfirmBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- Filter Device Modal -->
<div class="modal fade" id="filterDeviceModal" tabindex="-1" aria-labelledby="filterDeviceModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filterDeviceModalLabel">Filter Devices</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="GET" action="/device/device" id="filterDeviceForm">
        <input type="hidden" name="page" value="1">
        <% if (typeof pageSize !== 'undefined' && pageSize) { %>
          <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <% } %>
        <div class="modal-body">
          <div class="row g-2">
            <!-- Device Type Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Device Type</label>
              <select id="filterDeviceTypeId" name="device_type_id" class="form-control">
                <option value="">All Device Types</option>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
            <!-- Tags Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Tags</label>
              <select id="filterDeviceTags" name="tags[]" class="form-control" multiple></select>
            </div>
            
            <!-- Platform Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Platform</label>
              <select id="filterDevicePlatform" name="platform_id" class="form-control">
                <option value="">All Platforms</option>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
            <!-- Location Filter -->
            <div class="col-12 mb-2">
              <label for="filterDeviceLocation" class="form-label">Location</label>
              <select class="form-control" id="filterDeviceLocation" name="location">
                <option value="">All Locations</option>
                <% if (typeof locationOptions !== 'undefined' && locationOptions.length > 0) { %>
                  <% locationOptions.forEach(function(option) { %>
                    <option value="<%= option.value %>" <%= (typeof location !== 'undefined' && location === option.value) ? 'selected' : '' %>><%= option.label %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
            
            <!-- Manufacturer Filter -->
            <div class="col-12 mb-2">
              <label for="filterDeviceManufacturer" class="form-label">Manufacturer</label>
              <select id="filterDeviceManufacturer" name="manufacturer" class="form-control">
                <option value="">All Manufacturers</option>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
            <!-- Device Role Filter -->
            <div class="col-12 mb-2">
              <label for="filterDeviceRole" class="form-label">Device Role</label>
              <select id="filterDeviceRole" name="device_role" class="form-control">
                <option value="">All Device Roles</option>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-outline-danger" id="clearFilterBtnDevice" data-bs-dismiss="modal">Clear All Filters</button>
          <div>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Import Device Modal -->
<div class="modal fade" id="importDeviceModal" tabindex="-1" aria-labelledby="importDeviceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importDeviceModalLabel">Import Devices</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="importDeviceForm" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="deviceImportFile" class="form-label">Select File <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="file" class="form-control" id="deviceImportFile" name="file" accept=".csv,.xlsx,.xls" required>
              <a href="/device/device/template" class="btn btn-outline-info" download>
                <i class="bi bi-download"></i> Download Template
              </a>
            </div>
            <div class="form-text">Supported formats: CSV, Excel (.xlsx, .xls). Maximum file size: 10MB</div>
          </div>
          
          <div class="mb-3">
            <div class="alert alert-info">
              <h6><i class="bi bi-info-circle"></i> Import Instructions:</h6>
              <ul class="mb-0">
                <li>Click "Download Template" to get the Excel template with correct format</li>
                <li>Fill the template with your device data</li>
                <li><strong>Required fields:</strong> IP Address, Device Type</li>
                <li><strong>Optional fields:</strong> Name (auto-generated if empty), Platform, Location, Serial Number, Management Address, Manufacturer, Device Role, Manager, Tags, Description</li>
                <li>Select your filled template file and validate before importing</li>
              </ul>
            </div>
          </div>
          
          <!-- Progress bar -->
          <div id="deviceImportProgress" class="progress mb-3" style="display: none;">
            <div class="progress-bar" role="progressbar" style="width: 0%"></div>
          </div>
          
          <!-- Results display -->
          <div id="deviceImportResults" class="alert" style="display: none;"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning btn-sm" id="validateDeviceBtn">Validate File</button>
        <button type="button" class="btn btn-success btn-sm" id="importDeviceBtn" style="display: none;">Import Devices</button>
      </div>
    </div>
  </div>
</div>

<script>
// ==========================================
// JAVASCRIPT FUNCTIONS
// ==========================================

// Show device detail
function showDeviceDetail(deviceId) {
  const buttons = document.querySelectorAll('button[data-device]');
  let targetButton = null;
  
  for (let button of buttons) {
    const data = button.getAttribute('data-device');
    if (data) {
      try {
        const device = JSON.parse(data);
        if (device.id == deviceId) {
          targetButton = button;
          break;
        }
      } catch (e) {
        console.error('Error parsing device data:', e);
      }
    }
  }
  
  if (!targetButton) {
    alert('Device data not found');
    return;
  }
  
  const deviceData = targetButton.getAttribute('data-device');
  let device;
  try {
    device = JSON.parse(deviceData);
  } catch (e) {
    alert('Error parsing device data: ' + e.message);
    return;
  }
  
  const modalElement = document.getElementById('deviceDetailModal');
  const modal = new bootstrap.Modal(modalElement);
  const content = document.getElementById('deviceDetailContent');
  
  let html = '<dl class="row detail-dl">';
  html += '<dt class="col-sm-4">Device Name</dt><dd class="col-sm-8">' + String(device.name || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Type</dt><dd class="col-sm-8">' + String(device.device_type_name || device.type || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Location</dt><dd class="col-sm-8">' + String(device.location || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Platform (OS)</dt><dd class="col-sm-8">' + String(device.platform_name || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Serial Number</dt><dd class="col-sm-8">' + String(device.serial_number || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Manufacturer</dt><dd class="col-sm-8">' + String(device.manufacturer || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Device Role</dt><dd class="col-sm-8">' + String(device.device_role || 'N/A').trim() + '</dd>';

  html += '<dt class="col-sm-4">IP Addresses</dt><dd class="col-sm-8">';
  if (device.ip_addresses && device.ip_addresses.length > 0) {
    html += '<ul class="mb-0 ps-3">';
    device.ip_addresses.forEach(function(ip) {
      const ipValue = (typeof ip === 'string' ? ip : ip.ip_address);
      const searchUrl = '/network/ip-address?page=1&search=' + encodeURIComponent(ipValue);
      html += '<li><a href="' + searchUrl + '" class="text-primary text-decoration-underline">' + String(ipValue).trim() + '</a></li>';
    });
    html += '</ul>';
  } else {
    html += 'N/A';
  }
  html += '</dd>';

  html += '<dt class="col-sm-4">Management Address</dt><dd class="col-sm-8">';
  if (device.management_address && device.management_address.trim() !== '') {
    const managementAddresses = device.management_address.split(',').map(addr => addr.trim()).filter(addr => addr);
    if (managementAddresses.length > 1) {
      html += '<ul class="mb-0 ps-3">';
      managementAddresses.forEach(function(addr) {
        html += '<li>' + String(addr).trim() + '</li>';
      });
      html += '</ul>';
    } else {
      html += String(device.management_address).trim();
    }
  } else {
    html += 'N/A';
  }
  html += '</dd>';

  if (device.contacts && device.contacts.length > 0) {
    html += '<dt class="col-sm-4">Managers</dt><dd class="col-sm-8"><ul class="mb-0 ps-3">';
    device.contacts.forEach(function(manager) {
      const managerName = (typeof manager === 'string' ? manager : manager.name);
      const managerEmail = (typeof manager === 'string' ? '' : manager.email);
      const searchUrl = '/organize/contact?page=1&search=' + encodeURIComponent(managerName);
      html += '<li><a href="' + searchUrl + '" class="text-primary text-decoration-underline">' + String(managerName).trim();
      if (managerEmail) {
        html += ' (' + String(managerEmail).trim() + ')';
      }
      html += '</a></li>';
    });
    html += '</ul></dd>';
  }

  if (device.tags && device.tags.length > 0) {
    html += '<dt class="col-sm-4">Tags</dt><dd class="col-sm-8">';
    device.tags.forEach(function(tag) {
      const tagValue = (typeof tag === 'string' ? tag : tag.name);
      html += '<span class="badge bg-primary me-1 mb-1">' + String(tagValue).trim() + '</span>';
    });
    html += '</dd>';
  }

  html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8"><pre class="mb-0" style="white-space: pre-wrap; font-family: inherit; background: none; border: none; padding: 0;">' + String(device.description || 'N/A').trim() + '</pre></dd>';
  html += '</dl>';
  content.innerHTML = html;
  modal.show();
}

