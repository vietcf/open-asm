<%
  const f = filter;
  const activeFilterCount = [f.device_type_id, f.platform_id, f.location, f.manufacturer, f.device_role, f.tags.length].filter(Boolean).length;
  const COLUMNS = [
    { key: 'name', label: 'Device Name', def: true, fixed: true },
    { key: 'type', label: 'Device Type', def: true },
    { key: 'ips', label: 'IP Address(es)', def: true },
    { key: 'location', label: 'Location', def: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'platform', label: 'Platform' },
    { key: 'manufacturer', label: 'Manufacturer' },
    { key: 'role', label: 'Device Role' },
    { key: 'serial', label: 'Serial Number' },
    { key: 'management', label: 'Management Address' },
    { key: 'managers', label: 'Managers' },
    { key: 'tags', label: 'Tags' },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (d, key) => ({
    name: ui.esc(d.name),
    type: d.device_type_name ? `<span class="badge tag">${ui.esc(d.device_type_name)}</span>` : ui.dash,
    ips: ui.mono(d.ip_addresses.map(ip => ip.ip_address + (ip.role === 'vip' ? ' (VIP)' : ''))),
    location: d.location ? ui.esc(ui.optionLabel(locationOptions, d.location)) : ui.dash,
    description: ui.clip(d.description),
    platform: ui.text(d.platform_name),
    manufacturer: ui.text(d.manufacturer),
    role: ui.text(d.device_role),
    serial: d.serial_number ? `<span class="font-monospace small">${ui.esc(d.serial_number)}</span>` : ui.dash,
    management: ui.mono(d.management_address ? [d.management_address] : []),
    managers: ui.text((d.contacts || []).map(c => c.name).join(', ')),
    tags: ui.chips((d.tags || []).map(tg => tg.name)),
    updated: ui.date(d.updated_at),
  })[key];
  const oneId = (v) => JSON.stringify(v ? [v] : []);
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Device Management' }, { label: 'Device List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/device/device">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name, IP, serial, manufacturer...',
              filtersId: 'deviceFilters', activeFilterCount,
              columns: { tableId: 'deviceTable', storageKey: 'openasm.deviceList.columns', list: COLUMNS },
              exportUrl: '/device/device/export' + currentQuery,
              importModal: hasPermission('device.create') ? 'deviceImportModal' : null,
              addUrl: hasPermission('device.create') ? '/device/device/add' : null, addLabel: 'Add Device' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="deviceFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-4 col-xl-3">
                <label class="form-label small"><%= t('Device Type') %></label>
                <select name="device_type_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(deviceTypeOptions, f.device_type_id) %></select>
              </div>
              <div class="col-md-4 col-xl-3">
                <label class="form-label small"><%= t('Platform') %></label>
                <select name="platform_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(platformOptions, f.platform_id) %></select>
              </div>
              <div class="col-md-4 col-xl-3">
                <label class="form-label small"><%= t('Location') %></label>
                <select name="location" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                  <option value=""></option>
                  <% (locationOptions || []).forEach(function (o) { %>
                    <option value="<%= o.id %>" <%= f.location === o.id ? 'selected' : '' %>><%= o.text %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4 col-xl-3">
                <label class="form-label small"><%= t('Manufacturer') %></label>
                <input type="text" name="manufacturer" class="form-control" value="<%= f.manufacturer %>" placeholder="<%= t('All') %>">
              </div>
              <div class="col-md-4 col-xl-3">
                <label class="form-label small"><%= t('Device Role') %></label>
                <input type="text" name="device_role" class="form-control" value="<%= f.device_role %>" placeholder="<%= t('All') %>">
              </div>
              <div class="col-md-8 col-xl-6">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(tagOptions, f.tags) %></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="deviceTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (deviceList && deviceList.length) { %>
              <% deviceList.forEach(function (device, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(device, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showDeviceDetail(this)" data-record='<%= JSON.stringify(device) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('device.update')) { %>
                        <a href="/device/device/<%= device.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('device.delete')) { %>
                        <form action="/device/device/<%= device.id %>/delete" method="POST" data-delete-ip="<%= device.name %>">
                          <input type="hidden" name="delete_ip" value="false">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-router', message: 'No devices found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/device/device',
                      actionUrl: hasPermission('device.create') ? '/device/device/add' : null, actionLabel: 'Add Device' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (deviceList || []).length, summary: 'Showing {1} - {2} of {3} devices' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'deviceDetailModal', pentestType: 'device' }) %>
<%- include('../../partials/ui/pentest_quick_view') %>
<%- include('../../partials/ui/delete_ip_modal') %>
<% if (hasPermission('device.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'deviceImportModal', title: 'Import Devices', baseUrl: '/device/device',
        instructions: ['IP addresses and device type are required; unknown IPs are created as Reserved and assigned to the device', 'Device type, platform, managers (email) and tags must already exist', 'A row whose name or IP is already used is skipped'] }) %>
<% } %>

<script>
  const LOCATION_OPTIONS = <%- jsonSafe(locationOptions || []) %>;

  function showDeviceDetail(button) {
    const d = DV.record(button);
    if (!d) return;
    const ips = d.ip_addresses || [];
    let body = DV.section('Overview', DV.rows(
      DV.multiline(d.description) ? DV.field('Description', DV.multiline(d.description)) : '',
      DV.field('Device Type', DV.text(d.device_type_name)),
      DV.field('Platform', DV.text(d.platform_name)),
      DV.field('Manufacturer', DV.text(d.manufacturer)),
      DV.field('Device Role', DV.text(d.device_role)),
      DV.field('Serial Number', DV.text(d.serial_number)),
      DV.field('Location', DV.text(d.location ? DV.optionLabel(LOCATION_OPTIONS, d.location) : '')),
      DV.field('Tags', DV.chips((d.tags || []).map((tg) => tg.name))),
      DV.field('Managers', DV.contacts(d.contacts))
    ));
    body += DV.section('Network', DV.rows(
      DV.field('Management Address', DV.text(d.management_address)),
      DV.field('IP Addresses', DV.ipLinks(ips.filter((ip) => ip.role !== 'vip'))),
      DV.field('VIP IP Address(es)', DV.ipLinks(ips.filter((ip) => ip.role === 'vip')))
    ), ' <span class="badge tag ms-1">' + ips.length + '</span>');
    body += DV.meta(d);
    DV.open('deviceDetailModal', {
      title: d.name,
      subtitle: d.device_type_name ? '<span class="badge tag">' + DV.esc(d.device_type_name) + '</span>' : '',
      body,
      recordId: d.id,
    });
  }
</script>
