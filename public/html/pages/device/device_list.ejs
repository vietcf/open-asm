function loadFilterExistingValues() {
  console.log('Loading existing filter values...');
  
  // Get filter data from hidden div
  const filterDataEl = document.getElementById('filter-device-data');
  if (!filterDataEl) {
    console.log('Filter data element not found');
    return;
  }
  
  try {
    const filterDeviceTypeId = filterDataEl.dataset.deviceTypeId || '';
    const filterTags = JSON.parse(filterDataEl.dataset.tags || '[]');
    const filterPlatformId = filterDataEl.dataset.platformId || '';
    const filterLocation = filterDataEl.dataset.location || '';
    const filterManufacturer = filterDataEl.dataset.manufacturer || '';
    const filterDeviceRole = filterDataEl.dataset.deviceRole || '';
    
    console.log('Filter data:', { filterDeviceTypeId, filterTags, filterPlatformId, filterLocation, filterManufacturer, filterDeviceRole });
    
    // Clear existing options first to avoid duplicates
    $('#filterDeviceTags').find('option').remove();
    
    // Load device type from window variables (preferred) or from filter data (backup)
    const deviceTypeToLoad = window.selectedDeviceType || (filterDeviceTypeId ? { id: filterDeviceTypeId, text: filterDeviceTypeId } : null);
    if (deviceTypeToLoad && deviceTypeToLoad.id) {
      console.log('Loading device type:', deviceTypeToLoad);
      // For Select2, we need to fetch the device type data first
      $.ajax({
        url: '/device/api/device-type',
        data: { search: '' },
        success: function(data) {
          const deviceType = data.find(item => item.id == deviceTypeToLoad.id);
          if (deviceType) {
            const option = new Option(deviceType.text, deviceType.id, true, true);
            $('#filterDeviceTypeId').append(option).trigger('change');
          }
        }
      });
    }
    
    // Load tags from window variables (preferred) or from filter data (backup)
    const tagsToLoad = window.selectedTags && window.selectedTags.length > 0 ? window.selectedTags : filterTags;
    if (tagsToLoad && tagsToLoad.length > 0) {
      console.log('Loading tags:', tagsToLoad);
      tagsToLoad.forEach(tag => {
        // Handle both object format {id, name} and simple format
        const tagId = typeof tag === 'object' ? tag.id : tag;
        const tagName = typeof tag === 'object' ? tag.name : tag;
        const option = new Option(tagName, tagId, true, true);
        $('#filterDeviceTags').append(option);
      });
      $('#filterDeviceTags').trigger('change');
    }
    
    // Load platform from window variables (preferred) or from filter data (backup)
    const platformToLoad = window.selectedPlatform || (filterPlatformId ? { id: filterPlatformId, text: filterPlatformId } : null);
    if (platformToLoad && platformToLoad.id) {
      console.log('Loading platform:', platformToLoad);
      $.ajax({
        url: '/device/api/platform',
        data: { search: '' },
        success: function(data) {
          const platform = data.find(item => item.id == platformToLoad.id);
          if (platform) {
            const option = new Option(platform.text, platform.id, true, true);
            $('#filterDevicePlatform').append(option).trigger('change');
          }
        }
      });
    }
    
    // Load simple fields
    if (filterLocation) {
      $('#filterDeviceLocation').val(filterLocation);
    }
    
    // Load Manufacturer (Select2 with tag creation)
    if (filterManufacturer) {
      console.log('Loading manufacturer:', filterManufacturer);
      // For Select2 with tags, we can directly set the value
      const option = new Option(filterManufacturer, filterManufacturer, true, true);
      $('#filterDeviceManufacturer').append(option).trigger('change');
    }
    
    // Load Device Role (Select2 with tag creation)
    if (filterDeviceRole) {
      console.log('Loading device role:', filterDeviceRole);
      // For Select2 with tags, we can directly set the value
      const option = new Option(filterDeviceRole, filterDeviceRole, true, true);
      $('#filterDeviceRole').append(option).trigger('change');
    }
    
  } catch (e) {
    console.error('Error loading filter values:', e);
  }
}

