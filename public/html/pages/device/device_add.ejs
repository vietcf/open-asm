
<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item"><a href="/device/device"><%= t('Device List') %></a></li>
          <li class="breadcrumb-item active"><%= t('Add Device') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<section class="app-content">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10 col-sm-12">
      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><%= t('Add Device') %></h5>
        </div>
        
        <!-- Flash Messages (for error cases only) -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i><%= t(error) %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
          </div>
          <script>
            // Auto-hide error message after 8 seconds (longer for errors)
            setTimeout(function() {
              const alert = document.getElementById('errorAlert');
              if (alert) {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
              }
            }, 8000);
          </script>
        <% } %>
        
        <form action="/device/device" method="POST">
          <div class="card-body">
            <!-- 1. Device Type -->
            <div class="mb-3">
              <label class="form-label"><%= t('Type') %> <span class="text-danger">*</span></label>
              <select name="type" class="form-select" data-placeholder="<%= t('Select type') %>" required>
                <option value="">-- <%= t('Select type --') %></option>
                <% if (typeof typesOptions !== 'undefined' && typesOptions && typesOptions.length > 0) { %>
                  <% typesOptions.forEach(function(tp) { %>
                    <option value="<%= tp.value %>"><%= tp.label %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            
            <!-- 2. IP Address(es) -->
            <div class="mb-3">
              <label class="form-label"><%= t('IP Address(es)') %> <span class="text-danger">*</span></label>
              <div class="d-flex align-items-center gap-2">
                <select id="ip-select" name="ip_addresses[]" class="form-control flex-grow-1" multiple required></select>
                <button type="button" class="btn btn-outline-success btn-sm" id="add-ip-btn" title="<%= t('Add new IP') %>"><i class="bi bi-plus-circle"></i> <%= t('Add IP') %></button>
              </div>
            </div>

            <!-- 3. Device Name -->
            <div class="mb-3">
              <label class="form-label"><%= t('Device Name') %> <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="<%= t('Enter device name') %>" required>
            </div>
            
            <!-- 4. Location -->
            <div class="mb-3">
              <label class="form-label"><%= t('Location') %></label>
              <select name="location" class="form-select" data-placeholder="<%= t('Select location') %>">
                <option value="">-- <%= t('Select location --') %></option>
                <% if (typeof locationOptions !== 'undefined' && locationOptions && locationOptions.length > 0) { %>
                  <% locationOptions.forEach(function(loc) { %>
                    <option value="<%= loc.value %>"><%= loc.label %></option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            
            <!-- 5. Platform (OS) -->
            <div class="mb-3">
              <label class="form-label"><%= t('Platform (OS)') %></label>
              <select id="platform-select" name="os" class="form-select" data-placeholder="<%= t('Select platform') %>"></select>
            </div>
            
            <!-- 6. Serial Number -->
            <div class="mb-3">
              <label class="form-label"><%= t('Serial Number') %></label>
              <input type="text" name="serial_number" class="form-control" placeholder="<%= t('Enter device serial number') %>">
            </div>
            
            <!-- 7. Management Address -->
            <div class="mb-3">
              <label class="form-label"><%= t('Management Address') %></label>
              <input type="text" name="management_address" class="form-control" placeholder="<%= t('Enter management address(es), separated by commas') %>">
              <small class="form-text text-muted"><%= t('Multiple addresses can be separated by commas (e.g., 192.168.1.1, 10.0.0.1)') %></small>
            </div>
            
            <!-- 8. Manufacturer -->
            <div class="mb-3">
              <label class="form-label"><%= t('Manufacturer') %></label>
              <select id="manufacturer-select" name="manufacturer" class="form-select" data-placeholder="<%= t('Select or type manufacturer') %>">
                <option value="">-- <%= t('Select Manufacturer --') %></option>
              </select>
            </div>
            
            <!-- 9. Device Role -->
            <div class="mb-3">
              <label class="form-label"><%= t('Device Role') %></label>
              <select id="device-role-select" name="device_role" class="form-select" data-placeholder="<%= t('Select or type device role') %>">
                <option value="">-- <%= t('Select Device Role --') %></option>
              </select>
            </div>
            
            <!-- 10. Managers -->
            <div class="mb-3">
              <label class="form-label"><%= t('Managers') %></label>
              <select id="manager-select" name="managers[]" class="form-select" multiple data-placeholder="<%= t('Select managers') %>"></select>
            </div>
            
            <!-- 11. Tags -->
            <div class="mb-3">
              <label class="form-label"><%= t('Tags') %></label>
              <select id="tag-select" name="tags[]" class="form-select" multiple data-placeholder="<%= t('Select tags') %>"></select>
            </div>
            
            <!-- 12. Description -->
            <div class="mb-3">
              <label class="form-label"><%= t('Description') %></label>
              <textarea name="description" class="form-control" rows="3" placeholder="<%= t('Device description') %>"></textarea>
            </div>
          </div>
          <div class="card-footer d-flex justify-content-end">
            <a href="/device/device" class="btn btn-secondary btn-sm me-2"><%= t('Cancel') %></a>
            <button type="submit" class="btn btn-primary btn-sm"><%= t('Add Device') %></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
/* Match Add IP Address modal: stack action buttons full-width on mobile,
   with the primary action above Cancel. */
@media (max-width: 991.98px) {
  .card-footer.d-flex.justify-content-end {
    flex-direction: column !important;
    gap: 0.5rem !important;
    align-items: stretch !important;
  }
  .card-footer.d-flex.justify-content-end .btn {
    width: 100% !important;
    margin: 0 !important;
  }
  .card-footer.d-flex.justify-content-end .btn:first-child {
    order: 2 !important;
  }
  .card-footer.d-flex.justify-content-end .btn:last-child {
    order: 1 !important;
  }
}
</style>

<script src="/vendor/jquery-3.6.0.min.js"></script>
<link href="/css/select2.min.css" rel="stylesheet" />
<link href="/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="/vendor/select2.min.js"></script>
<script src="/vendor/bootstrap.min.js"></script>
<link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />

<script>
  $(function() {
    // IP Address select2 AJAX - Bootstrap 5 theme
    $('#ip-select').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select IP address(es)'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/network/api/ip-addresses/unassigned',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      },
      minimumInputLength: 0
    });

    // Manager select2 AJAX - Bootstrap 5 theme
    $('#manager-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#manager-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/organize/api/contact',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });



    // Type select2 - Bootstrap 5 theme
    $('select[name="type"]').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select type'),
      allowClear: true,
      width: '100%'
    });


    // Location select2 - Bootstrap 5 theme
    $('select[name="location"]').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select location'),
      allowClear: true,
      width: '100%'
    });

    // Manufacturer select2 AJAX - Bootstrap 5 theme with tag creation
    $('#manufacturer-select').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select or type manufacturer'),
      allowClear: true,
      width: '100%',
      tags: true,
      createTag: function (params) {
        var term = $.trim(params.term);
        if (term === '') {
          return null;
        }
        return {
          id: term,
          text: term,
          newTag: true
        };
      },
      ajax: {
        url: '/device/api/manufacturer',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Device Role select2 AJAX - Bootstrap 5 theme with tag creation
    $('#device-role-select').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select or type device role'),
      allowClear: true,
      width: '100%',
      tags: true,
      createTag: function (params) {
        var term = $.trim(params.term);
        if (term === '') {
          return null;
        }
        return {
          id: term,
          text: term,
          newTag: true
        };
      },
      ajax: {
        url: '/device/api/device-role',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Platform (OS) select2 AJAX - Bootstrap 5 theme
    $('#platform-select').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select platform (OS)'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/device/api/platform',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Tag select2 AJAX - Bootstrap 5 theme
    $('#tag-select').select2({
      theme: 'bootstrap-5',
      placeholder: $('#tag-select').data('placeholder'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/organize/api/tag',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    // Auto-fill device name if empty when device type and IP are selected, and convert to lowercase
    function autoFillDeviceName() {
      var nameInput = $("input[name='name']");
      var deviceType = $('select[name="type"]').find('option:selected').text() || $('select[name="type"]').select2('data')[0]?.text || '';
      var ipData = $('#ip-select').select2('data');
      var firstIp = ipData && ipData.length > 0 ? ipData[0].text : '';
      if (nameInput.val().trim() === '' && deviceType && firstIp) {
        // Clean device type: remove "-- Select type --" and convert to lowercase
        var cleanDeviceType = deviceType.replace(/^--\s*/, '').replace(/\s*--$/, '').toLowerCase();
        if (cleanDeviceType && cleanDeviceType !== 'select type') {
          var autoName = cleanDeviceType + '_' + firstIp;
          nameInput.val(autoName);
        }
      }
    }
    $('select[name="type"]').on('change', autoFillDeviceName);
    $('#ip-select').on('change', autoFillDeviceName);
    $("input[name='name']").on('input', function() {
      // Always convert to lowercase on manual input
      var val = $(this).val();
      $(this).val(val.toLowerCase());
    });

    // Add IP button: navigate to the Add IP Address page (same tab)
    $('#add-ip-btn').off('click').on('click', function(e) {
      e.preventDefault();
      window.location.href = '/network/ip-address?add=1';
    });

    // Fix: Remove blank <option> after select2 is initialized to avoid select2 placeholder bug
    setTimeout(function() {
      $('#manager-select, #tag-select').each(function() {
        $(this).find('option').filter(function() { return !$(this).val(); }).remove();
      });
    }, 100);
  });
</script>