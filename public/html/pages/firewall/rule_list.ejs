<%
// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  // Add status filter if exists
  if (typeof status !== 'undefined' && status) {
    params.set('status', status);
  }
  
  // Add protocol filter if exists
  if (typeof protocol !== 'undefined' && protocol) {
    params.set('protocol', protocol);
  }
  
  // Add action filter if exists
  if (typeof action !== 'undefined' && action) {
    params.set('action', action);
  }
  
  // Add firewall_name filter if exists
  if (typeof firewall_name !== 'undefined' && firewall_name) {
    params.set('firewall_name', firewall_name);
  }
  
  return '?' + params.toString();
}

// Helper function to build export URL with all query parameters
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add status filter if exists
  if (typeof status !== 'undefined' && status) {
    params.set('status', status);
  }
  
  // Add protocol filter if exists
  if (typeof protocol !== 'undefined' && protocol) {
    params.set('protocol', protocol);
  }
  
  // Add action filter if exists
  if (typeof action !== 'undefined' && action) {
    params.set('action', action);
  }
  
  // Add firewall_name filter if exists
  if (typeof firewall_name !== 'undefined' && firewall_name) {
    params.set('firewall_name', firewall_name);
  }
  
  return '/firewall/rule/export' + (params.toString() ? '?' + params.toString() : '');
}
%>

<!-- Content Header -->
<div class="app-content-header">
<div class="container-fluid">
    <div class="row">
    <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Firewall Rules List</li>
        </ol>
        </div>
        </div>
      </div>
    </div>
  
<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
  <!-- Search and Page Size Row -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/firewall/rule">
          <!-- Hidden inputs to preserve filter values -->
          <input type="hidden" name="page" value="1">
            <% if (typeof status !== 'undefined' && status) { %>
              <input type="hidden" name="status" value="<%= status %>">
      <% } %>
            <% if (typeof protocol !== 'undefined' && protocol) { %>
              <input type="hidden" name="protocol" value="<%= protocol %>">
          <% } %>
            <% if (typeof action !== 'undefined' && action) { %>
              <input type="hidden" name="action" value="<%= action %>">
          <% } %>
            <% if (typeof firewall_name !== 'undefined' && firewall_name) { %>
              <input type="hidden" name="firewall_name" value="<%= firewall_name %>">
          <% } %>
          
          <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search rule name, source, destination..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                    <% }) %>
                  </select>
                </div>
              </form>
            </div>
          </div>
        </div>

    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
        <% if (hasPermission('rule.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addRuleModal">
            <i class="bi bi-plus"></i> Add Rule
          </button>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#importRuleModal">
            <i class="bi bi-upload"></i> Import
          </button>
        <% } %>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#filterRuleModal">
          <i class="bi bi-funnel"></i> Filter
        </button>
          <% if (hasPermission('rule.read')) { %>
            <a href="<%= buildExportUrl() %>" class="btn btn-warning btn-sm">
              <i class="bi bi-download"></i> Export
            </a>
          <% } %>
      </div>
              </div>
                  </div>

    <!-- Filter values for JS -->
  <div id="filter-rule-data"
          data-status='<%= JSON.stringify(typeof status !== "undefined" ? status : '') %>'
          data-protocol='<%= JSON.stringify(typeof protocol !== "undefined" ? protocol : '') %>'
          data-action='<%= JSON.stringify(typeof action !== "undefined" ? action : '') %>'
          data-firewall-name='<%= JSON.stringify(typeof firewall_name !== "undefined" ? firewall_name : '') %>' style="display:none"></div>

  <!-- Flash Messages -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= successMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
      <script>
      // Auto-hide success message after 5 seconds
            setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
      </script>
  <% } %>
  
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

    <!-- Data Table -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0">Firewall Rules List</h3>
        </div>
          <div class="card-body table-responsive p-0" style="max-height: 70vh; overflow-y: auto; overflow-x: auto;">
            <table class="table table-hover" style="table-layout: fixed; min-width: 800px;">
            <thead>
              <tr>
                <th>No.</th>
                <th>Rule Name</th>
                <th>Source</th>
                <th>Destination</th>
                <th>Port</th>
                <th>Protocol</th>
                <th>Action</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof ruleList !== 'undefined' && ruleList && ruleList.length > 0) { %>
                <% ruleList.forEach(function(rule, idx) { %>
                  <tr>
                    <td><%= (page - 1) * pageSize + idx + 1 %></td>
                    <td><%= rule.rulename %></td>
                    <td><%= rule.src || '-' %></td>
                    <td><%= rule.dst || '-' %></td>
                    <td><%= rule.services || '-' %></td>
                    <td><span class="badge bg-primary"><%= rule.protocol || '-' %></span></td>
                    <td><span class="badge bg-<%= rule.action === 'allow' ? 'success' : 'danger' %>"><%= rule.action %></span></td>
                    <td><span class="badge bg-<%= rule.status === 'active' ? 'success' : 'secondary' %>"><%= rule.status %></span></td>
                    <td class="text-end">
                        <button type="button" class="btn btn-info btn-sm" title="Show" onclick="showRuleDetail('<%= rule.id %>')" data-rule-id="<%= rule.id %>" data-rule='<%= JSON.stringify(rule) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('firewall.update')) { %>
                      <button type="button" class="btn btn-warning btn-sm" title="Edit" 
                              data-bs-toggle="modal" data-bs-target="#editRuleModal"
                              data-rule-id="<%= rule.id %>"
                              data-rule-name="<%= rule.rulename %>"
                              data-source="<%= rule.src || '' %>"
                              data-destination="<%= rule.dst || '' %>"
                              data-services="<%= rule.services || '' %>"
                              data-protocol="<%= rule.protocol || '' %>"
                              data-action="<%= rule.action %>"
                              data-status="<%= rule.status %>"
                              data-raw-data="<%= rule.raw_data || '' %>">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <% } %>
                      <% if (hasPermission('firewall.delete')) { %>
                        <form action="/firewall/rule/<%= rule.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteRule(this, '<%= rule.rulename %>')">
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                              <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="9" class="text-center">No firewall rules found</td></tr>
              <% } %>
            </tbody>
          </table>
                        </div>
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <% 
                // Calculate pagination range
                const ruleStartItem = (page - 1) * pageSize + 1;
                const ruleEndItem = Math.min(page * pageSize, totalCount || 0);
              %>
              <span>Showing <%= ruleStartItem %> - <%= ruleEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> firewall rules</span>
            </div>
              <ul class="pagination pagination-sm m-0">
                <% 
                  let startPage = 1;
                  let endPage = totalPages;
                  if (totalPages > 10) {
                    if (page <= 6) {
                      startPage = 1;
                      endPage = 10;
                    } else if (page + 4 >= totalPages) {
                      startPage = totalPages - 9;
                      endPage = totalPages;
                    } else {
                      startPage = page - 5;
                      endPage = page + 4;
                    }
                  }
              %>
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= buildPaginationUrl(page - 1) %>">Previous</a>
              </li>
                <% if (startPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="<%= buildPaginationUrl(1) %>">1</a></li>
                  <% if (startPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% } %>
                <% for (let i = startPage; i <= endPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="<%= buildPaginationUrl(i) %>"><%= i %></a></li>
              <% } %>
                <% if (endPage < totalPages) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="<%= buildPaginationUrl(totalPages) %>"><%= totalPages %></a></li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= buildPaginationUrl(page + 1) %>">Next</a>
              </li>
            </ul>
            </div>
          </div>
        </div>
                  </div>
    </div>
  </div>
</div>

  <!-- Add Rule Modal -->
  <div class="modal fade" id="addRuleModal" tabindex="-1" aria-labelledby="addRuleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addRuleModalLabel">Add Firewall Rule</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addRuleForm" action="/firewall/rule" method="POST" onsubmit="return validateAddRuleForm()">
            <!-- Audit Batch -->
            <div class="mb-3">
              <label for="audit_batch" class="form-label">Audit Batch <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="audit_batch" name="audit_batch" required placeholder="Audit Batch">
              <div class="form-text">Enter audit batch name</div>
            </div>
            
            <div class="mb-3">
              <label for="firewall_name" class="form-label">Firewall Name <span class="text-danger">*</span></label>
            <select class="form-control" id="firewall_name" name="firewall_name" required style="width:100%">
                <option value="">-- Select Firewall Name --</option>
                <% (firewallNameOptions || []).forEach(function(fw) { %>
                  <option value="<%= fw.value %>"><%= fw.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label for="rulename" class="form-label">Rule Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="rulename" name="rulename" required placeholder="Rule Name">
            </div>
            
            <!-- Source Section -->
            <div class="mb-3">
              <label for="src_zone" class="form-label">Source Zone</label>
            <input type="text" class="form-control" id="src_zone" name="src_zone" placeholder="Source Zone">
            </div>
            <div class="mb-3">
              <label for="src" class="form-label">Source <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="src" name="src" required placeholder="Source IP/Network">
            </div>
            <div class="mb-3">
              <label for="src_detail" class="form-label">Source Detail</label>
            <input type="text" class="form-control" id="src_detail" name="src_detail" placeholder="Source Detail">
            </div>
            
            <!-- Destination Section -->
            <div class="mb-3">
              <label for="dst_zone" class="form-label">Destination Zone</label>
            <input type="text" class="form-control" id="dst_zone" name="dst_zone" placeholder="Destination Zone">
            </div>
            <div class="mb-3">
              <label for="dst" class="form-label">Destination <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="dst" name="dst" required placeholder="Destination IP/Network">
            </div>
            <div class="mb-3">
              <label for="dst_detail" class="form-label">Destination Detail</label>
            <input type="text" class="form-control" id="dst_detail" name="dst_detail" placeholder="Destination Detail">
            </div>
            
            <!-- Service Section -->
            <div class="mb-3">
              <label for="services" class="form-label">Services</label>
            <input type="text" class="form-control" id="services" name="services" placeholder="Service/Port">
            </div>
            <div class="mb-3">
              <label for="application" class="form-label">Application</label>
            <input type="text" class="form-control" id="application" name="application" placeholder="Application">
            </div>
            <div class="mb-3">
              <label for="url" class="form-label">URL</label>
            <input type="text" class="form-control" id="url" name="url" placeholder="URL">
            </div>
            <div class="mb-3">
              <label for="action" class="form-label">Action <span class="text-danger">*</span></label>
            <select class="form-control" id="action" name="action" required style="width:100%">
                <option value="">-- Select Action --</option>
                <% (actionsOptions || []).forEach(function(act) { %>
                  <option value="<%= act.value %>"><%= act.label %></option>
                <% }) %>
              </select>
            </div>
            
            <!-- Violation Type -->
            <div class="mb-3">
              <label for="violation_type" class="form-label">Violation Type</label>
            <select class="form-control" id="violation_type" name="violation_type" style="width:100%">
                <option value="">-- No violation --</option>
                <% (violationTypeOptions || []).forEach(function(vt) { %>
                  <option value="<%= vt.value %>"><%= vt.label %></option>
                <% }) %>
              </select>
            </div>
            
            <!-- Violation Detail -->
            <div class="mb-3">
              <label for="violation_detail" class="form-label">Violation Detail</label>
            <textarea class="form-control" id="violation_detail" name="violation_detail" rows="2" placeholder="Violation Detail"></textarea>
            </div>
            
            <!-- OU (Organizational Unit) -->
            <div class="mb-3">
              <label for="ou_id" class="form-label">OU (Organizational Unit)</label>
            <select class="form-control" id="ou_id" name="ou_id" style="width:100%">
                <option value="">-- Select OU --</option>
              </select>
            </div>
            
            <!-- Contacts -->
            <div class="mb-3">
              <label for="add-contact-select" class="form-label">Contacts</label>
              <select id="add-contact-select" name="contacts[]" class="form-control" multiple style="width:100%">
                <!-- Selected contacts will be populated here -->
              </select>
              <div class="form-text">Select contacts responsible for this rule</div>
            </div>
            
            <!-- Solution Proposal -->
            <div class="mb-3">
              <label for="solution_proposal" class="form-label">Solution Proposal</label>
            <textarea class="form-control" id="solution_proposal" name="solution_proposal" rows="2" placeholder="Solution Proposal"></textarea>
            </div>
            
            <!-- Solution Confirm -->
            <div class="mb-3">
              <label for="solution_confirm" class="form-label">Solution Confirm</label>
            <textarea class="form-control" id="solution_confirm" name="solution_confirm" rows="2" placeholder="Solution Confirm"></textarea>
            </div>
            
            <!-- Work Order -->
            <div class="mb-3">
              <label for="work_order" class="form-label">Work Order</label>
            <input type="text" class="form-control" id="work_order" name="work_order" placeholder="Work Order">
            </div>
            
            <!-- Status -->
            <div class="mb-3">
              <label for="status" class="form-label">Status</label>
            <select class="form-control" id="status" name="status" style="width:100%">
                <option value="">-- No status --</option>
                <% (statusOptions || []).forEach(function(st) { %>
                  <option value="<%= st.value %>"><%= st.label %></option>
                <% }) %>
              </select>
            </div>
            
            <!-- Description -->
            <div class="mb-3">
              <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="2" placeholder="Description"></textarea>
            </div>
            
            <!-- Raw Data -->
            <div class="mb-3">
              <label for="raw_data" class="form-label">Raw Data</label>
            <textarea class="form-control" id="raw_data" name="raw_data" rows="3" placeholder="Raw data from firewall device"></textarea>
              <div class="form-text">Original raw data from firewall device (optional)</div>
            </div>
          </form>
        </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary btn-sm" form="addRuleForm">Add Rule</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Rule Modal -->
