});

// Handle validate button click
  $(document).on('click', '#validateBtn', function() {
  if (!selectedFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedFile);
  
  // Show progress
    $('#importProgress').show();
    $('#importStatus').text('Validating file...');
  $('.progress-bar').css('width', '30%');
  
  $.ajax({
      url: '/firewall/rule/validate-import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
      success: function(data) {
      $('.progress-bar').css('width', '100%');
        $('#importStatus').text('Validation complete!');
        $('#importResults').show();
        $('#importMessage').html('<strong>Validation Complete!</strong><br>File is ready for import.');
        $('#importBtn').show();
    },
    error: function(xhr, status, error) {
      $('.progress-bar').css('width', '100%').text('Validation Failed');
        $('#importResults').show();
        $('#importMessage').html('<strong>Validation Error!</strong><br>' + (xhr.responseJSON?.error || 'Unknown error occurred'));
      },
      complete: function() {
        $('#validateBtn').prop('disabled', false);
      setTimeout(() => {
          $('#importProgress').hide();
      }, 2000);
    }
  });
});

// Handle import button click
  $(document).on('click', '#importBtn', function() {
  if (!selectedFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedFile);
  
  // Show progress
    $('#importProgress').show();
    $('#importStatus').text('Importing rules...');
  $('.progress-bar').css('width', '30%').text('Importing...');
    $('#importBtn').prop('disabled', true);
  
  $.ajax({
      url: '/firewall/rule/import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
      success: function(data) {
        $('#importProgress .progress-bar').css('width', '100%').text('Import Complete');
        $('#importResults').show();
        $('#importMessage').html('<strong>Import Completed!</strong><br>Rules imported successfully. Page will refresh.');
      
      // Hide import button
        $('#importBtn').hide();
      
      // Refresh page after 2 seconds
      setTimeout(() => {
        window.location.reload();
      }, 2000);
    },
    error: function(xhr, status, error) {
        $('#importProgress .progress-bar').css('width', '100%').text('Import Failed');
        $('#importResults').show();
        $('#importMessage').html('<strong>Import Error!</strong><br>' + (xhr.responseJSON?.error || 'Unknown error occurred'));
    },
    complete: function() {
        $('#importBtn').prop('disabled', false);
      setTimeout(() => {
          $('#importProgress').hide();
      }, 2000);
    }
  });
});

// Reset import modal when closed
  $('#importRuleModal').on('hidden.bs.modal', function() {
  // Reset form
    $('#importRuleForm')[0].reset();
  selectedFile = null;
  
  // Reset UI elements
    $('#validateBtn').prop('disabled', true);
    $('#importBtn').hide();
    $('#importProgress').hide();
    $('#importResults').hide();
  
  // Reset progress bar
  $('.progress-bar').css('width', '0%').text('');
  });
});
</script>

