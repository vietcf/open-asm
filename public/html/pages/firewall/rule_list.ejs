<script>
function showToast(msg, type) {
  const toast = document.createElement('div');
  toast.className = `alert alert-${type}`;
  toast.style.position = 'fixed';
  toast.style.top = '16px';
  toast.style.right = '16px';
  toast.style.zIndex = 9999;
  toast.style.minWidth = '200px';
  toast.innerText = msg;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
}

function showRuleDetail(ruleId) {
  console.log('showRuleDetail called with ruleId:', ruleId);
  
  // Get rule data from button (specifically the show button)
  const button = document.querySelector(`button[data-rule-id="${ruleId}"][title="Show"]`);
  if (!button) {
    console.error('Button not found for ruleId:', ruleId);
      return;
    }
    
  console.log('Button found:', button);
  
  const ruleData = button.getAttribute('data-rule');
  if (!ruleData) {
    console.error('No rule data found for ruleId:', ruleId);
      return;
    }
    
  let rule;
  try {
    rule = JSON.parse(ruleData);
  } catch (e) {
    console.error('Error parsing rule data:', e);
        return;
      }
      
  // Create modal HTML
  const modalId = `ruleDetailModal-${ruleId}`;
  const modalHtml = `
    <div class="modal fade" id="${modalId}" tabindex="-1" aria-labelledby="${modalId}Label" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="${modalId}Label">Firewall Rule Detail</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <dl class="row mb-0">
              <dt class="col-sm-4">Audit Batch</dt>
              <dd class="col-sm-8">${rule.audit_batch || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Firewall Name</dt>
              <dd class="col-sm-8">${rule.firewall_name || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Rule Name</dt>
              <dd class="col-sm-8">${rule.rulename || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Source Section -->
              <dt class="col-sm-4">Source Zone</dt>
              <dd class="col-sm-8">${rule.src_zone || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Source</dt>
              <dd class="col-sm-8">${rule.src || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Source Detail</dt>
              <dd class="col-sm-8">${rule.src_detail || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Destination Section -->
              <dt class="col-sm-4">Destination Zone</dt>
              <dd class="col-sm-8">${rule.dst_zone || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Destination</dt>
              <dd class="col-sm-8">${rule.dst || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Destination Detail</dt>
              <dd class="col-sm-8">${rule.dst_detail || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Service Section -->
              <dt class="col-sm-4">Services</dt>
              <dd class="col-sm-8">${rule.services || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Application</dt>
              <dd class="col-sm-8">${rule.application || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">URL</dt>
              <dd class="col-sm-8">${rule.url || '<span class="text-muted">No data</span>'}</dd>
              
              <dt class="col-sm-4">Action</dt>
              <dd class="col-sm-8">${rule.action || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Violation Section -->
              <dt class="col-sm-4">Violation Type</dt>
              <dd class="col-sm-8">${rule.violation_type || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Violation Detail</dt>
              <dd class="col-sm-8">${rule.violation_detail || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- OU Section -->
              <dt class="col-sm-4">OU (Organizational Unit)</dt>
              <dd class="col-sm-8">${rule.ou_name || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Contacts Section -->
              <dt class="col-sm-4">Contacts</dt>
              <dd class="col-sm-8">
                ${rule.contacts && rule.contacts.length > 0 
                  ? rule.contacts.map(contact => {
                      const name = contact.name || '';
                      const email = contact.email || '';
                      if (email) {
                        const shortEmail = email.split('@')[0];
                        return `${name} (${shortEmail})`;
                      }
                      return name;
                    }).join('<br>')
                  : '<span class="text-muted">No contacts assigned</span>'
                }
              </dd>
              
              <!-- Solution Section -->
              <dt class="col-sm-4">Solution Proposal</dt>
              <dd class="col-sm-8">${rule.solution_proposal || '<span class="text-muted">No data</span>'}</dd>
              <dt class="col-sm-4">Solution Confirm</dt>
              <dd class="col-sm-8">${rule.solution_confirm || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Work Order -->
              <dt class="col-sm-4">Work Order</dt>
              <dd class="col-sm-8">${rule.work_order || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Status -->
              <dt class="col-sm-4">Status</dt>
              <dd class="col-sm-8">
                ${rule.status 
                  ? `<span class="badge bg-${rule.status === 'active' ? 'success' : rule.status === 'inactive' ? 'secondary' : 'warning'}">${rule.status.charAt(0).toUpperCase() + rule.status.slice(1)}</span>`
                  : '<span class="text-muted">No status</span>'
                }
              </dd>
              
              <!-- Description -->
              <dt class="col-sm-4">Description</dt>
              <dd class="col-sm-8">${rule.description || '<span class="text-muted">No data</span>'}</dd>
              
              <!-- Raw Data -->
              <dt class="col-sm-4">Raw Data</dt>
              <dd class="col-sm-8">
                ${rule.raw_data 
                  ? `<pre class="bg-light p-2 rounded" style="white-space: pre-wrap; font-size: 0.875rem;">${rule.raw_data}</pre>`
                  : '<span class="text-muted">No raw data</span>'
                }
              </dd>
            </dl>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  `;
  
  // Remove existing modal if any
  const existingModal = document.getElementById(modalId);
  if (existingModal) {
    existingModal.remove();
  }
  
  // Add modal to body
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  
  // Show modal
  const modal = new bootstrap.Modal(document.getElementById(modalId));
  modal.show();
  
  // Remove modal from DOM when hidden
  document.getElementById(modalId).addEventListener('hidden.bs.modal', function() {
    this.remove();
  });
}

