<script>
$(function() {
  // Load OU options for Add Rule Modal
  function loadOUOptions() {
    $.ajax({
      url: '/organize/api/unit',
      dataType: 'json',
      success: function(data) {
        const $ouSelect = $('#ou_id');
        $ouSelect.empty().append('<option value="">-- Select OU --</option>');
        if (data && data.length > 0) {
          data.forEach(function(ou) {
            $ouSelect.append(`<option value="${ou.id}">${ou.text}</option>`);
          });
        }
      },
      error: function() {
        console.error('Failed to load OU options');
      }
    });
  }

  // Load Contact options for Add Rule Modal
  function loadContactOptions() {
    $.ajax({
      url: '/organize/api/contact',
      dataType: 'json',
      success: function(data) {
        const $contactSelect = $('#add-contact-select');
        $contactSelect.empty();
        if (data && data.length > 0) {
          data.forEach(function(contact) {
            const option = new Option(contact.text, contact.id, false, false);
            $contactSelect.append(option);
          });
        }
        $contactSelect.trigger('change');
      },
      error: function() {
        console.error('Failed to load contact options');
      }
    });
  }

  // Load OU options for Filter Modal
  function loadFilterOUOptions() {
    $.ajax({
      url: '/organize/api/unit',
      dataType: 'json',
      success: function(data) {
        const $ouSelect = $('#filterRuleOU');
        $ouSelect.empty().append('<option value="">-- All --</option>');
        if (data && data.length > 0) {
          data.forEach(function(ou) {
            $ouSelect.append(`<option value="${ou.id}">${ou.text}</option>`);
          });
        }
        // Set selected value if exists
        const filterData = document.getElementById('filter-rule-data');
        const selectedOU = filterData.getAttribute('data-ou-id');
        if (selectedOU && selectedOU !== '') {
          $ouSelect.val(selectedOU);
        }
        $ouSelect.trigger('change');
      },
      error: function() {
        console.error('Failed to load OU options for filter');
      }
    });
  }

  // Load Contact options for Filter Modal
  function loadFilterContactOptions() {
    $.ajax({
      url: '/organize/api/contact',
      dataType: 'json',
      success: function(data) {
