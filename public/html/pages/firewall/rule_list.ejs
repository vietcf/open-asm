  // Group rules by rulename + firewall_name
  function groupRules(rules) {
    var groups = {};
    rules.forEach(function(rule) {
      var key = rule.rulename + '|' + rule.firewall_name;
      if (!groups[key]) {
        groups[key] = {
          rulename: rule.rulename,
          firewall_name: rule.firewall_name,
          rules: [],
          occurrences: 0,
          latestUpdatedAt: '',
          latestAudit: ''
        };
      }
      groups[key].rules.push(rule);
      groups[key].occurrences++;

      // Get latest updated_at and audit
      if (!groups[key].latestAudit || rule.audit_batch > groups[key].latestAudit) {
        groups[key].latestUpdatedAt = rule.updated_at || '';
        groups[key].latestAudit = rule.audit_batch || '';
      }

      // Also check for latest updated_at across all rules in group
      if (rule.updated_at && (!groups[key].latestUpdatedAt || rule.updated_at > groups[key].latestUpdatedAt)) {
        groups[key].latestUpdatedAt = rule.updated_at;
      }
    });
    return Object.values(groups);
  }

  // Render grouped view
  function renderGroupedView() {
    if (!originalRules || originalRules.length === 0) {
      $('#rulesTableBody').html('<tr><td colspan="9" class="text-center">No rules found</td></tr>');
      return;
    }

    var groups = groupRules(originalRules);
    var tbody = $('#rulesTableBody');
    tbody.empty();

    if (groups.length === 0) {
      tbody.append('<tr><td colspan="9" class="text-center">No rules found</td></tr>');
      return;
    }

    groups.forEach(function(group, idx) {
      var row = $('<tr class="group-row" data-group-key="' + group.rulename + '|' + group.firewall_name + '">');
      row.append('<td>' + (idx + 1) + '</td>');
      row.append('<td style="font-size: 0.75rem; color: #6c757d;">' + (group.latestAudit || '') + '</td>');
      row.append('<td><span class="badge bg-info">' + group.firewall_name + '</span></td>');
      row.append('<td><strong>' + group.rulename + '</strong></td>');

      // Show first rule's src/dst/service as representative
      var firstRule = group.rules[0];
      row.append('<td>' + (firstRule ? firstRule.src || '' : '') + '</td>');
      row.append('<td>' + (firstRule ? firstRule.dst || '' : '') + '</td>');
      row.append('<td>' + (firstRule ? firstRule.services || 'N/A' : 'N/A') + '</td>');

      // Format updated_at date
      var updatedAtText = 'N/A';
      if (group.latestUpdatedAt) {
        try {
          var date = new Date(group.latestUpdatedAt);
          updatedAtText = date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
        } catch(e) {
          updatedAtText = group.latestUpdatedAt;
        }
      }
      row.append('<td>' + updatedAtText + '</td>');

      var actionsHtml = '<div class="btn-group btn-group-sm">';
      actionsHtml += '<button type="button" class="btn btn-outline-info btn-sm expand-group" title="Expand Details">';
      actionsHtml += '<i class="bi bi-chevron-down"></i></button>';
      actionsHtml += '<button type="button" class="btn btn-outline-primary btn-sm view-group" title="View All">';
      actionsHtml += '<i class="bi bi-eye"></i></button>';
      actionsHtml += '</div>';
      row.append('<td class="text-end">' + actionsHtml + '</td>');

      tbody.append(row);

      // Add expandable detail rows
      group.rules.forEach(function(rule, ruleIdx) {
        var detailRow = $('<tr class="group-detail-row" style="display: none;" data-group-key="' + group.rulename + '|' + group.firewall_name + '">');
        detailRow.append('<td></td>'); // Empty for No.
        detailRow.append('<td class="text-muted">' + (rule.audit_batch || '') + ' <small class="text-muted">(' + typeof rule.audit_batch + ')</small></td>'); // Audit Batch
        detailRow.append('<td class="text-muted">' + (rule.firewall_name || '') + '</td>'); // Firewall Name
        detailRow.append('<td class="text-muted">' + (rule.rulename || '') + '</td>'); // Rule Name
        detailRow.append('<td class="text-muted">' + (rule.src || '') + '</td>'); // Source
        detailRow.append('<td class="text-muted">' + (rule.dst || '') + '</td>'); // Destination
        detailRow.append('<td class="text-muted">' + (rule.services || 'N/A') + '</td>'); // Service
        detailRow.append('<td class="text-muted">' + (rule.updated_at ? new Date(rule.updated_at).toLocaleDateString() + ' ' + new Date(rule.updated_at).toLocaleTimeString() : 'N/A') + '</td>'); // Last Update

        var ruleActionsHtml = '<div class="btn-group btn-group-sm">';
        ruleActionsHtml += '<button type="button" class="btn btn-info btn-sm" title="Show" onclick="showRuleDetail(\'' + rule.id + '\')" data-rule-id="' + rule.id + '" data-rule=\'' + JSON.stringify(rule) + '\'>';
        ruleActionsHtml += '<i class="bi bi-eye"></i></button>';
        if (hasUpdatePermission) {
          ruleActionsHtml += '<button type="button" class="btn btn-warning btn-sm" title="Edit" data-bs-toggle="modal" data-bs-target="#editRuleModal" data-rule-id="' + rule.id + '" data-rule=\'' + JSON.stringify(rule) + '\'>';
          ruleActionsHtml += '<i class="bi bi-pencil"></i></button>';
        }
        if (hasDeletePermission) {
          ruleActionsHtml += '<form action="/firewall/rule/' + rule.id + '?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteRule(this, \'' + rule.rulename + '\')">';
          ruleActionsHtml += '<button type="submit" class="btn btn-danger btn-sm" title="Delete"><i class="bi bi-trash"></i></button>';
          ruleActionsHtml += '</form>';
        }
        ruleActionsHtml += '</div>';
        detailRow.append('<td class="text-end">' + ruleActionsHtml + '</td>');

        tbody.append(detailRow);
      });
    });
  }

  // Render detailed view (original)
  function renderDetailedView() {
    if (!originalRules || originalRules.length === 0) {
      $('#rulesTableBody').html('<tr><td colspan="11" class="text-center">No rules found</td></tr>');
      return;
    }

    var tbody = $('#rulesTableBody');
    tbody.empty();

    if (originalRules.length === 0) {
      tbody.append('<tr><td colspan="11" class="text-center">No rules found</td></tr>');
      return;
    }

    originalRules.forEach(function(rule, idx) {
      var row = $('<tr>');
      row.append('<td>' + (idx + 1) + '</td>');
      row.append('<td>' + (rule.audit_batch || '-') + '</td>');
      row.append('<td>' + (rule.firewall_name || '-') + '</td>');
      row.append('<td>' + rule.rulename + '</td>');
      row.append('<td>' + (rule.src || '-') + '</td>');
      row.append('<td>' + (rule.dst || '-') + '</td>');
      row.append('<td><span class="badge bg-' + (rule.action === 'allow' ? 'success' : 'danger') + '">' + (rule.action || '-') + '</span></td>');
      row.append('<td><span class="badge bg-' + (rule.status === 'active' ? 'success' : 'secondary') + '">' + (rule.status || '-') + '</span></td>');

      var actionsHtml = '<div class="btn-group btn-group-sm">';
      actionsHtml += '<button type="button" class="btn btn-info btn-sm" title="Show" onclick="showRuleDetail(\'' + rule.id + '\')" data-rule-id="' + rule.id + '" data-rule=\'' + JSON.stringify(rule) + '\'><i class="bi bi-eye"></i></button>';
      if (hasUpdatePermission) {
        actionsHtml += '<button type="button" class="btn btn-warning btn-sm" title="Edit" data-bs-toggle="modal" data-bs-target="#editRuleModal" data-rule-id="' + rule.id + '" data-rule=\'' + JSON.stringify(rule) + '\'><i class="bi bi-pencil"></i></button>';
      }
      if (hasDeletePermission) {
        actionsHtml += '<form action="/firewall/rule/' + rule.id + '?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteRule(this, \'' + rule.rulename + '\')">';
        actionsHtml += '<button type="submit" class="btn btn-danger btn-sm" title="Delete"><i class="bi bi-trash"></i></button>';
        actionsHtml += '</form>';
      }
      actionsHtml += '</div>';
      row.append('<td class="text-end">' + actionsHtml + '</td>');

      tbody.append(row);
    });
  }

  // View toggle handlers
  $('#groupedView').on('change', function() {
    if (this.checked) {
      currentView = 'grouped';
      $('#detailedHeader').hide();
      $('#groupedHeader').show();
      renderGroupedView();
    }
  });

  $('#detailedView').on('change', function() {
    if (this.checked) {
      currentView = 'detailed';
      $('#groupedHeader').hide();
      $('#detailedHeader').show();
      renderDetailedView();
    }
  });

  // Expand/collapse group details
  $(document).on('click', '.expand-group', function() {
    var $row = $(this).closest('tr');
    var groupKey = $row.data('group-key');
    var $detailRows = $('.group-detail-row[data-group-key="' + groupKey + '"]');
    var $icon = $(this).find('i');

    if ($detailRows.is(':visible')) {
      $detailRows.hide();
      $icon.removeClass('bi-chevron-up').addClass('bi-chevron-down');
    } else {
      $detailRows.show();
      $icon.removeClass('bi-chevron-down').addClass('bi-chevron-up');
    }
  });

  // View all rules in group
  $(document).on('click', '.view-group', function() {
    var $row = $(this).closest('tr');
    var groupKey = $row.data('group-key');
    var parts = groupKey.split('|');
    var rulename = parts[0];
    var firewall_name = parts[1];

    // Switch to detailed view and filter by this group
    $('#detailedView').prop('checked', true).trigger('change');
  });

  // Initialize with grouped view
  currentView = 'grouped';
  $('#groupedView').prop('checked', true);
  $('#detailedHeader').hide();
  $('#groupedHeader').show();

  // Small delay to ensure DOM is ready
  setTimeout(function() {
    renderGroupedView();
  }, 100);

  // Import functionality
let selectedFile = null;

// Handle file selection
  $(document).on('change', '#ruleFile', function() {
  selectedFile = this.files[0];
  if (selectedFile) {
    console.log('File selected:', selectedFile.name);
      $('#validateBtn').prop('disabled', false);
        } else {
      $('#validateBtn').prop('disabled', true);
      $('#importBtn').hide();
  }
});

// Handle validate button click
  $(document).on('click', '#validateBtn', function() {
  if (!selectedFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedFile);
  
  // Show progress
    $('#importProgress').show();
    $('#importStatus').text('Validating file...');
  $('.progress-bar').css('width', '30%');
  
  let nativeXhr;
  $.ajax({
      url: '/firewall/rule/validate-import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      nativeXhr = new window.XMLHttpRequest();
      nativeXhr.responseType = 'blob';
      return nativeXhr;
    },
      success: function(data, status, xhr) {
      $('.progress-bar').css('width', '100%');
        $('#importStatus').text('Validation complete!');
        
        // Get validation summary from headers
        const validationSummary = xhr.getResponseHeader('X-Validation-Summary');
        let summaryInfo = '';
        let showImportBtn = false;
        if (validationSummary) {
          try {
            const summary = JSON.parse(validationSummary);
            summaryInfo = `<br>Total: ${summary.total}, Passed: ${summary.passed}, Failed: ${summary.failed}`;
            // Only show import button if all rows passed (Failed: 0)
            showImportBtn = summary.failed === 0;
          } catch (e) {
            console.log('Could not parse validation summary');
          }
        }
        
        // Create download link for the validation results file
        const blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'firewall_rule_validation_results.xlsx';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.URL.revokeObjectURL(url);
        
        $('#importResults').show();
        $('#importMessage').html('<strong>Validation Complete!</strong><br>Validation results file has been downloaded.' + summaryInfo);
        
        // Only show import button if all validations passed
        if (showImportBtn) {
          $('#importBtn').show().prop('disabled', false);
          $('#importMessage').append('<br><br><strong style="color: green;">All validations passed! You can now import the rules.</strong>');
        } else {
          $('#importBtn').hide().prop('disabled', true);
          $('#importMessage').append('<br><br><strong style="color: red;">Please fix the validation errors before importing.</strong>');
        }
    },
    error: function(xhr, status, error) {
      $('.progress-bar').css('width', '100%').text('Validation Failed');
        $('#importResults').show();

        extractImportErrorMessage(nativeXhr || xhr).then(function(errorMessage) {
          $('#importMessage').html('<strong>Validation Error!</strong><br>' + errorMessage);
        });
      },
      complete: function() {
        $('#validateBtn').prop('disabled', false);
      setTimeout(() => {
          $('#importProgress').hide();
      }, 2000);
    }
  });
});

// Handle import button click
  $(document).on('click', '#importBtn', function() {
  if (!selectedFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedFile);
  
  // Show progress
    $('#importProgress').show();
    $('#importStatus').text('Importing rules...');
  $('.progress-bar').css('width', '30%').text('Importing...');
    $('#importBtn').prop('disabled', true);
  
  let nativeXhr;
  $.ajax({
      url: '/firewall/rule/import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      nativeXhr = new window.XMLHttpRequest();
      nativeXhr.responseType = 'blob'; // Important for downloading files
      return nativeXhr;
    },
      success: function(data, status, xhr) {
        $('#importProgress .progress-bar').css('width', '100%').text('Import Complete');
        $('#importResults').show();
        
        // Get import summary from headers
        const importSummary = xhr.getResponseHeader('X-Import-Summary');
        let summaryInfo = '';
        if (importSummary) {
          try {
            const summary = JSON.parse(importSummary);
            summaryInfo = `<br>Total: ${summary.total}, Success: ${summary.success}, Failed: ${summary.failed}`;
          } catch (e) {
            console.log('Could not parse import summary');
          }
        }
        
        // Download the import results Excel file
        const blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'firewall_rule_import_results.xlsx';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.URL.revokeObjectURL(url);
        
        // Show success message
        $('#importMessage').html('<strong>Import Completed!</strong><br>Import results file has been downloaded.' + summaryInfo + '<br><br>Page will refresh in 3 seconds.');
      
      // Hide import button
        $('#importBtn').hide();

      // Refresh page after 2 seconds (same as IP/Subnet/Server/Device import)
      setTimeout(() => {
        window.location.reload();
      }, 2000);
    },
    error: function(xhr, status, error) {
        $('#importProgress .progress-bar').css('width', '100%').text('Import Failed');
        $('#importResults').show();
        extractImportErrorMessage(nativeXhr || xhr).then(function(errorMessage) {
          $('#importMessage').html('<strong>Import Error!</strong><br>' + errorMessage);
        });
    },
    complete: function() {
        $('#importBtn').prop('disabled', false);
      setTimeout(() => {
          $('#importProgress').hide();
      }, 2000);
    }
  });
});

// Reset import modal when closed
  $('#importRuleModal').on('hidden.bs.modal', function() {
  // Reset form
    $('#importRuleForm')[0].reset();
  selectedFile = null;
  
  // Reset UI elements
    $('#validateBtn').prop('disabled', true);
    $('#importBtn').hide();
    $('#importProgress').hide();
    $('#importResults').hide();
  
  // Reset progress bar
  $('.progress-bar').css('width', '0%').text('');
  });
});
</script>

