<%
  const f = filter;
  const activeFilterCount = [f.firewall_name.length, f.action.length, f.status.length, f.violation_type.length, f.tags.length, f.contacts.length, f.ou_id, f.audit_batch, f.work_order].filter(Boolean).length;
  const COLUMNS = [
    { key: 'audit_batch', label: 'Audit Batch', def: true },
    { key: 'firewall_name', label: 'Firewall Name', def: true },
    { key: 'rulename', label: 'Rule Name', def: true, fixed: true },
    { key: 'src', label: 'Source', def: true },
    { key: 'dst', label: 'Destination', def: true },
    { key: 'services', label: 'Service', def: true },
    { key: 'action', label: 'Action', def: true },
    { key: 'status', label: 'Status', def: true },
    { key: 'violation_type', label: 'Violation Type' },
    { key: 'ou', label: 'OU (Unit)' },
    { key: 'contacts', label: 'Contacts' },
    { key: 'work_order', label: 'Work Order' },
    { key: 'tags', label: 'Tags' },
    { key: 'updated', label: 'Updated' },
  ];
  const zoned = (zone, value) => (zone ? `<small class="text-secondary">${ui.esc(zone)}</small><br>` : '') + ui.clip(value);
  const cell = (r, key) => ({
    audit_batch: ui.text(r.audit_batch),
    firewall_name: ui.text(ui.optionLabel(options.firewall_name, r.firewall_name)),
    rulename: ui.esc(r.rulename),
    src: zoned(r.src_zone, r.src),
    dst: zoned(r.dst_zone, r.dst),
    services: ui.clip(r.services),
    action: ui.chips([ui.optionLabel(options.action, r.action)]),
    status: r.status ? ui.chips([ui.optionLabel(options.status, r.status)]) : ui.dash,
    violation_type: ui.text(ui.optionLabel(options.violation_type, r.violation_type)),
    ou: ui.text(r.ou_name),
    contacts: ui.chips(r.contacts.map(c => c.name)),
    work_order: ui.text(r.work_order),
    tags: ui.chips(r.tags.map(x => x.name)),
    updated: ui.date(r.updated_at),
  })[key];
  const filterSelect = (name, label, list) => `<div class="col-md-3"><label class="form-label small">${t(label)}</label>
    <select name="${name}" class="form-select js-filter" multiple data-placeholder="${t('All')}">${ui.options(list, f[name])}</select></div>`;
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Firewall Rule' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/firewall/rule">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by rule, source, destination, service, contact...',
              filtersId: 'ruleFilters', activeFilterCount,
              columns: { tableId: 'ruleTable', storageKey: 'openasm.ruleList.columns', list: COLUMNS },
              exportUrl: '/firewall/rule/export' + currentQuery,
              importModal: hasPermission('rule.create') ? 'ruleImportModal' : null,
              addUrl: hasPermission('rule.create') ? '/firewall/rule/add' : null, addLabel: 'Add Rule' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="ruleFilters">
          <div class="list-filters">
            <div class="row g-2">
              <%- filterSelect('firewall_name', 'Firewall Name', options.firewall_name) %>
              <%- filterSelect('action', 'Action', options.action) %>
              <%- filterSelect('status', 'Status', options.status) %>
              <%- filterSelect('violation_type', 'Violation Type', options.violation_type) %>
              <div class="col-md-3">
                <label class="form-label small"><%= t('Audit Batch') %></label>
                <input type="text" name="audit_batch" class="form-control form-control-sm" value="<%= f.audit_batch %>" placeholder="2024-01, 2024-02">
              </div>
              <div class="col-md-3">
                <label class="form-label small"><%= t('Work Order') %></label>
                <input type="text" name="work_order" class="form-control form-control-sm" value="<%= f.work_order %>">
              </div>
              <div class="col-md-3">
                <label class="form-label small"><%= t('OU (Unit)') %></label>
                <select name="ou_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(unitOptions, f.ou_id ? [f.ou_id] : []) %></select>
              </div>
              <div class="col-md-3">
                <label class="form-label small"><%= t('Tags') %> <small class="text-secondary">(<%= t('all selected') %>)</small></label>
                <select name="tags" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(tagOptions, f.tags) %></select>
              </div>
              <div class="col-md-6">
                <label class="form-label small"><%= t('Contacts') %> <small class="text-secondary">(<%= t('all selected') %>)</small></label>
                <select name="contacts" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"
                        data-ajax-url="/organize/api/contact" data-ids-url="/organize/api/contact/ids" data-selected='<%= JSON.stringify(f.contacts) %>'></select>
              </div>
            </div>
            <div class="mt-2 d-flex justify-content-end gap-3">
              <button type="submit" class="btn btn-sm btn-primary"><%= t('Apply') %></button>
              <% if (activeFilterCount) { %>
                <a href="#" class="small align-self-center" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a>
              <% } %>
            </div>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="ruleTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (ruleList.length) { %>
              <% ruleList.forEach(function (r, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'rulename' ? ' class="fw-medium"' : '' %>><%- cell(r, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showRuleDetail(this)" data-record='<%= JSON.stringify(r) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('rule.update')) { %>
                        <a href="/firewall/rule/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('rule.delete')) { %>
                        <form action="/firewall/rule/<%= r.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: r.rulename }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-shield-exclamation', message: 'No firewall rules found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/firewall/rule',
                      actionUrl: hasPermission('rule.create') ? '/firewall/rule/add' : null, actionLabel: 'Add Rule' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: ruleList.length, summary: 'Showing {1} - {2} of {3} rules' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'ruleDetailModal' }) %>
<% if (hasPermission('rule.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'ruleImportModal', title: 'Import Firewall Rules', baseUrl: '/firewall/rule',
        instructions: ['Audit Batch format: YYYY-MM', 'Firewall name, action, status and violation type must be configured values', 'Rules already in the same audit batch are skipped'] }) %>
<% } %>

<script>
  const RULE_OPTIONS = <%- jsonSafe(options) %>;
  function showRuleDetail(button) {
    const r = DV.record(button);
    if (!r) return;
    const opt = (field) => DV.text(DV.optionLabel(RULE_OPTIONS[field], r[field])) || DV.EMPTY;
    const val = (v) => DV.text(v) || DV.EMPTY;
    const end = (zone, addr, detail) => DV.rows(DV.field('Zone', val(zone)), DV.field('Address', '<span class="font-monospace">' + val(addr) + '</span>'), detail ? DV.field('Detail', DV.multiline(detail)) : '');
    let body = DV.section('Overview', DV.rows(
      DV.field('Firewall Name', opt('firewall_name')), DV.field('Audit Batch', val(r.audit_batch)),
      DV.field('Action', opt('action')), DV.field('Status', opt('status')),
      DV.field('Service', val(r.services)), DV.field('Application', val(r.application)),
      r.url ? DV.field('URL', DV.urlList([r.url])) : '',
      DV.field('OU (Unit)', val(r.ou_name)), DV.field('Work Order', val(r.work_order)),
      DV.multiline(r.description) ? DV.field('Description', DV.multiline(r.description)) : ''
    ));
    body += DV.section('Source', end(r.src_zone, r.src, r.src_detail));
    body += DV.section('Destination', end(r.dst_zone, r.dst, r.dst_detail));
    if (r.violation_type || r.violation_detail || r.solution_proposal || r.solution_confirm) {
      body += DV.section('Violation', DV.rows(
        DV.field('Violation Type', opt('violation_type')),
        r.violation_detail ? DV.field('Violation Detail', DV.multiline(r.violation_detail)) : '',
        r.solution_proposal ? DV.field('Solution Proposal', DV.multiline(r.solution_proposal)) : '',
        r.solution_confirm ? DV.field('Solution Confirm', DV.multiline(r.solution_confirm)) : ''
      ));
    }
    body += DV.section('Links', DV.rows(DV.field('Contacts', DV.contacts(r.contacts || [])), DV.field('Tags', DV.chips((r.tags || []).map((x) => x.name)))));
    if (r.raw_data) body += DV.section('Raw Data', '<pre class="small mb-0 detail-pad" style="white-space:pre-wrap">' + DV.esc(r.raw_data) + '</pre>');
    body += DV.meta(r);
    DV.open('ruleDetailModal', { title: r.rulename, body, recordId: r.id });
  }
</script>
