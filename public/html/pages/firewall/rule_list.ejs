function loadFilterExistingValues() {
  console.log('Loading existing filter values...');
  
  // Get filter data from hidden div
  const filterDataEl = document.getElementById('filter-rule-data');
  if (!filterDataEl) {
    console.log('Filter data element not found');
    return;
  }
  
  try {
    const filterTags = JSON.parse(filterDataEl.dataset.tags || '[]');
    const filterSystems = JSON.parse(filterDataEl.dataset.systems || '[]');
    const filterContacts = JSON.parse(filterDataEl.dataset.contacts || '[]');
    
    console.log('Filter data:', { filterTags, filterSystems, filterContacts });
    
    // Clear existing options first to avoid duplicates
    $('#filterIpTags').find('option').remove();
    $('#filterIpSystems').find('option').remove();
    $('#filterIpContacts').find('option').remove();
    
    // Load tags
    if (filterTags && filterTags.length > 0) {
