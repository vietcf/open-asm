<%
  const f = filter;
  const activeFilterCount = [f.role.length, f.system_id.length].filter(Boolean).length;
  const COLUMNS = [
    { key: 'name', label: 'Cluster Name', def: true, fixed: true },
    { key: 'systems', label: 'Systems', def: true },
    { key: 'members', label: 'Members', def: true },
    { key: 'roles', label: 'Roles', def: true },
    { key: 'description', label: 'Description' },
    { key: 'updated', label: 'Updated', def: true },
  ];
  const cell = (c, key) => ({
    name: ui.esc(c.name),
    systems: ui.chips(c.systems.map(s => s.name)),
    members: c.members.length ? `<span class="badge tag">${c.members.length}</span> ` + ui.mono(c.members.slice(0, 3).map(m => m.ip).concat(c.members.length > 3 ? ['…'] : [])) : ui.dash,
    roles: ui.chips([...new Set(c.members.map(m => m.role).filter(Boolean))]),
    description: ui.clip(c.description),
    updated: ui.date(c.updated_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Cluster Management' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/cluster">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name, description, member IP...',
              filtersId: 'clusterFilters', activeFilterCount,
              columns: { tableId: 'clusterTable', storageKey: 'openasm.clusterList.columns', list: COLUMNS },
              exportUrl: '/cluster/export' + currentQuery,
              importModal: hasPermission('cluster.create') ? 'clusterImportModal' : null,
              addUrl: hasPermission('cluster.create') ? '/cluster/add' : null, addLabel: 'Add Cluster' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="clusterFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label small"><%= t('Role') %></label>
                <select name="role" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>">
                  <% (roleOptions || []).forEach(function (r) { %>
                    <option value="<%= r %>" <%= f.role.includes(r) ? 'selected' : '' %>><%= r %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label small"><%= t('Systems') %></label>
                <select name="system_id" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(f.system_id) %>'></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="clusterTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (clusterList && clusterList.length) { %>
              <% clusterList.forEach(function (cluster, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(cluster, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showClusterDetail(this)" data-record='<%= JSON.stringify(cluster) %>'><i class="bi bi-eye"></i></button>
                      <a href="/cluster/<%= cluster.id %>/export" class="btn btn-sm btn-outline-secondary" title="<%= t('Export members') %>"><i class="bi bi-download"></i></a>
                      <% if (hasPermission('cluster.update')) { %>
                        <a href="/cluster/<%= cluster.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('cluster.delete')) { %>
                        <form action="/cluster/<%= cluster.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: cluster.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-diagram-3', message: 'No clusters found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/cluster',
                      actionUrl: hasPermission('cluster.create') ? '/cluster/add' : null, actionLabel: 'Add Cluster' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (clusterList || []).length, summary: 'Showing {1} - {2} of {3} clusters' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'clusterDetailModal' }) %>
<% if (hasPermission('cluster.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'clusterImportModal', title: 'Import Clusters', baseUrl: '/cluster',
        instructions: ['One row per member; rows with the same cluster name make one cluster', 'IP addresses and systems must already exist', 'A cluster is created only when all of its rows are valid'] }) %>
<% } %>

<script>
  function showClusterDetail(button) {
    const c = DV.record(button);
    if (!c) return;
    const members = c.members || [];
    const owner = (m) => m.server_name
      ? '<a href="/server/server?search=' + encodeURIComponent(m.server_name) + '">' + DV.esc(m.server_name) + '</a>'
      : (m.device_name ? '<a href="/device/device?search=' + encodeURIComponent(m.device_name) + '">' + DV.esc(m.device_name) + '</a>' : DV.EMPTY);
    const table = members.length
      ? '<div class="table-responsive"><table class="table table-sm align-middle detail-table mb-0"><thead><tr><th>' + DV.esc(t('IP Address')) + '</th><th>' + DV.esc(t('Role')) + '</th><th>' + DV.esc(t('Server')) + ' / ' + DV.esc(t('Device')) + '</th></tr></thead><tbody>' +
        members.map((m) => '<tr><td>' + DV.ipLink(m.ip) + '</td><td>' + (DV.text(m.role) || DV.EMPTY) + '</td><td>' + owner(m) + '</td></tr>').join('') + '</tbody></table></div>'
      : '<p class="text-secondary small mb-0 detail-pad">' + DV.esc(t('No members')) + '</p>';
    let body = DV.section('Overview', DV.rows(
      DV.multiline(c.description) ? DV.field('Description', DV.multiline(c.description)) : '',
      DV.field('Systems', DV.linkChips(c.systems || [], (s) => '/system/system?search=' + encodeURIComponent(s.name)))
    ));
    body += DV.section('Members', table, ' <span class="badge tag ms-1">' + members.length + '</span>');
    body += DV.meta(c);
    DV.open('clusterDetailModal', { title: c.name, body, recordId: c.id });
  }
</script>
