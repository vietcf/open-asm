<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item"><a href="/cluster"><%= t('Cluster Management') %></a></li>
          <li class="breadcrumb-item active"><%= t('Add Cluster') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<section class="app-content">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10 col-sm-12">
      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><%= t('Add Cluster') %></h5>
        </div>
        <form action="/cluster/add" method="POST">
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label"><%= t('Cluster Name') %> <span class="text-danger">*</span></label>
              <input type="text" id="cluster-name-input" name="name" class="form-control" placeholder="<%= t('e.g. OpenShift Production, Oracle RAC DB01') %>" required>
              <div id="cluster-name-feedback" class="invalid-feedback"></div>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Description') %></label>
              <textarea name="description" class="form-control" rows="3" placeholder="<%= t('Notes about this cluster...') %>"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Systems') %></label>
              <select id="system-select" name="systems[]" class="form-select" multiple data-placeholder="<%= t('Select systems this cluster serves') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Members') %></label>
              <div id="member-rows"></div>
              <button type="button" id="add-member-row" class="btn btn-outline-primary btn-sm mt-1">
                <i class="bi bi-plus"></i> <%= t('Add Member') %>
              </button>
              <small class="d-block form-text text-muted mt-1"><%= t('Each member is an IP address with a role in this cluster (e.g. master, worker, primary, standby). Type a new role to add it — it becomes suggested for future clusters too.') %></small>

              <div class="border rounded p-2 mt-3">
                <label class="form-label mb-1"><%= t('Bulk-add members from a file') %></label>
                <div class="input-group input-group-sm">
                  <input type="file" id="member-file-input" class="form-control" accept=".xlsx,.xls">
                  <button type="button" id="validate-member-file-btn" class="btn btn-outline-warning" disabled>
                    <i class="bi bi-check2-circle"></i> <%= t('Validate File') %>
                  </button>
                  <a href="/cluster/member-template" class="btn btn-outline-info" download>
                    <i class="bi bi-download"></i> <%= t('Template') %>
                  </a>
                </div>
                <div class="form-text"><%= t('2 columns: IP Address (Require), Role (Optional). Every IP must already exist — this never creates IPs. Rows are only added once every row in the file passes.') %></div>
                <span id="add-validated-members-pointer" class="mt-2" style="display: none;">
                  <i class="bi bi-hand-index-thumb-fill blink-hand"></i>
                </span>
                <button type="button" id="add-validated-members-btn" class="btn btn-success btn-sm mt-2" style="display: none;">
                  <i class="bi bi-plus-circle"></i> <%= t('Add Validated Members') %>
                </button>
                <div id="member-file-results" class="alert mt-2" style="display: none;"></div>
              </div>
            </div>
          </div>
          <div class="card-footer d-flex justify-content-end">
            <a href="/cluster" class="btn btn-secondary btn-sm me-2"><%= t('Cancel') %></a>
            <button type="submit" class="btn btn-primary btn-sm"><%= t('Add Cluster') %></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<datalist id="role-options-list">
  <% (roleOptions || []).forEach(function(r) { %>
    <option value="<%= r %>"></option>
  <% }) %>
</datalist>

<style>
@media (max-width: 991.98px) {
  .card-footer.d-flex.justify-content-end {
    flex-direction: column !important;
    gap: 0.5rem !important;
    align-items: stretch !important;
  }
  .card-footer.d-flex.justify-content-end .btn {
    width: 100% !important;
    margin: 0 !important;
  }
  .card-footer.d-flex.justify-content-end .btn:first-child { order: 2 !important; }
  .card-footer.d-flex.justify-content-end .btn:last-child { order: 1 !important; }
}
.member-row .select2-container { flex: 1 1 auto; }

.blink-hand {
  color: #ffc107;
  font-size: 1.5rem;
  display: inline-block;
  animation: blink-hand-anim 1s steps(1, end) infinite;
}
@keyframes blink-hand-anim {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0.15; }
}
</style>

<script src="/vendor/jquery-3.6.0.min.js"></script>
<link href="/css/select2.min.css" rel="stylesheet" />
<link href="/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="/vendor/select2.min.js"></script>
<script src="/vendor/bootstrap.min.js"></script>
<link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />

<script>
  $(function() {
    $('#system-select').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select systems this cluster serves'),
      allowClear: true,
      width: '100%',
      ajax: {
        url: '/system/api/system',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        cache: true
      }
    });

    function downloadBlobResponse(data, xhr, fallbackName) {
      const contentType = xhr.getResponseHeader('Content-Type');
      const contentDisposition = xhr.getResponseHeader('Content-Disposition');
      if (!contentType || !contentType.includes('spreadsheetml.sheet')) return;
      const blob = new Blob([data], { type: contentType });
      const url = window.URL.createObjectURL(blob);
      let filename = fallbackName;
      if (contentDisposition) {
        const match = contentDisposition.match(/filename="(.+)"/);
        if (match) filename = match[1];
      }
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
    }

    // An IP already picked in one member row shouldn't be offered again in
    // another row's dropdown (a cluster member is one IP with one role).
    function getOtherSelectedIpIds(currentSelectEl) {
      const ids = [];
      $('.member-ip-select').each(function() {
        if (this === currentSelectEl[0]) return;
        const val = $(this).val();
        if (val) ids.push(String(val));
      });
      return ids;
    }

    let memberRowIndex = 0;
    function addMemberRow(preset) {
      const idx = memberRowIndex++;
      const row = $(
        '<div class="member-row d-flex gap-2 align-items-start mb-2">' +
          '<select class="form-select member-ip-select" name="member_ip_id" style="flex: 2 1 auto;"></select>' +
          '<input type="text" class="form-control member-role-input" name="member_role" list="role-options-list" placeholder="Role (e.g. master)" style="flex: 1 1 auto;">' +
          '<button type="button" class="btn btn-outline-danger btn-sm remove-member-row" title="Remove"><i class="bi bi-x-lg"></i></button>' +
        '</div>'
      );
      $('#member-rows').append(row);
      const ipSelect = row.find('.member-ip-select');
      ipSelect.select2({
        theme: 'bootstrap-5',
        placeholder: t('Select IP address'),
        allowClear: true,
        width: '100%',
        ajax: {
          url: '/network/api/ip-addresses',
          dataType: 'json',
          delay: 250,
          data: params => ({ search: params.term }),
          processResults: data => {
            const excluded = getOtherSelectedIpIds(ipSelect);
            return { results: data.filter(item => !excluded.includes(String(item.id))) };
          },
          cache: true
        }
      });
      if (preset && preset.ip_address_id) {
        const option = new Option(preset.ip, preset.ip_address_id, true, true);
        ipSelect.append(option).trigger('change');
      }
      if (preset && preset.role) {
        row.find('.member-role-input').val(preset.role);
      }
    }

    $('#add-member-row').on('click', function() { addMemberRow(null); });
    $(document).on('click', '.remove-member-row', function() {
      $(this).closest('.member-row').remove();
    });

    addMemberRow(null);

    // Cluster Name: warn immediately on blur if the name is already taken,
    // instead of only finding out after submitting the form.
    let nameCheckSeq = 0;
    $('#cluster-name-input').on('blur', function() {
      const name = $(this).val().trim();
      const $input = $(this);
      const $feedback = $('#cluster-name-feedback');
      if (!name) { $input.removeClass('is-invalid'); $feedback.hide(); return; }
      const seq = ++nameCheckSeq;
      $.get('/cluster/api/check-name', { name: name }, function(data) {
        if (seq !== nameCheckSeq) return; // a later blur already superseded this check
        if (data && data.available === false) {
          $input.addClass('is-invalid');
          $feedback.text('A cluster named "' + name + '" already exists.').show();
        } else {
          $input.removeClass('is-invalid');
          $feedback.hide();
        }
      });
    });

    // Bulk-add members from an IP/Role file - same two-step contract as the
    // list page's cluster import: Validate always downloads a row-by-row
    // report; rows are only handed to "Add Validated Members" when the
    // whole file passed (X-Resolved-Members), never partially.
    let selectedMemberFile = null;
    let resolvedMembersToAdd = null;

    function currentFormIpIds() {
      const ids = [];
      $('.member-ip-select').each(function() {
        const val = $(this).val();
        if (val) ids.push(val);
      });
      return ids;
    }

    $('#member-file-input').on('change', function() {
      selectedMemberFile = this.files[0];
      $('#validate-member-file-btn').prop('disabled', !selectedMemberFile);
      $('#add-validated-members-btn, #add-validated-members-pointer').hide();
      resolvedMembersToAdd = null;
    });

    $('#validate-member-file-btn').on('click', function() {
      if (!selectedMemberFile) return;
      const formData = new FormData();
      formData.append('file', selectedMemberFile);
      currentFormIpIds().forEach(function(id) { formData.append('existing_ip_ids', id); });

      const $btn = $(this);
      const $results = $('#member-file-results');
      $btn.prop('disabled', true);
      $('#add-validated-members-btn, #add-validated-members-pointer').hide();
      resolvedMembersToAdd = null;
      $results.hide();

      let nativeXhr;
      $.ajax({
        url: '/cluster/validate-members',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        xhr: function() {
          nativeXhr = new window.XMLHttpRequest();
          nativeXhr.responseType = 'blob';
          return nativeXhr;
        },
        success: function(data, status, xhr) {
          downloadBlobResponse(data, xhr, 'cluster_member_validation.xlsx');
          let summary = null;
          try { summary = JSON.parse(xhr.getResponseHeader('X-Validation-Summary')); } catch (e) {}

          if (summary && summary.allPassed) {
            try { resolvedMembersToAdd = JSON.parse(decodeURIComponent(xhr.getResponseHeader('X-Resolved-Members'))); } catch (e) { resolvedMembersToAdd = null; }
            $results.removeClass('alert-danger').addClass('alert-success')
              .html('<strong>Validation Complete!</strong><br><small>Total: ' + summary.total + ', Passed: ' + summary.passed + '</small><br><small>Validation file downloaded.</small>');
            if (resolvedMembersToAdd && resolvedMembersToAdd.length) $('#add-validated-members-btn, #add-validated-members-pointer').show();
          } else {
            const total = summary ? summary.total : '?';
            const failed = summary ? summary.failed : '?';
            $results.removeClass('alert-success').addClass('alert-danger')
              .html('<strong>Validation Failed!</strong><br><small>Total: ' + total + ', Failed: ' + failed + '</small><br><small>Validation file downloaded - fix the errors and try again. No members were added.</small>');
          }
          $results.show();
        },
        error: function(xhr) {
          extractImportErrorMessage(nativeXhr || xhr).then(function(msg) {
            $results.removeClass('alert-success').addClass('alert-danger').html('<strong>Validation Error!</strong><br>' + msg).show();
          });
        },
        complete: function() {
          $btn.prop('disabled', !selectedMemberFile);
        }
      });
    });

    $('#add-validated-members-btn').on('click', function() {
      if (!resolvedMembersToAdd) return;
      resolvedMembersToAdd.forEach(function(m) { addMemberRow(m); });
      $('#member-file-results').hide();
      $(this).hide();
      $('#add-validated-members-pointer').hide();
      $('#member-file-input').val('');
      selectedMemberFile = null;
      resolvedMembersToAdd = null;
      $('#validate-member-file-btn').prop('disabled', true);
    });
  });
</script>
