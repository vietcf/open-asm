<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">User List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
<div class="container-fluid">
  <!-- Search and Page Size Row -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end align-items-center gap-2">
        <form class="d-flex align-items-center gap-2" role="search" method="get" action="/administrator/users">
          <div class="input-group input-group-sm" style="width: 250px;">
            <input class="form-control form-control-sm" type="search" name="search" placeholder="Search users..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50,100]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                    <% }) %>
                  </select>
                </div>
              </form>
            </div>
          </div>
        </div>

    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission('user.create')) { %>
          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="bi bi-plus"></i> Add User
          </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= t(success) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= t(error) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">User List</h3>
          </div>
          <div class="card-body table-responsive p-0" style="max-height: 70vh; overflow-y: auto; overflow-x: auto;">
            <table class="table table-hover" id="userTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th data-sort-type="text">Username</th>
                  <th data-sort-type="text">Email</th>
                  <th data-sort-type="text">Full Name</th>
                  <th data-sort-type="text">Role</th>
                  <th data-sort-type="text">Auth</th>
                  <th data-sort-type="text">2FA</th>
                  <th data-sort-type="text">Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (userList && userList.length > 0) { %>
                  <% userList.forEach(function(user, idx) { %>
                    <tr>
                      <td><%= idx + 1 %></td>
                      <td><%= user.username %></td>
                      <td><%= user.email %></td>
                      <td><%= user.fullname || '-' %></td>
                      <td><%= user.role_name || '-' %></td>
                      <td>
                        <% if (user.auth_source === 'ldap') { %>
                          <span class="badge bg-info text-dark">LDAP</span>
                        <% } else { %>
                          <span class="badge bg-secondary">Local</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (user.require_twofa) { %>
                          <span class="badge bg-success">Enabled</span>
                        <% } else { %>
                          <span class="badge bg-secondary">Disabled</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (user.is_active) { %>
                          <span class="badge bg-success">Active</span>
                        <% } else { %>
                          <span class="badge bg-danger">Inactive</span>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <% if (hasPermission('user.update')) { %>
                        <button type="button" class="btn btn-info btn-sm me-1" data-bs-toggle="modal" data-bs-target="#userEditModal-<%= user.id %>" title="Edit">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <% } %>
                        <% if (hasPermission('user.delete')) { %>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#userDeleteModal-<%= user.id %>" title="Delete">
                          <i class="bi bi-trash"></i>
                        </button>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="9" class="text-center">No data</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range like IP address list
                  const userStartItem = (page - 1) * pageSize + 1;
                  const userEndItem = Math.min(page * pageSize, totalCount || 0);
                  const userStartPage = Math.max(1, page - 2);
                  const userEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= userStartItem %> - <%= userEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> users</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildUserFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const userFilterQuery = buildUserFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= userFilterQuery ? '&' + userFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (userStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= userFilterQuery ? '&' + userFilterQuery : '' %>">1</a></li>
                  <% if (userStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = userStartPage; i <= userEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= userFilterQuery ? '&' + userFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (userEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= userFilterQuery ? '&' + userFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= userFilterQuery ? '&' + userFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
  <!-- Add User Modal -->
  <% if (hasPermission('user.create')) { %>
  <div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addUserModalLabel">
            <i class="bi bi-plus-circle me-2"></i>Add User
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addUserForm" action="/administrator/users" method="POST">
            <div class="mb-3">
              <label class="form-label">Username <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="username" required pattern="^[a-zA-Z0-9_.-]{3,50}$" title="3-50 characters: letters, numbers, dots, hyphens, and underscores only (no spaces)" maxlength="50" placeholder="Enter username">
            </div>
            <div class="mb-3">
              <label class="form-label">Email <span class="text-danger">*</span></label>
              <input type="email" class="form-control" name="email" required placeholder="Enter email address">
            </div>
            <div class="mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control" name="fullname" placeholder="Enter full name">
            </div>
            <div class="mb-3">
              <label class="form-label">Role <span class="text-danger">*</span></label>
              <select class="form-select user-role-select2" name="role" required>
                <option value="">-- Select Role --</option>
                <% if (roles && roles.length) { roles.forEach(function(role) { %>
                  <option value="<%= role.id %>"><%= role.name %></option>
                <% }) } %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Authentication Method <span class="text-danger">*</span></label>
              <select class="form-select auth-source-select" name="auth_source">
                <option value="local" selected>Local</option>
                <option value="ldap">LDAP (Active Directory)</option>
              </select>
              <div class="form-text">LDAP users authenticate against AD using their sAMAccountName as username; no local password is stored.</div>
            </div>
            <div class="mb-3 auth-source-password-field">
              <label class="form-label">Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" name="password" required minlength="4" placeholder="Enter password">
            </div>
            <div class="mb-3">
              <label class="form-label">Require 2FA</label>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="require_twofa" checked>
                <label class="form-check-label">Enable Two-Factor Authentication</label>
              </div>
            </div>
            <div class="mb-3 auth-source-mcp-field">
              <label class="form-label">Must Change Password</label>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="must_change_password">
                <label class="form-check-label">Force password change on next login</label>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer d-flex justify-content-end">
          <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm" form="addUserForm">Add User</button>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Edit User Modals -->
  <% if (userList && userList.length > 0) { %>
    <% userList.forEach(function(user) { %>
      <div class="modal fade" id="userEditModal-<%= user.id %>" tabindex="-1" aria-labelledby="userEditModalLabel-<%= user.id %>" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="userEditModalLabel-<%= user.id %>">
                <i class="bi bi-pencil me-2"></i>Edit User: <%= user.username %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form id="editUserForm-<%= user.id %>" action="/administrator/users/<%= user.id %>?_method=PUT" method="POST">
                <div class="mb-3">
                  <label class="form-label">Username <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" name="username" value="<%= user.username %>" required pattern="^[a-zA-Z0-9_.-]{3,50}$" title="3-50 characters: letters, numbers, dots, hyphens, and underscores only (no spaces)" maxlength="50" placeholder="Enter username">
                </div>
                <div class="mb-3">
                  <label class="form-label">Email <span class="text-danger">*</span></label>
                  <input type="email" class="form-control" name="email" value="<%= user.email %>" required placeholder="Enter email address">
                </div>
                <div class="mb-3">
                  <label class="form-label">Full Name</label>
                  <input type="text" class="form-control" name="fullname" value="<%= user.fullname || '' %>" placeholder="Enter full name">
                </div>
                <div class="mb-3">
                  <label class="form-label">Role <span class="text-danger">*</span></label>
                  <select class="form-select user-role-select2" name="role" required>
                    <option value="">-- Select Role --</option>
                    <% if (roles && roles.length) { roles.forEach(function(role) { %>
                      <option value="<%= role.id %>" <%= user.role_id === role.id ? 'selected' : '' %>><%= role.name %></option>
                    <% }) } %>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label">Authentication Method <span class="text-danger">*</span></label>
                  <select class="form-select auth-source-select" name="auth_source">
                    <option value="local" <%= user.auth_source !== 'ldap' ? 'selected' : '' %>>Local</option>
                    <option value="ldap" <%= user.auth_source === 'ldap' ? 'selected' : '' %>>LDAP (Active Directory)</option>
                  </select>
                  <div class="form-text">LDAP users authenticate against AD using their sAMAccountName as username; no local password is stored.</div>
                </div>
                <div class="mb-3 auth-source-password-field">
                  <label class="form-label">New Password</label>
                  <input type="password" class="form-control" name="password" placeholder="Leave blank to keep current password" minlength="4">
                </div>
                <div class="mb-3 auth-source-password-field">
                  <label class="form-label">Repeat Password</label>
                  <input type="password" class="form-control" name="repeat_password" placeholder="Repeat new password" minlength="4">
                </div>
                <div class="mb-3">
                  <label class="form-label">Require 2FA</label>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="require_twofa" <%= user.require_twofa ? 'checked' : '' %>>
                    <label class="form-check-label">Enable Two-Factor Authentication</label>
                  </div>
                </div>
                <div class="mb-3 auth-source-mcp-field">
                  <label class="form-label">Must Change Password</label>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="must_change_password" <%= user.must_change_password ? 'checked' : '' %>>
                    <label class="form-check-label">Force password change on next login</label>
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label">Account Status</label>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="is_active" <%= user.is_active ? 'checked' : '' %>>
                    <label class="form-check-label">Active</label>
                  </div>
                </div>
              </form>
            </div>
            <div class="modal-footer d-flex justify-content-end">
              <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm" form="editUserForm-<%= user.id %>">Save Changes</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Delete User Modal -->
      <div class="modal fade" id="userDeleteModal-<%= user.id %>" tabindex="-1" aria-labelledby="userDeleteModalLabel-<%= user.id %>" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="userDeleteModalLabel-<%= user.id %>">Delete User</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p>Are you sure you want to delete user <strong><%= user.username %></strong>?</p>
              <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
              <form action="/administrator/users/<%= user.id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script>
// Role select styled like every other dropdown in the app (select2 instead
// of a plain native <select>) - one select2 per modal (Add + one per Edit
// modal), each scoped to its own modal for correct dropdown positioning.
// Deferred to document-ready: select2.min.js loads after this page's body
// content in the layout, so calling .select2() at parse time (before the
// script has loaded) throws "not a function" and leaves a plain <select>.
$(function() {
  $('.user-role-select2').each(function() {
    $(this).select2({
      theme: 'bootstrap-5',
      placeholder: 'Select role',
      allowClear: true,
      width: '100%',
      dropdownParent: $(this).closest('.modal')
    });
  });
});

// When an admin sets a new password for a user, nudge them to also force a
// change on next login — otherwise the admin-chosen password can persist
// indefinitely if they forget to tick the box separately.
$(document).on('input', '[id^="userEditModal-"] form input[name="password"]', function() {
  const $checkbox = $(this).closest('form').find('input[name="must_change_password"]');
  if (this.value.length > 0) {
    $checkbox.prop('checked', true);
  }
});

// LDAP accounts have no local password: grey out the password field(s) and
// "must change password" toggle whenever LDAP is selected, since AD owns
// authentication for these users, not this app.
function applyAuthSourceState($form) {
  const isLdap = $form.find('select[name="auth_source"]').val() === 'ldap';
  const $passwordFields = $form.find('.auth-source-password-field');
  const $mcpCheckbox = $form.find('.auth-source-mcp-field input[name="must_change_password"]');

  $passwordFields.find('input').prop('disabled', isLdap);
  $passwordFields.toggleClass('opacity-50', isLdap);
  if (isLdap) {
    $passwordFields.find('input').val('');
  }

  $mcpCheckbox.prop('disabled', isLdap);
  $mcpCheckbox.closest('.auth-source-mcp-field').toggleClass('opacity-50', isLdap);
  if (isLdap) {
    $mcpCheckbox.prop('checked', false);
  }
}

$(document).on('change', '.auth-source-select', function() {
  applyAuthSourceState($(this).closest('form'));
});

$(function() {
  $('form').each(function() {
    if ($(this).find('.auth-source-select').length) {
      applyAuthSourceState($(this));
    }
  });
});
</script>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#userTable {
  table-layout: fixed;
  min-width: 1000px;
}
#userTable thead th {
  white-space: nowrap;
}
#userTable th:nth-child(1), #userTable td:nth-child(1) { width: 4%; }
#userTable th:nth-child(2), #userTable td:nth-child(2) { width: 12%; }
#userTable th:nth-child(3), #userTable td:nth-child(3) { width: 18%; }
#userTable th:nth-child(4), #userTable td:nth-child(4) { width: 13%; }
#userTable th:nth-child(5), #userTable td:nth-child(5) { width: 11%; }
#userTable th:nth-child(6), #userTable td:nth-child(6) { width: 9%; }
#userTable th:nth-child(7), #userTable td:nth-child(7) { width: 9%; }
#userTable th:nth-child(8), #userTable td:nth-child(8) { width: 9%; }
#userTable th:nth-child(9), #userTable td:nth-child(9) { width: 15%; }

#userTable td:nth-child(2),
#userTable td:nth-child(3),
#userTable td:nth-child(4) {
  overflow-wrap: break-word;
}
#userTable td:nth-child(9) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>
