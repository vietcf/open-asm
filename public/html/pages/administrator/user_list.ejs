<%
  const f = filter;
  const activeFilterCount = [f.role_id.length, f.auth_source.length, f.status, f.twofa].filter(Boolean).length;
  const AUTH = [{ id: 'local', text: t('Local') }, { id: 'ldap', text: 'LDAP' }];
  const COLUMNS = [
    { key: 'username', label: 'Username', def: true, fixed: true },
    { key: 'fullname', label: 'Full Name', def: true },
    { key: 'email', label: 'Email', def: true },
    { key: 'role', label: 'Role', def: true },
    { key: 'unit', label: 'Unit', def: true },
    { key: 'auth', label: 'Sign-in', def: true },
    { key: 'twofa', label: '2FA', def: true },
    { key: 'status', label: 'Status', def: true },
    { key: 'created', label: 'Created At' },
  ];
  const badge = (cls, text) => `<span class="badge ${cls}">${ui.esc(text)}</span>`;
  const cell = (u, key) => ({
    username: ui.esc(u.username) + (u.id === currentUserId ? ` <small class="text-secondary">(${t('you')})</small>` : ''),
    fullname: ui.text(u.fullname),
    email: ui.text(u.email),
    role: ui.chips([u.role_name]),
    unit: u.unit_name ? ui.esc(u.unit_name) + (u.priv_unit_admin ? ` <span class="badge tag" title="${ui.esc(t('Manages the privileged accounts of their unit'))}"><i class="bi bi-key"></i></span>` : '') : ui.dash,
    auth: u.auth_source === 'ldap' ? badge('text-bg-info', 'LDAP') : badge('tag', t('Local')) + (u.must_change_password ? ` <i class="bi bi-key text-warning" title="${t('Must change password')}"></i>` : ''),
    twofa: u.twofa_enabled ? badge('text-bg-success', t('Enabled')) : (u.require_twofa ? badge('text-bg-warning', t('Pending setup')) : ui.dash),
    status: u.is_active ? badge('text-bg-success', t('Active')) : badge('text-bg-secondary', t('Inactive')),
    created: ui.date(u.created_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Administrator' }, { label: 'User Management' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/administrator/users">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by username, name, email, role...',
              filtersId: 'userFilters', activeFilterCount,
              columns: { tableId: 'userTable', storageKey: 'openasm.userList.columns', list: COLUMNS },
              addUrl: hasPermission('user.create') ? '/administrator/users/add' : null, addLabel: 'Add User' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="userFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-3">
                <label class="form-label small"><%= t('Role') %></label>
                <select name="role_id" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(roleOptions, f.role_id) %></select>
              </div>
              <div class="col-md-3">
                <label class="form-label small"><%= t('Sign-in') %></label>
                <select name="auth_source" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(AUTH, f.auth_source) %></select>
              </div>
              <div class="col-md-3">
                <label class="form-label small"><%= t('Status') %></label>
                <select name="status" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option>
                  <%- ui.options([{ id: 'active', text: t('Active') }, { id: 'inactive', text: t('Inactive') }], f.status) %></select>
              </div>
              <div class="col-md-3">
                <label class="form-label small">2FA</label>
                <select name="twofa" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option>
                  <%- ui.options([{ id: 'enabled', text: t('Enabled') }, { id: 'required', text: t('Pending setup') }, { id: 'off', text: t('Off') }], f.twofa) %></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="userTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (userList.length) { %>
              <% userList.forEach(function (u, idx) { %>
                <tr<%- u.is_active ? '' : ' class="text-secondary"' %>>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'username' ? ' class="fw-medium"' : '' %>><%- cell(u, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <% if (hasPermission('user.update')) { %>
                        <a href="/administrator/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('user.delete') && u.id !== currentUserId) { %>
                        <form action="/administrator/users/<%= u.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: u.username }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-people', message: 'No users found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/administrator/users',
                      actionUrl: hasPermission('user.create') ? '/administrator/users/add' : null, actionLabel: 'Add User' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: userList.length, summary: 'Showing {1} - {2} of {3} users' }) %>
    </div>
  </div>
</div>
