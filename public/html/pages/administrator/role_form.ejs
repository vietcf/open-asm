<%#
  Add / Edit Role.  mode, record (role), permissionGrid [{resource, actions: {read: perm, ...}}], actions
  Permissions as a resource x action grid of checkboxes (a column or row header ticks the whole column / row).
%>
<% const isEdit = mode === 'edit'; const r = locals.record || {}; const granted = new Set((r.permissions || []).map(p => p.id)); %>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'Role Management', href: '/administrator/roles' }, { label: isEdit ? 'Edit Role' : 'Add Role' }
] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>
    <form id="roleForm" class="card form-card" method="POST" action="<%= isEdit ? '/administrator/roles/' + r.id + '/edit' : '/administrator/roles/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit Role' : 'Add Role') %></h3>
      </div>
      <div class="card-body">
        <section class="form-section">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" for="f-name"><%= t('Role Name') %> <span class="text-danger">*</span></label>
              <input type="text" id="f-name" name="name" class="form-control" value="<%= r.name || '' %>" required maxlength="50">
            </div>
            <div class="col-md-8">
              <label class="form-label" for="f-description"><%= t('Description') %></label>
              <input type="text" id="f-description" name="description" class="form-control" value="<%= r.description || '' %>">
            </div>
          </div>
        </section>

        <section class="form-section">
          <h4 class="form-section-title"><%= t('Permissions') %> <span class="badge tag ms-1" id="permCount"><%= granted.size %></span></h4>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="permGrid">
              <thead>
                <tr>
                  <th><%= t('Resource') %></th>
                  <% actions.forEach(function (a) { %>
                    <th class="text-center"><button type="button" class="btn btn-link btn-sm p-0" data-toggle-col="<%= a %>"><%= t(a.charAt(0).toUpperCase() + a.slice(1)) %></button></th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% permissionGrid.forEach(function (g) { %>
                  <tr>
                    <td><button type="button" class="btn btn-link btn-sm p-0 text-reset font-monospace" data-toggle-row><%= g.resource %></button></td>
                    <% actions.forEach(function (a) { const p = g.actions[a]; %>
                      <td class="text-center">
                        <% if (p) { %>
                          <input class="form-check-input" type="checkbox" name="permissions" value="<%= p.id %>" data-col="<%= a %>" <%= granted.has(p.id) ? 'checked' : '' %>
                                 title="<%= p.name %><%= p.description ? ' - ' + p.description : '' %>">
                        <% } %>
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/administrator/roles', submitLabel: isEdit ? 'Save Changes' : 'Add Role' }) %>
    </form>
  </div>
</div>

<script>
  (function () {
    const grid = document.getElementById('permGrid');
    const count = () => { document.getElementById('permCount').textContent = grid.querySelectorAll('input:checked').length; };
    // a header ticks every box of its column / row (unticks when all are ticked)
    const toggle = (boxes) => { const on = boxes.some((b) => !b.checked); boxes.forEach((b) => { b.checked = on; }); count(); };
    grid.querySelectorAll('[data-toggle-col]').forEach((btn) => btn.addEventListener('click', () => toggle([...grid.querySelectorAll('input[data-col="' + btn.dataset.toggleCol + '"]')])));
    grid.querySelectorAll('[data-toggle-row]').forEach((btn) => btn.addEventListener('click', () => toggle([...btn.closest('tr').querySelectorAll('input')])));
    grid.addEventListener('change', count);
  })();
</script>
