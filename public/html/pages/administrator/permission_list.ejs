<%
  const COLUMNS = [
    { key: 'name', label: 'Permission Name', def: true, fixed: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'roles', label: 'Roles', def: true },
  ];
  const cell = (p, key) => ({
    name: `<span class="font-monospace">${ui.esc(p.name)}</span>`,
    description: ui.clip(p.description),
    roles: `<span class="badge tag">${p.role_count}</span>`,
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Administrator' }, { label: 'Permission Management' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/administrator/permissions">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name or description...',
              columns: { tableId: 'permissionTable', storageKey: 'openasm.permissionList.columns', list: COLUMNS },
              addUrl: hasPermission('permission.create') ? '/administrator/permissions/add' : null, addLabel: 'Add Permission' }) %>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="permissionTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (list.length) { %>
              <% list.forEach(function (p, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"><%- cell(p, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <% if (hasPermission('permission.update')) { %>
                        <a href="/administrator/permissions/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('permission.delete')) { %>
                        <form action="/administrator/permissions/<%= p.id %>/delete" method="POST"
                              data-confirm="<%= t('Delete {1}? Features checking this permission become unavailable to every role except superadmin.', { 1: p.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-key', message: 'No permissions found', filtered: !!search, clearUrl: '/administrator/permissions',
                      actionUrl: hasPermission('permission.create') ? '/administrator/permissions/add' : null, actionLabel: 'Add Permission' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: list.length, summary: 'Showing {1} - {2} of {3} permissions' }) %>
    </div>
  </div>
</div>
