<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item active"><%= t('Permission List') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
<div class="container-fluid">
  <!-- Search & Filter -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end gap-2">
        <form class="d-flex align-items-center gap-2" role="search" method="get" action="/administrator/permissions">
          <div class="input-group input-group-sm" style="width: 250px;">
            <input class="form-control form-control-sm" type="search" name="search" placeholder="<%= t('Search permissions...') %>" aria-label="<%= t('Search') %>" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted"><%= t('Show:') %></label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50,100]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
              <% }) %>
            </select>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end gap-2">
        <% if (hasPermission('permission.create')) { %>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPermissionModal">
          <i class="bi bi-plus"></i> <%= t('Add Permission') %>
        </button>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= t(success) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide success message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
    </script>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= t(error) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0"><%= t('Permission List') %></h3>
        </div>
        <div class="card-body table-responsive p-0" style="max-height: 70vh; overflow-y: auto; overflow-x: auto;">
          <table class="table table-hover" id="permissionTable">
            <thead>
              <tr>
                <th><%= t('No.') %></th>
                <th><%= t('Name') %></th>
                <th><%= t('Description') %></th>
                <th class="text-end"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (permissionList && permissionList.length > 0) { %>
                <% 
                  // Gom nhóm theo entity (prefix trước dấu .)
                  const permGroups = {};
                  permissionList.forEach(function(permission) {
                    const parts = permission.name.split('.');
                    const prefix = parts.length > 1 ? parts[0] : 'Other';
                    if (!permGroups[prefix]) permGroups[prefix] = [];
                    permGroups[prefix].push(permission);
                  });
                  Object.keys(permGroups).sort().forEach(function(prefix, groupIdx) {
                %>
                  <tr class="table-primary">
                    <td colspan="4" class="fw-bold"><%= prefix.charAt(0).toUpperCase() + prefix.slice(1).replace('_', ' ') %></td>
                  </tr>
                  <% permGroups[prefix].forEach(function(permission, idx) { %>
                    <tr>
                      <td><%= idx + 1 %></td>
                      <td><%= permission.name %></td>
                      <td><%= permission.description %></td>
                      <td class="text-end">
                        <% if (hasPermission('permission.update')) { %>
                        <button type="button" class="btn btn-warning btn-sm" title="<%= t('Edit') %>" data-bs-toggle="modal" data-bs-target="#permissionEditModal-<%= permission.id %>"><i class="bi bi-pencil"></i></button>
                        <% } %>
                        <% if (hasPermission('permission.delete')) { %>
                        <form action="/administrator/permissions/<%= permission.id %>?_method=DELETE" method="POST" style="display:inline">
                          <button type="submit" class="btn btn-danger btn-sm" title="<%= t('Delete') %>" onclick="return confirm('Are you sure you want to delete this permission?')"><i class="bi bi-trash"></i></button>
                        </form>
                        <% } %>
                      </td>
                    </tr>
                    <!-- Edit Permission Modal -->
                    <% if (hasPermission('permission.update')) { %>
                    <div class="modal fade" id="permissionEditModal-<%= permission.id %>" tabindex="-1" aria-labelledby="permissionEditModalLabel-<%= permission.id %>" aria-hidden="true">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <form action="/administrator/permissions/<%= permission.id %>/edit?_method=PUT" method="POST">
                            <input type="hidden" name="_method" value="PUT">
                            <div class="modal-header">
                              <h5 class="modal-title" id="permissionEditModalLabel-<%= permission.id %>"><%= t('Edit Permission') %></h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
                            </div>
                            <div class="modal-body">
                              <div class="mb-3">
                                <label class="form-label"><%= t('Name') %> <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control" value="<%= permission.name %>" readonly>
                              </div>
                              <div class="mb-3">
                                <label class="form-label"><%= t('Description') %></label>
                                <input type="text" name="description" class="form-control" value="<%= permission.description %>" placeholder="<%= t('Enter permission description') %>">
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Cancel') %></button>
                              <button type="submit" class="btn btn-primary btn-sm"><%= t('Save Changes') %></button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                    <% } %>
                  <% }) %>
                <% }); %>
              <% } else { %>
                <tr><td colspan="4" class="text-center"><%= t('No data') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <% 
                // Calculate pagination range like IP address list
                const permStartItem = (page - 1) * pageSize + 1;
                const permEndItem = Math.min(page * pageSize, totalCount || 0);
                const permStartPage = Math.max(1, page - 2);
                const permEndPage = Math.min(totalPages, page + 2);
              %>
              <span><%= t('Showing {1} - {2} of {3} permissions', { 1: permStartItem, 2: permEndItem, 3: typeof totalCount !== 'undefined' ? totalCount : 0 }) %></span>
            </div>
            <ul class="pagination pagination-sm m-0 float-end">
              <% 
                function buildPermissionFilterQuery() {
                  let params = [];
                  if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                  if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                  return params.join('&');
                }
                const permissionFilterQuery = buildPermissionFilterQuery();
              %>
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %><%= permissionFilterQuery ? '&' + permissionFilterQuery : '' %>" tabindex="-1"><%= t('Previous') %></a>
              </li>
              <% if (permStartPage > 1) { %>
                <li class="page-item"><a class="page-link" href="?page=1<%= permissionFilterQuery ? '&' + permissionFilterQuery : '' %>">1</a></li>
                <% if (permStartPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% } %>
              <% for (let i = permStartPage; i <= permEndPage; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= permissionFilterQuery ? '&' + permissionFilterQuery : '' %>"><%= i %></a></li>
              <% } %>
              <% if (permEndPage < totalPages) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= permissionFilterQuery ? '&' + permissionFilterQuery : '' %>"><%= totalPages %></a></li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %><%= permissionFilterQuery ? '&' + permissionFilterQuery : '' %>"><%= t('Next') %></a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
  <!-- Add Permission Modal -->
  <% if (hasPermission('permission.create')) { %>
  <div class="modal fade" id="addPermissionModal" tabindex="-1" aria-labelledby="addPermissionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addPermissionModalLabel">
            <i class="bi bi-plus-circle me-2"></i><%= t('Add Permission') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
        </div>
        <div class="modal-body">
          <form id="addPermissionForm" action="/administrator/permissions" method="POST">
            <div class="mb-3">
              <label class="form-label"><%= t('Name') %> <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="name" required pattern="^[a-zA-Z0-9_]+\.(read|create|update|delete)$" title="<%= t('Format: abc.read|abc.create|abc.update|abc.delete') %>" placeholder="<%= t('e.g. module.read') %>">
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Description') %></label>
              <input type="text" class="form-control" name="description" placeholder="<%= t('Enter permission description') %>">
            </div>
          </form>
        </div>
        <div class="modal-footer d-flex justify-content-end">
          <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal"><%= t('Cancel') %></button>
          <button type="submit" class="btn btn-primary btn-sm" form="addPermissionForm"><%= t('Add Permission') %></button>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#permissionTable {
  table-layout: fixed;
  min-width: 800px;
}
#permissionTable thead th {
  white-space: nowrap;
}
#permissionTable th:nth-child(1), #permissionTable td:nth-child(1) { width: 5%; }
#permissionTable th:nth-child(2), #permissionTable td:nth-child(2) { width: 30%; }
#permissionTable th:nth-child(3), #permissionTable td:nth-child(3) { width: 45%; }
#permissionTable th:nth-child(4), #permissionTable td:nth-child(4) { width: 20%; }

#permissionTable td:nth-child(3) {
  overflow-wrap: break-word;
}
#permissionTable td:nth-child(4) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>
