<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item active"><%= t('System Configuration') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
  <!-- Search and Page Size Row -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end align-items-center gap-2">
        <form class="d-flex align-items-center gap-2" role="search" method="get" action="/administrator/configuration">
          <div class="input-group input-group-sm" style="width: 250px;">
            <input class="form-control form-control-sm" type="search" name="search" placeholder="<%= t('Search Configuration...') %>" aria-label="<%= t('Search') %>" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted"><%= t('Show:') %></label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
              <% }) %>
            </select>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end gap-2">
        <% if (hasPermission('configuration.create')) { %>
          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addConfigModal">
            <i class="bi bi-plus"></i> <%= t('Add Configuration') %>
          </button>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= t(success) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide success message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
    </script>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= t(error) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0"><%= t('System Configuration') %></h3>
        </div>
        <div class="card-body table-responsive p-0" style="overflow-x: auto;">
          <table class="table table-hover" id="configTable">
            <thead>
              <tr>
                <th><%= t('No.') %></th>
                <th data-sort-type="text"><%= t('Key') %></th>
                <th data-sort-type="text"><%= t('Value') %></th>
                <th data-sort-type="text"><%= t('Description') %></th>
                <th class="text-end"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (configList && configList.length > 0) { %>
                <% configList.forEach(function(config, idx) { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td><%= config.key %></td>
                    <td>
                      <% if (typeof config.value === 'string' && config.value.length > 80) { %>
                        <%= config.value.substring(0, 80) %>...
                      <% } else { %>
                        <%= config.value %>
                      <% } %>
                    </td>
                    <td><%= config.description %></td>
                    <td class="text-end">
                      <a href="#" class="btn btn-info btn-sm" title="<%= t('Show') %>" data-bs-toggle="modal" data-bs-target="#configShowModal-<%= config.key %>"><i class="bi bi-eye"></i></a>
                      <% if (hasPermission('configuration.update')) { %>
                      <button type="button" class="btn btn-warning btn-sm" title="<%= t('Edit') %>" data-bs-toggle="modal" data-bs-target="#configEditModal-<%= config.key %>"><i class="bi bi-pencil"></i></button>
                      <% } %>
                      <% if (hasPermission('configuration.delete')) { %>
                      <button type="button" class="btn btn-danger btn-sm" title="<%= t('Delete') %>" data-bs-toggle="modal" data-bs-target="#configDeleteModal-<%= config.key %>"><i class="bi bi-trash"></i></button>
                      <% } %>
                    </td>
                  </tr>
                  <!-- Show Modal -->
                  <div class="modal fade" id="configShowModal-<%= config.key %>" tabindex="-1" aria-labelledby="configShowModalLabel-<%= config.key %>" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="configShowModalLabel-<%= config.key %>">
                            <i class="bi bi-gear-fill me-2"></i><%= t('Configuration Detail') %>
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
                        </div>
                        <div class="modal-body">
                          <dl class="row detail-dl">
                            <!-- Key Field -->
                            <dt class="col-sm-4"><%= t('Key') %></dt>
                            <dd class="col-sm-8">
                              <code class="fs-6 bg-light px-2 py-1 rounded"><%= config.key %></code>
                            </dd>

                            <!-- Value Field -->
                            <dt class="col-sm-4"><%= t('Value') %></dt>
                            <dd class="col-sm-8">
                              <% let parsed = null; let isJson = false;
                                 try { parsed = JSON.parse(config.value); isJson = true; } catch(e) { isJson = false; }
                              %>
                              <% if (isJson) { %>
                                <pre class="mb-0 small" style="white-space: pre-wrap; word-break: break-all; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 8px; max-height: 300px; overflow-y: auto;">
<%= JSON.stringify(parsed, null, 2) %>
                                </pre>
                              <% } else { %>
                                <div class="bg-light p-2 rounded border">
                                  <span class="small"><%= config.value %></span>
                                </div>
                              <% } %>
                            </dd>

                            <!-- Description Field -->
                            <dt class="col-sm-4"><%= t('Description') %></dt>
                            <dd class="col-sm-8">
                              <% if (config.description && config.description.trim()) { %>
                                <div class="bg-light p-2 rounded border">
                                  <span class="small"><%= config.description %></span>
                                </div>
                              <% } else { %>
                                <span class="text-muted fst-italic small"><%= t('No description provided') %></span>
                              <% } %>
                            </dd>
                          </dl>
                        </div>
                      <div class="modal-footer d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
                      </div>
                      </div>
                    </div>
                  </div>
                  <!-- Edit Modal -->
                  <% if (hasPermission('configuration.update')) { %>
                  <div class="modal fade" id="configEditModal-<%= config.key %>" tabindex="-1" aria-labelledby="configEditModalLabel-<%= config.key %>" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                      <div class="modal-content">
                        <form action="/administrator/configuration/<%= config.key %>?_method=PUT" method="POST">
                          <input type="hidden" name="key" value="<%= config.key %>">
                          <div class="modal-header">
                            <h5 class="modal-title" id="configEditModalLabel-<%= config.key %>">
                              <i class="bi bi-pencil-square me-2"></i><%= t('Edit Configuration') %>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
                          </div>
                          <div class="modal-body">
                            <div class="mb-3">
                              <label class="form-label"><%= t('Key') %></label>
                              <input type="text" class="form-control" name="key_display" value="<%= config.key %>" readonly>
                            </div>
                            <div class="mb-3">
                              <label class="form-label"><%= t('Value') %> <span class="text-danger">*</span></label>
                              <textarea class="form-control" name="value" rows="6" required placeholder='Enter value, example: [{ "value": "DC", "label": "Data Center DR" }, ...]'><%= config.value %></textarea>
                              <div class="form-text small"><%= t('You can enter JSON or multiple lines for list-type configurations.') %></div>
                            </div>
                            <div class="mb-3">
                              <label class="form-label"><%= t('Description') %></label>
                              <input type="text" class="form-control" name="description" value="<%= config.description || '' %>" placeholder="<%= t('Enter configuration description') %>">
                            </div>
                          </div>
                          <div class="modal-footer d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal"><%= t('Cancel') %></button>
                            <button type="submit" class="btn btn-primary btn-sm"><%= t('Save') %></button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                  <% } %>
                  
                  <!-- Delete Modal -->
                  <% if (hasPermission('configuration.delete')) { %>
                  <div class="modal fade" id="configDeleteModal-<%= config.key %>" tabindex="-1" aria-labelledby="configDeleteModalLabel-<%= config.key %>" aria-hidden="true">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="configDeleteModalLabel-<%= config.key %>">
                            <i class="bi bi-exclamation-triangle me-2 text-danger"></i><%= t('Delete Configuration') %>
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
                        </div>
                        <div class="modal-body">
                          <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong><%= t('Warning!') %></strong> <%= t('This action cannot be undone.') %>
                          </div>
                          <p><%= t('Are you sure you want to delete this configuration?') %></p>
                          <dl class="row detail-dl">
                            <dt class="col-sm-4"><%= t('Key') %></dt>
                            <dd class="col-sm-8"><code><%= config.key %></code></dd>
                            <dt class="col-sm-4"><%= t('Value') %></dt>
                            <dd class="col-sm-8">
                              <% if (typeof config.value === 'string' && config.value.length > 50) { %>
                                <%= config.value.substring(0, 50) %>...
                              <% } else { %>
                                <%= config.value %>
                              <% } %>
                            </dd>
                          </dl>
                        </div>
                        <div class="modal-footer d-flex justify-content-end">
                          <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal"><%= t('Cancel') %></button>
                          <form action="/administrator/configuration/<%= config.key %>?_method=DELETE" method="POST" style="display:inline">
                            <button type="submit" class="btn btn-danger btn-sm">
                              <i class="bi bi-trash me-1"></i><%= t('Delete') %>
                            </button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } %>
                <% }) %>
              <% } else { %>
                <tr><td colspan="4" class="text-center"><%= t('No configuration found') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <% 
                // Calculate pagination range like IP address list
                const configStartItem = (page - 1) * pageSize + 1;
                const configEndItem = Math.min(page * pageSize, totalCount || 0);
                const configStartPage = Math.max(1, page - 2);
                const configEndPage = Math.min(totalPages, page + 2);
              %>
              <span><%= t('Showing {1} - {2} of {3} configurations', { 1: configStartItem, 2: configEndItem, 3: typeof totalCount !== 'undefined' ? totalCount : 0 }) %></span>
            </div>
            <ul class="pagination pagination-sm m-0 float-end">
              <% 
                function buildConfigFilterQuery() {
                  let params = [];
                  if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                  if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                  return params.join('&');
                }
                const configFilterQuery = buildConfigFilterQuery();
              %>
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %><%= configFilterQuery ? '&' + configFilterQuery : '' %>" tabindex="-1"><%= t('Previous') %></a>
              </li>
              <% if (configStartPage > 1) { %>
                <li class="page-item"><a class="page-link" href="?page=1<%= configFilterQuery ? '&' + configFilterQuery : '' %>">1</a></li>
                <% if (configStartPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% } %>
              <% for (let i = configStartPage; i <= configEndPage; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= configFilterQuery ? '&' + configFilterQuery : '' %>"><%= i %></a></li>
              <% } %>
              <% if (configEndPage < totalPages) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= configFilterQuery ? '&' + configFilterQuery : '' %>"><%= totalPages %></a></li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %><%= configFilterQuery ? '&' + configFilterQuery : '' %>"><%= t('Next') %></a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>



  <!-- Add Configuration Modal -->
  <% if (hasPermission('configuration.create')) { %>
  <div class="modal fade" id="addConfigModal" tabindex="-1" aria-labelledby="addConfigModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addConfigModalLabel">
            <i class="bi bi-plus-circle me-2"></i><%= t('Add Configuration') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
        </div>
        <div class="modal-body">
          <form id="addConfigForm" action="/administrator/configuration" method="POST">
            <div class="mb-3">
              <label class="form-label"><%= t('Key') %> <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="key" placeholder="<%= t('Enter configuration key') %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Value') %> <span class="text-danger">*</span></label>
              <textarea class="form-control" name="value" rows="6" required placeholder='Enter value, example: [{ "value": "DC", "label": "Data Center DR" }, ...]'></textarea>
              <div class="form-text small"><%= t('You can enter JSON or multiple lines for list-type configurations.') %></div>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Description') %></label>
              <input type="text" class="form-control" name="description" placeholder="<%= t('Enter configuration description') %>">
            </div>
          </form>
        </div>
        <div class="modal-footer d-flex justify-content-end">
          <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal"><%= t('Cancel') %></button>
          <button type="submit" class="btn btn-primary btn-sm" form="addConfigForm"><%= t('Add Configuration') %></button>
        </div>
      </div>
    </div>
  </div>
  <% } %>
</div>
<script>

// Configuration management functionality

// Export functionality is now handled server-side

function validateConfigForm(form) {
  const key = form.key.value.trim();
  const value = form.value.value.trim();
  if (!key || !value) {
    alert(t('Key and Value are required!'));
    return false;
  }
  if (key === 'page_size') {
    // List of numbers, comma separated, strictly ascending
    const sizes = value.split(',').map(v => v.trim());
    if (!sizes.length || sizes.some(v => !/^\d+$/.test(v))) {
      alert(t('Page size must be a list of numbers, separated by commas.'));
      return false;
    }
    const nums = sizes.map(Number);
    for (let i = 1; i < nums.length; i++) {
      if (nums[i] <= nums[i-1]) {
        alert(t('Page size values must be sorted in ascending order.'));
        return false;
      }
    }
  } else if (key === 'log_level') {
    const allowed = ['info','warning','critical'];
    if (!allowed.includes(value)) {
      alert(t('Log level must be one of: info, warning, or critical.'));
      return false;
    }
  }
  return true;
}

            // Attach to add form
const addForm = document.querySelector('#addConfigModal form');
if (addForm) {
  addForm.onsubmit = function(e) {
    if (!validateConfigForm(this)) {
      e.preventDefault();
    }
  };
}

            // Attach to edit forms
const editForms = document.querySelectorAll('form[action="/administrator/configuration/update"]');
editForms.forEach(function(form) {
  form.onsubmit = function(e) {
    if (!validateConfigForm(this)) {
      e.preventDefault();
    }
  };
});
</script>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#configTable {
  table-layout: fixed;
  min-width: 900px;
}
#configTable thead th {
  white-space: nowrap;
}
#configTable th:nth-child(1), #configTable td:nth-child(1) { width: 5%; }
#configTable th:nth-child(2), #configTable td:nth-child(2) { width: 15%; }
#configTable th:nth-child(3), #configTable td:nth-child(3) { width: 35%; }
#configTable th:nth-child(4), #configTable td:nth-child(4) { width: 25%; }
#configTable th:nth-child(5), #configTable td:nth-child(5) { width: 20%; }

/* Value/Description columns: allow wrapping of long content, keep Actions on one line */
#configTable td:nth-child(3),
#configTable td:nth-child(4) {
  overflow-wrap: break-word;
  vertical-align: top;
}
#configTable td:nth-child(5) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>
