<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item active"><%= t('System Logs') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">

  <!-- Search & Filter -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
        <form class="d-flex flex-wrap justify-content-end align-items-center gap-2" role="search" method="get" action="/administrator/log">
          <!-- Date Range Picker -->
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted"><%= t('From:') %></label>
            <input type="date" class="form-control form-control-sm" name="dateFrom" value="<%= typeof dateFrom !== 'undefined' ? dateFrom : '' %>" style="width: 140px;">
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted"><%= t('To:') %></label>
            <input type="date" class="form-control form-control-sm" name="dateTo" value="<%= typeof dateTo !== 'undefined' ? dateTo : '' %>" style="width: 140px;">
          </div>
          <div class="input-group input-group-sm" style="width: 250px;">
            <input class="form-control form-control-sm" type="search" name="search" placeholder="<%= t('Search Logs...') %>" aria-label="<%= t('Search') %>" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted"><%= t('Show:') %></label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50,100]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
              <% }) %>
            </select>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= t(success) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide success message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
    </script>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= t(error) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0"><%= t('Recent System Logs') %></h3>
        </div>
        <div class="card-body table-responsive p-0" style="overflow-x: auto;">
          <table class="table table-hover" id="logTable">
            <thead>
              <tr>
                <th data-sort-type="date"><%= t('Time') %></th>
                <th data-sort-type="text"><%= t('User') %></th>
                <th data-sort-type="text"><%= t('Action') %></th>
                <th data-sort-type="text"><%= t('Status') %></th>
                <th data-sort-type="text"><%= t('Description') %></th>
                <th class="text-end"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(function(log) { %>
                  <tr>
                    <td data-sort-value="<%= log.created_at || '' %>"><%= log.created_at ? log.created_at.toLocaleString ? log.created_at.toLocaleString() : log.created_at : '' %></td>
                    <td><%= log.username || '' %></td>
                    <td><%= log.action || '' %></td>
                    <td><%= log.status || '' %></td>
                    <td><%= log.description || log.detail || '' %></td>
                    <td class="text-end">
                      <button type="button" class="btn btn-info btn-sm" title="<%= t('Show') %>" data-bs-toggle="modal" data-bs-target="#logDetailModal-<%= log.id %>"><i class="bi bi-eye"></i></button>
                    </td>
                  </tr>
                  <!-- Log Detail Modal -->
                  <div class="modal fade" id="logDetailModal-<%= log.id %>" tabindex="-1" aria-labelledby="logDetailModalLabel-<%= log.id %>" aria-hidden="true">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="logDetailModalLabel-<%= log.id %>"><%= t('Log Detail') %></h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
                        </div>
                        <div class="modal-body">
                          <dl class="row detail-dl">
                            <dt class="col-sm-4">ID</dt><dd class="col-sm-8"><%= log.id %></dd>
                            <dt class="col-sm-4"><%= t('Time') %></dt><dd class="col-sm-8"><%= log.created_at ? log.created_at.toLocaleString ? log.created_at.toLocaleString() : log.created_at : '' %></dd>
                            <dt class="col-sm-4"><%= t('User') %></dt><dd class="col-sm-8"><%= log.username || '' %></dd>
                            <dt class="col-sm-4"><%= t('User ID') %></dt><dd class="col-sm-8"><%= log.user_id || '' %></dd>
                            <dt class="col-sm-4">IP</dt><dd class="col-sm-8"><%= log.ip_address || '' %></dd>
                            <dt class="col-sm-4"><%= t('Action') %></dt><dd class="col-sm-8"><%= log.action || '' %></dd>
                            <dt class="col-sm-4"><%= t('Status') %></dt><dd class="col-sm-8"><%= log.status || '' %></dd>
                            <dt class="col-sm-4"><%= t('Object Type') %></dt><dd class="col-sm-8"><%= log.object_type || '' %></dd>
                            <dt class="col-sm-4"><%= t('Object ID') %></dt><dd class="col-sm-8"><%= log.object_id || '' %></dd>
                            <dt class="col-sm-4"><%= t('Description') %></dt><dd class="col-sm-8"><%= log.description || log.detail || '' %></dd>
                          </dl>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6" class="text-center"><%= t('No logs found') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <% 
                // Calculate pagination range like IP address list
                const logStartItem = (page - 1) * pageSize + 1;
                const logEndItem = Math.min(page * pageSize, totalCount || 0);
                const logStartPage = Math.max(1, page - 2);
                const logEndPage = Math.min(totalPages, page + 2);
              %>
              <span><%= t('Showing {1} - {2} of {3} logs', { 1: logStartItem, 2: logEndItem, 3: typeof totalCount !== 'undefined' ? totalCount : 0 }) %></span>
            </div>
            <ul class="pagination pagination-sm m-0 float-end">
              <% 
                function buildLogFilterQuery() {
                  let params = [];
                  if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                  if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                  if (typeof dateFrom !== 'undefined' && dateFrom) params.push('dateFrom=' + encodeURIComponent(dateFrom));
                  if (typeof dateTo !== 'undefined' && dateTo) params.push('dateTo=' + encodeURIComponent(dateTo));
                  return params.join('&');
                }
                const logFilterQuery = buildLogFilterQuery();
              %>
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %><%= logFilterQuery ? '&' + logFilterQuery : '' %>" tabindex="-1"><%= t('Previous') %></a>
              </li>
              <% if (logStartPage > 1) { %>
                <li class="page-item"><a class="page-link" href="?page=1<%= logFilterQuery ? '&' + logFilterQuery : '' %>">1</a></li>
                <% if (logStartPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% } %>
              <% for (let i = logStartPage; i <= logEndPage; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= logFilterQuery ? '&' + logFilterQuery : '' %>"><%= i %></a></li>
              <% } %>
              <% if (logEndPage < totalPages) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= logFilterQuery ? '&' + logFilterQuery : '' %>"><%= totalPages %></a></li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %><%= logFilterQuery ? '&' + logFilterQuery : '' %>"><%= t('Next') %></a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
<% if (success) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= t(success) %>', 'success');
    });
  </script>
<% } %>
<% if (error) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= t(error) %>', 'danger');
    });
  </script>
<% } %>

<!-- Responsive Tables CSS -->
<style>
/* Fixed proportional column widths — see network/ip_address_list.ejs for rationale. */
#logTable {
  table-layout: fixed;
  min-width: 900px;
}
#logTable thead th {
  white-space: nowrap;
}
#logTable th:nth-child(1), #logTable td:nth-child(1) { width: 16%; }
#logTable th:nth-child(2), #logTable td:nth-child(2) { width: 10%; }
#logTable th:nth-child(3), #logTable td:nth-child(3) { width: 10%; }
#logTable th:nth-child(4), #logTable td:nth-child(4) { width: 10%; }
#logTable th:nth-child(5), #logTable td:nth-child(5) { width: 44%; }
#logTable th:nth-child(6), #logTable td:nth-child(6) { width: 10%; }

#logTable td:nth-child(5) {
  overflow-wrap: break-word;
  vertical-align: top;
}
#logTable td:nth-child(6) {
  white-space: nowrap;
  vertical-align: middle;
}
</style>

<script>
$(document).ready(function() {
  // Date range picker functionality
  const dateFromInput = $('input[name="dateFrom"]');
  const dateToInput = $('input[name="dateTo"]');
  
  // Set max date for "From" field to today
  const today = new Date().toISOString().split('T')[0];
  dateFromInput.attr('max', today);
  dateToInput.attr('max', today);
  
  // Validate date range
  function validateDateRange() {
    const fromDate = dateFromInput.val();
    const toDate = dateToInput.val();
    
    if (fromDate && toDate && fromDate > toDate) {
      dateToInput[0].setCustomValidity('End date must be after start date');
      return false;
    } else {
      dateToInput[0].setCustomValidity('');
      return true;
    }
  }
  
  // Add validation on change
  dateFromInput.on('change', function() {
    validateDateRange();
    // Auto-submit form when date range changes
    if (dateFromInput.val() || dateToInput.val()) {
      $(this).closest('form').submit();
    }
  });
  
  dateToInput.on('change', function() {
    validateDateRange();
    // Auto-submit form when date range changes
    if (dateFromInput.val() || dateToInput.val()) {
      $(this).closest('form').submit();
    }
  });
  
  // Quick date range buttons
  function addQuickDateButtons() {
    const form = $('form[action="/administrator/log"]');
    const quickButtons = $(`
      <div class="d-flex flex-wrap align-items-center gap-1 ms-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="today">Today</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="yesterday">Yesterday</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="week">This Week</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="month">This Month</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-range="clear">Clear</button>
      </div>
    `);
    
    form.append(quickButtons);
    
    // Handle quick date buttons
    quickButtons.find('button').on('click', function() {
      const range = $(this).data('range');
      const today = new Date();
      
      switch(range) {
        case 'today':
          const todayStr = today.toISOString().split('T')[0];
          dateFromInput.val(todayStr);
          dateToInput.val(todayStr);
          break;
        case 'yesterday':
          const yesterday = new Date(today);
          yesterday.setDate(yesterday.getDate() - 1);
          const yesterdayStr = yesterday.toISOString().split('T')[0];
          dateFromInput.val(yesterdayStr);
          dateToInput.val(yesterdayStr);
          break;
        case 'week':
          const weekStart = new Date(today);
          weekStart.setDate(today.getDate() - today.getDay());
          const weekStartStr = weekStart.toISOString().split('T')[0];
          const todayStr2 = today.toISOString().split('T')[0];
          dateFromInput.val(weekStartStr);
          dateToInput.val(todayStr2);
          break;
        case 'month':
          const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
          const monthStartStr = monthStart.toISOString().split('T')[0];
          const todayStr3 = today.toISOString().split('T')[0];
          dateFromInput.val(monthStartStr);
          dateToInput.val(todayStr3);
          break;
        case 'clear':
          dateFromInput.val('');
          dateToInput.val('');
          break;
      }
      
      // Submit form after setting dates
      if (range !== 'clear') {
        form.submit();
      } else {
        // For clear, submit to remove date filters
        form.submit();
      }
    });
  }
  
  // Add quick date buttons
  addQuickDateButtons();
});
</script>
