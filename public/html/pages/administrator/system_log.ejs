<%#
  System Log: two tabs (application log / security audit) over system_log,
  list-kit layout (toolbar, collapsible filters, column chooser, stacked
  rows on phones, pagination). Read-only.
%>
<%
  const isSecurity = filter.category === 'security';
  const activeFilterCount = ['dateFrom', 'dateTo', 'username', 'action', 'objectType', 'status', 'level', 'ip'].filter(k => filter[k]).length;
  const hasActiveFilter = activeFilterCount > 0;
  const tabUrl = cat => '/administrator/log?category=' + cat;
  // currentQuery keeps tab + filters (the form always submits category)
  const exportUrl = '/administrator/log/export' + (currentQuery || '?category=' + filter.category);
  const fmtTime = d => {
    if (!d) return '';
    const x = new Date(d), p = n => String(n).padStart(2, '0');
    return `${x.getFullYear()}-${p(x.getMonth() + 1)}-${p(x.getDate())} ${p(x.getHours())}:${p(x.getMinutes())}:${p(x.getSeconds())}`;
  };
  const statusBadge = s => !s ? '' : (/^(failed|failure|error|denied)$/i.test(s) ? 'bg-danger' : (/^success$/i.test(s) ? 'bg-success' : 'tag'));
  const levelBadge = l => l === 'critical' ? 'bg-danger' : (l === 'warning' ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : 'tag');
  const COLUMNS = [
    { key: 'time', label: 'Time', def: true, fixed: true },
    { key: 'user', label: 'User', def: true },
    { key: 'action', label: 'Action', def: true },
    { key: 'object', label: 'Object', def: true },
    { key: 'status', label: 'Result', def: true },
    { key: 'level', label: 'Severity' },
    { key: 'ip', label: 'IP Address', def: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'agent', label: 'User agent' },
  ];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Administration' }, { label: 'System Log' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <ul class="nav nav-tabs config-tabs mb-3">
      <li class="nav-item">
        <a class="nav-link<%= !isSecurity ? ' active' : '' %>" href="<%= tabUrl('app') %>"<%- !isSecurity ? ' aria-current="page"' : '' %>><i class="bi bi-journal-text me-1"></i><%= t('Application log') %></a>
      </li>
      <li class="nav-item">
        <a class="nav-link<%= isSecurity ? ' active' : '' %>" href="<%= tabUrl('security') %>"<%- isSecurity ? ' aria-current="page"' : '' %>><i class="bi bi-shield-lock me-1"></i><%= t('Security audit') %></a>
      </li>
    </ul>
    <p class="text-secondary small mb-3">
      <%= isSecurity
        ? t('Sign-in and sign-out, 2FA, password changes and every change to users, roles, permissions and system configuration.')
        : t('Changes to assets and other data (create, update, delete, import), by the web interface and the REST API.') %>
    </p>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/administrator/log">
        <input type="hidden" name="category" value="<%= filter.category %>">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <div class="card-header list-toolbar">
          <div class="input-group list-search">
            <input class="form-control" type="search" name="search" value="<%= filter.search %>" placeholder="<%= t('Search user, action, object, IP, description...') %>" aria-label="<%= t('Search') %>">
            <button class="btn btn-outline-secondary" type="submit" title="<%= t('Search') %>"><i class="bi bi-search"></i></button>
          </div>
          <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#logFilters" aria-expanded="<%= hasActiveFilter %>">
            <i class="bi bi-funnel"></i> <%= t('Filter') %><% if (activeFilterCount) { %> <span class="badge rounded-pill"><%= activeFilterCount %></span><% } %>
          </button>
          <div class="list-actions">
            <div class="dropdown">
              <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="<%= t('Columns') %>">
                <i class="bi bi-layout-three-columns"></i><span class="btn-text"> <%= t('Columns') %></span>
              </button>
              <div class="dropdown-menu dropdown-menu-end columns-menu" id="logColumnsMenu">
                <div class="dropdown-header"><%= t('Show columns') %></div>
                <% COLUMNS.forEach(function (c) { %>
                  <label class="dropdown-item form-check mb-0">
                    <input type="checkbox" class="form-check-input" data-col="<%= c.key %>" <%= c.def || c.fixed ? 'checked' : '' %> <%= c.fixed ? 'disabled' : '' %>>
                    <span class="form-check-label"><%= t(c.label) %></span>
                  </label>
                <% }) %>
                <div class="dropdown-divider"></div>
                <button type="button" class="dropdown-item small" data-columns-reset><i class="bi bi-arrow-counterclockwise me-1"></i><%= t('Reset to default') %></button>
              </div>
            </div>
            <a href="<%= exportUrl %>" class="btn btn-outline-secondary" title="<%= t('Export') %>"><i class="bi bi-download"></i><span class="btn-text"> <%= t('Export') %></span></a>
          </div>
        </div>
        <div class="collapse<%= hasActiveFilter ? ' show' : '' %>" id="logFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="f-from"><%= t('From date') %></label>
                <input type="date" id="f-from" name="dateFrom" class="form-control js-filter-input" value="<%= filter.dateFrom %>">
              </div>
              <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="f-to"><%= t('To date') %></label>
                <input type="date" id="f-to" name="dateTo" class="form-control js-filter-input" value="<%= filter.dateTo %>">
              </div>
              <% [
                   { name: 'username', label: 'User', values: options.usernames, current: filter.username },
                   { name: 'action', label: 'Action', values: options.actions, current: filter.action },
                   { name: 'object_type', label: 'Object', values: options.objectTypes, current: filter.objectType },
                   { name: 'status', label: 'Result', values: options.statuses, current: filter.status },
                   { name: 'level', label: 'Severity', values: options.levels, current: filter.level },
                 ].forEach(function (f) { %>
                <div class="col-6 col-md-3 col-xl-2">
                  <label class="form-label small"><%= t(f.label) %></label>
                  <select name="<%= f.name %>" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                    <option value=""></option>
                    <% (f.values || []).forEach(function (v) { %>
                      <option value="<%= v %>" <%= f.current === v ? 'selected' : '' %>><%= t(v) %></option>
                    <% }) %>
                  </select>
                </div>
              <% }) %>
              <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label small" for="f-ip"><%= t('IP Address') %></label>
                <input type="text" id="f-ip" name="ip" class="form-control js-filter-input" value="<%= filter.ip %>" placeholder="10.0.">
              </div>
            </div>
            <div class="mt-2 d-flex justify-content-end gap-3">
              <% [['Today', 0], ['Last 7 days', 6], ['Last 30 days', 29]].forEach(function (r) { %>
                <a href="#" class="small" data-date-range="<%= r[1] %>"><%= t(r[0]) %></a>
              <% }) %>
              <% if (hasActiveFilter) { %>
                <a href="<%= tabUrl(filter.category) %>" class="small"><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a>
              <% } %>
            </div>
          </div>
        </div>
      </form>

      <%# hidden by default; !important wins over the layout's mobile table CSS %>
      <style id="logColumnsStyle">
        <%= COLUMNS.filter(c => !c.def).map(c => '#logTable [data-col="' + c.key + '"]').join(', ') %> { display: none !important; }
      </style>
      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="logTable">
          <thead>
            <tr>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% if (logs && logs.length) { %>
              <% logs.forEach(function (log) { %>
                <tr>
                  <%# the time cell is the card title on phones (.stack-title) %>
                  <td data-col="time" class="text-nowrap font-monospace small stack-title"><%= fmtTime(log.created_at) %></td>
                  <td data-col="user" data-label="<%= t('User') %>"><%= log.username || '—' %></td>
                  <td data-col="action" data-label="<%= t('Action') %>"><span class="badge tag"><%= t(log.action) %></span></td>
                  <td data-col="object" data-label="<%= t('Object') %>">
                    <% if (log.object_type) { %><%= log.object_type %><% if (log.object_id) { %> <span class="text-secondary">#<%= log.object_id %></span><% } %><% } else { %><span class="text-secondary">—</span><% } %>
                  </td>
                  <td data-col="status" data-label="<%= t('Result') %>"><% if (log.status) { %><span class="badge <%= statusBadge(log.status) %>"><%= t(log.status) %></span><% } else { %><span class="text-secondary">—</span><% } %></td>
                  <td data-col="level" data-label="<%= t('Severity') %>"><span class="badge <%= levelBadge(log.level) %>"><%= t(log.level) %></span></td>
                  <td data-col="ip" data-label="<%= t('IP Address') %>" class="font-monospace small"><%= log.ip_address || '—' %></td>
                  <td data-col="description" data-label="<%= t('Description') %>"><span class="cell-clip" title="<%= log.description %>"><%= log.description %></span></td>
                  <td data-col="agent" data-label="<%= t('User agent') %>"><span class="cell-clip small text-secondary" title="<%= log.user_agent %>"><%= log.user_agent || '—' %></span></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length %>">
                <%- include('../../partials/ui/empty_state', { icon: isSecurity ? 'bi-shield-lock' : 'bi-journal-text', message: 'No log entries found', filtered: hasActiveFilter || !!filter.search, clearUrl: tabUrl(filter.category) }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (logs || []).length, summary: 'Showing {1} - {2} of {3} entries' }) %>
    </div>
  </div>
</div>

<script>
  (function () {
    // Column chooser, same behaviour as the System List (per browser).
    var KEY = 'openasm.systemLog.columns';
    var columns = <%- jsonSafe(COLUMNS.map(c => ({ key: c.key, def: !!c.def, fixed: !!c.fixed }))) %>;
    var defaults = columns.filter(function (c) { return c.def; }).map(function (c) { return c.key; });
    var style = document.getElementById('logColumnsStyle');
    var menu = document.getElementById('logColumnsMenu');
    function load() {
      try { var saved = JSON.parse(localStorage.getItem(KEY) || 'null'); if (Array.isArray(saved)) return saved; } catch (e) { /* storage unavailable */ }
      return defaults;
    }
    function apply(visible) {
      var hidden = columns.filter(function (c) { return !c.fixed && visible.indexOf(c.key) === -1; });
      style.textContent = hidden.length ? hidden.map(function (c) { return '#logTable [data-col="' + c.key + '"]'; }).join(', ') + ' { display: none !important; }' : '';
      menu.querySelectorAll('input[data-col]').forEach(function (box) { box.checked = box.disabled || visible.indexOf(box.dataset.col) !== -1; });
    }
    var visible = load();
    apply(visible);
    menu.addEventListener('change', function (e) {
      if (!e.target.matches('input[data-col]')) return;
      visible = columns.filter(function (c) { var b = menu.querySelector('input[data-col="' + c.key + '"]'); return c.fixed || (b && b.checked); }).map(function (c) { return c.key; });
      try { localStorage.setItem(KEY, JSON.stringify(visible)); } catch (err) { /* ignore */ }
      apply(visible);
    });
    menu.querySelector('[data-columns-reset]').addEventListener('click', function () {
      visible = defaults.slice();
      try { localStorage.removeItem(KEY); } catch (err) { /* ignore */ }
      apply(visible);
    });

    // Date / IP inputs submit on change; quick date ranges fill both dates.
    var form = document.querySelector('.list-filter-form');
    form.querySelectorAll('.js-filter-input').forEach(function (input) {
      input.addEventListener('change', function () { form.submit(); });
    });
    form.querySelectorAll('[data-date-range]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        var p = function (n) { return String(n).padStart(2, '0'); };
        var day = function (d) { return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()); };
        var to = new Date();
        var from = new Date(); from.setDate(to.getDate() - Number(link.dataset.dateRange));
        form.elements.dateFrom.value = day(from);
        form.elements.dateTo.value = day(to);
        form.submit();
      });
    });
  })();
</script>
