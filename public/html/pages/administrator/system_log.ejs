<div class="container-fluid">
  <!-- Breadcrumb -->
  <div class="row mb-3">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/administrator">Administrator</a></li>
          <li class="breadcrumb-item active" aria-current="page">System Logs</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Search & Filter -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end align-items-center gap-2">
        <form class="d-flex align-items-center gap-2" role="search" method="get" action="/administrator/log">
          <div class="input-group input-group-sm" style="width: 250px;">
            <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Logs..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50,100]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
              <% }) %>
            </select>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <script>
      // Auto-hide success message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
    </script>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0">Recent System Logs</h3>
        </div>
        <div class="card-body table-responsive p-0" style="max-height: 70vh; overflow-y: auto; overflow-x: auto;">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Time</th>
                <th>User</th>
                <th>Action</th>
                <th>Status</th>
                <th>Description</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(function(log) { %>
                  <tr>
                    <td><%= log.created_at ? log.created_at.toLocaleString ? log.created_at.toLocaleString() : log.created_at : '' %></td>
                    <td><%= log.username || '' %></td>
                    <td><%= log.action || '' %></td>
                    <td><%= log.status || '' %></td>
                    <td><%= log.description || log.detail || '' %></td>
                    <td class="text-end">
                      <button type="button" class="btn btn-info btn-sm" title="Show" data-bs-toggle="modal" data-bs-target="#logDetailModal-<%= log.id %>"><i class="bi bi-eye"></i></button>
                    </td>
                  </tr>
                  <!-- Log Detail Modal -->
                  <div class="modal fade" id="logDetailModal-<%= log.id %>" tabindex="-1" aria-labelledby="logDetailModalLabel-<%= log.id %>" aria-hidden="true">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="logDetailModalLabel-<%= log.id %>">Log Detail</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                          <dl class="row mb-0">
                            <dt class="col-sm-4">ID</dt><dd class="col-sm-8"><%= log.id %></dd>
                            <dt class="col-sm-4">Time</dt><dd class="col-sm-8"><%= log.created_at ? log.created_at.toLocaleString ? log.created_at.toLocaleString() : log.created_at : '' %></dd>
                            <dt class="col-sm-4">User</dt><dd class="col-sm-8"><%= log.username || '' %></dd>
                            <dt class="col-sm-4">User ID</dt><dd class="col-sm-8"><%= log.user_id || '' %></dd>
                            <dt class="col-sm-4">IP</dt><dd class="col-sm-8"><%= log.ip_address || '' %></dd>
                            <dt class="col-sm-4">Action</dt><dd class="col-sm-8"><%= log.action || '' %></dd>
                            <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><%= log.status || '' %></dd>
                            <dt class="col-sm-4">Object Type</dt><dd class="col-sm-8"><%= log.object_type || '' %></dd>
                            <dt class="col-sm-4">Object ID</dt><dd class="col-sm-8"><%= log.object_id || '' %></dd>
                            <dt class="col-sm-4">Description</dt><dd class="col-sm-8"><%= log.description || log.detail || '' %></dd>
                          </dl>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6" class="text-center">No logs found</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <% 
                // Calculate pagination range like IP address list
                const logStartItem = (page - 1) * pageSize + 1;
                const logEndItem = Math.min(page * pageSize, totalCount || 0);
                const logStartPage = Math.max(1, page - 2);
                const logEndPage = Math.min(totalPages, page + 2);
              %>
              <span>Showing <%= logStartItem %> - <%= logEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> logs</span>
            </div>
            <ul class="pagination pagination-sm m-0 float-end">
              <% 
                function buildLogFilterQuery() {
                  let params = [];
                  if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                  if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                  return params.join('&');
                }
                const logFilterQuery = buildLogFilterQuery();
              %>
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %><%= logFilterQuery ? '&' + logFilterQuery : '' %>" tabindex="-1">Previous</a>
              </li>
              <% if (logStartPage > 1) { %>
                <li class="page-item"><a class="page-link" href="?page=1<%= logFilterQuery ? '&' + logFilterQuery : '' %>">1</a></li>
                <% if (logStartPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% } %>
              <% for (let i = logStartPage; i <= logEndPage; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= logFilterQuery ? '&' + logFilterQuery : '' %>"><%= i %></a></li>
              <% } %>
              <% if (logEndPage < totalPages) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= logFilterQuery ? '&' + logFilterQuery : '' %>"><%= totalPages %></a></li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %><%= logFilterQuery ? '&' + logFilterQuery : '' %>">Next</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% if (success) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= success %>', 'success');
    });
  </script>
<% } %>
<% if (error) { %>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      showToast('<%= error %>', 'danger');
    });
  </script>

<!-- Responsive Tables CSS -->
<% } %>
