<%
  const COLUMNS = [
    { key: 'name', label: 'Role Name', def: true, fixed: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'permissions', label: 'Permissions', def: true },
    { key: 'users', label: 'Users', def: true },
  ];
  const cell = (r, key) => ({
    name: ui.esc(r.name) + ((locals.builtinRoles || [superadmin]).includes(r.name) ? ` <i class="bi bi-lock text-secondary" title="${t('Built-in role')}"></i>` : ''),
    description: ui.clip(r.description),
    permissions: `<span class="badge tag">${r.permissions.length}</span>`,
    users: r.user_count ? `<a href="/administrator/users?role_id=${r.id}"><span class="badge tag">${r.user_count}</span></a>` : ui.dash,
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Administrator' }, { label: 'Role Management' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/administrator/roles">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by role, description, permission...',
              columns: { tableId: 'roleTable', storageKey: 'openasm.roleList.columns', list: COLUMNS },
              addUrl: hasPermission('role.create') ? '/administrator/roles/add' : null, addLabel: 'Add Role' }) %>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="roleTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (list.length) { %>
              <% list.forEach(function (r, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(r, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <% if (!(locals.builtinRoles || [superadmin]).includes(r.name) && hasPermission('role.update')) { %>
                        <a href="/administrator/roles/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (!(locals.builtinRoles || [superadmin]).includes(r.name) && hasPermission('role.delete')) { %>
                        <form action="/administrator/roles/<%= r.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: r.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-person-badge', message: 'No roles found', filtered: !!search, clearUrl: '/administrator/roles',
                      actionUrl: hasPermission('role.create') ? '/administrator/roles/add' : null, actionLabel: 'Add Role' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: list.length, summary: 'Showing {1} - {2} of {3} roles' }) %>
    </div>
  </div>
</div>
