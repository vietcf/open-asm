<%#
  Backup & Restore.  backups [{name, kind, size, created_at}], settings {enabled, frequency, hour, retention},
  directory, busy (running operation or null), restoreWord (what to type to confirm a restore)
%>
<%
  const KIND_LABEL = { scheduled: 'Scheduled', manual: 'Manual', 'pre-restore': 'Before restore', upload: 'Uploaded' };
  const size = (b) => (b >= 1073741824 ? (b / 1073741824).toFixed(2) + ' GB' : (b / 1048576).toFixed(2) + ' MB');
  const when = (d) => new Date(d).toLocaleString(lang === 'vi' ? 'vi-VN' : 'en-GB', { hour12: false });
  const canCreate = hasPermission('backup.create');
  const canRestore = hasPermission('backup.restore');
  const canDelete = hasPermission('backup.delete');
  const schedule = settings.enabled
    ? t('{frequency} at {hour}:00, keeping {count}', { frequency: t(settings.frequency), hour: String(settings.hour).padStart(2, '0'), count: settings.retention })
    : t('Off');
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Backup & Restore' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>
    <% if (busy) { %>
      <div class="alert alert-info"><i class="bi bi-hourglass-split me-2"></i><%= t('A {operation} is already running', { operation: t(busy) }) %></div>
    <% } %>

    <% if (canRestore) { %>
      <div class="alert alert-warning mb-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong><%= t('Restoring replaces the ENTIRE database.') %></strong>
        <%= t('All data saved after the backup was made will be lost. User accounts revert to their state at backup time — if you cannot sign in afterwards, use the CLI to reset your password:') %>
        <div class="font-monospace small mt-2 p-2 bg-body-secondary rounded">docker compose exec app node migrations/tools/reset_admin_password.js [username] [--disable-2fa]</div>
      </div>
    <% } %>

    <!-- ===== Backups: one list; each row downloads, restores or deletes its file ===== -->
    <div class="card list-card">
      <div class="card-header list-toolbar">
        <div class="me-auto">
          <div class="small text-secondary">
            <i class="bi bi-clock-history me-1"></i><%= t('Schedule') %>: <strong><%= schedule %></strong>
            <% if (hasPermission('configuration.read')) { %><a href="/administrator/configuration/backup" class="ms-2"><%= t('Change settings') %></a><% } %>
          </div>
          <div class="small text-secondary"><i class="bi bi-folder2 me-1"></i><%= t('Stored in') %> <span class="font-monospace"><%= directory %></span></div>
        </div>
        <div class="list-actions">
          <% if (canRestore) { %>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#restoreModal"<%= busy ? ' disabled' : '' %>><i class="bi bi-arrow-counterclockwise"></i> <span class="btn-text"><%= t('Restore from file') %></span></button>
          <% } %>
          <% if (canCreate) { %>
            <form method="POST" action="/backup/create" data-confirm="<%= t('Create a backup now?') %>">
              <button type="submit" class="btn btn-primary"<%= busy ? ' disabled' : '' %>><i class="bi bi-database-add"></i> <%= t('Back up now') %></button>
            </form>
          <% } %>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack">
          <thead>
            <tr>
              <th><%= t('File') %></th><th><%= t('Type') %></th><th><%= t('Created') %></th><th><%= t('Size') %></th>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (backups.length) { %>
              <% backups.forEach(function (b) { %>
                <tr>
                  <td class="font-monospace small" data-label="<%= t('File') %>"><%= b.name %></td>
                  <td data-label="<%= t('Type') %>"><%- ui.chips([t(KIND_LABEL[b.kind])]) %></td>
                  <td data-label="<%= t('Created') %>"><span class="text-nowrap small"><%= when(b.created_at) %></span></td>
                  <td data-label="<%= t('Size') %>"><span class="text-nowrap small"><%= size(b.size) %></span></td>
                  <td class="col-actions">
                    <div class="row-actions">
                      <a href="/backup/<%= encodeURIComponent(b.name) %>/download" class="btn btn-sm btn-outline-secondary" title="<%= t('Download') %>"><i class="bi bi-download"></i></a>
                      <% if (canDelete) { %>
                        <form action="/backup/<%= encodeURIComponent(b.name) %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: b.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5"><%- include('../../partials/ui/empty_state', { icon: 'bi-database', message: 'No backups yet', filtered: false }) %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% if (canRestore) { %>
<%# Restore = upload a .sql / .sql.gz file and replace the database with it (typed confirmation) %>
<div class="modal fade" id="restoreModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="POST" action="/backup/restore" enctype="multipart/form-data" id="restoreForm">
      <div class="modal-header">
        <h5 class="modal-title"><%= t('Restore from file') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-danger mb-3">
          <i class="bi bi-exclamation-triangle me-2"></i><%= t('Restoring replaces ALL current data with the contents of this backup. Everything saved after it was made is lost. A copy of the current data is saved first.') %>
        </div>
        <label class="form-label" for="restoreFile"><%= t('Backup file (.sql or .sql.gz from pg_dump, e.g. one downloaded from this list)') %></label>
        <input type="file" id="restoreFile" name="file" class="form-control mb-3" accept=".sql,.gz" required>
        <label class="form-label" for="restoreConfirm"><%= t('Type {word} to confirm', { word: restoreWord }) %></label>
        <input type="text" id="restoreConfirm" name="confirm" class="form-control" autocomplete="off" required>
        <div class="form-text"><%= t('This can take a while. Keep this page open until it finishes.') %></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('Cancel') %></button>
        <button type="submit" class="btn btn-danger" id="restoreSubmit" disabled><i class="bi bi-arrow-counterclockwise"></i> <%= t('Restore') %></button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('restoreForm');
    const file = document.getElementById('restoreFile');
    const input = document.getElementById('restoreConfirm');
    const submit = document.getElementById('restoreSubmit');
    const WORD = <%- jsonSafe(restoreWord) %>;
    const check = function () { submit.disabled = !(file.files.length && input.value === WORD); };
    file.addEventListener('change', check);
    input.addEventListener('input', check);
    document.getElementById('restoreModal').addEventListener('show.bs.modal', function () { form.reset(); check(); });
    form.addEventListener('submit', function () {
      submit.disabled = true;
      submit.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + <%- jsonSafe(t('Restoring...')) %>;
    });
  });
</script>
<% } %>
