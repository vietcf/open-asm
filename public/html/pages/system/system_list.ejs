<%
  const hasActiveFilter = !!(filterTags.length || filterContacts.length || filterScopes.length ||
    filterArchitecture.length || filterLevel || filterDepartment);
  const activeFilterCount = [filterTags.length, filterContacts.length, filterScopes.length,
    filterArchitecture.length, filterLevel ? 1 : 0, filterDepartment ? 1 : 0].filter(Boolean).length;
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'System Management' }, { label: 'System List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/system/system">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <div class="card-header list-toolbar">
          <div class="input-group list-search">
            <input class="form-control" type="search" name="search" value="<%= search || '' %>" placeholder="<%= t('Search by name, system ID...') %>" aria-label="<%= t('Search') %>">
            <button class="btn btn-outline-secondary" type="submit" title="<%= t('Search') %>"><i class="bi bi-search"></i></button>
          </div>
          <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#systemFilters" aria-expanded="<%= hasActiveFilter %>">
            <i class="bi bi-funnel"></i> <%= t('Filter') %><% if (activeFilterCount) { %> <span class="badge rounded-pill"><%= activeFilterCount %></span><% } %>
          </button>
          <div class="list-actions">
            <a href="/system/system/export<%= currentQuery %>" class="btn btn-outline-secondary"><i class="bi bi-download"></i> <%= t('Export') %></a>
            <% if (hasPermission('system.create')) { %>
              <a href="/system/system/add" class="btn btn-primary"><i class="bi bi-plus-lg"></i> <%= t('Add System') %></a>
            <% } %>
          </div>
        </div>
        <div class="collapse<%= hasActiveFilter ? ' show' : '' %>" id="systemFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"
                        data-ajax-url="/organize/api/tag" data-ids-url="/organize/api/tag/ids" data-selected='<%= JSON.stringify(filterTags) %>'></select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Contacts') %></label>
                <select name="contacts[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/organize/api/contact" data-ids-url="/organize/api/contact/ids" data-selected='<%= JSON.stringify(filterContacts) %>'></select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Department') %></label>
                <select name="department_id" class="form-select js-filter" data-placeholder="<%= t('All Departments') %>">
                  <option value=""></option>
                  <option value="__none__" <%= filterDepartment === '__none__' ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (departments || []).forEach(function (dept) { %>
                    <option value="<%= dept.id %>" <%= String(filterDepartment) === String(dept.id) ? 'selected' : '' %>><%= dept.name %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Scope user access') %></label>
                <select name="scopes[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>">
                  <option value="__none__" <%= filterScopes.includes('__none__') ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (scopeOptions || []).forEach(function (o) { %>
                    <option value="<%= o.id %>" <%= filterScopes.includes(String(o.id)) ? 'selected' : '' %>><%= o.text %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Architecture') %></label>
                <select name="architectures[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>">
                  <option value="__none__" <%= filterArchitecture.includes('__none__') ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (architectureOptions || []).forEach(function (o) { %>
                    <option value="<%= o.id %>" <%= filterArchitecture.includes(String(o.id)) ? 'selected' : '' %>><%= o.text %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Level') %></label>
                <select name="level" class="form-select js-filter" data-placeholder="<%= t('All Levels') %>">
                  <option value=""></option>
                  <option value="__none__" <%= filterLevel === '__none__' ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (levelOptions || []).forEach(function (level) { %>
                    <option value="<%= level.id %>" <%= String(filterLevel) === String(level.id) ? 'selected' : '' %>><%= level.text %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <% if (hasActiveFilter) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle" id="systemTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <th><%= t('System Code') %></th>
              <th><%= t('Name') %></th>
              <th><%= t('Description') %></th>
              <th><%= t('Alias') %></th>
              <th><%= t('Tags') %></th>
              <th><%= t('Scope user access') %></th>
              <th><%= t('Architecture') %></th>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (systemList && systemList.length) { %>
              <% systemList.forEach(function (system, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <td class="text-nowrap"><%= system.system_id %></td>
                  <td class="fw-medium"><%= system.name %></td>
                  <td>
                    <% const desc = (system.description || '').trim(); %>
                    <% if (desc) { %><span class="cell-clip" title="<%= desc %>"><%= desc %></span><% } else { %><span class="text-secondary">—</span><% } %>
                  </td>
                  <td>
                    <% const aliases = Array.isArray(system.alias) ? system.alias : (system.alias ? [system.alias] : []); %>
                    <%= aliases.length ? aliases.join(', ') : '—' %>
                  </td>
                  <td>
                    <% if (system.tags && system.tags.length) { %>
                      <div class="chip-list"><% system.tags.forEach(function (tag) { %><span class="badge tag"><%= tag.name %></span><% }); %></div>
                    <% } else { %><span class="text-secondary">—</span><% } %>
                  </td>
                  <td>
                    <% if (system.scopes && system.scopes.length) { %>
                      <div class="chip-list"><% system.scopes.forEach(function (scope) { %><span class="badge tag"><%= scope %></span><% }); %></div>
                    <% } else { %><span class="text-secondary">—</span><% } %>
                  </td>
                  <td>
                    <% if (system.architecture && system.architecture.length) { %>
                      <div class="chip-list"><% system.architecture.forEach(function (arch) { %><span class="badge tag"><%= arch %></span><% }); %></div>
                    <% } else { %><span class="text-secondary">—</span><% } %>
                  </td>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showSystemDetail(<%= JSON.stringify(system.id) %>)" data-system='<%= JSON.stringify(system) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('system.update')) { %>
                        <a href="/system/system/<%= system.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('system.delete')) { %>
                        <form action="/system/system/<%= system.id %>/delete" method="POST" onsubmit="return confirmDeleteSystem(this, <%= JSON.stringify(system.name) %>)">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="9">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-hdd-stack', message: 'No systems found', filtered: hasActiveFilter || !!search, clearUrl: '/system/system',
                      actionUrl: hasPermission('system.create') ? '/system/system/add' : null, actionLabel: 'Add System' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (systemList || []).length, summary: 'Showing {1} - {2} of {3} systems' }) %>
    </div>
  </div>
</div>
    <!-- System Detail Modal -->
    <div class="modal fade" id="systemDetailModal" tabindex="-1" aria-labelledby="systemDetailModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <div class="me-3">
              <h5 class="modal-title mb-0" id="systemDetailModalLabel"><%= t('System Detail') %></h5>
              <div class="small text-secondary mt-1" id="systemDetailSubtitle"></div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
          </div>
          <div class="modal-body" id="systemDetailContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <% if (hasPermission && hasPermission('pentest.read')) { %>
              <button type="button" class="btn btn-outline-primary btn-sm me-auto" onclick="showPentestQuickView('system', window.currentDetailSystemId)">
                <i class="bi bi-shield-check"></i> <%= t('Pentest History') %>
              </button>
            <% } %>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Pentest Quick-View Modal (read-only) -->
    <div class="modal fade" id="pentestQuickViewModal" tabindex="-1" aria-labelledby="pentestQuickViewModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="pentestQuickViewModalLabel"><%= t('Pentest History') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
          </div>
          <div class="modal-body" id="pentestQuickViewContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <a id="pentestQuickViewManageLink" href="/pentest" class="btn btn-outline-primary btn-sm me-auto"><%= t('Manage in Pentest page') %></a>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
          </div>
        </div>
      </div>
    </div>

  <!-- Filter values for JS (safe for strict EJS, same as IP Address List) -->
<!-- Data attributes for JavaScript -->
<div id="system-data" 
     data-scope-options='<%= JSON.stringify(scopeOptions || []) %>'
     data-architecture-options='<%= JSON.stringify(architectureOptions || []) %>'
     data-level-options='<%= JSON.stringify(levelOptions || []) %>'
     style="display: none;"></div>

<script>
    // Select2 option data, loaded from the database
    const systemDataEl = document.getElementById('system-data');
    window.scopeOptionsData = JSON.parse(systemDataEl.dataset.scopeOptions || '[]');
    window.architectureOptionsData = JSON.parse(systemDataEl.dataset.architectureOptions || '[]');
    window.levelOptionsData = JSON.parse(systemDataEl.dataset.levelOptions || '[]');
    
    

    
    function confirmDeleteSystem(form, name) {
      if (confirm(t('Are you sure you want to delete the system: ') + name + '?')) {
        form._deleting = true;
        return true;
      }
      return false;
    }

    // ---- System Detail modal -------------------------------------------
    // Same visual language as the list: neutral chips, "—" for empty
    // values, translated labels. Sections are only shown when they have
    // content; components and clusters load on demand.
    const EMPTY = '<span class="text-secondary">—</span>';

    function optionLabel(options, value) {
      const found = (options || []).find(function (o) { return String(o.id) === String(value); });
      return found ? found.text : value;
    }
    function chips(values, toLabel) {
      const list = (values || []).filter(function (v) { return v !== null && v !== undefined && String(v).trim() !== ''; });
      if (!list.length) return EMPTY;
      return '<div class="chip-list">' + list.map(function (v) {
        return '<span class="badge tag">' + escapeHtml(toLabel ? toLabel(v) : v) + '</span>';
      }).join('') + '</div>';
    }
    // One "label | value" row: label in a fixed left column, value on the right.
    function field(label, valueHtml) {
      return '<div class="detail-row"><div class="detail-label">' + escapeHtml(t(label)) + '</div><div class="detail-value">' + (valueHtml || EMPTY) + '</div></div>';
    }
    // A titled card; the body has no padding (rows/tables bring their own).
    function section(title, bodyHtml, extraHtml) {
      return '<section class="detail-card"><div class="detail-card-header">' + escapeHtml(t(title)) + (extraHtml || '') + '</div><div class="detail-card-body">' + bodyHtml + '</div></section>';
    }
    function formatDate(value) {
      if (!value) return '';
      const d = new Date(value);
      if (isNaN(d)) return String(value);
      return d.toLocaleString(document.documentElement.lang || undefined, { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    }
    // "host [comment]" -> link + chip
    function fqdnItem(raw) {
      const str = String(raw).trim();
      const m = str.match(/^(.+?)\s*\[(.+?)\]$/);
      const host = m ? m[1].trim() : str;
      const note = m ? ' <span class="badge tag">' + escapeHtml(m[2].trim()) + '</span>' : '';
      return '<li><a href="http://' + encodeURI(host) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(host) + '</a>' + note + '</li>';
    }
    function contactLinks(contacts) {
      if (!contacts || !contacts.length) return EMPTY;
      return '<ul class="detail-list">' + contacts.map(function (c) {
        const name = c.name || c;
        const user = c.email ? String(c.email).split('@')[0] : '';
        return '<li><i class="bi bi-person text-secondary me-1"></i><a href="/organize/contact?search=' + encodeURIComponent(c.email || name) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(name) + '</a>' +
          (user ? ' <span class="text-secondary small">(' + escapeHtml(user) + ')</span>' : '') + '</li>';
      }).join('') + '</ul>';
    }
    function ipLink(ip) {
      return '<a href="/network/ip-address?search=' + encodeURIComponent(ip) + '" target="_blank" rel="noopener noreferrer" class="ip-hover-link font-monospace" data-ip="' + escapeHtml(ip) + '" data-bs-toggle="tooltip" data-bs-placement="top" title="' + escapeHtml(t('Loading IP info...')) + '">' + escapeHtml(ip) + '</a>';
    }

    function showSystemDetail(systemId) {
      window.currentDetailSystemId = systemId;
      const button = Array.from(document.querySelectorAll('button[data-system]')).find(function (b) {
        try { return String(JSON.parse(b.getAttribute('data-system')).id) === String(systemId); } catch (e) { return false; }
      });
      if (!button) return;
      const system = JSON.parse(button.getAttribute('data-system'));
      const toArray = function (v) { return Array.isArray(v) ? v : (v ? [v] : []); };

      // Header: name, code and level
      document.getElementById('systemDetailModalLabel').textContent = system.name || t('System Detail');
      const level = system.level ? optionLabel(window.levelOptionsData, system.level) : '';
      document.getElementById('systemDetailSubtitle').innerHTML =
        '<span class="font-monospace">' + escapeHtml(system.system_id || '') + '</span>' +
        (level ? ' <span class="badge tag ms-1">' + escapeHtml(level) + '</span>' : '');

      let html = '';

      // Overview
      const department = system.department_id
        ? '<span class="org-tooltip" data-unit-id="' + escapeHtml(system.department_id) + '" style="cursor: help;">' + escapeHtml(system.department_name || '') + '</span>'
        : '';
      const description = (system.description || '').trim();
      html += section('Overview',
        '<div class="detail-rows">' +
          field('Department', department) +
          field('Alias', toArray(system.alias).length ? escapeHtml(toArray(system.alias).join(', ')) : '') +
          field('Scope user access', chips(system.scopes, function (v) { return optionLabel(window.scopeOptionsData, v); })) +
          field('Architecture', chips(system.architecture, function (v) { return optionLabel(window.architectureOptionsData, v); })) +
          field('Tags', chips((system.tags || []).map(function (tg) { return typeof tg === 'string' ? tg : tg.name; }))) +
          field('Managers', contactLinks(system.contacts)) +
          (description ? field('Description', '<span class="text-pre-wrap">' + escapeHtml(description) + '</span>') : '') +
        '</div>');

      // Access: FQDN and domains
      const fqdns = toArray(system.fqdn);
      const domains = system.domains || [];
      if (fqdns.length || domains.length) {
        html += section('Access',
          '<div class="detail-rows">' +
            field('FQDN', fqdns.length ? '<ul class="detail-list">' + fqdns.map(fqdnItem).join('') + '</ul>' : '') +
            field('Domains', domains.length ? '<div class="chip-list">' + domains.map(function (d) {
              const name = d.domain || d;
              return '<a href="/network/domain?search=' + encodeURIComponent(name) + '" target="_blank" rel="noopener noreferrer" class="badge tag text-decoration-none">' + escapeHtml(name) + '</a>';
            }).join('') + '</div>' : '') +
          '</div>');
      }

      // Infrastructure: IP addresses (+ clusters)
      const ips = system.ip_addresses || [];
      let infra = '';
      if (ips.length) {
        infra += '<div class="table-responsive"><table class="table table-sm align-middle detail-table mb-0"><thead><tr>' +
          '<th>' + escapeHtml(t('IP Address')) + '</th><th>' + escapeHtml(t('Server')) + '</th><th>' + escapeHtml(t('Zone')) + ' / ' + escapeHtml(t('Environment')) + '</th>' +
          '</tr></thead><tbody>' +
          ips.map(function (ip) {
            const addr = ip.ip || ip.ip_address || ip;
            const zoneEnv = [ip.subnet_zone, ip.subnet_environment].filter(Boolean).join(' / ');
            return '<tr><td>' + ipLink(addr) + '</td><td>' + (ip.server_name ? escapeHtml(ip.server_name) : EMPTY) + '</td><td>' + (zoneEnv ? escapeHtml(zoneEnv) : EMPTY) + '</td></tr>';
          }).join('') +
          '</tbody></table></div>';
      } else {
        infra += '<p class="text-secondary small mb-0 detail-pad">' + escapeHtml(t('No IP addresses')) + '</p>';
      }
      <% if (hasPermission('cluster.read')) { %>
      infra += '<div class="detail-rows detail-rows-divided">' + field('Clusters', '<span id="clusters-section-' + escapeHtml(systemId) + '" class="text-secondary small">' + escapeHtml(t('Loading...')) + '</span>') + '</div>';
      <% } %>
      html += section('Infrastructure', infra, ' <span class="badge tag ms-1">' + ips.length + '</span>');

      // Components (loaded on demand)
      html += section('Components', '<div id="components-section-' + escapeHtml(systemId) + '" class="text-secondary small detail-pad">' + escapeHtml(t('Loading...')) + '</div>',
        ' <span class="badge tag ms-1 d-none" id="components-count-' + escapeHtml(systemId) + '"></span>');

      // Attached files
      const docs = system.docs || [];
      if (docs.length) {
        html += section('Attached Files', '<ul class="detail-list detail-pad">' + docs.map(function (file) {
          const name = file.name || file.originalname || t('Unknown file');
          const viewUrl = file.id ? '/system/file/' + encodeURIComponent(file.id) + '/view' : file.url;
          return '<li><i class="bi bi-paperclip text-secondary me-1"></i><a href="' + escapeHtml(file.url || '#') + '" download>' + escapeHtml(name) + '</a>' +
            ' <a href="' + escapeHtml(viewUrl || '#') + '" target="_blank" rel="noopener noreferrer" class="badge tag text-decoration-none ms-1">' + escapeHtml(t('View')) + '</a></li>';
        }).join('') + '</ul>');
      }

      // Record metadata
      const meta = [];
      if (system.created_at) meta.push(escapeHtml(t('Created')) + ' ' + escapeHtml(formatDate(system.created_at)));
      if (system.updated_at) meta.push(escapeHtml(t('Updated')) + ' ' + escapeHtml(formatDate(system.updated_at)) + (system.updated_by ? ' · ' + escapeHtml(system.updated_by) : ''));
      if (meta.length) html += '<div class="detail-meta">' + meta.join('<span class="mx-2">|</span>') + '</div>';

      const content = document.getElementById('systemDetailContent');
      content.innerHTML = html;
      initOrgTooltips(content);
      setupIPHover();
      bootstrap.Modal.getOrCreateInstance(document.getElementById('systemDetailModal')).show();

      loadSystemComponents(systemId);
      <% if (hasPermission('cluster.read')) { %>
      loadSystemClusters(systemId);
      <% } %>
    }

    document.getElementById('systemDetailModal').addEventListener('hidden.bs.modal', function () {
      document.getElementById('systemDetailContent').innerHTML = '';
    });

    // Function to setup IP hover functionality — uses Bootstrap's Tooltip
    // component (same as the Description column tooltips) instead of the
    // native browser title tooltip, so both look and behave the same way.
    function setupIPHover() {
      const ipLinks = document.querySelectorAll('.ip-hover-link');
      ipLinks.forEach(link => {
        if (link.getAttribute('data-tooltip-init') === 'true') return;
        link.setAttribute('data-tooltip-init', 'true');
        new bootstrap.Tooltip(link);
        link.addEventListener('mouseenter', handleIPHover);
      });
    }

    // IP hover handler
    function handleIPHover(event) {
      const element = event.target.closest('.ip-hover-link');
      const ipAddress = element.getAttribute('data-ip');
      const tooltip = bootstrap.Tooltip.getInstance(element);

      if (!ipAddress || !tooltip || element.getAttribute('data-loading') === 'true') {
        return;
      }

      // Set loading state
      element.setAttribute('data-loading', 'true');
      tooltip.setContent({ '.tooltip-inner': 'Loading IP info...' });

      // Fetch IP information
      fetch(`/network/api/ip-addresses/detail?search=${encodeURIComponent(ipAddress)}`)
        .then(response => response.json())
        .then(data => {
          if (data && data.length > 0) {
            const ipInfo = data[0];
            let tooltipText = `IP: ${ipInfo.ip_address || ipInfo.ip || ipAddress}`;
            
            if (ipInfo.description) {
              tooltipText += `\nDescription: ${ipInfo.description}`;
            }
            
            if (ipInfo.status) {
              tooltipText += `\nStatus: ${ipInfo.status}`;
            }
            
            // List EVERY owner — an IP can have more than one device/server
            // once VIP sharing is involved, not just a single primary owner.
            (ipInfo.servers || []).forEach(function(s) {
              tooltipText += `\nServer: ${s.name}${s.role === 'vip' ? ' (VIP)' : ''}`;
            });
            (ipInfo.devices || []).forEach(function(d) {
              tooltipText += `\nDevice: ${d.name}${d.role === 'vip' ? ' (VIP)' : ''}`;
            });
            
            // Add tags information
            if (ipInfo.tags && ipInfo.tags.length > 0) {
              const tagNames = ipInfo.tags.map(tag => typeof tag === 'string' ? tag : tag.name).join(', ');
              tooltipText += `\nTags: ${tagNames}`;
            }
            
            // Add contacts information
            if (ipInfo.contacts && ipInfo.contacts.length > 0) {
              const contactEmails = ipInfo.contacts.map(contact => {
                if (typeof contact === 'string') {
                  // If it's a string, check if it's an email or name
                  if (contact.includes('@')) {
                    return contact.split('@')[0]; // Extract username part
                  }
                  return contact;
                }
                // If it's an object, handle email and name like in System Detail
                if (contact.email) {
                  const emailUsername = contact.email.split('@')[0];
                  return contact.name ? `${contact.name} (${emailUsername})` : emailUsername;
                }
                return contact.name || contact;
              }).join(', ');
              tooltipText += `\nContacts: ${contactEmails}`;
            }
            
            // Add systems information
            if (ipInfo.systems && ipInfo.systems.length > 0) {
              const systemNames = ipInfo.systems.map(system => typeof system === 'string' ? system : system.name).join(', ');
              tooltipText += `\nSystems: ${systemNames}`;
            }
            
            tooltip.setContent({ '.tooltip-inner': tooltipText });
          } else {
            tooltip.setContent({ '.tooltip-inner': `IP: ${ipAddress}\nNo additional information found` });
          }
        })
        .catch(error => {
          console.error('Error loading IP info:', error);
          tooltip.setContent({ '.tooltip-inner': `IP: ${ipAddress}\nError loading information` });
        })
        .finally(() => {
          element.removeAttribute('data-loading');
        });
    }

    // Components of a system: one collapsible row each (name + app type),
    // details in the same field grid as the rest of the modal.
    function loadSystemComponents(systemId) {
      const target = document.getElementById('components-section-' + systemId);
      const counter = document.getElementById('components-count-' + systemId);
      if (!target) return;
      fetch('/system/api/system/' + encodeURIComponent(systemId) + '/components')
        .then(function (response) { return response.json(); })
        .then(function (data) {
          const components = data.components || [];
          if (counter) { counter.textContent = components.length; counter.classList.remove('d-none'); }
          if (!components.length) {
            target.innerHTML = escapeHtml(t('No components'));
            return;
          }
          target.classList.remove('text-secondary', 'small');
          target.innerHTML = '<div class="detail-components">' + components.map(function (c, index) {
            const id = 'component-detail-' + systemId + '-' + index;
            const fqdns = Array.isArray(c.fqdn) ? c.fqdn : (c.fqdn ? [c.fqdn] : []);
            const ips = c.ips || [];
            const description = (c.description || '').trim();
            return '<div class="detail-component">' +
              '<button type="button" class="detail-component-head collapsed" data-bs-toggle="collapse" data-bs-target="#' + id + '" aria-expanded="false" aria-controls="' + id + '">' +
                '<i class="bi bi-chevron-right detail-component-icon"></i>' +
                '<span class="fw-medium">' + escapeHtml(c.name || '') + '</span>' +
                (c.app_type ? '<span class="badge tag ms-auto">' + escapeHtml(c.app_type) + '</span>' : '') +
              '</button>' +
              '<div class="collapse" id="' + id + '"><div class="detail-component-body"><div class="detail-rows">' +
                field('IP Addresses', ips.length ? '<div class="chip-list">' + ips.map(function (ip) { return ipLink(ip.ip_address || ip.ip || ip); }).join('') + '</div>' : '') +
                field('FQDN', fqdns.length ? '<ul class="detail-list">' + fqdns.map(fqdnItem).join('') + '</ul>' : '') +
                field('Managers', contactLinks(c.contacts)) +
                field('Tags', chips((c.tags || []).map(function (tg) { return typeof tg === 'string' ? tg : tg.name; }))) +
                (description ? field('Description', '<span class="text-pre-wrap">' + escapeHtml(description) + '</span>') : '') +
              '</div>' +
              (c.updated_at ? '<div class="detail-meta px-3 pb-2">' + escapeHtml(t('Updated')) + ' ' + escapeHtml(formatDate(c.updated_at)) + '</div>' : '') +
              '</div></div>' +
            '</div>';
          }).join('') + '</div>';
          setupIPHover();
        })
        .catch(function () {
          target.innerHTML = '<span class="text-danger">' + escapeHtml(t('Error loading components')) + '</span>';
        });
    }

    // Clusters serving this System - loaded via AJAX from a dedicated
    // Cluster endpoint (read-only here; managed from the Cluster Management
    // page). System's own query/model is untouched by this feature.
    function loadSystemClusters(systemId) {
      const target = document.getElementById('clusters-section-' + systemId);
      if (!target) return;
      fetch('/cluster/api/by-system?system_id=' + encodeURIComponent(systemId))
        .then(function (response) { return response.json(); })
        .then(function (data) {
          const clusters = data.clusters || [];
          if (!clusters.length) { target.innerHTML = EMPTY; return; }
          target.classList.remove('text-secondary', 'small');
          target.innerHTML = '<div class="chip-list">' + clusters.map(function (cluster) {
            return '<a href="/cluster?search=' + encodeURIComponent(cluster.name) + '" target="_blank" rel="noopener noreferrer" class="badge tag text-decoration-none">' + escapeHtml(cluster.name) + '</a>';
          }).join('') + '</div>';
        })
        .catch(function () {
          target.innerHTML = '<span class="text-danger">' + escapeHtml(t('Error loading clusters')) + '</span>';
        });
    }

    function showToast(msg, type) {
      const toast = document.createElement('div');
      toast.className = `alert alert-${type}`;
      toast.style.position = 'fixed';
      toast.style.top = '16px';
      toast.style.right = '16px';
      toast.style.zIndex = 9999;
      toast.style.minWidth = '200px';
      toast.innerText = msg;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    // Filter modal select2 logic
    // Initialize tooltips
    $(document).ready(function() {
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });
    });

    // Organization/Unit hover tooltip — lazily fetches the unit's
    // description via AJAX on first hover instead of carrying it through
    // this page's own query. Cached across elements sharing the same unit id.
    const unitInfoCache = {};
    function initOrgTooltips(scopeEl) {
      (scopeEl || document).querySelectorAll('.org-tooltip').forEach(function(el) {
        if (el.dataset.tooltipInit) return;
        el.dataset.tooltipInit = '1';
        const unitId = el.getAttribute('data-unit-id');
        if (!unitId) return;
        const tooltip = new bootstrap.Tooltip(el, { title: 'Loading...' });
        el.addEventListener('show.bs.tooltip', function() {
          if (unitInfoCache[unitId]) {
            tooltip.setContent({ '.tooltip-inner': unitInfoCache[unitId] });
            return;
          }
          fetch('/organize/api/unit/' + encodeURIComponent(unitId) + '/detail')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              const desc = (data && data.description) ? data.description : 'No description';
              unitInfoCache[unitId] = desc;
              tooltip.setContent({ '.tooltip-inner': desc });
            })
            .catch(function() {
              tooltip.setContent({ '.tooltip-inner': 'Error loading info' });
            });
        });
      });
    }

    // Read-only quick-view of pentest rounds for a System/Component, launched
    // from the Detail modal's "Pentest History" button. Full add/edit/delete
    // happens on the dedicated Pentest Management page (link below).
    // Round name, participant names, and the uploaded report's original
    // filename are all free-text user input persisted server-side with no
    // HTML stripping — must be escaped before going into innerHTML, or a
    // crafted round/filename executes script in the browser of anyone who
    // later opens this quick-view.
    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function showPentestQuickView(objectType, objectId) {
      if (!objectId) return;
      const content = document.getElementById('pentestQuickViewContent');
      content.innerHTML = '<p class="text-muted mb-0">Loading...</p>';
      document.getElementById('pentestQuickViewManageLink').href = '/pentest?object_type=' + encodeURIComponent(objectType) + '&object_id=' + encodeURIComponent(objectId);
      const modal = new bootstrap.Modal(document.getElementById('pentestQuickViewModal'));
      modal.show();

      fetch('/pentest/api/by-object?object_type=' + encodeURIComponent(objectType) + '&object_id=' + encodeURIComponent(objectId))
        .then(res => res.json())
        .then(data => {
          const rounds = data.rounds || [];
          if (rounds.length === 0) {
            content.innerHTML = '<p class="text-muted mb-0">No pentest rounds recorded yet.</p>';
            return;
          }
          let html = '<table class="table table-sm table-hover mb-0"><thead><tr><th>Round Name</th><th>Date</th><th>Status</th><th>Participants</th><th>Report</th></tr></thead><tbody>';
          rounds.forEach(function(round) {
            const participants = (round.participants || []).map(p => escapeHtml(p.name)).join(', ') || '-';
            let report = '<span class="text-muted">No report</span>';
            if (round.report) {
              report = '<a href="' + escapeHtml(round.report.url) + '" download class="text-decoration-none text-primary me-1">' + escapeHtml(round.report.original_name) + '</a>' +
                       '<a href="/pentest/report/' + encodeURIComponent(round.report.id) + '/view" target="_blank" rel="noopener noreferrer" class="badge bg-light text-dark border text-decoration-none" style="border-radius:3px;">[View]</a>';
            }
            html += '<tr><td>' + escapeHtml(round.name) + '</td><td>' + (round.test_date ? new Date(round.test_date).toLocaleDateString('en-GB') : '-') + '</td><td>' + escapeHtml(round.status || 'NOT_STARTED') + '</td><td>' + participants + '</td><td>' + report + '</td></tr>';
          });
          html += '</tbody></table>';
          content.innerHTML = html;
        })
        .catch(() => {
          content.innerHTML = '<p class="text-danger mb-0">Error loading pentest rounds.</p>';
        });
    }
</script>

