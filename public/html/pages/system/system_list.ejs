        .then(response => response.json())
        .then(data => {
          if (data.components && data.components.length > 0) {
            let componentsHtml = '<div class="components-section">';
            componentsHtml += '<h6 class="mb-3 text-primary"><i class="bi bi-gear-fill me-2"></i>Components (' + data.components.length + ')</h6>';
            
            data.components.forEach(function(component, index) {
              // Add separator line between components (except for the first one)
              if (index > 0) {
                componentsHtml += '<hr class="my-3">';
              }
              
              componentsHtml += '<div class="component-card border rounded p-3 mb-2 bg-light">';
              
              // Component Header with Name and App Type
              componentsHtml += '<div class="d-flex justify-content-between align-items-start mb-2">';
