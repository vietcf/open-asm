                      componentsHtml += '<div class="mb-1"><a href="http://' + domain + '" target="_blank" class="text-decoration-none text-primary">' + domain + '</a> <span class="badge bg-secondary ms-1">' + comment + '</span></div>';
                    } else {
                      componentsHtml += '<div class="mb-1 text-muted">' + fqdnStr + '</div>';
                    }
                  } else {
                    componentsHtml += '<div class="mb-1"><a href="http://' + fqdnStr + '" target="_blank" class="text-decoration-none text-primary">' + fqdnStr + '</a></div>';
                  }
                });
                componentsHtml += '</div>';
                componentsHtml += '</div>';
              }
              
              // IP Addresses
              if (component.ips && component.ips.length > 0) {
                componentsHtml += '<div class="mb-2">';
                componentsHtml += '<span class="fw-semibold">IP Addresses:</span>';
                componentsHtml += '<div class="mt-1">';
                component.ips.forEach(function(ipObj, index) {
