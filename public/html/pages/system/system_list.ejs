  overflow-wrap: break-word;
}

/* Filter modal footer has 3 buttons (Clear/Cancel/Apply), Cancel+Apply
   nested in a sub-div - the site-wide .modal-footer rule only reaches
   direct children, so this footer needs its own mobile stacking rule
   (same pattern as device_list.ejs's filter modal). */
@media (max-width: 768px) {
  /* layout.ejs's generic mobile table rule keeps only column 2 + the last
     column visible, assuming column 2 is "Name" - here column 2 is
     "System Code" (Name is column 3), so it showed the wrong data. Swap
     which column stays visible; #systemTable's ID specificity beats the
     generic .table th/td:nth-child(2) class selector. */
  #systemTable th:nth-child(2),
  #systemTable td:nth-child(2) {
    display: none !important;
  }
  #systemTable th:nth-child(3),
  #systemTable td:nth-child(3) {
    display: table-cell !important;
    width: 70% !important;
    max-width: 70% !important;
    word-wrap: break-word;
    word-break: break-word;
  }
  /* Match the site-standard "Name column" text style that the generic rule
     applies to td:nth-child(2) - it doesn't reach column 3, so without this
     the name here rendered in the browser's plain default font/size. */
  #systemTable td:nth-child(3) {
    font-size: 0.9rem;
    line-height: 1.3;
    padding: 8px 6px;
  }
}

@media (max-width: 991.98px) {
  #filterSystemModal .modal-footer > div {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.5rem !important;
