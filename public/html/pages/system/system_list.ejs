<%
  const activeFilterCount = [filterTags.length, filterContacts.length, filterScopes.length,
    filterArchitecture.length, filterLevel ? 1 : 0, filterDepartment ? 1 : 0].filter(Boolean).length;
  // "def" = shown by default, "fixed" = always shown (column chooser)
  const COLUMNS = [
    { key: 'code', label: 'System Code', def: true },
    { key: 'name', label: 'Name', def: true, fixed: true },
    { key: 'level', label: 'Level', def: true },
    { key: 'ops', label: 'Operations department (L2)', def: true },
    { key: 'dev', label: 'Development department (L3)', def: true },
    { key: 'tags', label: 'Tags', def: true },
    { key: 'description', label: 'Description' },
    { key: 'alias', label: 'Alias' },
    { key: 'scopes', label: 'Scope user access' },
    { key: 'architecture', label: 'Architecture' },
    { key: 'managers', label: 'Managers' },
    { key: 'urls', label: 'Access URLs' },
    { key: 'ips', label: 'IP Addresses' },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (s, key) => ({
    code: ui.esc(s.system_id),
    name: ui.esc(s.name),
    level: s.level ? ui.esc(ui.optionLabel(levelOptions, s.level)) : ui.dash,
    ops: ui.text(s.ops_department_name),
    dev: ui.text(s.department_name),
    tags: ui.chips((s.tags || []).map(tg => tg.name)),
    description: ui.clip(s.description),
    alias: ui.text(ui.toArray(s.alias).join(', ')),
    scopes: ui.chips((s.scopes || []).map(v => ui.optionLabel(scopeOptions, v))),
    architecture: ui.chips((s.architecture || []).map(v => ui.optionLabel(architectureOptions, v))),
    managers: ui.text((s.contacts || []).map(c => c.name).join(', ')),
    urls: ui.clip(ui.toArray(s.fqdn).join(', ')),
    ips: ui.mono((s.ip_addresses || []).map(ip => ip.ip)),
    updated: ui.date(s.updated_at),
  })[key];
  const NOWRAP = ['code', 'level'];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'System Management' }, { label: 'System List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/system/system">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name, system ID...',
              filtersId: 'systemFilters', activeFilterCount,
              columns: { tableId: 'systemTable', storageKey: 'openasm.systemList.columns', list: COLUMNS },
              exportUrl: '/system/system/export' + currentQuery,
              addUrl: hasPermission('system.create') ? '/system/system/add' : null, addLabel: 'Add System' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="systemFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(tagOptions, filterTags) %></select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Contacts') %></label>
                <select name="contacts[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/organize/api/contact" data-ids-url="/organize/api/contact/ids" data-selected='<%= JSON.stringify(filterContacts) %>'></select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Department (L2 or L3)') %></label>
                <select name="department_id" class="form-select js-filter" data-placeholder="<%= t('All Departments') %>">
                  <option value=""></option>
                  <option value="__none__" <%= filterDepartment === '__none__' ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (departments || []).forEach(function (dept) { %>
                    <option value="<%= dept.id %>" <%= String(filterDepartment) === String(dept.id) ? 'selected' : '' %>><%= dept.name %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Scope user access') %></label>
                <select name="scopes[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>">
                  <option value="__none__" <%= filterScopes.includes('__none__') ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (scopeOptions || []).forEach(function (o) { %>
                    <option value="<%= o.id %>" <%= filterScopes.includes(String(o.id)) ? 'selected' : '' %>><%= o.text %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Architecture') %></label>
                <select name="architectures[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>">
                  <option value="__none__" <%= filterArchitecture.includes('__none__') ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (architectureOptions || []).forEach(function (o) { %>
                    <option value="<%= o.id %>" <%= filterArchitecture.includes(String(o.id)) ? 'selected' : '' %>><%= o.text %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Level') %></label>
                <select name="level" class="form-select js-filter" data-placeholder="<%= t('All Levels') %>">
                  <option value=""></option>
                  <option value="__none__" <%= filterLevel === '__none__' ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (levelOptions || []).forEach(function (level) { %>
                    <option value="<%= level.id %>" <%= String(filterLevel) === String(level.id) ? 'selected' : '' %>><%= level.text %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="systemTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (systemList && systemList.length) { %>
              <% systemList.forEach(function (system, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : (NOWRAP.includes(c.key) ? ' class="text-nowrap"' : '') %>><%- cell(system, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showSystemDetail(this)" data-record='<%= JSON.stringify(system) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('system.update')) { %>
                        <a href="/system/system/<%= system.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('system.delete')) { %>
                        <form action="/system/system/<%= system.id %>/delete" method="POST" data-confirm="<%= t('Are you sure you want to delete the system: ') + system.name + '?' %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-hdd-stack', message: 'No systems found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/system/system',
                      actionUrl: hasPermission('system.create') ? '/system/system/add' : null, actionLabel: 'Add System' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (systemList || []).length, summary: 'Showing {1} - {2} of {3} systems' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'systemDetailModal', pentestType: 'system' }) %>
<%- include('../../partials/ui/pentest_quick_view') %>

<script>
  // Option labels for the detail modal
  const SYSTEM_OPTIONS = {
    level: <%- jsonSafe(levelOptions || []) %>,
    scope: <%- jsonSafe(scopeOptions || []) %>,
    architecture: <%- jsonSafe(architectureOptions || []) %>,
  };
  const CAN_READ_CLUSTERS = <%- jsonSafe(hasPermission('cluster.read')) %>;

  function showSystemDetail(button) {
    const s = DV.record(button);
    if (!s) return;
    const level = s.level ? DV.optionLabel(SYSTEM_OPTIONS.level, s.level) : '';
    const ips = s.ip_addresses || [];
    const scopes = s.scopes || [];
    const urls = DV.toArray(s.fqdn);
    const domains = s.domains || [];

    let body = DV.section('Overview', DV.rows(
      DV.field('Operations department (L2)', DV.unit(s.ops_department_id, s.ops_department_name)),
      DV.field('Development department (L3)', DV.unit(s.department_id, s.department_name)),
      DV.field('Alias', DV.text(DV.toArray(s.alias).join(', '))),
      DV.field('Architecture', DV.chips(s.architecture, (v) => DV.optionLabel(SYSTEM_OPTIONS.architecture, v))),
      DV.field('Tags', DV.chips((s.tags || []).map((tg) => tg.name || tg))),
      DV.field('Managers', DV.contacts(s.contacts)),
      DV.multiline(s.description) ? DV.field('Description', DV.multiline(s.description)) : ''
    ));
    if (scopes.length || urls.length || domains.length) {
      body += DV.section('Access', DV.rows(
        DV.field('Scope user access', DV.chips(scopes, (v) => DV.optionLabel(SYSTEM_OPTIONS.scope, v))),
        DV.field('Access URLs', DV.urlList(urls)),
        DV.field('Domains', DV.linkChips(domains, (d) => '/network/domain?search=' + encodeURIComponent(d.domain || d)))
      ));
    }
    const ipTable = ips.length
      ? '<div class="table-responsive"><table class="table table-sm align-middle detail-table mb-0"><thead><tr><th>' + DV.esc(t('IP Address')) + '</th><th>' + DV.esc(t('Server')) + '</th><th>' + DV.esc(t('Zone')) + ' / ' + DV.esc(t('Environment')) + '</th></tr></thead><tbody>' +
        ips.map((ip) => '<tr><td>' + DV.ipLink(ip.ip) + '</td><td>' + (DV.text(ip.server_name) || DV.EMPTY) + '</td><td>' + (DV.text([ip.subnet_zone, ip.subnet_environment].filter(Boolean).join(' / ')) || DV.EMPTY) + '</td></tr>').join('') +
        '</tbody></table></div>'
      : '<p class="text-secondary small mb-0 detail-pad">' + DV.esc(t('No IP addresses')) + '</p>';
    body += DV.section('Infrastructure',
      ipTable + (CAN_READ_CLUSTERS ? '<div class="detail-rows detail-rows-divided">' + DV.field('Clusters', DV.placeholder('sysClusters')) + '</div>' : ''),
      ' <span class="badge tag ms-1">' + ips.length + '</span>');
    body += DV.section('Components', '<div id="sysComponents" class="text-secondary small detail-pad">' + DV.esc(t('Loading...')) + '</div>',
      ' <span class="badge tag ms-1 d-none" id="sysComponentsCount"></span>');
    if ((s.docs || []).length) body += DV.section('Attached Files', DV.files(s.docs, '/system/file/:id/view'));
    body += DV.meta(s);

    DV.open('systemDetailModal', {
      title: s.name,
      subtitle: '<span class="font-monospace">' + DV.esc(s.system_id) + '</span>' + (level ? ' <span class="badge tag ms-1">' + DV.esc(level) + '</span>' : ''),
      body,
      recordId: s.id,
    });

    DV.load('/system/api/system/' + encodeURIComponent(s.id) + '/components', document.getElementById('sysComponents'), (data) => {
      const components = data.components || [];
      const counter = document.getElementById('sysComponentsCount');
      if (counter) { counter.textContent = components.length; counter.classList.remove('d-none'); }
      if (!components.length) return DV.esc(t('No components'));
      return '<div class="detail-components">' + components.map((c, i) => {
        const id = 'sysComponent' + i;
        return '<div class="detail-component">' +
          '<button type="button" class="detail-component-head collapsed" data-bs-toggle="collapse" data-bs-target="#' + id + '" aria-expanded="false" aria-controls="' + id + '">' +
            '<i class="bi bi-chevron-right detail-component-icon"></i><span class="fw-medium">' + DV.esc(c.name) + '</span>' +
            (c.app_type ? '<span class="badge tag ms-auto">' + DV.esc(c.app_type) + '</span>' : '') +
          '</button>' +
          '<div class="collapse" id="' + id + '"><div class="detail-component-body">' + DV.rows(
            DV.field('IP Addresses', DV.ipLinks(c.ips)),
            DV.field('Access URLs', DV.urlList(c.fqdn)),
            DV.field('Managers', DV.contacts(c.contacts)),
            DV.field('Tags', DV.chips((c.tags || []).map((tg) => tg.name || tg))),
            DV.multiline(c.description) ? DV.field('Description', DV.multiline(c.description)) : ''
          ) + (c.updated_at ? '<div class="detail-meta px-3 pb-2">' + DV.esc(t('Updated')) + ' ' + DV.esc(DV.date(c.updated_at)) + '</div>' : '') + '</div></div>' +
        '</div>';
      }).join('') + '</div>';
    });
    if (CAN_READ_CLUSTERS) {
      DV.load('/cluster/api/by-system?system_id=' + encodeURIComponent(s.id), document.getElementById('sysClusters'),
        (data) => DV.linkChips(data.clusters || [], (c) => '/cluster?search=' + encodeURIComponent(c.name)));
    }
  }
</script>
