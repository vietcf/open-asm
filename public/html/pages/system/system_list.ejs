  }
  #filterSystemModal .modal-footer > div .btn {
    width: 100% !important;
    margin: 0 !important;
  }
  #filterSystemModal .modal-footer .btn:first-child {
    order: 3 !important; /* Clear All Filters at bottom */
  }
  #filterSystemModal .modal-footer > div .btn:first-child {
    order: 2 !important; /* Cancel in middle */
  }
  #filterSystemModal .modal-footer > div .btn:last-child {
