<%
// Helper function to build export URL with all current filter query parameters
function buildSystemExportUrl() {
  const params = new URLSearchParams();
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(id => params.append('tags[]', id));
  }
  if (typeof filterContacts !== 'undefined' && filterContacts && filterContacts.length > 0) {
    filterContacts.forEach(id => params.append('contacts[]', id));
  }
  if (typeof filterScopes !== 'undefined' && filterScopes && filterScopes.length > 0) {
    filterScopes.forEach(v => params.append('scopes[]', v));
  }
  if (typeof filterArchitecture !== 'undefined' && filterArchitecture && filterArchitecture.length > 0) {
    filterArchitecture.forEach(v => params.append('architectures[]', v));
  }
  if (typeof filterLevel !== 'undefined' && filterLevel) {
    params.set('level', filterLevel);
  }
  if (typeof filterDepartment !== 'undefined' && filterDepartment) {
    params.set('department_id', filterDepartment);
  }
  return '/system/system/export' + (params.toString() ? '?' + params.toString() : '');
}
%>

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item active"><%= t('System List') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
  <!-- Search and Page Size Row -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end align-items-center gap-2">
        <form class="d-flex align-items-center gap-2" role="search" method="get" action="/system/system">
          <div class="input-group input-group-sm" style="width: 250px;">
            <input class="form-control form-control-sm" type="search" name="search" placeholder="<%= t('Search by name, system ID...') %>" aria-label="<%= t('Search') %>" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted"><%= t('Show:') %></label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
              <% }) %>
            </select>
          </div>
        </form>
      </div>
    </div>
  </div>

    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('system.create')) { %>
            <a href="/system/system/add" class="btn btn-primary btn-sm">
              <i class="bi bi-plus"></i> <%= t('Add System') %>
            </a>
          <% } %>
          <%
            const hasActiveSystemFilter = !!(
              (filterTags && filterTags.length > 0) ||
              (filterContacts && filterContacts.length > 0) ||
              (filterScopes && filterScopes.length > 0) ||
              (filterArchitecture && filterArchitecture.length > 0) ||
              (filterLevel && filterLevel !== '') ||
              (filterDepartment && filterDepartment !== '')
            );
          %>
          <button type="button" class="btn btn-sm <%= hasActiveSystemFilter ? 'btn-primary' : 'btn-outline-secondary' %>" data-bs-toggle="modal" data-bs-target="#filterSystemModal">
            <i class="bi bi-funnel<%= hasActiveSystemFilter ? '-fill' : '' %>"></i> <%= t('Filter{1}', { 1: hasActiveSystemFilter ? ' (Filtered)' : '' }) %>
          </button>
          <% if (hasPermission && hasPermission('system.read')) { %>
            <a href="<%= buildSystemExportUrl() %>" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> <%= t('Export') %>
            </a>
          <% } %>
        </div>
      </div>
    </div>
      <!-- Filter Modal -->
      <div class="modal fade" id="filterSystemModal" tabindex="-1" aria-labelledby="filterSystemModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <form id="systemFilterForm" method="get" action="/system/system">
              <!-- Preserve current pageSize and search -->
              <input type="hidden" name="pageSize" value="<%= typeof pageSize !== 'undefined' ? pageSize : 10 %>">
              <input type="hidden" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <div class="modal-header">
                <h5 class="modal-title" id="filterSystemModalLabel"><%= t('Filter System List') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
              </div>
              <div class="modal-body">
                <div class="row g-2">
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Tags') %></label>
                    <select id="filterSystemTags" name="tags[]" class="form-control" multiple></select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Contacts') %></label>
                    <select id="filterSystemContacts" name="contacts[]" class="form-control" multiple></select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Scope user access') %></label>
                    <select id="filterSystemScopes" name="scopes[]" class="form-control" multiple></select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Architecture') %></label>
                    <select id="filterSystemArchitecture" name="architectures[]" class="form-control" multiple></select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Level') %></label>
                    <select id="filterSystemLevel" name="level" class="form-select">
                      <option value=""><%= t('All Levels') %></option>
                      <option value="__none__" <%= (typeof filterLevel !== 'undefined' && filterLevel === '__none__') ? 'selected' : '' %>><%= t('(Not set)') %></option>
                      <% if (levelOptions && levelOptions.length > 0) { %>
                        <% levelOptions.forEach(function(level) { %>
                          <option value="<%= level.id %>" <%= (typeof filterLevel !== 'undefined' && filterLevel === level.id) ? 'selected' : '' %>><%= level.text %></option>
                        <% }) %>
                      <% } %>
                    </select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Department') %></label>
                    <select id="filterSystemDepartment" name="department_id" class="form-select">
                      <option value=""><%= t('All Departments') %></option>
                      <option value="__none__" <%= (typeof filterDepartment !== 'undefined' && filterDepartment === '__none__') ? 'selected' : '' %>><%= t('(Not set)') %></option>
                      <% if (departments && departments.length > 0) { %>
                        <% departments.forEach(function(dept) { %>
                          <option value="<%= dept.id %>" <%= (typeof filterDepartment !== 'undefined' && String(filterDepartment) === String(dept.id)) ? 'selected' : '' %>><%= dept.name %></option>
                        <% }) %>
                      <% } %>
                    </select>
                  </div>
                </div>
              </div>
              <div class="modal-footer d-flex justify-content-between">
                <button type="button" id="clearFilterBtnSystem" class="btn btn-outline-danger btn-sm"><%= t('Clear All Filters') %></button>
                <div>
                  <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal"><%= t('Cancel') %></button>
                  <button type="submit" class="btn btn-primary btn-sm"><%= t('Apply Filter') %></button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

    <!-- System Detail Modal -->
    <div class="modal fade" id="systemDetailModal" tabindex="-1" aria-labelledby="systemDetailModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="systemDetailModalLabel"><%= t('System Detail') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
          </div>
          <div class="modal-body" id="systemDetailContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <% if (hasPermission && hasPermission('pentest.read')) { %>
              <button type="button" class="btn btn-outline-primary btn-sm me-auto" onclick="showPentestQuickView('system', window.currentDetailSystemId)">
                <i class="bi bi-shield-check"></i> <%= t('Pentest History') %>
              </button>
            <% } %>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Pentest Quick-View Modal (read-only) -->
    <div class="modal fade" id="pentestQuickViewModal" tabindex="-1" aria-labelledby="pentestQuickViewModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="pentestQuickViewModalLabel"><%= t('Pentest History') %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
          </div>
          <div class="modal-body" id="pentestQuickViewContent">
            <!-- Content will be loaded here -->
          </div>
          <div class="modal-footer">
            <a id="pentestQuickViewManageLink" href="/pentest" class="btn btn-outline-primary btn-sm me-auto"><%= t('Manage in Pentest page') %></a>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
          </div>
        </div>
      </div>
    </div>

  <!-- Filter values for JS (safe for strict EJS, same as IP Address List) -->
  <div id="filter-system-data"
    data-tags='<%= JSON.stringify(filterTags || []) %>'
    data-contacts='<%= JSON.stringify(filterContacts || []) %>'
    data-scopes='<%= JSON.stringify(filterScopes || []) %>'
    data-architecture='<%= JSON.stringify(filterArchitecture || []) %>' style="display:none"></div>

  <% // Declare pagination variables ONCE before the table, to avoid duplicate declaration errors and ReferenceError %>
  <% 
    let sysStartItem = (page - 1) * pageSize + 1;
    let sysEndItem = sysStartItem + (systemList ? systemList.length : 0) - 1;
    if (!systemList || systemList.length === 0) {
      sysStartItem = 0;
      sysEndItem = 0;
    }
    let sysStartPage = 1;
    let sysEndPage = totalPages;
    if (totalPages > 10) {
      if (page <= 5) {
        sysStartPage = 1;
        sysEndPage = 10;
      } else if (page + 4 >= totalPages) {
        sysStartPage = totalPages - 9;
        sysEndPage = totalPages;
      } else {
        sysStartPage = page - 5 + 1;
        sysEndPage = page + 4;
      }
    }
  %>

  <!-- Flash Messages -->
  <!-- Debug: successMessage = <%= typeof successMessage !== 'undefined' ? successMessage : 'undefined' %> -->
  <!-- Debug: errorMessage = <%= typeof errorMessage !== 'undefined' ? errorMessage : 'undefined' %> -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= t(successMessage) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide success message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
    </script>
  <% } %>
  
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= t(errorMessage) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

  <!-- System List Table -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0"><%= t('System List') %></h3>
        </div>
        <div class="card-body table-responsive p-0" style="overflow-x: auto;">
          <table class="table table-hover" id="systemTable">
            <thead>
              <tr>
                <th><%= t('No.') %></th>
                <th data-sort-type="text"><%= t('System Code') %></th>
                <th data-sort-type="text"><%= t('Name') %></th>
                <th data-sort-type="text"><%= t('Description') %></th>
                <th data-sort-type="text"><%= t('Alias') %></th>
                <th data-sort-type="text"><%= t('Tags') %></th>
                <th data-sort-type="text"><%= t('Scope user access') %></th>
                <th data-sort-type="text"><%= t('Architecture') %></th>
                <th class="text-end"><%= t('Actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (systemList && systemList.length > 0) { %>
                <% systemList.forEach(function(system, idx) { %>
                  <tr>
                    <td><%= (page - 1) * pageSize + idx + 1 %></td>
                    <td><%= system.system_id %></td>
                    <td><%= system.name %></td>
                    <td>
                      <% if (system.description && system.description.trim()) { %>
                        <%
                          const cleanDescription = system.description.trim();
                          const shortDescription = cleanDescription.length > 100 ? cleanDescription.substring(0, 100) + '…' : cleanDescription;
                        %>
                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="<%= cleanDescription %>" style="cursor: help; word-break: break-word;">
                          <%= shortDescription %>
                        </span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (Array.isArray(system.alias) && system.alias.length > 0) { %>
                        <%= system.alias.join(', ') %>
                      <% } else if (system.alias) { %>
                        <%= system.alias %>
                      <% } else { %>
                        <span class="text-muted"><%= t('No alias') %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (system.tags && system.tags.length > 0) { %>
                        <div style="line-height: 1.4;">
                          <% system.tags.forEach(function(tag, idx) { %>
                            <span class="badge bg-primary text-white" style="font-size:1rem; font-weight:500; padding:0.15em 0.5em; margin: 0.1em 0.1em; display: inline-block;">
                              <%= tag.name %>
                            </span>
                            <% if ((idx + 1) % 2 === 0 && idx < system.tags.length - 1) { %>
                              <br>
                            <% } %>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span class="text-muted"><%= t('No tags') %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (system.scopes && system.scopes.length > 0) { %>
                        <div style="line-height: 1.4;">
                          <% system.scopes.forEach(function(scope, idx) { %>
                            <span class="badge bg-info text-white" style="font-size:1rem; font-weight:500; padding:0.15em 0.5em; margin: 0.1em 0.1em; display: inline-block;">
                              <%= scope %>
                            </span>
                            <% if ((idx + 1) % 2 === 0 && idx < system.scopes.length - 1) { %>
                              <br>
                            <% } %>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span class="text-muted"><%= t('No scope') %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (system.architecture && system.architecture.length > 0) { %>
                        <div style="line-height: 1.4;">
                          <% system.architecture.forEach(function(arch, idx) { %>
                            <span class="badge bg-warning text-dark" style="font-size:1rem; font-weight:500; padding:0.15em 0.5em; margin: 0.1em 0.1em; display: inline-block;">
                              <%= arch %>
                            </span>
                            <% if ((idx + 1) % 2 === 0 && idx < system.architecture.length - 1) { %>
                              <br>
                            <% } %>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span class="text-muted"><%= t('No architecture') %></span>
                      <% } %>
                    </td>

                    <td class="text-end">
                      <button type="button" class="btn btn-info btn-sm" title="<%= t('Show') %>" onclick="showSystemDetail('<%= system.id %>')" data-system='<%= JSON.stringify(system) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('system.update')) { %>
                      <a href="/system/system/<%= system.id %>/edit" class="btn btn-warning btn-sm" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('system.delete')) { %>
                      <form action="/system/system/<%= system.id %>/delete" method="POST" style="display:inline" onsubmit="return confirmDeleteSystem(this, '<%= system.name %>')">
                        <button type="submit" class="btn btn-danger btn-sm" title="<%= t('Delete') %>">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                      <% } %>
                    </td>
                  </tr>

                <% }) %>
              <% } else { %>
                <tr><td colspan="9" class="text-center"><%= t('No data') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        
        <!-- Mobile Cards Layout -->
        <div class="mobile-cards d-none" id="systemMobileCards">
          <% if (systemList && systemList.length > 0) { %>
            <% systemList.forEach(function(system, idx) { %>
              <div class="mobile-card">
                <div class="mobile-card-header">
                  <h6 class="mb-0"><%= system.name %></h6>
                  <small class="text-muted">#<%= (page - 1) * pageSize + idx + 1 %></small>
                </div>
                <div class="mobile-card-body">
                  <div class="mobile-card-row">
                    <span class="mobile-card-label"><%= t('System Code:') %></span>
                    <span class="mobile-card-value"><%= system.system_id %></span>
                  </div>
                  <% if (system.description && system.description.trim()) { %>
                      <%
                        const cleanDescription = system.description.trim();
                        const shortDescription = cleanDescription.length > 80 ? cleanDescription.substring(0, 80) + '…' : cleanDescription;
                      %>
                    <div class="mobile-card-row">
                      <span class="mobile-card-label"><%= t('Description:') %></span>
                      <span class="mobile-card-value" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= cleanDescription %>" style="cursor: help;"><%= shortDescription %></span>
                    </div>
                  <% } %>
                  <% if (system.alias && (Array.isArray(system.alias) ? system.alias.length > 0 : system.alias)) { %>
                    <div class="mobile-card-row">
                      <span class="mobile-card-label"><%= t('Alias:') %></span>
                      <span class="mobile-card-value"><%= Array.isArray(system.alias) ? system.alias.join(', ') : system.alias %></span>
                    </div>
                  <% } %>
                  <% if (system.tags && system.tags.length > 0) { %>
                    <div class="mobile-card-row">
                      <span class="mobile-card-label"><%= t('Tags:') %></span>
                      <span class="mobile-card-value">
                        <% system.tags.slice(0, 2).forEach(function(tag) { %>
                          <span class="badge bg-primary text-white me-1" style="font-size:0.8rem;"><%= tag.name %></span>
                        <% }) %>
                        <% if (system.tags.length > 2) { %>
                          <span class="text-muted"><%= t('+{1} more', { 1: system.tags.length - 2 }) %></span>
                        <% } %>
                      </span>
                    </div>
                  <% } %>
                  <% if (system.scopes && system.scopes.length > 0) { %>
                    <div class="mobile-card-row">
                      <span class="mobile-card-label"><%= t('Scope:') %></span>
                      <span class="mobile-card-value">
                        <% system.scopes.slice(0, 1).forEach(function(scope) { %>
                          <span class="badge bg-info text-white me-1" style="font-size:0.8rem;"><%= scope %></span>
                        <% }) %>
                        <% if (system.scopes.length > 1) { %>
                          <span class="text-muted"><%= t('+{1} more', { 1: system.scopes.length - 1 }) %></span>
                        <% } %>
                      </span>
                    </div>
                  <% } %>
                  <% if (system.architecture && system.architecture.length > 0) { %>
                    <div class="mobile-card-row">
                      <span class="mobile-card-label"><%= t('Architecture:') %></span>
                      <span class="mobile-card-value">
                        <% system.architecture.slice(0, 1).forEach(function(arch) { %>
                          <span class="badge bg-warning text-dark me-1" style="font-size:0.8rem;"><%= arch %></span>
                        <% }) %>
                        <% if (system.architecture.length > 1) { %>
                          <span class="text-muted"><%= t('+{1} more', { 1: system.architecture.length - 1 }) %></span>
                        <% } %>
                      </span>
                    </div>
                  <% } %>
                </div>
                <div class="mobile-card-actions">
                  <button type="button" class="btn btn-info btn-sm" title="<%= t('Show') %>" onclick="showSystemDetail('<%= system.id %>')" data-system='<%= JSON.stringify(system) %>'>
                    <i class="bi bi-eye"></i>
                  </button>
                  <% if (hasPermission('system.update')) { %>
                    <a href="/system/system/<%= system.id %>/edit" class="btn btn-warning btn-sm" title="<%= t('Edit') %>">
                      <i class="bi bi-pencil"></i>
                    </a>
                  <% } %>
                  <% if (hasPermission('system.delete')) { %>
                    <form action="/system/system/<%= system.id %>/delete" method="POST" style="display:inline" onsubmit="return confirmDeleteSystem(this, '<%= system.name %>')">
                      <button type="submit" class="btn btn-danger btn-sm" title="<%= t('Delete') %>">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="mobile-card">
              <div class="mobile-card-body text-center">
                <span class="text-muted"><%= t('No data') %></span>
              </div>
            </div>
          <% } %>
        </div>
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <% 
                // Only declare these variables ONCE at the top of the file or before the table, not here again
                // So here, just use sysStartItem, sysEndItem, sysStartPage, sysEndPage if already declared
              %>
              <span><%= t('Showing {1} - {2} of {3} systems', { 1: sysStartItem, 2: sysEndItem, 3: typeof totalCount !== 'undefined' ? totalCount : 0 }) %></span>
            </div>
            <ul class="pagination pagination-sm m-0 float-end">
              <% 
                function buildFilterQuery() {
                  let params = [];
                  if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                  if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                  if (typeof filterTags !== 'undefined' && filterTags.length) filterTags.forEach(function(tag) { params.push('tags[]=' + encodeURIComponent(tag)); });
                  if (typeof filterContacts !== 'undefined' && filterContacts.length) filterContacts.forEach(function(c) { params.push('contacts[]=' + encodeURIComponent(c)); });
                  if (typeof filterScopes !== 'undefined' && filterScopes.length) filterScopes.forEach(function(scope) { params.push('scopes[]=' + encodeURIComponent(scope)); });
                  if (typeof filterArchitecture !== 'undefined' && filterArchitecture.length) filterArchitecture.forEach(function(arch) { params.push('architectures[]=' + encodeURIComponent(arch)); });
                  if (typeof filterLevel !== 'undefined' && filterLevel) params.push('level=' + encodeURIComponent(filterLevel));
                  if (typeof filterDepartment !== 'undefined' && filterDepartment) params.push('department_id=' + encodeURIComponent(filterDepartment));
                  return params.join('&');
                }
                const filterQuery = buildFilterQuery();
              %>
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %><%= filterQuery ? '&' + filterQuery : '' %>" tabindex="-1"><%= t('Previous') %></a>
              </li>
              <% if (sysStartPage > 1) { %>
                <li class="page-item"><a class="page-link" href="?page=1<%= filterQuery ? '&' + filterQuery : '' %>">1</a></li>
                <% if (sysStartPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% } %>
              <% for (let i = sysStartPage; i <= sysEndPage; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= filterQuery ? '&' + filterQuery : '' %>"><%= i %></a></li>
              <% } %>
              <% if (sysEndPage < totalPages) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= filterQuery ? '&' + filterQuery : '' %>"><%= totalPages %></a></li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %><%= filterQuery ? '&' + filterQuery : '' %>"><%= t('Next') %></a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>



<!-- Data attributes for JavaScript -->
<div id="system-data" 
     data-scope-options='<%= JSON.stringify(scopeOptions || []) %>'
     data-architecture-options='<%= JSON.stringify(architectureOptions || []) %>'
     style="display: none;"></div>

<script>
    // Select2 option data, loaded from the database
    const systemDataEl = document.getElementById('system-data');
    window.scopeOptionsData = JSON.parse(systemDataEl.dataset.scopeOptions || '[]');
    window.architectureOptionsData = JSON.parse(systemDataEl.dataset.architectureOptions || '[]');
    
    

    
    function confirmDeleteSystem(form, name) {
      if (confirm(t('Are you sure you want to delete the system: ') + name + '?')) {
        form._deleting = true;
        return true;
      }
      return false;
    }

    // Simple function to show system detail modal
    function showSystemDetail(systemId) {
      console.log('showSystemDetail called with ID:', systemId);
      window.currentDetailSystemId = systemId;

      try {
        // Find the button that was clicked
        const buttons = document.querySelectorAll('button[data-system]');
        let targetButton = null;
        
        for (let button of buttons) {
          const data = button.getAttribute('data-system');
          if (data) {
            try {
              const system = JSON.parse(data);
              if (system.id == systemId) {
                targetButton = button;
                break;
              }
            } catch (e) {
              console.error('Error parsing system data:', e);
            }
          }
        }
        
        if (!targetButton) {
          console.error('Button not found for system ID:', systemId);
          alert(t('Button not found for system ID: ') + systemId);
          return;
        }
        
        const systemData = targetButton.getAttribute('data-system');
        console.log('Raw system data:', systemData);
        
        let system;
        try {
          system = JSON.parse(systemData);
          console.log('Parsed system data:', system);
        } catch (e) {
          console.error('Error parsing system data:', e);
          alert(t('Error parsing system data: ') + e.message);
          return;
        }
        
        // Check if Bootstrap is available
        if (typeof bootstrap === 'undefined') {
          console.error('Bootstrap is not loaded');
          alert(t('Bootstrap is not loaded'));
          return;
        }
        
        const modalElement = document.getElementById('systemDetailModal');
        if (!modalElement) {
          console.error('Modal element not found');
          alert(t('Modal element not found'));
          return;
        }
        
        const modal = new bootstrap.Modal(modalElement, {
          backdrop: true,
          keyboard: true,
          focus: true
        });
        const content = document.getElementById('systemDetailContent');
        
        // Build HTML content - definition-list field:value layout
        let html = '<dl class="row detail-dl">';

        // Debug: Show all system properties
        console.log('All system properties:', Object.keys(system));

        // System Name
        const systemName = (system.name || system.system_name || 'N/A');
        console.log('System Name:', systemName, 'System Code:', system.system_id || system.code);
        html += '<dt class="col-sm-4">System Name</dt><dd class="col-sm-8">' + escapeHtml(String(systemName).trim()) + '</dd>';

        // System Code
        const systemCode = (system.system_id || system.code || 'N/A');
        console.log('System Code raw:', systemCode, 'Type:', typeof systemCode);
        html += '<dt class="col-sm-4">System Code</dt><dd class="col-sm-8">' + escapeHtml(String(systemCode).trim()) + '</dd>';

        // ID
        const systemIdValue = (system.id || 'N/A');
        html += '<dt class="col-sm-4">ID</dt><dd class="col-sm-8">' + escapeHtml(String(systemIdValue).trim()) + '</dd>';

        // Description
        if (system.description && system.description.trim()) {
          html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8"><span style="white-space: pre-wrap;">' + escapeHtml(system.description) + '</span></dd>';
        }

        // Level
        const level = (system.level || 'N/A');
        html += '<dt class="col-sm-4">Level</dt><dd class="col-sm-8">' + escapeHtml(String(level).trim()) + '</dd>';

        // Organization (Department)
        const department = (system.department_name || system.department || 'N/A');
        if (system.department_id) {
          html += '<dt class="col-sm-4">Organization</dt><dd class="col-sm-8"><span class="org-tooltip" data-unit-id="' + escapeHtml(system.department_id) + '" title="Loading..." style="cursor: help;">' + escapeHtml(String(department).trim()) + '</span></dd>';
        } else {
          html += '<dt class="col-sm-4">Organization</dt><dd class="col-sm-8">' + escapeHtml(String(department).trim()) + '</dd>';
        }

        // Alias
        if (system.alias && (Array.isArray(system.alias) ? system.alias.length > 0 : system.alias)) {
          const alias = Array.isArray(system.alias) ? system.alias.join(', ') : system.alias;
          html += '<dt class="col-sm-4">Alias</dt><dd class="col-sm-8">' + escapeHtml(String(alias).trim()) + '</dd>';
        }

        // FQDN
        if (system.fqdn && (Array.isArray(system.fqdn) ? system.fqdn.length > 0 : system.fqdn)) {
          html += '<dt class="col-sm-4">FQDN</dt><dd class="col-sm-8">';
          const fqdnList = Array.isArray(system.fqdn) ? system.fqdn : [system.fqdn];
          html += '<ul class="mb-0 ps-3">';
          fqdnList.forEach(function(fqdn) {
            const fqdnStr = String(fqdn).trim();
            // Check if FQDN contains brackets - extract domain and comment separately
            if (fqdnStr.includes('[') && fqdnStr.includes(']')) {
              const bracketMatch = fqdnStr.match(/^(.+?)\s*\[(.+?)\]$/);
              if (bracketMatch) {
                const domain = bracketMatch[1].trim();
                const comment = bracketMatch[2].trim();
                html += '<li><a href="http://' + escapeHtml(domain) + '" target="_blank" class="text-decoration-none">' + escapeHtml(domain) + '</a> <span class="badge bg-secondary ms-1">' + escapeHtml(comment) + '</span></li>';
              } else {
                html += '<li><span class="text-muted">' + escapeHtml(fqdnStr) + '</span></li>';
              }
            } else {
              html += '<li><a href="http://' + escapeHtml(fqdnStr) + '" target="_blank" class="text-decoration-none">' + escapeHtml(fqdnStr) + '</a></li>';
            }
          });
          html += '</ul>';
          html += '</dd>';
        }

        // Tags
        if (system.tags && system.tags.length > 0) {
          html += '<dt class="col-sm-4">Tags</dt><dd class="col-sm-8">';
          system.tags.forEach(function(tag) {
            const tagValue = (typeof tag === 'string' ? tag : tag.name);
            html += '<span class="badge bg-primary me-1 mb-1">' + escapeHtml(String(tagValue).trim()) + '</span>';
          });
          html += '</dd>';
        }

        // Scopes
        if (system.scopes && system.scopes.length > 0) {
          html += '<dt class="col-sm-4">Scope</dt><dd class="col-sm-8">';
          system.scopes.forEach(function(scope) {
            html += '<span class="badge bg-info me-1 mb-1">' + escapeHtml(String(scope).trim()) + '</span>';
          });
          html += '</dd>';
        }

        // Architecture
        if (system.architecture && system.architecture.length > 0) {
          html += '<dt class="col-sm-4">Architecture</dt><dd class="col-sm-8">';
          system.architecture.forEach(function(arch) {
            html += '<span class="badge bg-warning me-1 mb-1">' + escapeHtml(String(arch).trim()) + '</span>';
          });
          html += '</dd>';
        }

        // IP Addresses
        if (system.ip_addresses && system.ip_addresses.length > 0) {
          html += '<dt class="col-sm-4">IP Addresses</dt><dd class="col-sm-8">';
          system.ip_addresses.forEach(function(ipObj) {
            const ipAddress = ipObj.ip || ipObj.ip_address || ipObj;
            const zone = ipObj.subnet_zone || '';
            const environment = ipObj.subnet_environment || '';
            const serverName = ipObj.server_name || '';
            
            html += '<div class="mt-1 d-flex align-items-center flex-wrap">';
            html += '<a href="/network/ip-address?search=' + encodeURIComponent(ipAddress) + '" target="_blank" class="text-decoration-none text-primary me-2 ip-hover-link" data-ip="' + escapeHtml(ipAddress) + '" data-bs-toggle="tooltip" data-bs-placement="top" title="Loading IP info...">' + escapeHtml(String(ipAddress).trim()) + '</a>';

            // Add server/device name if available
            if (serverName) {
              html += '<span class="badge bg-light text-dark border me-2" style="border-radius: 3px;">[' + escapeHtml(serverName) + ']</span>';
            }

            // Add zone and environment info if available
            if (zone || environment) {
              const zoneEnvText = (zone && environment) ? zone + '-' + environment : (zone || environment);
              html += '<span class="badge bg-light text-dark border me-2" style="border-radius: 3px;">[' + escapeHtml(zoneEnvText) + ']</span>';
            }
            
            html += '</div>';
          });
          html += '</dd>';
        }

        // Domains
        if (system.domains && system.domains.length > 0) {
          html += '<dt class="col-sm-4">Domains</dt><dd class="col-sm-8">';
          system.domains.forEach(function(domainObj) {
            const domain = domainObj.domain || domainObj;
            html += '<a href="/network/domain?search=' + encodeURIComponent(domain) + '" target="_blank" class="badge bg-secondary me-1 mb-1 text-decoration-none" title="Click to view domain details">' + escapeHtml(String(domain).trim()) + '</a>';
          });
          html += '</dd>';
        }

        <% if (hasPermission('cluster.read')) { %>
        // Clusters - loaded via AJAX, same as Components. Kept out of
        // System's own query entirely (mirrors the Organization-tooltip and
        // Pentest quick-view approach: a small dedicated API + client-side
        // fetch instead of baking cluster data into System's SQL).
        html += '<dt class="col-sm-4">Clusters</dt><dd class="col-sm-8" id="clusters-section-' + escapeHtml(systemId) + '"><span class="text-muted">Loading...</span></dd>';
        <% } %>

        // Contacts
        if (system.contacts && system.contacts.length > 0) {
          html += '<dt class="col-sm-4">Contacts</dt><dd class="col-sm-8"><ul class="mb-0 ps-3">';
          system.contacts.forEach(function(contactObj) {
            const contactName = contactObj.name || contactObj;
            const contactEmail = contactObj.email || '';
            let displayText = contactName;
            let searchTerm = contactName;

            if (contactEmail) {
              // Extract username part before @
              const emailUsername = contactEmail.split('@')[0];
              displayText = `${contactName} (${emailUsername})`;
              searchTerm = contactEmail; // Still use full email for search
            }

            html += '<li><a href="/organize/contact?search=' + encodeURIComponent(searchTerm) + '" target="_blank" class="text-decoration-none text-primary">' + escapeHtml(String(displayText).trim()) + '</a></li>';
          });
          html += '</ul></dd>';
        }

        // Created
        const created = (system.created_at || system.createdAt || 'N/A');
        html += '<dt class="col-sm-4">Created</dt><dd class="col-sm-8">' + escapeHtml(String(created).trim()) + '</dd>';

        // Updated
        const updated = (system.updated_at || system.updatedAt || 'N/A');
        html += '<dt class="col-sm-4">Updated</dt><dd class="col-sm-8">' + escapeHtml(String(updated).trim()) + '</dd>';

        // Updated By
        if (system.updated_by) {
          html += '<dt class="col-sm-4">Updated By</dt><dd class="col-sm-8">' + escapeHtml(String(system.updated_by).trim()) + '</dd>';
        }

        // Files/Documents
        if (system.docs && system.docs.length > 0) {
          html += '<dt class="col-sm-4">Attached Files</dt><dd class="col-sm-8">';
          system.docs.forEach(function(file) {
            const fileName = file.name || file.originalname || 'Unknown file';
            const fileUrl = file.url || '#';
            const fileViewUrl = file.id ? ('/system/file/' + file.id + '/view') : fileUrl;
            html += '<div class="mt-1">';
            html += '<a href="' + escapeHtml(fileUrl) + '" download class="text-decoration-none text-primary me-2">' + escapeHtml(String(fileName).trim()) + '</a>';
            html += '<a href="' + escapeHtml(fileViewUrl) + '" target="_blank" rel="noopener noreferrer" class="badge bg-light text-dark border text-decoration-none" style="border-radius: 3px;">[View]</a>';
            html += '</div>';
          });
          html += '</dd>';
        }

        // Components - will be loaded via AJAX (moved to bottom)
        html += '<dt class="col-sm-4">Components</dt><dd class="col-sm-8" id="components-section-' + escapeHtml(systemId) + '"><span class="text-muted">Loading...</span></dd>';

        html += '</dl>';
        content.innerHTML = html;
        initOrgTooltips(content);

        // Show modal with proper event handling
        modal.show();

        // Load components data via AJAX
        loadSystemComponents(systemId);
        <% if (hasPermission('cluster.read')) { %>
        loadSystemClusters(systemId);
        <% } %>
        
        // Add IP hover functionality
        setupIPHover();
        
        // Handle modal events
        modalElement.addEventListener('shown.bs.modal', function() {
          console.log('Modal shown successfully');
        });
        
        modalElement.addEventListener('hidden.bs.modal', function() {
          console.log('Modal hidden');
          // Clear content when modal is hidden
          content.innerHTML = '';
        });
        
      } catch (error) {
        console.error('Error showing system detail:', error);
        alert(t('Error loading system details: ') + error.message);
      }
    }

    // Function to setup IP hover functionality — uses Bootstrap's Tooltip
    // component (same as the Description column tooltips) instead of the
    // native browser title tooltip, so both look and behave the same way.
    function setupIPHover() {
      const ipLinks = document.querySelectorAll('.ip-hover-link');
      ipLinks.forEach(link => {
        if (link.getAttribute('data-tooltip-init') === 'true') return;
        link.setAttribute('data-tooltip-init', 'true');
        new bootstrap.Tooltip(link);
        link.addEventListener('mouseenter', handleIPHover);
      });
    }

    // IP hover handler
    function handleIPHover(event) {
      const element = event.target.closest('.ip-hover-link');
      const ipAddress = element.getAttribute('data-ip');
      const tooltip = bootstrap.Tooltip.getInstance(element);

      if (!ipAddress || !tooltip || element.getAttribute('data-loading') === 'true') {
        return;
      }

      // Set loading state
      element.setAttribute('data-loading', 'true');
      tooltip.setContent({ '.tooltip-inner': 'Loading IP info...' });

      // Fetch IP information
      fetch(`/network/api/ip-addresses/detail?search=${encodeURIComponent(ipAddress)}`)
        .then(response => response.json())
        .then(data => {
          if (data && data.length > 0) {
            const ipInfo = data[0];
            let tooltipText = `IP: ${ipInfo.ip_address || ipInfo.ip || ipAddress}`;
            
            if (ipInfo.description) {
              tooltipText += `\nDescription: ${ipInfo.description}`;
            }
            
            if (ipInfo.status) {
              tooltipText += `\nStatus: ${ipInfo.status}`;
            }
            
            // List EVERY owner — an IP can have more than one device/server
            // once VIP sharing is involved, not just a single primary owner.
            (ipInfo.servers || []).forEach(function(s) {
              tooltipText += `\nServer: ${s.name}${s.role === 'vip' ? ' (VIP)' : ''}`;
            });
            (ipInfo.devices || []).forEach(function(d) {
              tooltipText += `\nDevice: ${d.name}${d.role === 'vip' ? ' (VIP)' : ''}`;
            });
            
            // Add tags information
            if (ipInfo.tags && ipInfo.tags.length > 0) {
              const tagNames = ipInfo.tags.map(tag => typeof tag === 'string' ? tag : tag.name).join(', ');
              tooltipText += `\nTags: ${tagNames}`;
            }
            
            // Add contacts information
            if (ipInfo.contacts && ipInfo.contacts.length > 0) {
              const contactEmails = ipInfo.contacts.map(contact => {
                if (typeof contact === 'string') {
                  // If it's a string, check if it's an email or name
                  if (contact.includes('@')) {
                    return contact.split('@')[0]; // Extract username part
                  }
                  return contact;
                }
                // If it's an object, handle email and name like in System Detail
                if (contact.email) {
                  const emailUsername = contact.email.split('@')[0];
                  return contact.name ? `${contact.name} (${emailUsername})` : emailUsername;
                }
                return contact.name || contact;
              }).join(', ');
              tooltipText += `\nContacts: ${contactEmails}`;
            }
            
            // Add systems information
            if (ipInfo.systems && ipInfo.systems.length > 0) {
              const systemNames = ipInfo.systems.map(system => typeof system === 'string' ? system : system.name).join(', ');
              tooltipText += `\nSystems: ${systemNames}`;
            }
            
            tooltip.setContent({ '.tooltip-inner': tooltipText });
          } else {
            tooltip.setContent({ '.tooltip-inner': `IP: ${ipAddress}\nNo additional information found` });
          }
        })
        .catch(error => {
          console.error('Error loading IP info:', error);
          tooltip.setContent({ '.tooltip-inner': `IP: ${ipAddress}\nError loading information` });
        })
        .finally(() => {
          element.removeAttribute('data-loading');
        });
    }

    // Function to load system components via AJAX
    function loadSystemComponents(systemId) {
      const componentsSection = document.getElementById('components-section-' + systemId);
      if (!componentsSection) return;
      
      fetch(`/system/api/system/${systemId}/components`)
        .then(response => response.json())
        .then(data => {
          if (data.components && data.components.length > 0) {
            let componentsHtml = '<div class="components-section">';
            componentsHtml += '<h6 class="mb-3 text-primary"><i class="bi bi-gear-fill me-2"></i>Components (' + data.components.length + ')</h6>';

            data.components.forEach(function(component, index) {
              const detailId = 'component-detail-' + systemId + '-' + index;

              // Name row — collapsed by default; click to expand the detail card below
              componentsHtml += '<div class="component-name-row d-flex justify-content-between align-items-center border rounded px-3 py-2 mb-1 bg-light" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#' + escapeHtml(detailId) + '" role="button" aria-expanded="false">';
              componentsHtml += '<span class="fw-bold text-dark">' + escapeHtml(String(component.name || 'N/A').trim()) + '</span>';
              componentsHtml += '<span class="d-flex align-items-center">';
              if (component.app_type) {
                componentsHtml += '<span class="badge bg-primary me-2">' + escapeHtml(String(component.app_type).trim()) + '</span>';
              }
              componentsHtml += '<i class="bi bi-chevron-down component-toggle-icon"></i>';
              componentsHtml += '</span>';
              componentsHtml += '</div>';

              componentsHtml += '<div class="collapse mb-2" id="' + escapeHtml(detailId) + '">';
              componentsHtml += '<div class="component-card border rounded p-3 bg-white">';

              // Component Details in smaller font
              componentsHtml += '<div class="component-details small text-muted">';
              
              // Component ID
              if (component.id) {
                componentsHtml += '<div class="mb-1">';
                componentsHtml += '<span class="fw-semibold">ID:</span> ' + escapeHtml(String(component.id).trim());
                componentsHtml += '</div>';
              }

              // Description
              if (component.description && component.description.trim()) {
                componentsHtml += '<div class="mb-2">';
                componentsHtml += '<span class="fw-semibold">Description:</span><br><span style="white-space: pre-wrap;">' + escapeHtml(component.description) + '</span>';
                componentsHtml += '</div>';
              }
              
              // FQDN
              if (component.fqdn && (Array.isArray(component.fqdn) ? component.fqdn.length > 0 : component.fqdn)) {
                componentsHtml += '<div class="mb-2">';
                componentsHtml += '<span class="fw-semibold">FQDN:</span>';
                const fqdnList = Array.isArray(component.fqdn) ? component.fqdn : [component.fqdn];
                componentsHtml += '<div class="mt-1">';
                fqdnList.forEach(function(fqdn) {
                  const fqdnStr = String(fqdn).trim();
                  // Check if FQDN contains brackets - extract domain and comment separately
                  if (fqdnStr.includes('[') && fqdnStr.includes(']')) {
                    const bracketMatch = fqdnStr.match(/^(.+?)\s*\[(.+?)\]$/);
                    if (bracketMatch) {
                      const domain = bracketMatch[1].trim();
                      const comment = bracketMatch[2].trim();
                      componentsHtml += '<div class="mb-1"><a href="http://' + escapeHtml(domain) + '" target="_blank" class="text-decoration-none text-primary">' + escapeHtml(domain) + '</a> <span class="badge bg-secondary ms-1">' + escapeHtml(comment) + '</span></div>';
                    } else {
                      componentsHtml += '<div class="mb-1 text-muted">' + escapeHtml(fqdnStr) + '</div>';
                    }
                  } else {
                    componentsHtml += '<div class="mb-1"><a href="http://' + escapeHtml(fqdnStr) + '" target="_blank" class="text-decoration-none text-primary">' + escapeHtml(fqdnStr) + '</a></div>';
                  }
                });
                componentsHtml += '</div>';
                componentsHtml += '</div>';
              }
              
              // IP Addresses
              if (component.ips && component.ips.length > 0) {
                componentsHtml += '<div class="mb-2">';
                componentsHtml += '<span class="fw-semibold">IP Addresses:</span>';
                componentsHtml += '<div class="mt-1">';
                component.ips.forEach(function(ipObj, index) {
                  const ipAddress = ipObj.ip_address || ipObj.ip || ipObj;
                  componentsHtml += '<a href="/network/ip-address?search=' + encodeURIComponent(ipAddress) + '" target="_blank" class="text-decoration-none text-primary ip-hover-link" data-ip="' + escapeHtml(ipAddress) + '" data-bs-toggle="tooltip" data-bs-placement="top" title="Loading IP info...">' + escapeHtml(String(ipAddress).trim()) + '</a>';
                  
                  // Add comma separator if not the last item
                  if (index < component.ips.length - 1) {
                    componentsHtml += ', ';
                  }
                });
                componentsHtml += '</div>';
                componentsHtml += '</div>';
              }
              
              // Contacts
              if (component.contacts && component.contacts.length > 0) {
                componentsHtml += '<div class="mb-2">';
                componentsHtml += '<span class="fw-semibold">Contacts:</span>';
                componentsHtml += '<ul class="mb-0 mt-1">';
                component.contacts.forEach(function(contactObj) {
                  const contactName = contactObj.name || contactObj;
                  const contactEmail = contactObj.email || '';
                  let displayText = contactName;
                  let searchTerm = contactName;
                  
                  if (contactEmail) {
                    // Extract username part before @
                    const emailUsername = contactEmail.split('@')[0];
                    displayText = `${contactName} (${emailUsername})`;
                    searchTerm = contactEmail; // Still use full email for search
                  }
                  
                  componentsHtml += '<li><a href="/organize/contact?search=' + encodeURIComponent(searchTerm) + '" target="_blank" class="text-decoration-none text-primary">' + escapeHtml(String(displayText).trim()) + '</a></li>';
                });
                componentsHtml += '</ul>';
                componentsHtml += '</div>';
              }

              // Tags
              if (component.tags && component.tags.length > 0) {
                componentsHtml += '<div class="mb-2">';
                componentsHtml += '<span class="fw-semibold">Tags:</span>';
                componentsHtml += '<div class="mt-1">';
                component.tags.forEach(function(tag) {
                  const tagValue = (typeof tag === 'string' ? tag : tag.name);
                  componentsHtml += '<span class="badge bg-primary me-1 mb-1">' + escapeHtml(String(tagValue).trim()) + '</span>';
                });
                componentsHtml += '</div>';
                componentsHtml += '</div>';
              }

              // Created/Updated dates
              if (component.created_at || component.updated_at) {
                componentsHtml += '<div class="d-flex justify-content-between text-muted">';
                if (component.created_at) {
                  componentsHtml += '<small><span class="fw-semibold">Created:</span> ' + escapeHtml(String(component.created_at).trim()) + '</small>';
                }
                if (component.updated_at) {
                  componentsHtml += '<small><span class="fw-semibold">Updated:</span> ' + escapeHtml(String(component.updated_at).trim()) + '</small>';
                }
                componentsHtml += '</div>';
              }
              
              componentsHtml += '</div>'; // End component-details
              componentsHtml += '</div>'; // End component-card
              componentsHtml += '</div>'; // End collapse
            });
            
            componentsHtml += '</div>'; // End components-section
            componentsSection.innerHTML = componentsHtml;
            
            // Setup IP hover for components
            setupIPHover();
          } else {
            componentsSection.innerHTML = '<div class="text-center text-muted py-3"><i class="bi bi-gear me-2"></i>No components found</div>';
          }
        })
        .catch(error => {
          console.error('Error loading components:', error);
          componentsSection.innerHTML = '<strong>Components:</strong> <span class="text-danger">Error loading components</span>';
        });
    }

    // Clusters serving this System - loaded via AJAX from a dedicated
    // Cluster endpoint (read-only here; managed from the Cluster Management
    // page). System's own query/model is untouched by this feature.
    function loadSystemClusters(systemId) {
      const clustersSection = document.getElementById('clusters-section-' + systemId);
      if (!clustersSection) return;

      fetch('/cluster/api/by-system?system_id=' + encodeURIComponent(systemId))
        .then(function(response) { return response.json(); })
        .then(function(data) {
          const clusters = data.clusters || [];
          if (clusters.length === 0) {
            clustersSection.innerHTML = '<span class="text-muted">No clusters</span>';
            return;
          }
          let html = '';
          clusters.forEach(function(cluster) {
            html += '<a href="/cluster?search=' + encodeURIComponent(cluster.name) + '" target="_blank" rel="noopener noreferrer" class="badge bg-secondary me-1 mb-1 text-decoration-none">' + escapeHtml(cluster.name) + '</a>';
          });
          clustersSection.innerHTML = html;
        })
        .catch(function(error) {
          console.error('Error loading clusters:', error);
          clustersSection.innerHTML = '<span class="text-danger">Error loading clusters</span>';
        });
    }

    function showToast(msg, type) {
      const toast = document.createElement('div');
      toast.className = `alert alert-${type}`;
      toast.style.position = 'fixed';
      toast.style.top = '16px';
      toast.style.right = '16px';
      toast.style.zIndex = 9999;
      toast.style.minWidth = '200px';
      toast.innerText = msg;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    // Filter modal select2 logic
    function restoreSelect2Value($el, values, url) {
      if (!values || !values.length) {
        return;
      }

      // '__none__' is a synthetic "not set" sentinel, not a real record id -
      // it can't be resolved via the ids-lookup endpoint, so add its display
      // option directly and only look up the real ids via AJAX.
      var hasNone = values.indexOf('__none__') !== -1;
      var realValues = values.filter(function(v) { return v !== '__none__'; });
      if (hasNone && $el.find('option[value="__none__"]').length === 0) {
        $el.append(new Option('-- None (not set) --', '__none__', true, true));
      }

      if (!realValues.length) {
        setTimeout(function() {
          $el.val(values).trigger('change');
        }, 100);
        return;
      }

      $.ajax({
        url: url,
        data: { ids: realValues },
        dataType: 'json',
        traditional: true,
        xhrFields: {
          withCredentials: true
        },
        success: function(data) {
          if (!data || !Array.isArray(data)) {
            return;
          }

          data.forEach(function(item) {
            if ($el.find('option[value="' + item.id + '"]').length === 0) {
              var option = new Option(item.text || item.name, item.id, true, true);
              $el.append(option);
            }
          });

          // Use setTimeout to ensure options are added before setting values
          setTimeout(function() {
            $el.val(values).trigger('change');
          }, 100);
        },
        error: function(xhr, status, error) {
          // Silent error handling
        }
      });
    }


    $(function() {
      
      var $filterModal = $('#filterSystemModal');
      var $modalContent = $filterModal.find('.modal-content');
      
      var filterValues = {
        tags: JSON.parse(document.getElementById('filter-system-data').dataset.tags || '[]'),
        contacts: JSON.parse(document.getElementById('filter-system-data').dataset.contacts || '[]'),
        scopes: JSON.parse(document.getElementById('filter-system-data').dataset.scopes || '[]'),
        architecture: JSON.parse(document.getElementById('filter-system-data').dataset.architecture || '[]')
      };
      
      $('#filterSystemTags').select2({
        theme: 'bootstrap-5',
        placeholder: t('Select tag(s)'),
        allowClear: true,
        width: '100%',
        dropdownParent: $modalContent,
        ajax: {
          url: '/organize/api/tag',
          dataType: 'json',
          delay: 250,
          data: params => ({ search: params.term }),
          processResults: data => ({ results: data })
        }
      });
      $('#filterSystemContacts').select2({
        theme: 'bootstrap-5',
        placeholder: t('Select contact(s)'),
        allowClear: true,
        width: '100%',
        dropdownParent: $modalContent,
        ajax: {
          url: '/organize/api/contact',
          dataType: 'json',
          delay: 250,
          data: params => ({ search: params.term }),
          // "(Not set)" isn't a real contact, so it can't come from the
          // contact-search endpoint - prepend it client-side, only while not
          // actively searching, so it stays the default first option.
          processResults: (data, params) => {
            const results = data || [];
            if (!params.term) {
              return { results: [{ id: '__none__', text: '-- None (not set) --' }, ...results] };
            }
            return { results: results };
          }
        }
      });
      // Build Select2 directly from the backend data
      $('#filterSystemScopes').select2({
        theme: 'bootstrap-5',
        placeholder: t('Select scope(s)'),
        allowClear: true,
        width: '100%',
        dropdownParent: $modalContent,
        data: [{ id: '__none__', text: '-- None (not set) --' }, ...(window.scopeOptionsData || [])],
        // Uses Select2's default {id, text} format
      });

      // Build Select2 directly from the backend data
      $('#filterSystemArchitecture').select2({
        theme: 'bootstrap-5',
        placeholder: t('Select architecture(s)'),
        allowClear: true,
        width: '100%',
        dropdownParent: $modalContent,
        data: [{ id: '__none__', text: '-- None (not set) --' }, ...(window.architectureOptionsData || [])],
        // Uses Select2's default {id, text} format
      });

      // Level and Department: plain single-selects, options + selected
      // state already rendered server-side, so no restore step needed.
      $('#filterSystemLevel').select2({
        theme: 'bootstrap-5',
        placeholder: t('All Levels'),
        allowClear: true,
        width: '100%',
        dropdownParent: $modalContent
      });
      $('#filterSystemDepartment').select2({
        theme: 'bootstrap-5',
        placeholder: t('All Departments'),
        allowClear: true,
        width: '100%',
        dropdownParent: $modalContent
      });


      // Restore all filter values with proper timing
      setTimeout(function() {
        // Restore tags
        if (filterValues.tags && filterValues.tags.length > 0) {
          restoreSelect2Value($('#filterSystemTags'), filterValues.tags, '/organize/api/tag/ids');
        }
        
        // Restore contacts
        if (filterValues.contacts && filterValues.contacts.length > 0) {
          restoreSelect2Value($('#filterSystemContacts'), filterValues.contacts, '/organize/api/contact/ids');
        }
      }, 500);
      
      
      // Also restore when modal is shown
      $filterModal.on('shown.bs.modal', function() {
        setTimeout(function() {
          // Restore tags
          if (filterValues.tags && filterValues.tags.length > 0) {
            restoreSelect2Value($('#filterSystemTags'), filterValues.tags, '/organize/api/tag/ids');
          }
          
          // Restore contacts
          if (filterValues.contacts && filterValues.contacts.length > 0) {
            restoreSelect2Value($('#filterSystemContacts'), filterValues.contacts, '/organize/api/contact/ids');
          }
        }, 200);
      });
      
      // Restore scope and architecture values - need to add options first
      if (filterValues.scopes && filterValues.scopes.length > 0) {
        // Add options to scope select if they don't exist
        filterValues.scopes.forEach(function(scopeValue) {
          if ($('#filterSystemScopes').find('option[value="' + scopeValue + '"]').length === 0) {
            const option = new Option(scopeValue, scopeValue, true, true);
            $('#filterSystemScopes').append(option);
          }
        });
        // Use setTimeout to ensure Select2 is fully initialized
        setTimeout(function() {
          $('#filterSystemScopes').val(filterValues.scopes).trigger('change');
        }, 100);
      }
      
      if (filterValues.architecture && filterValues.architecture.length > 0) {
        // Add options to architecture select if they don't exist
        filterValues.architecture.forEach(function(archValue) {
          if ($('#filterSystemArchitecture').find('option[value="' + archValue + '"]').length === 0) {
            const option = new Option(archValue, archValue, true, true);
            $('#filterSystemArchitecture').append(option);
          }
        });
        // Use setTimeout to ensure Select2 is fully initialized
        setTimeout(function() {
          $('#filterSystemArchitecture').val(filterValues.architecture).trigger('change');
        }, 100);
      }
      

      // Clear Filter button
      $('#clearFilterBtnSystem').on('click', function() {
        // Clear all select2 values
        $('#filterSystemTags').val(null).trigger('change');
        $('#filterSystemContacts').val(null).trigger('change');
        $('#filterSystemScopes').val(null).trigger('change');
        $('#filterSystemArchitecture').val(null).trigger('change');
        $('#filterSystemLevel').val(null).trigger('change');
        $('#filterSystemDepartment').val(null).trigger('change');
        // Close modal
        $filterModal.modal('hide');
        // Redirect to clean URL but preserve pageSize and search
        const currentPageSize = $('select[name="pageSize"]').val() || '10';
        const currentSearch = $('input[name="search"]').val() || '';
        let cleanUrl = '/system/system';
        const params = [];
        if (currentPageSize && currentPageSize !== '10') params.push('pageSize=' + encodeURIComponent(currentPageSize));
        if (currentSearch) params.push('search=' + encodeURIComponent(currentSearch));
        if (params.length > 0) cleanUrl += '?' + params.join('&');
        window.location.href = cleanUrl;
      });
      

    });
    
    // Responsive layout handler
    function handleResponsiveLayout() {
      const width = window.innerWidth;
      const table = document.getElementById('systemTable');
      const mobileCards = document.getElementById('systemMobileCards');
      
      if (width <= 576) {
        // Show mobile cards, hide table
        if (table) table.closest('.table-responsive').style.display = 'none';
        if (mobileCards) mobileCards.style.display = 'block';
      } else {
        // Show table, hide mobile cards
        if (table) table.closest('.table-responsive').style.display = 'block';
        if (mobileCards) mobileCards.style.display = 'none';
      }
    }
    
    // Initialize responsive layout
    $(document).ready(function() {
      handleResponsiveLayout();


      // Handle window resize
      let resizeTimeout;
      $(window).on('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(handleResponsiveLayout, 100);
      });
    });

    // Initialize tooltips
    $(document).ready(function() {
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });
    });

    // Organization/Unit hover tooltip — lazily fetches the unit's
    // description via AJAX on first hover instead of carrying it through
    // this page's own query. Cached across elements sharing the same unit id.
    const unitInfoCache = {};
    function initOrgTooltips(scopeEl) {
      (scopeEl || document).querySelectorAll('.org-tooltip').forEach(function(el) {
        if (el.dataset.tooltipInit) return;
        el.dataset.tooltipInit = '1';
        const unitId = el.getAttribute('data-unit-id');
        if (!unitId) return;
        const tooltip = new bootstrap.Tooltip(el, { title: 'Loading...' });
        el.addEventListener('show.bs.tooltip', function() {
          if (unitInfoCache[unitId]) {
            tooltip.setContent({ '.tooltip-inner': unitInfoCache[unitId] });
            return;
          }
          fetch('/organize/api/unit/' + encodeURIComponent(unitId) + '/detail')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              const desc = (data && data.description) ? data.description : 'No description';
              unitInfoCache[unitId] = desc;
              tooltip.setContent({ '.tooltip-inner': desc });
            })
            .catch(function() {
              tooltip.setContent({ '.tooltip-inner': 'Error loading info' });
            });
        });
      });
    }

    // Read-only quick-view of pentest rounds for a System/Component, launched
    // from the Detail modal's "Pentest History" button. Full add/edit/delete
    // happens on the dedicated Pentest Management page (link below).
    // Round name, participant names, and the uploaded report's original
    // filename are all free-text user input persisted server-side with no
    // HTML stripping — must be escaped before going into innerHTML, or a
    // crafted round/filename executes script in the browser of anyone who
    // later opens this quick-view.
    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function showPentestQuickView(objectType, objectId) {
      if (!objectId) return;
      const content = document.getElementById('pentestQuickViewContent');
      content.innerHTML = '<p class="text-muted mb-0">Loading...</p>';
      document.getElementById('pentestQuickViewManageLink').href = '/pentest?object_type=' + encodeURIComponent(objectType) + '&object_id=' + encodeURIComponent(objectId);
      const modal = new bootstrap.Modal(document.getElementById('pentestQuickViewModal'));
      modal.show();

      fetch('/pentest/api/by-object?object_type=' + encodeURIComponent(objectType) + '&object_id=' + encodeURIComponent(objectId))
        .then(res => res.json())
        .then(data => {
          const rounds = data.rounds || [];
          if (rounds.length === 0) {
            content.innerHTML = '<p class="text-muted mb-0">No pentest rounds recorded yet.</p>';
            return;
          }
          let html = '<table class="table table-sm table-hover mb-0"><thead><tr><th>Round Name</th><th>Date</th><th>Status</th><th>Participants</th><th>Report</th></tr></thead><tbody>';
          rounds.forEach(function(round) {
            const participants = (round.participants || []).map(p => escapeHtml(p.name)).join(', ') || '-';
            let report = '<span class="text-muted">No report</span>';
            if (round.report) {
              report = '<a href="' + escapeHtml(round.report.url) + '" download class="text-decoration-none text-primary me-1">' + escapeHtml(round.report.original_name) + '</a>' +
                       '<a href="/pentest/report/' + encodeURIComponent(round.report.id) + '/view" target="_blank" rel="noopener noreferrer" class="badge bg-light text-dark border text-decoration-none" style="border-radius:3px;">[View]</a>';
            }
            html += '<tr><td>' + escapeHtml(round.name) + '</td><td>' + (round.test_date ? new Date(round.test_date).toLocaleDateString('en-GB') : '-') + '</td><td>' + escapeHtml(round.status || 'NOT_STARTED') + '</td><td>' + participants + '</td><td>' + report + '</td></tr>';
          });
          html += '</tbody></table>';
          content.innerHTML = html;
        })
        .catch(() => {
          content.innerHTML = '<p class="text-danger mb-0">Error loading pentest rounds.</p>';
        });
    }
</script>

<style>
/* Custom tooltip styles for multi-line descriptions */
.tooltip .tooltip-inner {
  white-space: pre-wrap;
  max-width: 400px;
  text-align: left;
}

/* Component name row chevron rotates when its detail card is expanded */
.component-name-row .component-toggle-icon {
  transition: transform 0.2s ease-in-out;
}
.component-name-row[aria-expanded="true"] .component-toggle-icon {
  transform: rotate(180deg);
}

/* Description column alignment - same as other columns */
/* DISABLED TO USE DEFAULT TABLE STYLES */
/*
#systemTable td:nth-child(4) {
  text-align: left;
  vertical-align: top;
}

#systemTable td:nth-child(4) span {
  text-align: left;
  display: inline-block;
  padding-top: 0;
  margin-top: 0;
  line-height: 1;
}
*/

/* Fixed proportional column widths — see network/ip_address_list.ejs for
   rationale. Description is column 4 here (No., System Code, Name precede it). */
#systemTable {
  table-layout: fixed;
  min-width: 1200px;
}
#systemTable thead th {
  white-space: nowrap;
}
#systemTable th:nth-child(1), #systemTable td:nth-child(1) { width: 4%; }
#systemTable th:nth-child(2), #systemTable td:nth-child(2) { width: 9%; }
#systemTable th:nth-child(3), #systemTable td:nth-child(3) { width: 12%; }
#systemTable th:nth-child(4), #systemTable td:nth-child(4) { width: 15%; }
#systemTable th:nth-child(5), #systemTable td:nth-child(5) { width: 10%; }
#systemTable th:nth-child(6), #systemTable td:nth-child(6) { width: 11%; }
#systemTable th:nth-child(7), #systemTable td:nth-child(7) { width: 12%; }
#systemTable th:nth-child(8), #systemTable td:nth-child(8) { width: 13%; }
/* Wide enough that the 3 action icons stay on one line — the table already
   scrolls horizontally (min-width above), so there's no need to squeeze this
   column narrow the way IP Address List's Actions column is. */
#systemTable th:nth-child(9), #systemTable td:nth-child(9) { width: 14%; }
#systemTable td:nth-child(4) {
  text-align: left;
  vertical-align: top;
  overflow-wrap: break-word;
}
#systemTable td:nth-child(3) {
