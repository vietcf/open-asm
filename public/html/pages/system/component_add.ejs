<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item"><a href="/system/component"><%= t('Component List') %></a></li>
          <li class="breadcrumb-item active"><%= t('Add Component') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<section class="app-content">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10 col-sm-12">
      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><%= t('Add System Component') %></h5>
        </div>
        <form action="/system/component/add" method="POST">
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label"><%= t('Component Name') %> <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="<%= t('Enter component name') %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Description') %></label>
              <textarea name="description" class="form-control" rows="4" placeholder="<%= t('Please provide the following information: 1) What business functions/features does this component provide? 2) What components does it include? 3) Who are the target users of this component?') %>"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('System') %> <span class="text-danger">*</span></label>
              <select id="system-select" name="system_id" class="form-select" required></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('App Type') %></label>
              <select name="app_type" class="form-select" data-placeholder="<%= t('Select app type') %>">
                <option value="">-- <%= t('Select App Type --') %></option>
                <% if (typeof appTypeOptions !== 'undefined' && Array.isArray(appTypeOptions)) { %>
                  <% appTypeOptions.forEach(function(opt) { %>
                    <option value="<%= opt.id || opt.value %>"><%= opt.text || opt.label %></option>
                  <% }) %>
                <% } else { %>
                  <option value="web"><%= t('Web App') %></option>
                  <option value="mobile"><%= t('Mobile App') %></option>
                  <option value="api">API</option>
                  <option value="service"><%= t('Service') %></option>
                  <option value="database"><%= t('Database') %></option>
                <% } %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('FQDN / Domain / IP / URL (comma separated)') %></label>
              <textarea name="fqdn" class="form-control" rows="3" placeholder="<%= t('Example: http://domain:8443, https://domain.com, http://192.168.1.3:8443, ...') %>"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Contacts') %></label>
              <select id="contact-select" name="contacts[]" class="form-select" multiple data-placeholder="<%= t('Select contacts') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('IP Addresses') %></label>
              <select id="ip-select" name="ips[]" class="form-select" multiple data-placeholder="<%= t('Select IP addresses') %>"></select>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= t('Tags') %></label>
              <select id="tag-select" name="tags[]" class="form-select" multiple data-placeholder="<%= t('Select tags') %>"></select>
            </div>
          </div>
          <div class="card-footer d-flex justify-content-end">
            <a href="/system/component" class="btn btn-secondary btn-sm me-2"><%= t('Cancel') %></a>
            <button type="submit" class="btn btn-primary btn-sm"><%= t('Add Component') %></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
/* Match Add IP Address modal: stack action buttons full-width on mobile,
   with the primary action above Cancel. */
@media (max-width: 991.98px) {
  .card-footer.d-flex.justify-content-end {
    flex-direction: column !important;
    gap: 0.5rem !important;
    align-items: stretch !important;
  }
  .card-footer.d-flex.justify-content-end .btn {
    width: 100% !important;
    margin: 0 !important;
  }
  .card-footer.d-flex.justify-content-end .btn:first-child {
    order: 2 !important;
  }
  .card-footer.d-flex.justify-content-end .btn:last-child {
    order: 1 !important;
  }
}
</style>

<script src="/vendor/jquery-3.6.0.min.js"></script>
<link href="/css/select2.min.css" rel="stylesheet" />
<link href="/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="/vendor/select2.min.js"></script>
<script src="/vendor/bootstrap.min.js"></script>
<link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css" />

<script>
$(function() {
  // System select2 AJAX - Bootstrap 5 theme
  $('#system-select').select2({
    theme: 'bootstrap-5',
    placeholder: t('Select system'),
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/system/api/system',
      dataType: 'json',
      delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
      cache: true
    }
  });
  
  // App Type select2 - Bootstrap 5 theme
  $('select[name="app_type"]').select2({
    theme: 'bootstrap-5',
    placeholder: t('Select app type'),
    allowClear: true,
    width: '100%'
  });

  // Contact select2 AJAX - Bootstrap 5 theme
  $('#contact-select').select2({
    theme: 'bootstrap-5',
    placeholder: $('#contact-select').data('placeholder'),
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/organize/api/contact',
      dataType: 'json',
      delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
      cache: true
    }
  });
  
  // IP Address select2 AJAX - Bootstrap 5 theme
  $('#ip-select').select2({
    theme: 'bootstrap-5',
    placeholder: $('#ip-select').data('placeholder'),
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/network/api/ip-addresses',
      dataType: 'json',
      delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
      cache: true
    }
  });
  
  // Tag select2 AJAX - Bootstrap 5 theme
  $('#tag-select').select2({
    theme: 'bootstrap-5',
    placeholder: $('#tag-select').data('placeholder'),
    allowClear: true,
    width: '100%',
    ajax: {
      url: '/organize/api/tag',
      dataType: 'json',
      delay: 250,
      data: params => ({ search: params.term }),
      processResults: data => ({ results: data }),
      cache: true
    }
  });
});
</script>

