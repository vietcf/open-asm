<%
  const activeFilterCount = [filterTags.length, filterContacts.length, filterSystemId.length, filterAppType.length].filter(Boolean).length;
  // "def" = shown by default, "fixed" = always shown (column chooser)
  const COLUMNS = [
    { key: 'name', label: 'Component Name', def: true, fixed: true },
    { key: 'system', label: 'System', def: true },
    { key: 'appType', label: 'App Type', def: true },
    { key: 'tags', label: 'Tags', def: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'managers', label: 'Managers' },
    { key: 'urls', label: 'Access URLs' },
    { key: 'ips', label: 'IP Addresses' },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (c, key) => ({
    name: ui.esc(c.name),
    system: ui.text(c.system_name),
    appType: c.app_type ? ui.esc(ui.optionLabel(appTypeOptions, c.app_type)) : ui.dash,
    tags: ui.chips((c.tags || []).map(tg => tg.name)),
    description: ui.clip(c.description),
    managers: ui.text((c.contacts || []).map(ct => ct.name).join(', ')),
    urls: ui.clip(ui.toArray(c.fqdn).join(', ')),
    ips: ui.mono((c.ips || []).map(ip => ip.ip)),
    updated: ui.date(c.updated_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'System Management' }, { label: 'Component List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/system/component">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name, system...',
              filtersId: 'componentFilters', activeFilterCount,
              columns: { tableId: 'componentTable', storageKey: 'openasm.componentList.columns', list: COLUMNS },
              exportUrl: '/system/component/export' + currentQuery,
              addUrl: hasPermission('system.create') ? '/system/component/add' : null, addLabel: 'Add Component' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="componentFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('System') %></label>
                <select name="system_id[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"
                        data-ajax-url="/system/api/system" data-ids-url="/organize/api/system/ids" data-selected='<%= JSON.stringify(filterSystemId) %>'></select>
              </div>
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('App Type') %></label>
                <select name="app_type[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>">
                  <option value="__none__" <%= filterAppType.includes('__none__') ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (appTypeOptions || []).forEach(function (o) { %>
                    <option value="<%= o.id %>" <%= filterAppType.includes(String(o.id)) ? 'selected' : '' %>><%= o.text %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"
                        data-ajax-url="/organize/api/tag" data-ids-url="/organize/api/tag/ids" data-selected='<%= JSON.stringify(filterTags) %>'></select>
              </div>
              <div class="col-md-6 col-xl-3">
                <label class="form-label small"><%= t('Contacts') %></label>
                <select name="contacts[]" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/organize/api/contact" data-ids-url="/organize/api/contact/ids" data-selected='<%= JSON.stringify(filterContacts) %>'></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="componentTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (componentList && componentList.length) { %>
              <% componentList.forEach(function (component, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(component, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showComponentDetail(this)" data-record='<%= JSON.stringify(component) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('system.update')) { %>
                        <a href="/system/component/<%= component.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('system.delete')) { %>
                        <form action="/system/component/<%= component.id %>/delete" method="POST" data-confirm="<%= t('Delete this component?') + ' ' + component.name %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-boxes', message: 'No components found.', filtered: activeFilterCount > 0 || !!search, clearUrl: '/system/component',
                      actionUrl: hasPermission('system.create') ? '/system/component/add' : null, actionLabel: 'Add Component' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (componentList || []).length, summary: 'Showing {1} - {2} of {3} components' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'componentDetailModal', pentestType: 'system_component' }) %>
<%- include('../../partials/ui/pentest_quick_view') %>

<script>
  const APP_TYPE_OPTIONS = <%- jsonSafe(appTypeOptions || []) %>;

  function showComponentDetail(button) {
    const c = DV.record(button);
    if (!c) return;
    const appType = c.app_type ? DV.optionLabel(APP_TYPE_OPTIONS, c.app_type) : '';
    let body = DV.section('Overview', DV.rows(
      DV.field('System', DV.text(c.system_name)),
      DV.field('Tags', DV.chips((c.tags || []).map((tg) => tg.name || tg))),
      DV.field('Managers', DV.contacts(c.contacts)),
      DV.multiline(c.description) ? DV.field('Description', DV.multiline(c.description)) : ''
    ));
    body += DV.section('Access', DV.rows(
      DV.field('Access URLs', DV.urlList(c.fqdn)),
      DV.field('IP Addresses', DV.ipLinks(c.ips))
    ));
    body += DV.meta(c);
    DV.open('componentDetailModal', {
      title: c.name,
      subtitle: DV.esc(c.system_name || '') + (appType ? ' <span class="badge tag ms-1">' + DV.esc(appType) + '</span>' : ''),
      body,
      recordId: c.id,
    });
  }
</script>
