<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><%= t('Home') %></a></li>
          <li class="breadcrumb-item active"><%= t('Component List') %></li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<section class="app-content">
  <div class="container-fluid">
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/system/component">
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="<%= t('Search by name, system...') %>" aria-label="<%= t('Search') %>" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted"><%= t('Show:') %></label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Filter and Add Buttons Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('system.create')) { %>
            <a href="/system/component/add" class="btn btn-primary btn-sm">
              <i class="bi bi-plus"></i> <%= t('Add Component') %>
            </a>
          <% } %>
          <%
            const hasActiveComponentFilter = !!(
              (filterTags && filterTags.length > 0) ||
              (filterContacts && filterContacts.length > 0) ||
              (filterSystemId && filterSystemId.length > 0) ||
              (filterAppType && filterAppType.length > 0)
            );
          %>
          <button type="button" class="btn btn-sm <%= hasActiveComponentFilter ? 'btn-primary' : 'btn-outline-secondary' %>" data-bs-toggle="modal" data-bs-target="#filterComponentModal">
            <i class="bi bi-funnel<%= hasActiveComponentFilter ? '-fill' : '' %>"></i> <%= t('Filter{1}', { 1: hasActiveComponentFilter ? ' (Filtered)' : '' }) %>
          </button>
        </div>
      </div>
    </div>
      <!-- Filter Modal -->
      <div class="modal fade" id="filterComponentModal" tabindex="-1" aria-labelledby="filterComponentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <form id="componentFilterForm" method="get" action="/system/component">
              <!-- Preserve current pageSize and search -->
              <input type="hidden" name="pageSize" value="<%= typeof pageSize !== 'undefined' ? pageSize : 10 %>">
              <input type="hidden" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <div class="modal-header">
                <h5 class="modal-title" id="filterComponentModalLabel"><%= t('Filter Component List') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
              </div>
              <div class="modal-body">
                <div class="row g-2">
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Tags') %></label>
                    <select id="filterComponentTags" name="tags[]" class="form-control" multiple></select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('Contacts') %></label>
                    <select id="filterComponentContacts" name="contacts[]" class="form-control" multiple></select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('System') %></label>
                    <select id="filterComponentSystem" name="system_id[]" class="form-control" multiple></select>
                  </div>
                  <div class="col-12 mb-2">
                    <label class="form-label"><%= t('App Type') %></label>
                    <select id="filterComponentAppType" name="app_type[]" class="form-control" multiple></select>
                  </div>
                </div>
              </div>
              <div class="modal-footer d-flex justify-content-between">
                <button type="button" id="clearFilterBtnComponent" class="btn btn-outline-danger btn-sm"><%= t('Clear All Filters') %></button>
                <div>
                  <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal"><%= t('Cancel') %></button>
                  <button type="submit" class="btn btn-primary btn-sm"><%= t('Apply Filter') %></button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
  <!-- Filter values for JS (safe for strict EJS, same as IP Address List) -->
  <div id="filter-component-data"
    data-tags='<%= JSON.stringify(filterTags || []) %>'
    data-contacts='<%= JSON.stringify(filterContacts || []) %>'
    data-system-id='<%= JSON.stringify(filterSystemId || '') %>'
    data-app-type='<%= JSON.stringify(filterAppType || '') %>' style="display:none"></div>

  <!-- Flash Messages -->
  <!-- Debug: successMessage = <%= typeof successMessage !== 'undefined' ? successMessage : 'undefined' %> -->
  <!-- Debug: errorMessage = <%= typeof errorMessage !== 'undefined' ? errorMessage : 'undefined' %> -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= t(successMessage) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide success message after 5 seconds
      setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
    </script>
  <% } %>
  
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= t(errorMessage) %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('Close') %>"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

  <!-- Component List Table -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0"><%= t('Component List') %></h3>
        </div>
        <div class="card-body table-responsive p-0" style="overflow-x: auto;">
          <table class="table table-hover" id="componentTable">
            <!-- Table Header -->
            <thead>
              <tr>
                <th><%= t('No.') %></th>
                <th data-sort-type="text"><%= t('Component Name') %></th>
                <th data-sort-type="text"><%= t('System') %></th>
                <th data-sort-type="text"><%= t('Description') %></th>
                <th data-sort-type="text"><%= t('Tags') %></th>
                <th data-sort-type="text"><%= t('App Type') %></th>
                <th class="text-end"><%= t('Actions') %></th>
              </tr>
            </thead>
            
            <!-- Table Body -->
            <tbody>
              <% if (componentList && componentList.length > 0) { %>
                <% componentList.forEach(function(component, idx) { %>
                  <tr>
                    <!-- Row Number -->
                    <td><%= (page - 1) * pageSize + idx + 1 %></td>
                    
                    <!-- Component Name -->
                    <td><%= component.name %></td>
                    
                    <!-- System Name -->
                    <td><%= component.system_name || '-' %></td>
                    
                    <!-- Description -->
                    <td>
                      <% if (component.description && component.description.trim()) { %>
                        <%
                          const cleanDescription = component.description.trim();
                          const shortDescription = cleanDescription.length > 100 ? cleanDescription.substring(0, 100) + '…' : cleanDescription;
                        %>
                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="<%= cleanDescription %>" style="cursor: help; word-break: break-word;">
                          <%= shortDescription %>
                        </span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    
                    <!-- Tags -->
                    <td>
                      <% if (component.tags && component.tags.length > 0) { %>
                        <div style="line-height: 1.4;">
                          <% component.tags.forEach(function(tag, idx) { %>
                            <span class="badge bg-primary text-white" 
                                  style="font-size:1rem; font-weight:500; padding:0.15em 0.5em; margin: 0.1em 0.1em; display: inline-block;">
                              <%= tag.name %>
                            </span>
                            <% if ((idx + 1) % 2 === 0 && idx < component.tags.length - 1) { %>
                              <br>
                            <% } %>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span class="text-muted"><%= t('No tags') %></span>
                      <% } %>
                    </td>
                    
                    <!-- App Type -->
                    <td>
                      <% if (component.app_type) { %>
                        <%= component.app_type %>
                      <% } else { %>
                        <span class="text-muted"><%= t('No data') %></span>
                      <% } %>
                    </td>
                    
                    <!-- Actions -->
                    <td class="text-end">
                      <!-- Show Button -->
                      <button type="button" class="btn btn-info btn-sm" title="<%= t('Show') %>" onclick="showComponentDetail('<%= component.id %>')" data-component='<%= JSON.stringify(component) %>'><i class="bi bi-eye"></i></button>
                      
                      <!-- Edit Button -->
                      <% if (hasPermission && hasPermission('system.update')) { %>
                      <a href="/system/component/<%= component.id %>/edit"
                         class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <% } %>

                      <!-- Delete Button -->
                      <% if (hasPermission && hasPermission('system.delete')) { %>
                      <form action="/system/component/<%= component.id %>/delete"
                            method="post"
                            class="d-inline-block"
                            onsubmit="return confirm('Delete this component?');">
                        <button type="submit" class="btn btn-sm btn-danger">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                      <% } %>
                    </td>
                  </tr>

                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center"><%= t('No components found.') %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        
        <!-- Card Footer -->
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 pb-2" 
               style="padding-top: 1rem;">
            <!-- Pagination Info -->
            <div>
              <% 
                let cStartItem = (page - 1) * pageSize + 1;
                let cEndItem = cStartItem + (componentList ? componentList.length : 0) - 1;
                if (!componentList || componentList.length === 0) {
                  cStartItem = 0;
                  cEndItem = 0;
                }
              %>
              <span><%= t('Showing {1} - {2} of {3} components', { 1: cStartItem, 2: cEndItem, 3: typeof totalCount !== 'undefined' ? totalCount : 0 }) %></span>
            </div>
            
            <!-- Pagination -->
            <ul class="pagination pagination-sm m-0 float-end">
              <% 
                let cStartPage = 1;
                let cEndPage = totalPages;
                if (totalPages > 10) {
                  if (page <= 5) {
                    cStartPage = 1;
                    cEndPage = 10;
                  } else if (page + 4 >= totalPages) {
                    cStartPage = totalPages - 9;
                    cEndPage = totalPages;
                  } else {
                    cStartPage = page - 5 + 1;
                    cEndPage = page + 4;
                  }
                }
                
                function buildFilterQuery() {
                  let params = [];
                  if (typeof search !== 'undefined' && search) {
                    params.push('search=' + encodeURIComponent(search));
                  }
                  if (typeof pageSize !== 'undefined' && pageSize) {
                    params.push('pageSize=' + encodeURIComponent(pageSize));
                  }
                  if (typeof filterTags !== 'undefined' && filterTags.length) {
                    filterTags.forEach(function(tag) { 
                      params.push('tags[]=' + encodeURIComponent(tag)); 
                    });
                  }
                  if (typeof filterContacts !== 'undefined' && filterContacts.length) {
                    filterContacts.forEach(function(c) { 
                      params.push('contacts[]=' + encodeURIComponent(c)); 
                    });
                  }
                  if (typeof filterSystemId !== 'undefined' && filterSystemId) {
                    params.push('system_id=' + encodeURIComponent(filterSystemId));
                  }
                  if (typeof filterAppType !== 'undefined' && filterAppType) {
                    params.push('app_type=' + encodeURIComponent(filterAppType));
                  }
                  return params.join('&');
                }
                const filterQuery = buildFilterQuery();
              %>
              
              <!-- Previous Button -->
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" 
                   href="?page=<%= page - 1 %><%= filterQuery ? '&' + filterQuery : '' %>" 
                   tabindex="-1">
                  <%= t('Previous') %>
                </a>
              </li>
              
              <!-- First Page -->
              <% if (cStartPage > 1) { %>
                <li class="page-item">
                  <a class="page-link" 
                     href="?page=1<%= filterQuery ? '&' + filterQuery : '' %>">
                    1
                  </a>
                </li>
                <% if (cStartPage > 2) { %>
                  <li class="page-item disabled">
                    <span class="page-link">...</span>
                  </li>
                <% } %>
              <% } %>
              
              <!-- Page Numbers -->
              <% for (let i = cStartPage; i <= cEndPage; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>">
                  <a class="page-link" 
                     href="?page=<%= i %><%= filterQuery ? '&' + filterQuery : '' %>">
                    <%= i %>
                  </a>
                </li>
              <% } %>
              
              <!-- Last Page -->
              <% if (cEndPage < totalPages) { %>
                <li class="page-item disabled">
                  <span class="page-link">...</span>
                </li>
                <li class="page-item">
                  <a class="page-link" 
                     href="?page=<%= totalPages %><%= filterQuery ? '&' + filterQuery : '' %>">
                    <%= totalPages %>
                  </a>
                </li>
              <% } %>
              
              <!-- Next Button -->
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" 
                   href="?page=<%= page + 1 %><%= filterQuery ? '&' + filterQuery : '' %>">
                  <%= t('Next') %>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Component Detail Modal -->
<div class="modal fade" id="componentDetailModal" tabindex="-1" aria-labelledby="componentDetailModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="componentDetailModalLabel"><%= t('Component Detail') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
      </div>
      <div class="modal-body" id="componentDetailContent">
        <!-- Content will be loaded here -->
      </div>
      <div class="modal-footer">
        <% if (hasPermission && hasPermission('pentest.read')) { %>
          <button type="button" class="btn btn-outline-primary btn-sm me-auto" onclick="showPentestQuickView('system_component', window.currentDetailComponentId)">
            <i class="bi bi-shield-check"></i> <%= t('Pentest History') %>
          </button>
        <% } %>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
      </div>
    </div>
  </div>
</div>

<!-- Pentest Quick-View Modal (read-only) -->
<div class="modal fade" id="pentestQuickViewModal" tabindex="-1" aria-labelledby="pentestQuickViewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="pentestQuickViewModalLabel"><%= t('Pentest History') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('Close') %>"></button>
      </div>
      <div class="modal-body" id="pentestQuickViewContent">
        <!-- Content will be loaded here -->
      </div>
      <div class="modal-footer">
        <a id="pentestQuickViewManageLink" href="/pentest" class="btn btn-outline-primary btn-sm me-auto"><%= t('Manage in Pentest page') %></a>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('Close') %></button>
      </div>
    </div>
  </div>
</div>

<!-- Custom Scripts -->
<link href="/css/select2.min.css" rel="stylesheet" />
<link href="/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<script src="/vendor/jquery-3.6.0.min.js"></script>
<script src="/vendor/select2.min.js"></script>
<script>
  // App Type options data for Select2 — appTypeOptions is {value,label} (from
  // config), but Select2's `data` option requires {id,text}; map here so both
  // the dropdown labels and the filter-restore .val() matching work.
  window.appTypeOptionsData = <%- JSON.stringify((appTypeOptions || []).map(o => ({ id: o.value, text: o.label }))) %>;
  
  // Restore Select2 values function
  function restoreSelect2Value($el, values, url) {
    if (!values || !values.length) return;

    // '__none__' is a synthetic "not set" sentinel, not a real record id -
    // it can't be resolved via the ids-lookup endpoint, so add its display
    // option directly and only look up the real ids via AJAX.
    var hasNone = values.indexOf('__none__') !== -1;
    var realValues = values.filter(function(v) { return v !== '__none__'; });
    if (hasNone && $el.find('option[value="__none__"]').length === 0) {
      $el.append(new Option('-- None (not set) --', '__none__', true, true));
    }
    if (!realValues.length) {
      $el.val(values).trigger('change');
      return;
    }

    $.ajax({
      url: url,
      data: { ids: realValues },
      dataType: 'json',
      traditional: true,
      xhrFields: { withCredentials: true },
      success: function(data) {
        data.forEach(function(item) {
          if ($el.find('option[value="' + item.id + '"]').length === 0) {
            var option = new Option(item.text || item.name, item.id, true, true);
            $el.append(option);
          }
        });
        $el.val(values).trigger('change');
      },
      error: function(xhr, status, error) {
        console.error('Error restoring select2 value:', error);
      }
    });
  }

  // Main initialization
  $(function() {
    var $filterModal = $('#filterComponentModal');
    var $modalContent = $filterModal.find('.modal-content');
    
    // Parse filter values
    var filterValues = {
      tags: JSON.parse(document.getElementById('filter-component-data').dataset.tags || '[]'),
      contacts: JSON.parse(document.getElementById('filter-component-data').dataset.contacts || '[]'),
      systemId: JSON.parse(document.getElementById('filter-component-data').dataset.systemId || '[]'),
      appType: JSON.parse(document.getElementById('filter-component-data').dataset.appType || '[]')
    };
    
    // Initialize Tags Select2
    $('#filterComponentTags').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select tag(s)'),
      allowClear: true,
      width: '100%',
      dropdownParent: $modalContent,
      ajax: {
        url: '/organize/api/tag',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data })
      }
    });
    
    // Initialize Contacts Select2
    $('#filterComponentContacts').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select contact(s)'),
      allowClear: true,
      width: '100%',
      dropdownParent: $modalContent,
      ajax: {
        url: '/organize/api/contact',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        // "-- None --" isn't a real contact, so it can't come from the
        // contact-search endpoint - prepend it client-side, only while not
        // actively searching, so it stays the default first option.
        processResults: (data, params) => {
          const results = data || [];
          if (!params.term) {
            return { results: [{ id: '__none__', text: '-- None (not set) --' }, ...results] };
          }
          return { results: results };
        }
      }
    });
    
    // Initialize System Select2
    $('#filterComponentSystem').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select system(s)'),
      allowClear: true,
      width: '100%',
      dropdownParent: $modalContent,
      ajax: {
        url: '/system/api/system',
        dataType: 'json',
        delay: 250,
        data: params => ({ search: params.term }),
        processResults: data => ({ results: data }),
        xhrFields: { withCredentials: true }
      }
    });
    
    // Initialize App Type Select2
    const appTypeData = window.appTypeOptionsData || [
      { id: 'web', text: 'Web App' },
      { id: 'mobile', text: 'Mobile App' },
      { id: 'api', text: 'API' },
      { id: 'service', text: 'Service' },
      { id: 'database', text: 'Database' },
      { id: 'microservice', text: 'Microservice' },
      { id: 'desktop', text: 'Desktop App' },
      { id: 'cli', text: 'CLI Tool' }
    ];
    $('#filterComponentAppType').select2({
      theme: 'bootstrap-5',
      placeholder: t('Select app type(s)'),
      allowClear: true,
      width: '100%',
      dropdownParent: $modalContent,
      data: [{ id: '__none__', text: '-- None (not set) --' }, ...appTypeData],
      matcher: function(params, data) {
        // If there are no search terms, return all data
        if ($.trim(params.term) === '') {
          return data;
        }
        // Do not display the item if there is no 'text' property
        if (typeof data.text === 'undefined') {
          return null;
        }
        // Return the data if it matches the search term
        if (data.text.toLowerCase().indexOf(params.term.toLowerCase()) > -1) {
          return data;
        }
        return null;
      }
    });
    
    // Restore selected values when modal is shown
    $filterModal.on('shown.bs.modal', function() {
      setTimeout(function() {
        restoreSelect2Value($('#filterComponentTags'), filterValues.tags, '/organize/api/tag/ids');
        restoreSelect2Value($('#filterComponentContacts'), filterValues.contacts, '/organize/api/contact/ids');
        restoreSelect2Value($('#filterComponentSystem'), filterValues.systemId, '/organize/api/system/ids');
        
        // Restore App Type values
        if (filterValues.appType && filterValues.appType.length > 0) {
          $('#filterComponentAppType').val(filterValues.appType).trigger('change');
        }
      }, 100);
    });
    
    // Clear All Filters button
    $('#clearFilterBtnComponent').on('click', function() {
      // Clear all select2 values
      $('#filterComponentTags').val(null).trigger('change');
      $('#filterComponentContacts').val(null).trigger('change');
      $('#filterComponentSystem').val(null).trigger('change');
      $('#filterComponentAppType').val(null).trigger('change');
      
      // Close modal
      $filterModal.modal('hide');
      
      // Redirect to clean URL but preserve pageSize and search
      const currentPageSize = $('select[name="pageSize"]').val() || '10';
      const currentSearch = $('input[name="search"]').val() || '';
      let cleanUrl = '/system/component';
      const params = [];
      if (currentPageSize && currentPageSize !== '10') params.push('pageSize=' + encodeURIComponent(currentPageSize));
      if (currentSearch) params.push('search=' + encodeURIComponent(currentSearch));
      if (params.length > 0) cleanUrl += '?' + params.join('&');
      window.location.href = cleanUrl;
    });
    
    // Attach IP hover events to existing content
    attachIPHoverEvents();
  });
  
  // Function to attach IP hover events
  function attachIPHoverEvents() {
    document.querySelectorAll('.ip-hover-link').forEach(function(element) {
      // Remove existing event listeners to avoid duplicates
      element.removeEventListener('mouseenter', handleIPHover);
      element.removeEventListener('mouseleave', handleIPLeave);
      
      // Add new event listeners
      element.addEventListener('mouseenter', handleIPHover);
      element.addEventListener('mouseleave', handleIPLeave);
    });
  }
  
  // IP hover handler
  function handleIPHover(event) {
    const element = event.target;
    const ipAddress = element.getAttribute('data-ip');
    
    if (!ipAddress || element.getAttribute('data-loading') === 'true') {
      return;
    }
    
    // Set loading state
    element.setAttribute('data-loading', 'true');
    element.setAttribute('title', 'Loading IP info...');
    
    // Fetch IP information
    fetch(`/network/api/ip-addresses/detail?search=${encodeURIComponent(ipAddress)}`)
      .then(response => response.json())
      .then(data => {
        if (data && data.length > 0) {
          const ipInfo = data[0];
          let tooltipText = `IP: ${ipInfo.ip_address || ipInfo.ip || ipAddress}`;
          
          if (ipInfo.description) {
            tooltipText += `\nDescription: ${ipInfo.description}`;
          }
          
          if (ipInfo.status) {
            tooltipText += `\nStatus: ${ipInfo.status}`;
          }
          
          // List EVERY owner — an IP can have more than one device/server
          // once VIP sharing is involved, not just a single primary owner.
          (ipInfo.servers || []).forEach(function(s) {
            tooltipText += `\nServer: ${s.name}${s.role === 'vip' ? ' (VIP)' : ''}`;
          });
          (ipInfo.devices || []).forEach(function(d) {
            tooltipText += `\nDevice: ${d.name}${d.role === 'vip' ? ' (VIP)' : ''}`;
          });
          
          // Add tags information
          if (ipInfo.tags && ipInfo.tags.length > 0) {
            const tagNames = ipInfo.tags.map(tag => tag.name).join(', ');
            tooltipText += `\nTags: ${tagNames}`;
          }
          
          // Add contacts information
          if (ipInfo.contacts && ipInfo.contacts.length > 0) {
            const contactEmails = ipInfo.contacts.map(contact => contact.email || contact.name).join(', ');
            tooltipText += `\nContacts: ${contactEmails}`;
          }
          
          // Add systems information
          if (ipInfo.systems && ipInfo.systems.length > 0) {
            const systemNames = ipInfo.systems.map(system => system.name).join(', ');
            tooltipText += `\nSystems: ${systemNames}`;
          }
          
          element.setAttribute('title', tooltipText);
        } else {
          element.setAttribute('title', `IP: ${ipAddress}\nNo additional information found`);
        }
      })
      .catch(error => {
        console.error('Error fetching IP info:', error);
        element.setAttribute('title', `IP: ${ipAddress}\nError loading information`);
      })
      .finally(() => {
        element.removeAttribute('data-loading');
      });
  }
  
  // IP leave handler
  function handleIPLeave(event) {
    // Optional: Reset tooltip or do cleanup
  }

  // Component Detail Modal Function
  function showComponentDetail(componentId) {
    console.log('showComponentDetail called with ID:', componentId);
    window.currentDetailComponentId = componentId;

    // Find the button that was clicked to get the component data
    let targetButton = null;
    const buttons = document.querySelectorAll('button[data-component]');
    for (let button of buttons) {
      try {
        const data = JSON.parse(button.getAttribute('data-component'));
        if (data && data.id == componentId) {
          targetButton = button;
          break;
        }
      } catch (e) {
        console.error('Error parsing component data:', e);
      }
    }
    
    if (!targetButton) {
      console.error('Button not found for component ID:', componentId);
      alert(t('Button not found for component ID: ') + componentId);
      return;
    }
    
    const componentData = targetButton.getAttribute('data-component');
    const component = JSON.parse(componentData);
    
    console.log('Component data:', component);
    
    // Check if Bootstrap is available
    if (typeof bootstrap === 'undefined') {
      console.error('Bootstrap is not loaded');
      alert(t('Bootstrap is not loaded'));
      return;
    }
    
    const modalElement = document.getElementById('componentDetailModal');
    if (!modalElement) {
      console.error('Modal element not found');
      alert(t('Modal element not found'));
      return;
    }
    
    const modal = new bootstrap.Modal(modalElement, {
      backdrop: true,
      keyboard: true,
      focus: true
    });
    const content = document.getElementById('componentDetailContent');
    
    // Build HTML content - definition-list field:value layout
    let html = '<dl class="row detail-dl">';

    // Component Name
    const componentName = (component.name || 'N/A');
    html += '<dt class="col-sm-4">Component Name</dt><dd class="col-sm-8">' + escapeHtml(String(componentName).trim()) + '</dd>';

    // ID
    const componentIdValue = (component.id || 'N/A');
    html += '<dt class="col-sm-4">ID</dt><dd class="col-sm-8">' + escapeHtml(String(componentIdValue).trim()) + '</dd>';

    // System
    const system = (component.system_name || 'N/A');
    html += '<dt class="col-sm-4">System</dt><dd class="col-sm-8">' + escapeHtml(String(system).trim()) + '</dd>';

    // Description
    if (component.description && component.description.trim()) {
      html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8"><span style="white-space: pre-wrap;">' + escapeHtml(component.description) + '</span></dd>';
    }

    // App Type
    const appType = (component.app_type || 'N/A');
    html += '<dt class="col-sm-4">App Type</dt><dd class="col-sm-8">' + escapeHtml(String(appType).trim()) + '</dd>';

    // FQDN
    if (component.fqdn && (Array.isArray(component.fqdn) ? component.fqdn.length > 0 : component.fqdn)) {
      html += '<dt class="col-sm-4">FQDN</dt><dd class="col-sm-8">';
      const fqdnList = Array.isArray(component.fqdn) ? component.fqdn : [component.fqdn];
      html += '<ul class="mb-0 ps-3">';
      fqdnList.forEach(function(fqdn) {
        const fqdnStr = String(fqdn).trim();
        // Check if FQDN contains brackets - extract domain and comment separately
        if (fqdnStr.includes('[') && fqdnStr.includes(']')) {
          const bracketMatch = fqdnStr.match(/^(.+?)\s*\[(.+?)\]$/);
          if (bracketMatch) {
            const domain = bracketMatch[1].trim();
            const comment = bracketMatch[2].trim();
            html += '<li><a href="http://' + escapeHtml(domain) + '" target="_blank" class="text-decoration-none">' + escapeHtml(domain) + '</a> <span class="badge bg-secondary ms-1">' + escapeHtml(comment) + '</span></li>';
          } else {
            html += '<li><span class="text-muted">' + escapeHtml(fqdnStr) + '</span></li>';
          }
        } else {
          html += '<li><a href="http://' + escapeHtml(fqdnStr) + '" target="_blank" class="text-decoration-none">' + escapeHtml(fqdnStr) + '</a></li>';
        }
      });
      html += '</ul>';
      html += '</dd>';
    }

    // Tags
    if (component.tags && component.tags.length > 0) {
      html += '<dt class="col-sm-4">Tags</dt><dd class="col-sm-8">';
      component.tags.forEach(function(tag) {
        const tagValue = (typeof tag === 'string' ? tag : tag.name);
        html += '<span class="badge bg-primary me-1 mb-1">' + escapeHtml(String(tagValue).trim()) + '</span>';
      });
      html += '</dd>';
    }

    // IP Addresses
    if (component.ips && component.ips.length > 0) {
      html += '<dt class="col-sm-4">IP Addresses</dt><dd class="col-sm-8">';
      component.ips.forEach(function(ipObj) {
        const ipAddress = ipObj.ip || ipObj.ip_address || ipObj;
        const zone = ipObj.subnet_zone || '';
        const environment = ipObj.subnet_environment || '';
        const serverName = ipObj.server_name || '';

        html += '<div class="mt-1 d-flex align-items-center flex-wrap">';
        html += '<a href="/network/ip-address?search=' + encodeURIComponent(ipAddress) + '" target="_blank" class="text-decoration-none text-primary me-2 ip-hover-link" data-ip="' + escapeHtml(ipAddress) + '" data-bs-toggle="tooltip" data-bs-placement="top" title="Loading IP info...">' + escapeHtml(String(ipAddress).trim()) + '</a>';

        // Add server/device name if available
        if (serverName) {
          html += '<span class="badge bg-light text-dark border me-2" style="border-radius: 3px;">[' + escapeHtml(serverName) + ']</span>';
        }

        // Add zone and environment info if available
        if (zone || environment) {
          const zoneEnvText = (zone && environment) ? zone + '-' + environment : (zone || environment);
          html += '<span class="badge bg-light text-dark border me-2" style="border-radius: 3px;">[' + escapeHtml(zoneEnvText) + ']</span>';
        }

        html += '</div>';
      });
      html += '</dd>';
    }

    // Contacts
    if (component.contacts && component.contacts.length > 0) {
      html += '<dt class="col-sm-4">Contacts</dt><dd class="col-sm-8"><ul class="mb-0 ps-3">';
      component.contacts.forEach(function(contactObj) {
        const contactName = contactObj.name || contactObj;
        const contactEmail = contactObj.email || '';
        let displayText = contactName;
        let searchTerm = contactName;

        if (contactEmail) {
          // Extract username part before @
          const emailUsername = contactEmail.split('@')[0];
          displayText = `${contactName} (${emailUsername})`;
          searchTerm = contactEmail; // Still use full email for search
        }

        html += '<li><a href="/organize/contact?search=' + encodeURIComponent(searchTerm) + '" target="_blank" class="text-decoration-none text-primary">' + escapeHtml(String(displayText).trim()) + '</a></li>';
      });
      html += '</ul></dd>';
    }

    // Created
    const created = (component.created_at || component.createdAt || 'N/A');
    html += '<dt class="col-sm-4">Created</dt><dd class="col-sm-8">' + escapeHtml(String(created).trim()) + '</dd>';

    // Updated
    const updated = (component.updated_at || component.updatedAt || 'N/A');
    html += '<dt class="col-sm-4">Updated</dt><dd class="col-sm-8">' + escapeHtml(String(updated).trim()) + '</dd>';

    // Updated By
    if (component.updated_by) {
      html += '<dt class="col-sm-4">Updated By</dt><dd class="col-sm-8">' + escapeHtml(String(component.updated_by).trim()) + '</dd>';
    }

    html += '</dl>';
    content.innerHTML = html;
    
    // Setup IP hover functionality
    setupComponentIPHover();
    
    // Show modal with proper event handling
    modal.show();
  }

  // Setup IP hover functionality for component detail — uses Bootstrap's
  // Tooltip component (same as the Description column tooltips elsewhere)
  // instead of the native browser title tooltip, so it's actually styled
  // by the .tooltip .tooltip-inner CSS below (multi-line, max-width).
  function setupComponentIPHover() {
    const ipLinks = document.querySelectorAll('.ip-hover-link');
    ipLinks.forEach(link => {
      new bootstrap.Tooltip(link);
      link.removeEventListener('mouseenter', handleComponentIPHover); // Prevent duplicate listeners
      link.addEventListener('mouseenter', handleComponentIPHover);
    });
  }

  function handleComponentIPHover(event) {
    const element = event.target.closest('.ip-hover-link');
    const ipAddress = element.getAttribute('data-ip');
    const tooltip = bootstrap.Tooltip.getInstance(element);

    if (!ipAddress || !tooltip || element.getAttribute('data-loading') === 'true') {
      return;
    }

    element.setAttribute('data-loading', 'true');
    tooltip.setContent({ '.tooltip-inner': 'Loading IP info...' });

    fetch(`/network/api/ip-addresses/detail?search=${encodeURIComponent(ipAddress)}`)
      .then(response => response.json())
      .then(data => {
        if (data && data.length > 0) {
          const ipInfo = data[0];
          let tooltipText = `IP: ${ipInfo.ip_address || ipInfo.ip || ipAddress}`;

          if (ipInfo.description) {
            tooltipText += `\nDescription: ${ipInfo.description}`;
          }
          if (ipInfo.status) {
            tooltipText += `\nStatus: ${ipInfo.status}`;
          }
          if (ipInfo.server_name) {
            tooltipText += `\nServer: ${ipInfo.server_name}`;
          }
          if (ipInfo.device_name) {
            tooltipText += `\nDevice: ${ipInfo.device_name}`;
          }
          if (ipInfo.tags && ipInfo.tags.length > 0) {
            const tagNames = ipInfo.tags.map(tag => typeof tag === 'string' ? tag : tag.name).join(', ');
            tooltipText += `\nTags: ${tagNames}`;
          }
          if (ipInfo.contacts && ipInfo.contacts.length > 0) {
            const contactEmails = ipInfo.contacts.map(contact => {
              if (typeof contact === 'string') {
                if (contact.includes('@')) {
                  return contact.split('@')[0];
                }
                return contact;
              }
              if (contact.email) {
                const emailUsername = contact.email.split('@')[0];
                return contact.name ? `${contact.name} (${emailUsername})` : emailUsername;
              }
              return contact.name || contact;
            }).join(', ');
            tooltipText += `\nContacts: ${contactEmails}`;
          }
          if (ipInfo.systems && ipInfo.systems.length > 0) {
            const systemNames = ipInfo.systems.map(system => typeof system === 'string' ? system : system.name).join(', ');
            tooltipText += `\nSystems: ${systemNames}`;
          }
          tooltip.setContent({ '.tooltip-inner': tooltipText });
        } else {
          tooltip.setContent({ '.tooltip-inner': `IP: ${ipAddress}\nNo additional information found` });
        }
      })
      .catch(error => {
        console.error('Error loading IP info:', error);
        tooltip.setContent({ '.tooltip-inner': `IP: ${ipAddress}\nError loading information` });
      })
      .finally(() => {
        element.removeAttribute('data-loading');
      });
  }
  
  // Initialize tooltips
  $(document).ready(function() {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl);
    });
  });

  // Read-only quick-view of pentest rounds for a System/Component, launched
  // from the Detail modal's "Pentest History" button. Full add/edit/delete
  // happens on the dedicated Pentest Management page (link below).
  // Round name, participant names, and the uploaded report's original
  // filename are all free-text user input persisted server-side with no
  // HTML stripping — must be escaped before going into innerHTML, or a
  // crafted round/filename executes script in the browser of anyone who
  // later opens this quick-view.
  function escapeHtml(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function showPentestQuickView(objectType, objectId) {
    if (!objectId) return;
    const content = document.getElementById('pentestQuickViewContent');
    content.innerHTML = '<p class="text-muted mb-0">Loading...</p>';
    document.getElementById('pentestQuickViewManageLink').href = '/pentest?object_type=' + encodeURIComponent(objectType) + '&object_id=' + encodeURIComponent(objectId);
    const modal = new bootstrap.Modal(document.getElementById('pentestQuickViewModal'));
    modal.show();

    fetch('/pentest/api/by-object?object_type=' + encodeURIComponent(objectType) + '&object_id=' + encodeURIComponent(objectId))
      .then(res => res.json())
      .then(data => {
        const rounds = data.rounds || [];
        if (rounds.length === 0) {
          content.innerHTML = '<p class="text-muted mb-0">No pentest rounds recorded yet.</p>';
          return;
        }
        let html = '<table class="table table-sm table-hover mb-0"><thead><tr><th>Round Name</th><th>Date</th><th>Status</th><th>Participants</th><th>Report</th></tr></thead><tbody>';
        rounds.forEach(function(round) {
          const participants = (round.participants || []).map(p => escapeHtml(p.name)).join(', ') || '-';
          let report = '<span class="text-muted">No report</span>';
          if (round.report) {
            report = '<a href="' + escapeHtml(round.report.url) + '" download class="text-decoration-none text-primary me-1">' + escapeHtml(round.report.original_name) + '</a>' +
                     '<a href="/pentest/report/' + encodeURIComponent(round.report.id) + '/view" target="_blank" rel="noopener noreferrer" class="badge bg-light text-dark border text-decoration-none" style="border-radius:3px;">[View]</a>';
          }
          html += '<tr><td>' + escapeHtml(round.name) + '</td><td>' + (round.test_date ? new Date(round.test_date).toLocaleDateString('en-GB') : '-') + '</td><td>' + escapeHtml(round.status || 'NOT_STARTED') + '</td><td>' + participants + '</td><td>' + report + '</td></tr>';
        });
        html += '</tbody></table>';
        content.innerHTML = html;
      })
      .catch(() => {
        content.innerHTML = '<p class="text-danger mb-0">Error loading pentest rounds.</p>';
      });
  }
</script>

