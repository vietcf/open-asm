<%#
  Add / Edit Contact.  mode: 'add' | 'edit', contact, positionOptions, selectedUnit [{id, text}]
%>
<% const isEdit = mode === 'edit'; const c = contact || {}; %>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'Organization' }, { label: 'Contact List', href: '/organize/contact' }, { label: isEdit ? 'Edit Contact' : 'Add Contact' }
] }) %>

<div class="app-content">
  <div class="container-fluid">
    <form class="card form-card" method="POST" action="<%= isEdit ? '/organize/contact/' + c.id + '/edit' : '/organize/contact/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit Contact' : 'Add Contact') %></h3>
      </div>
      <div class="card-body">
        <section class="form-section">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-name"><%= t('Name') %> <span class="text-danger">*</span></label>
              <input type="text" id="f-name" name="name" class="form-control" value="<%= c.name || '' %>" maxlength="255" placeholder="<%= t('Enter contact name') %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-email"><%= t('Email') %> <span class="text-danger">*</span></label>
              <input type="email" id="f-email" name="email" class="form-control" value="<%= c.email || '' %>" maxlength="255" placeholder="<%= t('Enter email address') %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-position"><%= t('Position') %> <span class="text-danger">*</span></label>
              <select id="f-position" name="position" class="form-select js-select" data-placeholder="<%= t('Select position') %>" required>
                <option value=""></option>
                <% (positionOptions || []).forEach(function (o) { %>
                  <option value="<%= o.id %>" <%= c.position === o.id ? 'selected' : '' %>><%= o.text %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-phone"><%= t('Phone') %></label>
              <input type="text" id="f-phone" name="phone" class="form-control" value="<%= c.phone || '' %>" maxlength="50" placeholder="<%= t('Enter phone number') %>">
            </div>
            <div class="col-12">
              <label class="form-label" for="f-unit"><%= t('Organization') %></label>
              <select id="f-unit" name="unit_id" class="form-select js-select" data-ajax-url="/organize/api/unit"
                      data-placeholder="<%= t('Select organization unit') %>" data-selected="<%= JSON.stringify(selectedUnit || []) %>"></select>
            </div>
            <div class="col-12">
              <label class="form-label" for="f-description"><%= t('Description') %></label>
              <textarea id="f-description" name="description" class="form-control" rows="3" placeholder="<%= t('Enter contact description') %>"><%= c.description || '' %></textarea>
            </div>
          </div>
        </section>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/organize/contact', submitLabel: isEdit ? 'Save Changes' : 'Add Contact' }) %>
    </form>
  </div>
</div>
