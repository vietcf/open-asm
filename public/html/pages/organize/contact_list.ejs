<%
  const activeFilterCount = [filterUnitId, filterPosition].filter(Boolean).length;
  const COLUMNS = [
    { key: 'name', label: 'Name', def: true, fixed: true },
    { key: 'email', label: 'Email', def: true },
    { key: 'phone', label: 'Phone', def: true },
    { key: 'position', label: 'Position', def: true },
    { key: 'unit', label: 'Organization', def: true },
    { key: 'description', label: 'Description' },
    { key: 'updated', label: 'Updated' },
  ];
  const cell = (c, key) => ({
    name: ui.esc(c.name),
    email: c.email ? `<a href="mailto:${ui.esc(c.email)}">${ui.esc(c.email)}</a>` : ui.dash,
    phone: ui.text(c.phone),
    position: c.position ? ui.esc(ui.optionLabel(positionOptions, c.position)) : ui.dash,
    unit: ui.text(c.unit_name),
    description: ui.clip(c.description),
    updated: ui.date(c.updated_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Organization' }, { label: 'Contact List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/organize/contact">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search Contact Name...',
              filtersId: 'contactFilters', activeFilterCount,
              columns: { tableId: 'contactTable', storageKey: 'openasm.contactList.columns', list: COLUMNS },
              exportUrl: '/organize/contact/export' + currentQuery,
              importModal: hasPermission('contact.create') ? 'contactImportModal' : null,
              addUrl: hasPermission('contact.create') ? '/organize/contact/add' : null, addLabel: 'Add Contact' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="contactFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Organization') %></label>
                <select name="unit_id" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                  <option value=""></option>
                  <option value="__none__" <%= filterUnitId === '__none__' ? 'selected' : '' %>><%= t('(Not set)') %></option>
                  <% (units || []).forEach(function (u) { %>
                    <option value="<%= u.id %>" <%= String(filterUnitId) === String(u.id) ? 'selected' : '' %>><%= u.text %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6 col-xl-4">
                <label class="form-label small"><%= t('Position') %></label>
                <select name="position" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                  <option value=""></option>
                  <%- ui.options(positionOptions, filterPosition, { all: true }) %>
                </select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="contactTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (contactList && contactList.length) { %>
              <% contactList.forEach(function (contact, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(contact, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showContactDetail(this)" data-record='<%= JSON.stringify(contact) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('contact.update')) { %>
                        <a href="/organize/contact/<%= contact.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('contact.delete')) { %>
                        <form action="/organize/contact/<%= contact.id %>/delete" method="POST" data-confirm="<%= t('Are you sure you want to delete contact: ') + contact.name + '?' %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-person-lines-fill', message: 'No contacts found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/organize/contact',
                      actionUrl: hasPermission('contact.create') ? '/organize/contact/add' : null, actionLabel: 'Add Contact' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (contactList || []).length, summary: 'Showing {1} - {2} of {3} contacts' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'contactDetailModal' }) %>
<% if (hasPermission('contact.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'contactImportModal', title: 'Import Contacts', baseUrl: '/organize/contact',
        instructions: ['Name, Email, and Position (Required, one per row) must not already exist', 'Phone, Org Unit, and Description are optional'] }) %>
<% } %>

<script>
  const POSITION_OPTIONS = <%- jsonSafe(positionOptions || []) %>;

  function showContactDetail(button) {
    const c = DV.record(button);
    if (!c) return;
    const body = '<div class="row g-3"><div class="col-md-8">' +
      DV.section('Overview', DV.rows(
        DV.multiline(c.description) ? DV.field('Description', DV.multiline(c.description)) : '',
        DV.field('Email', c.email ? '<a href="mailto:' + DV.esc(c.email) + '">' + DV.esc(c.email) + '</a>' : ''),
        DV.field('Phone', DV.text(c.phone)),
        DV.field('Position', DV.text(c.position ? DV.optionLabel(POSITION_OPTIONS, c.position) : '')),
        DV.field('Organization', DV.unit(c.unit_id, c.unit_name))
      )) +
      '</div><div class="col-md-4 text-center"><div id="contactQr" class="detail-qr text-secondary small">' + DV.esc(t('Loading...')) + '</div>' +
      '<div class="small text-secondary mt-1">' + DV.esc(t('Scan to save contact')) + '</div></div></div>' + DV.meta(c);
    DV.open('contactDetailModal', { title: c.name, subtitle: DV.esc(c.position ? DV.optionLabel(POSITION_OPTIONS, c.position) : ''), body, recordId: c.id });
    DV.load('/organize/api/contact/' + encodeURIComponent(c.id) + '/qrcode', document.getElementById('contactQr'),
      (data) => '<img src="data:' + DV.esc(data.mime) + ';base64,' + DV.esc(data.image) + '" alt="QR" class="img-fluid" width="200" height="200">');
  }
</script>
