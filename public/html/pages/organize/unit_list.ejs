<%
  const COLUMNS = [
    { key: 'name', label: 'Unit Name', def: true, fixed: true },
    { key: 'code', label: 'Code', def: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'contacts', label: 'Contacts', def: true },
    { key: 'systems', label: 'Systems', def: true },
    { key: 'privUsers', label: 'Privileged Accounts' },
    { key: 'rules', label: 'Firewall Rules' },
  ];
  const count = (n) => (n ? `<span class="badge tag">${n}</span>` : ui.dash);
  const cell = (u, key) => ({
    name: ui.esc(u.name),
    code: u.code ? `<span class="font-monospace small">${ui.esc(u.code)}</span>` : ui.dash,
    description: ui.clip(u.description),
    contacts: count(u.contacts_count),
    systems: count(u.systems_count),
    privUsers: count(u.priv_users_count),
    rules: count(u.rulefirewall_count),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Organization' }, { label: 'Organization Unit' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/organize/unit">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search Unit Name...',
              columns: { tableId: 'unitTable', storageKey: 'openasm.unitList.columns', list: COLUMNS },
              exportUrl: '/organize/unit/export' + currentQuery,
              addUrl: hasPermission('unit.create') ? '/organize/unit/add' : null, addLabel: 'Add Unit' }) %>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="unitTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (unitList && unitList.length) { %>
              <% unitList.forEach(function (unit, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(unit, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <% if (hasPermission('unit.update')) { %>
                        <a href="/organize/unit/<%= unit.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('unit.delete')) { %>
                        <form action="/organize/unit/<%= unit.id %>/delete" method="POST" data-confirm="<%= t('Are you sure you want to delete unit: ') + unit.name + '?' %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-diagram-3', message: 'No units found', filtered: !!search, clearUrl: '/organize/unit',
                      actionUrl: hasPermission('unit.create') ? '/organize/unit/add' : null, actionLabel: 'Add Unit' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (unitList || []).length, summary: 'Showing {1} - {2} of {3} units' }) %>
    </div>
  </div>
</div>
