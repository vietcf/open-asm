<!-- Modal Buttons Custom CSS -->
<link rel="stylesheet" href="/css/modal-buttons.css">

<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '?' + params.toString();
}
%>

<!-- ========================================== -->
<!-- MAIN CONTENT -->
<!-- ========================================== -->

<!-- Content Header -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Tag List</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
    <!-- ========================================== -->
    <!-- SEARCH AND FILTER SECTION -->
    <!-- ========================================== -->
    
    <!-- Search and Page Size Row -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/organize/tag">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" type="search" name="search" placeholder="Search Tag Name..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                <% }) %>
              </select>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- ACTION BUTTONS SECTION -->
    <!-- ========================================== -->
    
    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('tag.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addTagModal">
              <i class="bi bi-plus"></i> Add Tag
            </button>
          <% } %>
          <% if (hasPermission && hasPermission('tag.read')) { %>
            <a href="/organize/tag/export" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> Export
            </a>
          <% } %>
          <% if (hasPermission && hasPermission('tag.create')) { %>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#importTagModal">
              <i class="bi bi-upload"></i> Import Tag
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- FILTER DATA AND FLASH MESSAGES -->
    <!-- ========================================== -->
    
    <!-- Flash Messages -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ========================================== -->
    <!-- TAG LIST TABLE -->
    <!-- ========================================== -->
    
    <!-- Tag List Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Tag List</h3>
          </div>
          <div class="card-body table-responsive" style="overflow-x: auto;">
            <table class="table table-hover" id="tagTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Tag Name</th>
                  <th>Description</th>
                  <th>Color</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (tagList && tagList.length > 0) { %>
                  <% tagList.forEach(function(tag, idx) { %>
                    <tr>
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      <td><%= tag.name %></td>
                      <td><%= tag.description || '-' %></td>
                      <td>
                        <% if (tag.color) { %>
                          <span class="badge" style="background-color: <%= tag.color %>; color: white;"><%= tag.color %></span>
                        <% } else { %>
                          <span class="badge bg-secondary">Default</span>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <% if (hasPermission('tag.update')) { %>
                          <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editTagModal" data-tag-id="<%= tag.id %>" data-tag-name="<%= tag.name %>" data-tag-description="<%= tag.description || '' %>" data-tag-color="<%= tag.color || '' %>" title="Edit">
                            <i class="bi bi-pencil"></i>
                          </button>
                        <% } %>
                        <% if (hasPermission('tag.delete')) { %>
                          <form action="/organize/tag/<%= tag.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteTag(this, '<%= tag.name %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center">No tags found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <div>
                <% 
                  // Calculate pagination range
                  const tagStartItem = (page - 1) * pageSize + 1;
                  const tagEndItem = Math.min(page * pageSize, totalCount || 0);
                  const tagStartPage = Math.max(1, page - 2);
                  const tagEndPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= tagStartItem %> - <%= tagEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> tags</span>
              </div>
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  function buildTagFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    return params.join('&');
                  }
                  const tagFilterQuery = buildTagFilterQuery();
                %>
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page - 1 %><%= tagFilterQuery ? '&' + tagFilterQuery : '' %>" tabindex="-1">Previous</a>
                </li>
                <% if (tagStartPage > 1) { %>
                  <li class="page-item"><a class="page-link" href="?page=1<%= tagFilterQuery ? '&' + tagFilterQuery : '' %>">1</a></li>
                  <% if (tagStartPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                <% for (let i = tagStartPage; i <= tagEndPage; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= tagFilterQuery ? '&' + tagFilterQuery : '' %>"><%= i %></a></li>
                <% } %>
                <% if (tagEndPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= tagFilterQuery ? '&' + tagFilterQuery : '' %>"><%= totalPages %></a></li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= page + 1 %><%= tagFilterQuery ? '&' + tagFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODALS SECTION -->
<!-- ========================================== -->

<!-- Add Tag Modal -->
<div class="modal fade" id="addTagModal" tabindex="-1" aria-labelledby="addTagModalLabel">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addTagModalLabel">Add Tag</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/organize/tag" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="tagName" class="form-label">Tag Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="tagName" name="name" required>
          </div>
          <div class="mb-3">
            <label for="tagDescription" class="form-label">Description</label>
            <textarea class="form-control" id="tagDescription" name="description" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label for="tagColor" class="form-label">Color</label>
            <input type="color" class="form-control form-control-color" id="tagColor" name="color" value="#007bff">
          </div>
        </div>
        <div class="modal-footer d-flex flex-column flex-lg-row gap-2">
          <button type="button" class="btn btn-secondary w-100 order-2 order-lg-1" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary w-100 order-1 order-lg-2">Add Tag</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Tag Modal -->
<div class="modal fade" id="editTagModal" tabindex="-1" aria-labelledby="editTagModalLabel">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editTagModalLabel">Edit Tag</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editTagForm" action="" method="POST">
        <input type="hidden" name="_method" value="PUT">
        <div class="modal-body">
          <div class="mb-3">
            <label for="editTagName" class="form-label">Tag Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editTagName" name="name" required>
          </div>
          <div class="mb-3">
            <label for="editTagDescription" class="form-label">Description</label>
            <textarea class="form-control" id="editTagDescription" name="description" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label for="editTagColor" class="form-label">Color</label>
            <input type="color" class="form-control form-control-color" id="editTagColor" name="color">
          </div>
        </div>
        <div class="modal-footer d-flex flex-column flex-lg-row gap-2">
          <button type="button" class="btn btn-secondary w-100 order-2 order-lg-1" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary w-100 order-1 order-lg-2">Update Tag</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Import Tag Modal -->
<div class="modal fade" id="importTagModal" tabindex="-1" aria-labelledby="importTagModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importTagModalLabel">Import Tags</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="importTagForm" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="tagImportFile" class="form-label">Select File <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="file" class="form-control" id="tagImportFile" name="file" accept=".csv,.xlsx,.xls" required>
              <a href="/organize/tag/template" class="btn btn-outline-info" download>
                <i class="bi bi-download"></i> Download Template
              </a>
            </div>
            <div class="form-text">Supported formats: CSV, Excel (.xlsx, .xls). Maximum file size: 10MB</div>
          </div>
          
          <div class="mb-3">
            <div class="alert alert-info">
              <h6><i class="bi bi-info-circle"></i> Import Instructions:</h6>
              <ul class="mb-0">
                <li>Click "Download Template" to get the Excel template with correct format</li>
                <li>Fill the template with your tag data</li>
                <li>Tag Name (Required) is required</li>
                <li>Description and Color are optional</li>
                <li>Select your filled template file and validate before importing</li>
              </ul>
            </div>
          </div>
          
          <!-- Progress bar -->
          <div id="tagImportProgress" class="progress mb-3" style="display: none;">
            <div class="progress-bar" role="progressbar" style="width: 0%"></div>
          </div>
          
          <!-- Results display -->
          <div id="tagImportResults" class="alert" style="display: none;"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" id="validateTagBtn">Validate File</button>
        <button type="button" class="btn btn-success" id="importTagBtn" style="display: none;">Import Tags</button>
      </div>
    </div>
  </div>
</div>

<script>
// ==========================================
// JAVASCRIPT FUNCTIONS
// ==========================================

// Handle edit button click with data attributes
$(document).on('click', 'button[data-bs-target="#editTagModal"]', function() {
  const id = $(this).data('tag-id');
  const name = $(this).data('tag-name');
  const description = $(this).data('tag-description');
  const color = $(this).data('tag-color');
  editTag(id, name, description, color);
});

// Edit tag function
function editTag(id, name, description, color) {
  document.getElementById('editTagForm').action = '/organize/tag/' + id;
  document.getElementById('editTagName').value = name;
  document.getElementById('editTagDescription').value = description;
  document.getElementById('editTagColor').value = color || '#007bff';
}

// Confirm delete tag
function confirmDeleteTag(form, tagName) {
  return confirm(`Are you sure you want to delete tag "${tagName}"? This action cannot be undone.`);
}

// Helper function to build export URL
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  return '/organize/tag/export' + (params.toString() ? '?' + params.toString() : '');
}
</script>