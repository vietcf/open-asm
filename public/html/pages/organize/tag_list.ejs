<%
  const COLUMNS = [
    { key: 'name', label: 'Tag Name', def: true, fixed: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'usage', label: 'Used by', def: true },
  ];
  const cell = (tg, key) => ({
    name: `<span class="badge tag">${ui.esc(tg.name)}</span>`,
    description: ui.clip(tg.description),
    usage: tg.usage_count ? ui.esc(t('{1} object(s)', { 1: tg.usage_count })) : ui.dash,
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Organization' }, { label: 'Tag List' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/organize/tag">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search Tag Name...',
              exportUrl: '/organize/tag/export' + currentQuery,
              addUrl: hasPermission('tag.create') ? '/organize/tag/add' : null, addLabel: 'Add Tag' }) %>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="tagTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (tagList && tagList.length) { %>
              <% tagList.forEach(function (tag, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="stack-title"' : '' %>><%- cell(tag, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <% if (hasPermission('tag.update')) { %>
                        <a href="/organize/tag/<%= tag.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('tag.delete')) { %>
                        <form action="/organize/tag/<%= tag.id %>/delete" method="POST" data-confirm="<%= t('Are you sure you want to delete tag: ') + tag.name + '?' %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-tags', message: 'No tags found', filtered: !!search, clearUrl: '/organize/tag',
                      actionUrl: hasPermission('tag.create') ? '/organize/tag/add' : null, actionLabel: 'Add Tag' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (tagList || []).length, summary: 'Showing {1} - {2} of {3} tags' }) %>
    </div>
  </div>
</div>
