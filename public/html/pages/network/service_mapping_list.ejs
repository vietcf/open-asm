<%
  const f = filter;
  const activeFilterCount = [f.access_mode, f.protocol, f.provider, f.partner, f.device_id, f.system_id].filter(Boolean).length;
  const cap = (s) => s ? s.charAt(0).toUpperCase() + s.slice(1) : '';
  const flowOf = (vs) => flows.find((x) => x.id === vs.direction + '-' + vs.scope) || flows[0];
  const currentFlow = f.direction && f.scope ? f.direction + '-' + f.scope : '';
  const COLUMNS = [
    { key: 'name', label: 'Name', def: true, fixed: true },
    { key: 'flow', label: 'Flow', def: true },
    { key: 'direction', label: 'Direction' },
    { key: 'scope', label: 'Scope' },
    { key: 'domain', label: 'Domain', def: true },
    { key: 'endpoint', label: 'Endpoint', def: true },
    { key: 'partners', label: 'Partners', def: true },
    { key: 'provider', label: 'Provider / Channel', def: true },
    { key: 'access', label: 'Access' },
    { key: 'system', label: 'System', def: true },
    { key: 'owner', label: 'IP owner' },
    { key: 'members', label: 'Backends / Sources', def: true },
    { key: 'description', label: 'Description' },
    { key: 'updated', label: 'Updated' },
  ];
  // every IP links to the IP list searched for it (new tab); hover shows its details
  const ipA = (ip, suffix) => (ip
    ? `<a href="/network/ip-address?search=${encodeURIComponent(ip)}" target="_blank" rel="noopener noreferrer" class="ip-hover-link font-monospace small" data-ip="${ui.esc(ip)}">${ui.esc(ip)}</a>${suffix || ''}`
    : '<span class="text-secondary">—</span>');
  const cell = (vs, key) => ({
    name: ui.esc(vs.name),
    flow: `<span class="badge tag text-nowrap"><i class="bi ${flowOf(vs).icon} me-1"></i>${ui.esc(t(flowOf(vs).label))}</span>`,
    partners: (vs.partner_ips || []).length
      ? ui.chips([...new Set(vs.partner_ips.map((p) => p.partner || p.address))].slice(0, 3)) + (new Set(vs.partner_ips.map((p) => p.partner || p.address)).size > 3 ? ' …' : '')
      : ui.dash,
    direction: `<span class="text-nowrap"><i class="bi ${vs.direction === 'outbound' ? 'bi-box-arrow-up-right' : 'bi-box-arrow-in-down-right'} me-1"></i>${ui.esc(t(cap(vs.direction)))}</span>`,
    scope: `<span class="badge tag">${ui.esc(t(cap(vs.scope)))}</span>`,
    domain: vs.domain ? `<span class="font-monospace small">${ui.esc(vs.domain)}</span>` : ui.dash,
    // inbound: our IP:port; outbound: our NAT / egress IP (the ports are on the partner IPs)
    endpoint: vs.port
      ? `${ipA(vs.ip_address, `<span class="font-monospace small">:${vs.port}</span>`)} <span class="badge tag">${ui.esc(vs.protocol || '')}</span>`
      : ipA(vs.ip_address),
    provider: vs.provider ? `<span class="badge tag">${ui.esc(vs.provider)}</span>` +
      (vs.provider_port || vs.provider_protocol ? ` <span class="font-monospace small">${vs.provider_port ? ':' + vs.provider_port : ''} ${ui.esc(vs.provider_protocol || '')}</span>` : '') : ui.dash,
    access: vs.access_mode === 'limited'
      ? `<span class="badge tag" title="${ui.esc((vs.partner_ips || []).map((p) => p.address).join(', '))}"><i class="bi bi-shield-lock me-1"></i>${ui.esc(t('Limited'))}${(vs.partner_ips || []).length ? ` (${vs.partner_ips.length})` : ''}</span>`
      : `<span class="badge tag">${ui.esc(t('Full'))}</span>`,
    system: vs.system_name ? ui.esc(vs.system_name) : ui.dash,
    owner: vs.ip_owner_name ? `<i class="bi ${vs.ip_owner_type === 'device' ? 'bi-hdd-rack' : 'bi-server'} me-1 text-secondary"></i>${ui.esc(vs.ip_owner_name)}` : ui.dash,
    members: vs.members.length ? `<span class="badge tag">${vs.members.length}</span> ` + vs.members.slice(0, 3).map(m => ipA(m.ip, m.port ? `<span class="font-monospace small">:${m.port}</span>` : '')).join(', ') + (vs.members.length > 3 ? ' …' : '') : ui.dash,
    description: ui.clip(vs.description),
    updated: ui.date(vs.updated_at),
  })[key];
  const simpleFilter = (name, label, options, labelOf) => ({ name, label, options, labelOf: labelOf || ((o) => o) });
  const FILTERS = [
    simpleFilter('partner', 'Partner', partnerOptions || []),
    simpleFilter('access_mode', 'Access', ['full', 'limited'], (o) => t(o === 'full' ? 'Full' : 'Limited')),
    simpleFilter('protocol', 'Protocol', protocolOptions || []),
    simpleFilter('provider', 'Provider / Channel', providerOptions || []),
  ];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Network' }, { label: 'Service Mapping' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <%# One tab per flow (direction + scope) %>
      <%# Two levels: All / Inbound / Outbound, then the flows of the chosen direction %>
      <ul class="nav nav-tabs px-3 pt-2">
        <li class="nav-item"><a class="nav-link<%= f.direction ? '' : ' active' %>" href="/network/service-mapping"><%= t('All') %></a></li>
        <li class="nav-item"><a class="nav-link<%= f.direction === 'inbound' ? ' active' : '' %>" href="/network/service-mapping?direction=inbound"><i class="bi bi-box-arrow-in-down-right me-1"></i><%= t('Inbound') %></a></li>
        <li class="nav-item"><a class="nav-link<%= f.direction === 'outbound' ? ' active' : '' %>" href="/network/service-mapping?direction=outbound"><i class="bi bi-box-arrow-up-right me-1"></i><%= t('Outbound') %></a></li>
      </ul>
      <% if (f.direction) { %>
        <div class="d-flex flex-wrap gap-2 px-3 pt-2">
          <a class="btn btn-sm <%= f.scope ? 'btn-outline-secondary' : 'btn-secondary' %>" href="/network/service-mapping?direction=<%= f.direction %>"><%= t(f.direction === 'inbound' ? 'All inbound' : 'All outbound') %></a>
          <% flows.filter(function (fl) { return fl.id.startsWith(f.direction + '-'); }).forEach(function (fl) { const sc = fl.id.split('-')[1]; %>
            <a class="btn btn-sm <%= currentFlow === fl.id ? 'btn-secondary' : 'btn-outline-secondary' %>" href="/network/service-mapping?direction=<%= f.direction %>&scope=<%= sc %>" title="<%= t(fl.path) %>"><i class="bi <%= fl.icon %> me-1"></i><%= t(fl.label) %></a>
          <% }) %>
        </div>
      <% } %>
      <form class="list-filter-form" method="get" action="/network/service-mapping">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <% if (f.direction) { %><input type="hidden" name="direction" value="<%= f.direction %>"><% } %>
        <% if (f.scope) { %><input type="hidden" name="scope" value="<%= f.scope %>"><% } %>
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by name, description, domain, IP, partner, system, device, server...',
              filtersId: 'smFilters', activeFilterCount,
              columns: { tableId: 'smTable', storageKey: 'openasm.serviceMappingList.columns.v4', list: COLUMNS },
              exportUrl: '/network/service-mapping/export' + currentQuery,
              importModal: hasPermission('service_mapping.create') ? 'smImportModal' : null,
              addUrl: hasPermission('service_mapping.create') ? '/network/service-mapping/add' : null, addLabel: 'Add Service Mapping' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="smFilters">
          <div class="list-filters">
            <div class="row g-2">
              <% FILTERS.forEach(function (fl) { %>
                <div class="col-md-3">
                  <label class="form-label small"><%= t(fl.label) %></label>
                  <select name="<%= fl.name %>" class="form-select js-filter" data-placeholder="<%= t('All') %>">
                    <option value=""></option>
                    <% fl.options.forEach(function (o) { %>
                      <option value="<%= o %>" <%= f[fl.name] === o ? 'selected' : '' %>><%= fl.labelOf(o) %></option>
                    <% }) %>
                  </select>
                </div>
              <% }) %>
              <div class="col-md-3">
                <label class="form-label small"><%= t('System') %></label>
                <select name="system_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(f.system_id ? [f.system_id] : []) %>'></select>
              </div>
              <div class="col-md-3">
                <label class="form-label small"><%= t('Device holding the IP') %></label>
                <select name="device_id" class="form-select js-filter" data-placeholder="<%= t('All') %>"
                        data-ajax-url="/device/api/device" data-ids-url="/device/api/device/ids" data-selected='<%= JSON.stringify(f.device_id ? [f.device_id] : []) %>'></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="smTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (vsList && vsList.length) { %>
              <% vsList.forEach(function (vs, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'name' ? ' class="fw-medium"' : '' %>><%- cell(vs, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showSmDetail(this)" data-record='<%= JSON.stringify(vs) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('service_mapping.create')) { %>
                        <a href="/network/service-mapping/<%= vs.id %>/duplicate" class="btn btn-sm btn-outline-secondary" title="<%= t('Duplicate') %>"><i class="bi bi-copy"></i></a>
                      <% } %>
                      <% if (hasPermission('service_mapping.update')) { %>
                        <a href="/network/service-mapping/<%= vs.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('service_mapping.delete')) { %>
                        <form action="/network/service-mapping/<%= vs.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: vs.name }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-hdd-network', message: 'No service mappings found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/network/service-mapping',
                      actionUrl: hasPermission('service_mapping.create') ? '/network/service-mapping/add' : null, actionLabel: 'Add Service Mapping' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: (vsList || []).length, summary: 'Showing {1} - {2} of {3} service mappings' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'smDetailModal' }) %>
<% if (hasPermission('service_mapping.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'smImportModal', title: 'Import Service Mappings', baseUrl: '/network/service-mapping',
        instructions: ['Flow = Direction + Scope: inbound public (public exposure), inbound internal (internal exposure), inbound private (private connectivity), outbound private (partner connectivity), outbound public (internet connectivity)',
          'IP = the public / NAT service / NAT / egress IP of the flow; Port / Protocol: required for inbound, empty for outbound',
          'Partner IPs (single IPs, no CIDR), comma-separated: IP[Partner] = allowed sources of inbound; IP:port/protocol[Partner] = partner connectivity destinations; IP:port/protocol@domain[Partner] = internet destinations (domain optional)',
          'System is looked up by exact name', 'Backends: ip:port/protocol (protocol optional), comma-separated; outbound sources: ip, comma-separated'] }) %>
<% } %>

<style>
  .sm-flow{display:flex;align-items:stretch;gap:.5rem;padding:1rem;overflow-x:auto;background:var(--bs-tertiary-bg);border-radius:.5rem}
  .sm-node{display:flex;flex-direction:column;justify-content:center;text-align:center;padding:.5rem .75rem;border-radius:.5rem;background:var(--bs-body-bg);border:1px solid var(--bs-border-color);min-width:110px;flex-shrink:0}
  .sm-node > i.bi{font-size:1.25rem;margin-bottom:.25rem}
  .sm-node .sm-title{font-weight:500}
  .sm-node small{display:block;font-size:.75rem;color:var(--bs-secondary-color);word-break:break-all}
  .sm-arrow{display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--bs-secondary-color);flex-shrink:0;font-size:.7rem}
  .sm-arrow i{font-size:1.25rem}
  .sm-n-source{background:var(--bs-info-bg-subtle);border-color:var(--bs-info-border-subtle)}
  .sm-n-edge{background:var(--bs-warning-bg-subtle);border-color:var(--bs-warning-border-subtle)}
  .sm-n-entry{background:var(--bs-primary-bg-subtle);border-color:var(--bs-primary-border-subtle)}
  .sm-n-servers{background:var(--bs-success-bg-subtle);border-color:var(--bs-success-border-subtle);text-align:left}
  .sm-n-servers .sm-srv{white-space:nowrap;padding:.1rem 0}
  .sm-n-servers .sm-srv.is-inactive{opacity:.55;text-decoration:line-through}
</style>
<script>
  // The device / server holding a backend IP, like the frontend IP owner ('' when nothing holds it)
  function memberOwner(m, before) {
    if (!m.owner_name) return '';
    return (before || '') + '<small><i class="bi ' + (m.owner_type === 'device' ? 'bi-hdd-rack' : 'bi-server') + ' me-1 text-secondary"></i>' + DV.esc(m.owner_name) + '</small>';
  }

  // Asset mapping: the device / server holding an IP of the flow, on its own line
  const ownerLine = (name, type) => (name ? '<br><i class="bi ' + (type === 'device' ? 'bi-hdd-rack' : 'bi-server') + ' me-1"></i>' + DV.esc(name) : '');
  const FLOW_LABEL = <%- jsonSafe(Object.fromEntries(flows.map((fl) => [fl.id, { label: t(fl.label), icon: fl.icon }]))) %>;

  // Service Flow, one diagram per flow (direction-scope):
  //   inbound-public    users / partners (limited on the CDN, or on the FW without CDN) -> domain -> CDN -> public IP:port (on its FW / LB) -> backends
  //   inbound-internal  internal users -> domain -> IP:port -> backends
  //   inbound-private   partner VPN IPs -> VPN / lease line -> NAT service IP:port -> backends
  //   outbound-private  internal IPs -> NAT IP -> VPN / lease line -> each partner IP:port / protocol
  //   outbound-public   internal IPs -> egress public IP -> each internet IP (domain):port / protocol
  function smFlow(vs) {
    const esc = DV.esc;
    const flow = vs.direction + '-' + vs.scope;
    const node = (cls, icon, title, sub) =>
      `<div class="sm-node ${cls}"><i class="bi ${icon}"></i><div class="sm-title">${title}</div>${sub ? '<small>' + sub + '</small>' : ''}</div>`;
    const arrow = (label) => `<div class="sm-arrow"><i class="bi bi-arrow-right"></i>${label ? '<span>' + esc(label) + '</span>' : ''}</div>`;
    const members = vs.members || [];
    const membersNode = (title) => members.length
      ? `<div class="sm-node sm-n-servers"><div class="sm-title mb-1">${esc(t(title))}</div>` +
        members.map(m => `<div class="sm-srv${m.status === 'inactive' ? ' is-inactive' : ''}"><i class="bi bi-server ${m.status === 'inactive' ? 'text-secondary' : 'text-success'} me-1"></i>${DV.ipLink(m.ip)}${m.port ? ':' + m.port : ''}${m.protocol ? ' · ' + esc(m.protocol) : ''}${memberOwner(m, '<br>')}</div>`).join('') + '</div>'
      : node('sm-n-servers', 'bi-server', esc(t(title)), esc(t('None')));
    // partner IPs grouped by partner: "Bank A" then its IPs (with the asset holding an IP, if any)
    const partners = vs.partner_ips || [];
    const dest = (p) => `${DV.ipLink(p.address)}${p.port ? '<span class="font-monospace">:' + p.port + '</span>' : ''}${p.protocol ? ' · ' + esc(p.protocol) : ''}${p.domain ? '<br><span class="font-monospace">' + esc(p.domain) + '</span>' : ''}`;
    // at most PARTNERS_SHOWN partners on the diagram; "see all" jumps to the full, filterable table below
    const PARTNERS_SHOWN = 10;
    const partnersNode = (title, icon) => {
      if (!partners.length) return node('sm-n-source', icon, esc(t(title)), esc(t('Not recorded')));
      const groups = new Map();
      partners.forEach((p) => { const k = p.partner || t('Unnamed partner'); if (!groups.has(k)) groups.set(k, []); groups.get(k).push(p); });
      const list = [...groups];
      const more = list.length - PARTNERS_SHOWN;
      return `<div class="sm-node sm-n-source text-start"><div class="sm-title mb-1"><i class="bi ${icon} me-1"></i>${esc(t(title))}</div>` +
        list.slice(0, PARTNERS_SHOWN).map(([name, ips]) => `<div class="small"><strong>${esc(name)}</strong><br>` +
          ips.slice(0, 5).map((p) => dest(p) + ownerLine(p.owner_name, p.owner_type)).join('<br>') +
          (ips.length > 5 ? '<br>+' + (ips.length - 5) : '') + '</div>').join('') +
        (more > 0 || partners.length > PARTNERS_SHOWN
          ? `<button type="button" class="btn btn-link btn-sm p-0 mt-1 text-start" data-sm-show-partners>${esc(more > 0 ? t('+{1} partner(s) · See all', { 1: more }) : t('See all'))}</button>` : '') +
        '</div>';
    };
    // our IP and the device holding it (FW / LB / NAT): the asset mapping
    const ourIp = (title, icon, withPort) => node('sm-n-entry', icon, esc(t(title)),
      (vs.ip_address ? `${DV.ipLink(vs.ip_address)}${withPort && vs.port ? '<span class="font-monospace">:' + vs.port + '</span> · ' + esc(vs.protocol || '') : ''}` : esc(t('Not recorded'))) +
      ownerLine(vs.ip_owner_name, vs.ip_owner_type));
    const providerEnd = vs.provider_port || vs.provider_protocol
      ? '<br>' + [vs.provider_port ? ':' + vs.provider_port : '', esc(vs.provider_protocol || '')].filter(Boolean).join(' · ') : '';
    // a CDN shows where it listens; a VPN / lease line only carries the traffic
    const channel = (kind) => (vs.provider ? [arrow(''), node('sm-n-edge', kind === 'cdn' ? 'bi-cloud' : 'bi-signpost-split', esc(vs.provider), esc(t(kind === 'cdn' ? 'CDN / WAF' : 'VPN / Lease line')) + (kind === 'cdn' ? providerEnd : ''))] : []);
    const parts = [];
    if (flow === 'inbound-public') {
      parts.push(vs.access_mode === 'limited' ? partnersNode(vs.provider ? 'Allowed partners (limited on the CDN)' : 'Allowed partners (limited on the FW)', 'bi-people') : node('sm-n-source', 'bi-globe', esc(t('Users (Internet)')), esc(t('Any source'))));
      if (vs.domain) parts.push(arrow(''), node('sm-n-edge', 'bi-at', esc(vs.domain), esc(t('Domain'))));
      // the public IP's FW / LB device comes from the asset mapping (ownerLine)
      parts.push(...channel('cdn'), arrow(''), ourIp('Public IP (FW / LB)', 'bi-door-open', true), arrow(''), membersNode('Backend Servers'));
    } else if (flow === 'inbound-internal') {
      parts.push(node('sm-n-source', 'bi-house-door', esc(t('Internal users')), esc(t('Internal network'))));
      if (vs.domain) parts.push(arrow(''), node('sm-n-edge', 'bi-at', esc(vs.domain), esc(t('Domain'))));
      parts.push(arrow(''), ourIp('IP', 'bi-diagram-3', true), arrow(''), membersNode('Backend Servers'));
    } else if (flow === 'inbound-private') {
      parts.push(partnersNode('Partner VPN IPs', 'bi-building'), ...channel('vpn'), arrow(''), ourIp('NAT service IP', 'bi-door-open', true), arrow(''), membersNode('Backend Servers'));
    } else if (flow === 'outbound-private') {
      parts.push(membersNode('Internal IPs'), arrow(''), ourIp('NAT IP', 'bi-shuffle', false), ...channel('vpn'), arrow(''), partnersNode('Partner IPs', 'bi-building'));
    } else {
      parts.push(membersNode('Internal IPs'), arrow(''), ourIp('Egress public IP', 'bi-box-arrow-up-right', false), arrow(''), partnersNode('Internet destinations', 'bi-globe'));
    }
    return `<div class="sm-flow">${parts.join('')}</div>`;
  }

  function showSmDetail(button) {
    const vs = DV.record(button);
    if (!vs) return;
    const esc = DV.esc;
    const cap = (s) => s ? s.charAt(0).toUpperCase() + s.slice(1) : '';
    const flow = FLOW_LABEL[vs.direction + '-' + vs.scope] || {};
    const members = vs.members || [];
    const partners = vs.partner_ips || [];
    const asset = (name, type) => (name ? DV.text(name + ' (' + t(type === 'device' ? 'Device' : 'Server') + ')') : '');
    let body = DV.section('Service Flow', smFlow(vs));
    body += DV.section('Overview', DV.rows(
      DV.multiline(vs.description) ? DV.field('Description', DV.multiline(vs.description)) : '',
      DV.field('Flow', '<span class="badge tag"><i class="bi ' + esc(flow.icon || '') + ' me-1"></i>' + esc(flow.label || '') + '</span>'),
      DV.field('System', DV.text(vs.system_name)),
      vs.domain ? DV.field('Domain', DV.text(vs.domain)) : '',
      DV.field('Provider / Channel', vs.provider ? DV.chips([vs.provider]) : ''),
      vs.provider && vs.direction === 'inbound' && vs.scope === 'public' && (vs.provider_port || vs.provider_protocol) ? DV.field('Provider port', DV.text([vs.provider_port, vs.provider_protocol].filter(Boolean).join(' · '))) : '',
      DV.field('IP Address', vs.ip_address ? DV.ipLink(vs.ip_address) : ''),
      vs.ip_address ? DV.field('IP owner', asset(vs.ip_owner_name, vs.ip_owner_type)) : '',
      vs.port ? DV.field('Port', DV.text(vs.port)) : '',
      vs.protocol ? DV.field('Protocol', DV.chips([vs.protocol])) : '',
      vs.direction === 'inbound' && vs.scope === 'public' ? DV.field('Access', DV.chips([t(vs.access_mode === 'limited' ? 'Limited' : 'Full')])) : ''
    ));
    if (partners.length) {
      // outbound destinations carry their own port / protocol (and domain for internet connectivity)
      const out = vs.direction === 'outbound';
      const withDomain = out && vs.scope === 'public';
      const head = [t('IP')].concat(out ? [t('Port'), t('Protocol')] : [], withDomain ? [t('Domain')] : [], [t('Partner'), t('Server/Device')]);
      const rows = partners.map((p) => '<tr data-sm-partner-row="' + esc([p.partner, p.address, p.domain, p.port, p.protocol].filter(Boolean).join(' ').toLowerCase()) + '"><td>' + DV.ipLink(p.address) + '</td>' +
        (out ? '<td>' + esc(p.port || '') + '</td><td>' + (p.protocol ? '<span class="badge tag">' + esc(p.protocol) + '</span>' : '') + '</td>' : '') +
        (withDomain ? '<td class="font-monospace">' + esc(p.domain || '—') + '</td>' : '') +
        '<td>' + esc(p.partner || '—') + '</td><td>' + (p.owner_name ? memberOwner(p) : '—') + '</td></tr>').join('');
      body += DV.section(out ? (withDomain ? 'Internet destinations' : 'Partner IPs (destination)') : 'Partner IPs (source)',
        '<div id="smPartners">' + (partners.length > 10 ? '<div class="detail-pad pb-0"><input type="search" class="form-control form-control-sm" data-sm-partner-filter placeholder="' + esc(t('Filter by partner, IP or domain...')) + '"></div>' : '') +
        '<div class="table-responsive" style="max-height: 24rem"><table class="table table-sm mb-0"><thead class="sticky-top"><tr>' + head.map((h) => '<th>' + esc(h) + '</th>').join('') + '</tr></thead><tbody>' + rows + '</tbody></table></div></div>',
        ' <span class="badge tag ms-1">' + partners.length + '</span>');
    }
    if (members.length) {
      const rows = members.map(m =>
        `<tr><td>${DV.ipLink(m.ip)}</td><td>${m.port || ''}</td>${vs.direction === 'outbound' ? '' : '<td>' + (m.protocol ? '<span class="badge tag">' + esc(m.protocol) + '</span>' : '') + '</td>'}<td>${memberOwner(m) || '—'}</td><td><span class="badge tag">${esc(t(cap(m.status || 'active')))}</span></td></tr>`
      ).join('');
      body += DV.section(vs.direction === 'outbound' ? 'Internal IPs (source)' : 'Backend Servers',
        `<table class="table table-sm mb-0"><thead><tr><th>${t('IP Address')}</th><th>${t('Port')}</th>${vs.direction === 'outbound' ? '' : '<th>' + t('Protocol') + '</th>'}<th>${t('Server/Device')}</th><th>${t('Status')}</th></tr></thead><tbody>${rows}</tbody></table>`,
        ' <span class="badge tag ms-1">' + members.length + '</span>');
    }
    body += DV.meta(vs);
    DV.open('smDetailModal', { title: vs.name, subtitle: '<i class="bi ' + esc(flow.icon || '') + ' me-1"></i>' + esc(flow.label || '') + (vs.domain ? ' · <span class="font-monospace small">' + esc(vs.domain) + '</span>' : ''), body });
  }
</script>

<script>
  // IP tooltips of the list's IP links
  document.addEventListener('DOMContentLoaded', () => DV.enhance(document.getElementById('smTable')));
</script>

<script>
  // Service Flow "see all partners": the full table of the detail, filtered as you type
  document.addEventListener('click', (e) => {
    if (!e.target.closest('[data-sm-show-partners]')) return;
    const box = document.getElementById('smPartners');
    if (!box) return;
    box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    const filter = box.querySelector('[data-sm-partner-filter]');
    if (filter) setTimeout(() => filter.focus(), 300);
  });
  document.addEventListener('input', (e) => {
    const filter = e.target.closest('[data-sm-partner-filter]');
    if (!filter) return;
    const q = filter.value.trim().toLowerCase();
    filter.closest('#smPartners').querySelectorAll('[data-sm-partner-row]').forEach((tr) => { tr.hidden = q !== '' && !tr.dataset.smPartnerRow.includes(q); });
  });
</script>
