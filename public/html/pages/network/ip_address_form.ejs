<%#
  Add / Edit IP Address.  mode: 'add' | 'edit', ip, statusOptions, tagOptions ([{id, text}]); systems / contacts load via AJAX
  Add accepts several addresses separated by commas (same details for all).
%>
<% const isEdit = mode === 'edit'; const ip = locals.ip || {}; %>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'IP Address', href: '/network/ip-address' }, { label: isEdit ? 'Edit IP Address' : 'Add IP Address' }
] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>
    <form class="card form-card" method="POST" action="<%= isEdit ? '/network/ip-address/' + ip.id + '/edit' : '/network/ip-address/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit IP Address' : 'Add IP Address') %></h3>
      </div>
      <div class="card-body">
        <%- include('../../partials/ui/copied_from', { copiedFrom: locals.copiedFrom, hint: 'Enter the new address(es).' }) %>
        <section class="form-section">
          <h4 class="form-section-title"><%= t('General information') %></h4>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-address"><%= t('IP Address') %> <span class="text-danger">*</span></label>
              <% if (isEdit) { %>
                <input type="text" id="f-address" class="form-control font-monospace" value="<%= ip.ip_address %>" disabled>
              <% } else { %>
                <input type="text" id="f-address" name="address" class="form-control font-monospace" required placeholder="192.168.1.10, 192.168.1.11" autocomplete="off" aria-describedby="f-address-check">
                <%# filled when the field is left: format / duplicate / already in the inventory %>
                <div id="f-address-check" class="small mt-1" aria-live="polite"></div>
                <div class="form-text"><%= t('Several addresses can be separated by commas') %></div>
              <% } %>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-status"><%= t('Status') %></label>
              <select id="f-status" name="status" class="form-select js-select" data-placeholder="<%= t('Select status') %>">
                <option value=""></option><%- ui.options(statusOptions, ip.status) %>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="f-description"><%= t('Description') %></label>
              <textarea id="f-description" name="description" class="form-control" rows="3"><%= ip.description || '' %></textarea>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h4 class="form-section-title"><%= t('Links') %></h4>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" for="f-systems"><%= t('Systems') %></label>
              <select id="f-systems" name="systems" class="form-select js-select" multiple data-placeholder="<%= t('Select systems') %>"
                      data-ajax-url="/system/api/system" data-selected="<%= JSON.stringify((ip.systems || []).map(s => ({ id: s.id, text: s.name }))) %>"></select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f-contacts"><%= t('Contacts') %></label>
              <select id="f-contacts" name="contacts" class="form-select js-select" multiple data-placeholder="<%= t('Select contacts') %>"
                      data-ajax-url="/organize/api/contact" data-selected="<%= JSON.stringify((ip.contacts || []).map(c => ({ id: c.id, text: c.name }))) %>"></select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="f-tags"><%= t('Tags') %></label>
              <select id="f-tags" name="tags" class="form-select js-select" multiple data-placeholder="<%= t('Select tags') %>"><%- ui.options(tagOptions, ip.tags) %></select>
            </div>
          </div>
        </section>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/network/ip-address', submitLabel: isEdit ? 'Save Changes' : 'Add IP Address', record: ip }) %>
    </form>
  </div>
</div>

<% if (!isEdit) { %>
<script>
  // Leaving the address field checks the addresses (format, repeated, already in
  // the inventory) and blocks the submit while one is wrong. The server checks again.
  (function () {
    var input = document.getElementById('f-address');
    var box = document.getElementById('f-address-check');
    var esc = function (v) { return String(v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    var last = null;
    function show(html, ok) {
      box.innerHTML = html;
      box.className = 'small mt-1 ' + (ok ? 'text-success' : 'text-danger');
      input.classList.toggle('is-invalid', !ok && !!html);
      input.classList.toggle('is-valid', ok && !!html);
    }
    async function check() {
      var value = input.value.trim();
      if (value === last) return;
      last = value;
      if (!value) { input.setCustomValidity(''); show('', true); return; }
      try {
        var res = await fetch('/network/api/ip-addresses/check?addresses=' + encodeURIComponent(value), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(res.status);
        var rows = await res.json();
        if (value !== input.value.trim()) return; // changed while checking
        var bad = rows.filter(function (r) { return r.state !== 'ok'; });
        if (!bad.length) {
          input.setCustomValidity('');
          show('<i class="bi bi-check-circle me-1"></i>' + esc(rows.length > 1 ? t('{1} new addresses').replace('{1}', rows.length) : t('New address')), true);
          return;
        }
        var lines = bad.map(function (r) {
          if (r.state === 'invalid') return esc(t('Not a valid IPv4 address: {1}').replace('{1}', r.address));
          if (r.state === 'duplicate') return esc(t('Entered twice: {1}').replace('{1}', r.address));
          return esc(t('Already exists: {1}').replace('{1}', r.address)) + (r.owner ? ' (' + esc(r.owner) + ')' : '') +
            ' <a href="/network/ip-address/' + r.id + '/edit" target="_blank" rel="noopener">' + esc(t('Open')) + '</a>';
        });
        input.setCustomValidity(t('Fix the addresses before saving'));
        show('<i class="bi bi-exclamation-circle me-1"></i>' + lines.join('<br>'), false);
      } catch (e) {
        last = null; // could not check: the server still refuses duplicates on save
        input.setCustomValidity('');
        show('', true);
      }
    }
    input.addEventListener('blur', check);
    input.addEventListener('input', function () {
      if (input.validationMessage) { input.setCustomValidity(''); show('', true); last = null; }
    });
  })();
</script>
<% } %>
