<%
  const f = filter;
  const activeFilterCount = [f.record_type.length, f.tags.length, f.systems.length].filter(Boolean).length;
  const COLUMNS = [
    { key: 'domain', label: 'Domain', def: true, fixed: true },
    { key: 'record_type', label: 'Record Type', def: true },
    { key: 'ip', label: 'IP Address', def: true },
    { key: 'systems', label: 'Systems', def: true },
    { key: 'tags', label: 'Tags', def: true },
    { key: 'description', label: 'Description', def: true },
  ];
  const cell = (d, key) => ({
    domain: ui.esc(d.domain),
    record_type: d.record_type ? ui.chips([d.record_type]) : ui.dash,
    ip: d.ip ? `<a href="/network/ip-address?search=${encodeURIComponent(d.ip.ip_address)}" class="font-monospace small">${ui.esc(d.ip.ip_address)}</a>` : ui.dash,
    systems: ui.chips(d.systems.map(x => x.name)),
    tags: ui.chips(d.tags.map(x => x.name)),
    description: ui.clip(d.description),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Network' }, { label: 'Domain' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/network/domain">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by domain, description, IP, system...',
              filtersId: 'domainFilters', activeFilterCount,
              columns: { tableId: 'domainTable', storageKey: 'openasm.domainList.columns', list: COLUMNS },
              exportUrl: '/network/domain/export' + currentQuery,
              importModal: hasPermission('domain.create') ? 'domainImportModal' : null,
              addUrl: hasPermission('domain.create') ? '/network/domain/add' : null, addLabel: 'Add Domain' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="domainFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label small"><%= t('Record Type') %></label>
                <select name="record_type" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(recordTypeOptions, f.record_type) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Systems') %></label>
                <select name="systems" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(f.systems) %>'></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(tagOptions, f.tags) %></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="domainTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (domainList.length) { %>
              <% domainList.forEach(function (d, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"<%- c.key === 'domain' ? ' class="fw-medium"' : '' %>><%- cell(d, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showDomainDetail(this)" data-record='<%= JSON.stringify(d) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('domain.update')) { %>
                        <a href="/network/domain/<%= d.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('domain.delete')) { %>
                        <form action="/network/domain/<%= d.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: d.domain }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-globe', message: 'No domains found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/network/domain',
                      actionUrl: hasPermission('domain.create') ? '/network/domain/add' : null, actionLabel: 'Add Domain' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: domainList.length, summary: 'Showing {1} - {2} of {3} domains' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'domainDetailModal' }) %>
<% if (hasPermission('domain.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'domainImportModal', title: 'Import Domains', baseUrl: '/network/domain',
        instructions: ['One domain per row', 'IP addresses, systems and tags must already exist', 'Existing domains are skipped'] }) %>
<% } %>

<script>
  function showDomainDetail(button) {
    const d = DV.record(button);
    if (!d) return;
    let body = DV.section('Overview', DV.rows(
      DV.multiline(d.description) ? DV.field('Description', DV.multiline(d.description)) : '',
      DV.field('Record Type', DV.text(d.record_type) || DV.EMPTY),
      DV.field('IP Address', d.ip ? DV.ipLink(d.ip.ip_address) : DV.EMPTY),
      DV.field('Systems', DV.linkChips(d.systems || [], (s) => '/system/system?search=' + encodeURIComponent(s.name))),
      DV.field('Tags', DV.chips((d.tags || []).map((x) => x.name)))
    ));
    DV.open('domainDetailModal', { title: d.domain, body, recordId: d.id });
  }
</script>
