<link rel="stylesheet" href="/css/custom.css">

<!--
==========================================
DOMAIN LIST PAGE - EJS TEMPLATE
==========================================
This template renders the domain list page with search, filter, pagination,
and CRUD operations for domain management.

Structure:
1. Helper Functions (EJS)
2. Page Header & Breadcrumb
3. Search & Filter Section
4. Action Buttons
5. Data Table
6. Pagination
7. Modals (Add, Edit, Detail, Filter)
8. Styles & JavaScript
==========================================
-->

<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

/**
 * Build pagination URL with all query parameters
 * @param {number} targetPage - Target page number
 * @returns {string} - Complete URL with query parameters
 */
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Core parameters
  params.set('page', targetPage);
  if (typeof search !== 'undefined' && search) params.set('search', search);
  if (typeof pageSize !== 'undefined' && pageSize) params.set('pageSize', pageSize);
  
  // Filter parameters
  if (typeof filterStatus !== 'undefined' && filterStatus) params.set('status', filterStatus);
  
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => params.append('tags[]', tag.id));
  }
  
  if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) {
    filterSystems.forEach(system => params.append('systems[]', system.id));
  }

  return '?' + params.toString();
}

/**
 * Build export URL with all current filter query parameters (no pagination)
 * @returns {string}
 */
function buildExportUrl() {
  const params = new URLSearchParams();
  if (typeof search !== 'undefined' && search) params.set('search', search);
  if (typeof filterStatus !== 'undefined' && filterStatus) params.set('status', filterStatus);
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => params.append('tags[]', tag.id));
  }
  if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) {
    filterSystems.forEach(system => params.append('systems[]', system.id));
  }
  return '/network/domain/export' + (params.toString() ? '?' + params.toString() : '');
}

%>

<!-- ==========================================
     PAGE HEADER & BREADCRUMB
     ========================================== -->
<div class="app-content-header">
<div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Domain List</li>
        </ol>
      </div>
    </div>
  </div>
</div>
  
<!-- ==========================================
     MAIN CONTENT AREA
     ========================================== -->
<div class="app-content">
  <div class="container-fluid">
    
    <!-- ==========================================
         SEARCH & FILTER SECTION
         ========================================== -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/network/domain">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <!-- Filter Status -->
            <% if (typeof filterStatus !== 'undefined' && filterStatus) { %>
              <input type="hidden" name="status" value="<%= filterStatus %>">
            <% } %>
            
            <!-- Filter Tags -->
            <% if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) { %>
              <% filterTags.forEach(function(tag) { %>
                <input type="hidden" name="tags[]" value="<%= tag.id %>">
              <% }); %>
            <% } %>
            
            <!-- Filter Systems -->
            <% if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) { %>
              <% filterSystems.forEach(function(system) { %>
                <input type="hidden" name="systems[]" value="<%= system.id %>">
              <% }); %>
            <% } %>
            
            
            <!-- Search Input -->
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" 
                     type="search" 
                     name="search" 
                     placeholder="Search Domain or Description..." 
                     aria-label="Search" 
                     value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit">
                <i class="bi bi-search"></i>
              </button>
            </div>
            
            <!-- Page Size Selector -->
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" 
                      name="pageSize" 
                      onchange="this.form.submit()" 
                      style="width: 80px;">
      <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>>
                    <%= size %>
                  </option>
      <% }) %>
    </select>
            </div>
  </form>
        </div>
      </div>
    </div>

    <!-- ==========================================
         ACTION BUTTONS
         ========================================== -->
  <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <!-- Add Domain Button -->
          <% if (hasPermission && hasPermission('domain.create')) { %>
            <button type="button" 
                    class="btn btn-primary btn-sm" 
                    data-bs-toggle="modal" 
                    data-bs-target="#addDomainModal">
          <i class="bi bi-plus"></i> Add Domain
        </button>
          <% } %>
          
          <!-- Filter Button -->
          <%
            const hasActiveDomainFilter = !!(
              (filterStatus && filterStatus !== '') ||
              (filterTags && filterTags.length > 0) ||
              (filterSystems && filterSystems.length > 0)
            );
          %>
          <button type="button"
                  class="btn btn-sm <%= hasActiveDomainFilter ? 'btn-primary' : 'btn-outline-secondary' %>"
                  data-bs-toggle="modal"
                  data-bs-target="#filterDomainModal">
            <i class="bi bi-funnel<%= hasActiveDomainFilter ? '-fill' : '' %>"></i> Filter<%= hasActiveDomainFilter ? ' (Filtered)' : '' %>
          </button>

          <!-- Export Button -->
          <% if (hasPermission && hasPermission('domain.read')) { %>
            <a href="<%= buildExportUrl() %>" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> Export
            </a>
          <% } %>

          <!-- Import Domain Button -->
          <% if (hasPermission && hasPermission('domain.create')) { %>
            <button type="button"
                    class="btn btn-success btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#importDomainModal">
              <i class="bi bi-upload"></i> Import Domain
            </button>
          <% } %>

      </div>
    </div>
            </div>

    <!-- ==========================================
         FILTER DATA FOR JAVASCRIPT
         ========================================== -->
    <div id="filter-domain-data"
         data-tags='<%= JSON.stringify(filterTags || []) %>'
         data-systems='<%= JSON.stringify(filterSystems || []) %>'
         data-status='<%= JSON.stringify(filterStatus || '') %>' 
         style="display:none">
                </div>

    <!-- ==========================================
         FLASH MESSAGES
         ========================================== -->
    <!-- Success Message -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= t(successMessage) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <!-- Error Message -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= t(errorMessage) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ==========================================
         DOMAIN LIST TABLE
         ========================================== -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0">Domain List</h3>
        </div>
          <div class="card-body table-responsive p-0" style="overflow-x: auto;">
            <table class="table table-hover" id="domainTable">
            <thead>
              <tr>
                <th>No.</th>
                <th data-sort-type="text">Domain</th>
                <th data-sort-type="text">Description</th>
                <th data-sort-type="ip">IP Address</th>
                <th data-sort-type="text">Record Type</th>
                  <th data-sort-type="text">Tags</th>
                  <th data-sort-type="text">Systems</th>
                  <th data-sort-type="text">Contacts</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (domainList && domainList.length > 0) { %>
                <% domainList.forEach(function(domain, idx) { %>
                  <tr>
                      <!-- Row Number -->
                    <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      
                      <!-- Domain Name -->
                      <td><strong><%= domain.domain %></strong></td>
                      
                      <!-- Description -->
                      <td>
                      <%
                        const description = domain.description || '-';
                        const cleanDescription = description.trim();
                        const shortDescription = cleanDescription.length > 50 ? cleanDescription.substring(0, 50) + '…' : cleanDescription;
                      %>
                      <span data-bs-toggle="tooltip" data-bs-placement="top" title="<%= cleanDescription %>" style="cursor: help; word-break: break-word;"><%= shortDescription %></span>
                      </td>
                      
                      <!-- IP Address -->
                      <td>
                        <% if (domain.ip && domain.ip.ip_address) { %>
                          <span class="badge bg-primary"><%= domain.ip.ip_address %></span>
                      <% } else { %>
                          <span class="text-muted">No IP</span>
                      <% } %>
                    </td>
                      
                      <!-- Record Type -->
                      <td><span class="badge bg-info"><%= domain.record_type || 'A' %></span></td>
                      
                      <!-- Tags -->
                      <td>
                        <% if (domain.tags && domain.tags.length > 0) { %>
                          <% domain.tags.forEach(function(tag) { %>
                            <span class="badge bg-primary me-1">
                              <%= (typeof tag === 'string') ? tag : tag.name %>
                            </span>
                          <% }) %>
                      <% } else { %>
                          <span class="text-muted">No tags</span>
                      <% } %>
                    </td>
                      
                      <!-- Systems -->
                    <td>
                      <% if (domain.systems && domain.systems.length > 0) { %>
                          <% domain.systems.forEach(function(system) { %>
                            <span class="badge bg-info me-1">
                              <%= (typeof system === 'string') ? system : system.name %>
                            </span>
                        <% }) %>
                      <% } else { %>
                          <span class="text-muted">No systems</span>
                      <% } %>
                    </td>
                      
                      <!-- Contacts -->
                      <td>
                        <% if (domain.contacts && domain.contacts.length > 0) { %>
                          <% domain.contacts.forEach(function(contact) { %>
                            <span class="badge bg-warning me-1">
                              <%= (typeof contact === 'string') ? contact : (contact.name || contact.email) %>
                            </span>
                          <% }) %>
                        <% } else { %>
                          <span class="text-muted">No contacts</span>
                        <% } %>
                      </td>
                      
                      <!-- Actions -->
                    <td class="text-end">
                        <!-- View Button -->
                        <button type="button" 
                                class="btn btn-info btn-sm" 
                                title="Show" 
                                onclick="showDomainDetail('<%= domain.id %>')" 
                                data-domain='<%= JSON.stringify(domain) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        
                        <!-- Edit Button -->
                        <% if (hasPermission('domain.update')) { %>
                          <button type="button" class="btn btn-warning btn-sm" title="Edit" 
                                  data-bs-toggle="modal" data-bs-target="#editDomainModal"
                                  data-domain-id="<%= domain.id %>"
                                  data-domain="<%= domain.domain %>"
                                  data-description="<%= domain.description || '' %>"
                                  data-record-type="<%= domain.record_type %>"
                                  data-ip-id="<%= domain.ip ? domain.ip.id : '' %>"
                                  data-ip-address="<%= domain.ip ? domain.ip.ip_address : '' %>"
                                  data-tags="<%= JSON.stringify(domain.tags || []) %>"
                                  data-systems="<%= JSON.stringify(domain.systems || []) %>">
                            <i class="bi bi-pencil"></i>
                          </button>
                      <% } %>
                        
                        <!-- Delete Button -->
                        <% if (hasPermission('domain.delete')) { %>
                          <form action="/network/domain/<%= domain.id %>?_method=DELETE" 
                                method="POST" 
                                style="display:inline" 
                                onsubmit="return confirmDeleteDomain(this, '<%= domain.domain %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                      </form>
                        <% } %>
                    </td>
                  </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center">No data</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <!-- ==========================================
               PAGINATION
               ========================================== -->
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <!-- Pagination Info -->
              <div>
                <% 
                  // Calculate pagination range
                  const startItem = (page - 1) * pageSize + 1;
                  const endItem = Math.min(page * pageSize, totalCount || 0);
                  const startPage = Math.max(1, page - 2);
                  const endPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= startItem %> - <%= endItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> domains</span>
              </div>
              
              <!-- Pagination Controls -->
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  // Build filter query for pagination links
                  function buildDomainFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    if (typeof filterTags !== 'undefined' && filterTags.length) filterTags.forEach(function(tag) { params.push('tags[]=' + encodeURIComponent(tag.id || tag)); });
                    if (typeof filterStatus !== 'undefined' && filterStatus) params.push('status=' + encodeURIComponent(filterStatus));
                    if (typeof filterSystems !== 'undefined' && filterSystems.length) filterSystems.forEach(function(system) { params.push('systems[]=' + encodeURIComponent(system.id || system)); });
                    return params.join('&');
                  }
                  const domainFilterQuery = buildDomainFilterQuery();
                %>
                
                <!-- Previous Button -->
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" 
                     href="?page=<%= page - 1 %><%= domainFilterQuery ? '&' + domainFilterQuery : '' %>" 
                     tabindex="-1">Previous</a>
                </li>
                
                <!-- First Page -->
                <% if (startPage > 1) { %>
                  <li class="page-item">
                    <a class="page-link" 
                       href="?page=1<%= domainFilterQuery ? '&' + domainFilterQuery : '' %>">1</a>
                  </li>
                  <% if (startPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                
                <!-- Page Numbers -->
                <% for (let i = startPage; i <= endPage; i++) { %>
                  <li class="page-item <%= (i === page) ? 'active' : '' %>">
                    <a class="page-link" 
                       href="?page=<%= i %><%= domainFilterQuery ? '&' + domainFilterQuery : '' %>">
                      <%= i %>
                    </a>
                  </li>
                <% } %>
                
                <!-- Last Page -->
                <% if (endPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item">
                    <a class="page-link" 
                       href="?page=<%= totalPages %><%= domainFilterQuery ? '&' + domainFilterQuery : '' %>">
                      <%= totalPages %>
                    </a>
                  </li>
                <% } %>
                
                <!-- Next Button -->
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" 
                     href="?page=<%= page + 1 %><%= domainFilterQuery ? '&' + domainFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================
     MODALS SECTION
     ========================================== -->

<!-- ==========================================
     ADD DOMAIN MODAL
     ========================================== -->
<div class="modal fade" id="addDomainModal" tabindex="-1" aria-labelledby="addDomainModalLabel">
  <div class="modal-dialog modal-lg">
                      <div class="modal-content">
      <form id="addDomainForm" method="POST" action="/network/domain">
                        <div class="modal-header">
          <h5 class="modal-title" id="addDomainModalLabel">Add Domain</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
          <div class="row g-3">
            <!-- Domain Name -->
            <div class="col-12">
              <label for="domainName" class="form-label">Domain <span class="text-danger">*</span></label>
              <input type="text" 
                     class="form-control" 
                     id="domainName" 
                     name="domain" 
                     required 
                     placeholder="example.com">
                                  </div>
            
            <!-- Description -->
            <div class="col-12">
              <label for="domainDescription" class="form-label">Description</label>
              <textarea class="form-control"
                        id="domainDescription"
                        name="description"
                        rows="3"
                        placeholder="Enter domain description"></textarea>
            </div>
            
            <!-- Record Type -->
            <div class="col-12">
              <label for="domainRecordType" class="form-label">Record Type</label>
              <select class="form-select" id="domainRecordType" name="record_type">
                <option value="A" selected>A</option>
                <option value="AAAA">AAAA</option>
                <option value="CNAME">CNAME</option>
                <option value="MX">MX</option>
                <option value="TXT">TXT</option>
                <option value="NS">NS</option>
                <option value="SRV">SRV</option>
                <option value="PTR">PTR</option>
                <option value="SOA">SOA</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
            
            <!-- IP Address -->
            <div class="col-12">
              <label for="domainIpId" class="form-label">IP Address</label>
              <select id="domainIpId" name="ip_id" class="form-select">
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
            <!-- Tags -->
            <div class="col-12">
              <label for="domainTags" class="form-label">Tags</label>
              <select id="domainTags" name="tags[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
            <!-- Systems -->
            <div class="col-12">
              <label for="domainSystems" class="form-label">Systems</label>
              <select id="domainSystems" name="systems[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
          </div>
                        </div>
                        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Add Domain</button>
                        </div>
      </form>
                      </div>
                    </div>
                  </div>

<!-- ==========================================
     EDIT DOMAIN MODAL
     ========================================== -->
<div class="modal fade" id="editDomainModal" tabindex="-1" aria-labelledby="editDomainModalLabel">
  <div class="modal-dialog modal-lg">
                      <div class="modal-content">
      <form id="editDomainForm" method="POST" action="">
        <input type="hidden" name="page" value="<%= page %>">
                        <div class="modal-header">
          <h5 class="modal-title" id="editDomainModalLabel">Edit Domain</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                          <div class="modal-body">
          <div class="row g-3">
            <!-- Domain Name (Read-only) -->
            <div class="col-12">
              <label for="editDomainName" class="form-label">Domain <span class="text-danger">*</span></label>
              <input type="text" 
                     class="form-control" 
                     id="editDomainName" 
                     name="domain" 
                     readonly>
              <small class="form-text text-muted">Domain cannot be changed</small>
                            </div>
            
            <!-- Description -->
            <div class="col-12">
              <label for="editDomainDescription" class="form-label">Description</label>
              <textarea class="form-control"
                        id="editDomainDescription"
                        name="description"
                        rows="3"
                        placeholder="Enter domain description"></textarea>
                            </div>
            
            <!-- Record Type -->
            <div class="col-12">
              <label for="editDomainRecordType" class="form-label">Record Type</label>
              <select class="form-select" id="editDomainRecordType" name="record_type">
                <option value="A">A</option>
                <option value="AAAA">AAAA</option>
                <option value="CNAME">CNAME</option>
                <option value="MX">MX</option>
                <option value="TXT">TXT</option>
                <option value="NS">NS</option>
                <option value="SRV">SRV</option>
                <option value="PTR">PTR</option>
                <option value="SOA">SOA</option>
                <option value="OTHER">Other</option>
                              </select>
                            </div>
            
            <!-- IP Address -->
            <div class="col-12">
              <label for="editDomainIpId" class="form-label">IP Address</label>
              <select id="editDomainIpId" name="ip_id" class="form-select">
                <!-- Options will be loaded via AJAX -->
                              </select>
                            </div>
            
            <!-- Tags -->
            <div class="col-12">
              <label for="editDomainTags" class="form-label">Tags</label>
              <select id="editDomainTags" name="tags[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
            <!-- Systems -->
            <div class="col-12">
              <label for="editDomainSystems" class="form-label">Systems</label>
              <select id="editDomainSystems" name="systems[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
                            </div>
                          </div>
                          <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Update Domain</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
        
<!-- ==========================================
     DOMAIN DETAIL MODAL
     ========================================== -->
<div class="modal fade" id="domainDetailModal" tabindex="-1" aria-labelledby="domainDetailModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="domainDetailModalLabel">Domain Detail</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      <div class="modal-body" id="domainDetailContent">
        <!-- Content will be loaded here -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
                  
<!-- ==========================================
     FILTER DOMAIN MODAL
     ========================================== -->
<div class="modal fade" id="filterDomainModal" tabindex="-1" aria-labelledby="filterDomainModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filterDomainModalLabel">Filter Domains</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="GET" action="/network/domain" id="filterDomainForm">
        <input type="hidden" name="page" value="1">
        <input type="hidden" name="pageSize" value="<%= typeof pageSize !== 'undefined' ? pageSize : 10 %>">
        
        <!-- Preserve current search term -->
        <% if (typeof search !== 'undefined' && search) { %>
          <input type="hidden" name="search" value="<%= search %>">
        <% } %>
        <div class="modal-body">
          <div class="row g-2">
            <!-- Record Type Filter -->
            <div class="col-12 mb-2">
              <label for="filterDomainRecordType" class="form-label">Record Type</label>
              <select class="form-control" id="filterDomainRecordType" name="status">
                <option value="">All Record Types</option>
                <option value="A" <%= (filterStatus === 'A') ? 'selected' : '' %>>A</option>
                <option value="AAAA" <%= (filterStatus === 'AAAA') ? 'selected' : '' %>>AAAA</option>
                <option value="CNAME" <%= (filterStatus === 'CNAME') ? 'selected' : '' %>>CNAME</option>
                <option value="MX" <%= (filterStatus === 'MX') ? 'selected' : '' %>>MX</option>
                <option value="TXT" <%= (filterStatus === 'TXT') ? 'selected' : '' %>>TXT</option>
                <option value="NS" <%= (filterStatus === 'NS') ? 'selected' : '' %>>NS</option>
                <option value="SRV" <%= (filterStatus === 'SRV') ? 'selected' : '' %>>SRV</option>
                <option value="PTR" <%= (filterStatus === 'PTR') ? 'selected' : '' %>>PTR</option>
                <option value="SOA" <%= (filterStatus === 'SOA') ? 'selected' : '' %>>SOA</option>
                <option value="OTHER" <%= (filterStatus === 'OTHER') ? 'selected' : '' %>>Other</option>
              </select>
            </div>
            
            <!-- Tags Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Tags</label>
              <select id="filterDomainTags" name="tags[]" class="form-control" multiple></select>
            </div>
            
            <!-- Systems Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Systems</label>
              <select id="filterDomainSystems" name="systems[]" class="form-control" multiple></select>
            </div>
            
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-outline-danger" id="clearFilterBtnDomain">Clear All Filters</button>
            <div>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
            </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Import Domain Modal -->
<div class="modal fade" id="importDomainModal" tabindex="-1" aria-labelledby="importDomainModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importDomainModalLabel">Import Domains</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="importDomainForm" enctype="multipart/form-data">
          <!-- File Selection -->
          <div class="mb-3">
            <label for="domainImportFile" class="form-label">Select File <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="file"
                     class="form-control"
                     id="domainImportFile"
                     name="file"
                     accept=".xlsx,.xls"
                     required>
              <a href="/network/domain/template" class="btn btn-outline-info" download>
                <i class="bi bi-download"></i> Download Template
              </a>
            </div>
            <div class="form-text">Supported format: Excel (.xlsx, .xls). Maximum file size: 10MB</div>
          </div>

          <!-- Import Instructions -->
          <div class="mb-3">
            <div class="alert alert-info">
              <h6><i class="bi bi-info-circle"></i> Import Instructions:</h6>
              <ul class="mb-0">
                <li>Click "Download Template" to get the Excel template with correct format</li>
                <li>Fill the template with your domain data</li>
                <li>Domain Name (Required, one per row) must not already exist</li>
                <li>Description and Record Type are optional (Record Type defaults to A)</li>
                <li>IP Address, System Name, and Tags are optional and can be comma-separated if multiple</li>
                <li>Select your filled template file and validate before importing</li>
              </ul>
            </div>
          </div>

          <!-- Progress Bar -->
          <div id="domainImportProgress" class="progress mb-3" style="display: none;">
            <div class="progress-bar" role="progressbar" style="width: 0%"></div>
          </div>

          <!-- Results Display -->
          <div id="domainImportResults" class="alert" style="display: none;"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning btn-sm" id="validateDomainBtn">Validate File</button>
        <button type="button" class="btn btn-success btn-sm" id="importDomainBtn" style="display: none;">Import Domains</button>
      </div>
    </div>
  </div>
</div>

