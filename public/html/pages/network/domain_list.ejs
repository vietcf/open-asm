<!-- ==========================================
     JAVASCRIPT
     ========================================== -->
<script>
$(function() {
  console.log('Initializing Domain List JavaScript...');
  
  // ==========================================
  // SELECT2 INITIALIZATION
  // ==========================================
  
  // Tags Select2 - Add Domain Modal
  console.log('Setting up Tags Select2...');
  // Record Type — options are already rendered server-side, so no ajax
  // needed, just the Bootstrap 5 Select2 styling to match Tags/Systems.
  $('#domainRecordType').select2({
    theme: 'bootstrap-5',
    width: '100%',
    minimumResultsForSearch: Infinity,
    dropdownParent: $('#addDomainModal')
  });

  $('#domainTags').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select tags (optional)',
    allowClear: true,
    width: '100%',
    multiple: true,
    dropdownParent: $('#addDomainModal'),
    ajax: {
      url: '/organize/api/tag',
      dataType: 'json',
      delay: 250,
      data: params => {
        console.log('Tags AJAX request:', params.term);
        return { search: params.term };
      },
      processResults: data => {
        console.log('Tags API response:', data);
        return { results: data };
      },
      cache: true
    }
  });

  // Systems select2 AJAX - Bootstrap 5 theme (clone from system_add.ejs)
  console.log('Setting up Systems Select2...');
  $('#domainSystems').select2({
    theme: 'bootstrap-5',
    placeholder: 'Select systems (optional)',
    allowClear: true,
    width: '100%',
    multiple: true,
    dropdownParent: $('#addDomainModal'),
    ajax: {
      url: '/system/api/system',
      dataType: 'json',
      delay: 250,
      data: params => {
        console.log('Systems AJAX request:', params.term);
        return { search: params.term };
      },
      processResults: data => {
        console.log('Systems API response:', data);
        return { results: data };
      },
      cache: true
    }
  });


  // IP Address select2 AJAX - Bootstrap 5 theme
  console.log('Setting up IP Address Select2...');
  $('#domainIpId').select2({
      theme: 'bootstrap-5',
    placeholder: 'Select IP address (optional)',
      allowClear: true,
      width: '100%',
    dropdownParent: $('#addDomainModal'),
        ajax: {
          url: '/network/api/ip-addresses',
          dataType: 'json',
          delay: 250,
      data: params => {
        console.log('IP Address AJAX request:', params.term);
        return { search: params.term };
      },
      processResults: data => {
        console.log('IP Address API response:', data);
        return { results: data };
      },
          cache: true
        }
      });
  
  console.log('All Select2 initialized!');

  // Debug: Select2 events
  $('#domainTags').on('select2:open', function() {
    console.log('Tags dropdown opened');
  });
  
  $('#domainSystems').on('select2:open', function() {
    console.log('Systems dropdown opened');
  });
  
  $('#domainContacts').on('select2:open', function() {
    console.log('Contacts dropdown opened');
  });
  
  $('#domainIpId').on('select2:open', function() {
    console.log('IP Address dropdown opened');
  });

  // Debug: Modal events
  $('#addDomainModal').on('shown.bs.modal', function() {
    console.log('Add Domain Modal shown');
    console.log('Select2 elements in modal:');
    console.log('domainTags:', $('#addDomainModal #domainTags').length);
    console.log('domainSystems:', $('#addDomainModal #domainSystems').length);
    console.log('domainIpId:', $('#addDomainModal #domainIpId').length);
  });

  // Reset form when modal is hidden
  $('#addDomainModal').on('hidden.bs.modal', function() {
    console.log('Add Domain Modal hidden, resetting form');
    $('#addDomainForm')[0].reset();
    $('#domainTags, #domainSystems, #domainIpId').val(null).trigger('change');
    $('#domainRecordType').trigger('change');
  });


  // IP Address validation - Check immediately on blur
  $('#ipAddress').on('blur', function() {
    console.log('IP input blurred - starting validation...');
    const ipInput = $(this).val().trim();
    const errorDiv = $('#ipAddressError');
    
    console.log('Input value:', ipInput);
    
    if (!ipInput) {
      console.log('No input - clearing validation');
      $(this).removeClass('is-invalid is-valid');
      errorDiv.text('');
      $('#ipValidationIcon').hide();
      $('#ipAddressSuccess').hide();
      $('#ipAddressExists').hide();
      return;
    }
    
    // Split by comma and check each IP
    const ipList = ipInput.split(',').map(ip => ip.trim()).filter(ip => ip.length > 0);
    console.log('IP list to check:', ipList);
    
    // Validate format for each IP
    const invalidIPs = ipList.filter(ip => !isValidIP(ip));
    if (invalidIPs.length > 0) {
      console.log('Invalid IPs found:', invalidIPs);
      $(this).removeClass('is-valid').addClass('is-invalid');
      errorDiv.text(`Invalid IP format: ${invalidIPs.join(', ')}`);
      $('#ipValidationIcon').hide();
      $('#ipAddressSuccess').hide();
      $('#ipAddressExists').hide();
        return;
      }
      
    console.log('All IPs format valid - checking existence...');
    // Check if any IP already exists
    checkMultipleIPsExist(ipList, $(this), errorDiv);
  });

  // Form submission
  $('#addDomainForm').on('submit', function(e) {
    const domainInput = $('#domainName').val().trim();
    if (!domainInput) {
      e.preventDefault();
      $('#domainName').addClass('is-invalid');
      return;
    }
    
    // If validation passes, allow normal form submission
    // Backend will handle redirect and flash messages
    const submitBtn = $(this).find('button[type="submit"]');
    submitBtn.prop('disabled', true).html('<i class="spinner-border spinner-border-sm me-1"></i>Adding...');
  });

  // Edit Domain Modal - Initialize Select2
  // Record Type — options are already rendered server-side, so no ajax
  // needed, just the Bootstrap 5 Select2 styling to match Tags/Systems.
  $('#editDomainRecordType').select2({
    theme: 'bootstrap-5',
    width: '100%',
    minimumResultsForSearch: Infinity,
    dropdownParent: $('#editDomainModal')
  });

  $('#editDomainTags').select2({
            theme: 'bootstrap-5',
    multiple: true,
            allowClear: true,
            width: '100%',
    dropdownParent: $('#editDomainModal'),
            ajax: {
              url: '/organize/api/tag',
              dataType: 'json',
      processResults: function(data) {
        return { results: data };
      }
    }
  });

  $('#editDomainSystems').select2({
            theme: 'bootstrap-5',
    multiple: true,
            allowClear: true,
            width: '100%',
    dropdownParent: $('#editDomainModal'),
            ajax: {
      url: '/system/api/system',
              dataType: 'json',
      processResults: function(data) {
        return { results: data };
      }
    }
  });


  $('#editDomainIpId').select2({
            theme: 'bootstrap-5',
            allowClear: true,
            width: '100%',
    dropdownParent: $('#editDomainModal'),
            ajax: {
              url: '/network/api/ip-addresses',
              dataType: 'json',
      processResults: function(data) {
        return { results: data };
      }
    }
  });

  // Edit Domain Modal - Load data when opened
  $('#editDomainModal').on('show.bs.modal', function(event) {
    const button = $(event.relatedTarget);
    const domainId = button.data('domain-id');
    const domain = button.data('domain');
    const description = button.data('description') || '';
    const recordType = button.data('record-type') || 'A';
    const ipId = button.data('ip-id') || '';
    const ipAddress = button.data('ip-address') || '';
    const tags = button.data('tags') || [];
    const systems = button.data('systems') || [];
    const contacts = button.data('contacts') || [];

    console.log('Edit Domain Modal opened with data:', {
      domainId, domain, description, recordType, ipId, ipAddress, tags, systems, contacts
    });

    // Set form action URL
    const actionUrl = `/network/domain/${domainId}`;
    $('#editDomainForm').attr('action', actionUrl);
    console.log('Form action set to:', actionUrl);

    // Populate form fields
    $('#editDomainName').val(domain);
    $('#editDomainDescription').val(description);
    $('#editDomainRecordType').val(recordType).trigger('change');

    // Load existing values for Select2 fields after a short delay
        setTimeout(() => {
      loadEditExistingValues(tags, systems, ipId, ipAddress);
    }, 100);
  });

  // Edit Domain Modal - Reset form when hidden
  $('#editDomainModal').on('hidden.bs.modal', function() {
    $('#editDomainForm')[0].reset();
    $('#editDomainTags, #editDomainSystems, #editDomainIpId').val(null).trigger('change');
  });

  // Edit Domain Form submission
  $('#editDomainForm').on('submit', function(e) {
    console.log('Edit Domain Form submitting...');
    
    // Get Domain ID from form action or data attribute
    const currentAction = $(this).attr('action');
    const domainId = currentAction.split('/').pop();
    
    // Set the correct form action URL with method indicator
    const correctAction = `/network/domain/${domainId}?_method=PUT`;
    $(this).attr('action', correctAction);
    
    console.log('Form action set to:', correctAction);
    console.log('Form method:', $(this).attr('method'));
    console.log('Method override in URL: ?_method=PUT');
    console.log('Note: Browser will show POST, but server will receive PUT due to method override');

    // Allow normal form submission - backend handles redirect
    const submitBtn = $(this).find('button[type="submit"]');
    submitBtn.prop('disabled', true).html('<i class="spinner-border spinner-border-sm me-1"></i>Updating...');
  });

  // Filter Domain Modal - Initialize Select2
  // Record Type — options are already rendered server-side, so no ajax
  // needed, just the Bootstrap 5 Select2 styling to match Tags/Systems.
  $('#filterDomainRecordType').select2({
    theme: 'bootstrap-5',
    placeholder: 'All Record Types',
    allowClear: true,
    width: '100%',
    dropdownParent: $('#filterDomainModal')
  });

  $('#filterDomainTags').select2({
            theme: 'bootstrap-5',
            placeholder: 'Select tag(s)',
            allowClear: true,
            width: '100%',
    dropdownParent: $('#filterDomainModal'),
            ajax: {
              url: '/organize/api/tag',
              dataType: 'json',
              delay: 250,
      data: function(params) {
        return { search: params.term };
      },
      processResults: function(data) {
        return { results: data };
      },
              cache: true
            }
          });

  $('#filterDomainSystems').select2({
        theme: 'bootstrap-5',
        placeholder: 'Select system(s)',
        allowClear: true,
        width: '100%',
    dropdownParent: $('#filterDomainModal'),
        ajax: {
          url: '/system/api/system',
          dataType: 'json',
          delay: 250,
      data: function(params) {
        return { search: params.term };
      },
      processResults: function(data) {
        return { results: data };
      },
          cache: true
        }
      });


  // Filter Domain Modal - Load existing filter values when opened
  $('#filterDomainModal').on('show.bs.modal', function() {
    console.log('Filter Domain Modal opened');
    
    // Load existing filter values
    setTimeout(() => {
      loadFilterExistingValues();
    }, 100);
  });

  // Filter Domain Modal - Reset form when hidden
  $('#filterDomainModal').on('hidden.bs.modal', function() {
    console.log('Filter Domain Modal hidden, resetting form');
    $('#filterDomainForm')[0].reset();
    $('#filterDomainTags, #filterDomainSystems, #filterDomainRecordType').val(null).trigger('change');
  });

  // Clear All Filters button
  $('#clearFilterBtnDomain').on('click', function() {
    // Clear all select2 values
    $('#filterDomainTags').val(null).trigger('change');
    $('#filterDomainSystems').val(null).trigger('change');
    $('#filterDomainRecordType').val(null).trigger('change');
    
    // Close modal
    $('#filterDomainModal').modal('hide');
    
    // Redirect to clean URL but preserve pageSize and search
    const currentPageSize = $('select[name="pageSize"]').val() || '10';
    const currentSearch = $('input[name="search"]').val() || '';
    let cleanUrl = '/network/domain';
    const params = [];
    if (currentPageSize && currentPageSize !== '10') params.push('pageSize=' + encodeURIComponent(currentPageSize));
    if (currentSearch) params.push('search=' + encodeURIComponent(currentSearch));
    if (params.length > 0) cleanUrl += '?' + params.join('&');
    window.location.href = cleanUrl;
  });

  // ==========================================
  // IMPORT DOMAIN
  // ==========================================
  let selectedDomainFile = null;

  $(document).on('change', '#domainImportFile', function() {
    selectedDomainFile = this.files[0];
    if (selectedDomainFile) {
      $('#validateDomainBtn').prop('disabled', false);
      $('#importDomainBtn').hide();
      $('#domainImportResults').hide();
    } else {
      $('#validateDomainBtn').prop('disabled', true);
      $('#importDomainBtn').hide();
    }
  });

  // Handle validate button click
  $(document).on('click', '#validateDomainBtn', function() {
    if (!selectedDomainFile) {
      alert('Please select a file first');
      return;
    }

    const formData = new FormData();
    formData.append('file', selectedDomainFile);

    $('#domainImportProgress').show();
    $('#domainImportResults').text('Validating file...');
    $('.progress-bar').css('width', '30%');

    let nativeXhr;
    $.ajax({
      url: '/network/domain/validate-import',
      type: 'POST',
      data: formData,
      processData: false,
      contentType: false,
      xhr: function() {
        nativeXhr = new window.XMLHttpRequest();
        nativeXhr.responseType = 'blob';
        return nativeXhr;
      },
      success: function(data, status, xhr) {
        $('.progress-bar').css('width', '100%');
        $('#domainImportResults').text('Validation complete! Downloading results...');

        const contentType = xhr.getResponseHeader('Content-Type');
        const contentDisposition = xhr.getResponseHeader('Content-Disposition');

        if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
          const blob = new Blob([data], { type: contentType });
          const url = window.URL.createObjectURL(blob);
          let filename = 'validation_results.xlsx';
          if (contentDisposition) {
            const filenameMatch = contentDisposition.match(/filename="(.+)"/);
            if (filenameMatch) filename = filenameMatch[1];
          }
          const a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          window.URL.revokeObjectURL(url);
        }

        const validationSummary = xhr.getResponseHeader('X-Validation-Summary');
        if (validationSummary) {
          try {
            const summary = JSON.parse(validationSummary);
            const resultsDiv = $('#domainImportResults');
            if (summary.allPassed) {
              resultsDiv.removeClass('alert-danger').addClass('alert-success')
                .html(`<strong>Validation Complete!</strong><br>
                       <small>Total: ${summary.total}, Passed: ${summary.passed}, Failed: ${summary.failed}</small><br>
                       <small>Validation file downloaded. Review results before importing.</small>`);
              $('#importDomainBtn').show();
            } else {
              resultsDiv.removeClass('alert-success').addClass('alert-danger')
                .html(`<strong>Validation Failed!</strong><br>
                       <small>Total: ${summary.total}, Passed: ${summary.passed}, Failed: ${summary.failed}</small><br>
                       <small>Validation file downloaded. Please fix the errors before importing.</small>`);
            }
            resultsDiv.show();
          } catch (e) {
            const resultsDiv = $('#domainImportResults');
            resultsDiv.removeClass('alert-danger').addClass('alert-success')
              .html(`<strong>Validation Complete!</strong><br>
                     <small>Validation file downloaded. Review results before importing.</small>`);
            resultsDiv.show();
            $('#importDomainBtn').show();
          }
        }
      },
      error: function(xhr, status, error) {
        $('.progress-bar').css('width', '100%').text('Validation Failed');
        extractImportErrorMessage(nativeXhr || xhr).then(function(msg) {
          $('#domainImportResults').removeClass('alert-success').addClass('alert-danger')
            .html('<strong>Validation Error!</strong><br>' + msg)
            .show();
        });
      },
      complete: function() {
        $('#validateDomainBtn').prop('disabled', false);
        setTimeout(() => {
          $('#domainImportProgress').hide();
        }, 2000);
      }
    });
  });

  // Handle import button click
  $(document).on('click', '#importDomainBtn', function() {
    if (!selectedDomainFile) {
      alert('Please select a file first');
      return;
    }

    const formData = new FormData();
    formData.append('file', selectedDomainFile);

    $('#domainImportProgress').show();
    $('#domainImportResults').text('Importing domains...');
    $('.progress-bar').css('width', '30%').text('Importing...');
    $('#importDomainBtn').prop('disabled', true);

    let nativeXhr;
    $.ajax({
      url: '/network/domain/import',
      type: 'POST',
      data: formData,
      processData: false,
      contentType: false,
      xhr: function() {
        nativeXhr = new window.XMLHttpRequest();
        nativeXhr.responseType = 'blob';
        return nativeXhr;
      },
      success: function(data, status, xhr) {
        $('#domainImportProgress .progress-bar').css('width', '100%').text('Import Complete');

        const contentType = xhr.getResponseHeader('Content-Type');
        const contentDisposition = xhr.getResponseHeader('Content-Disposition');

        if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
          const blob = new Blob([data], { type: contentType });
          const url = window.URL.createObjectURL(blob);
          let filename = 'import_results.xlsx';
          if (contentDisposition) {
            const filenameMatch = contentDisposition.match(/filename="(.+)"/);
            if (filenameMatch) filename = filenameMatch[1];
          }
          const a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          window.URL.revokeObjectURL(url);
        }

        const resultsDiv = $('#domainImportResults');
        let importSummary = null;
        try {
          const summaryHeader = xhr.getResponseHeader('X-Import-Summary');
          if (summaryHeader) importSummary = JSON.parse(summaryHeader);
        } catch (e) {}

        if (importSummary && importSummary.failed > 0) {
          resultsDiv.removeClass('alert-success').addClass('alert-danger')
            .html(`<strong>Import Completed with Errors!</strong><br>
                   <small>Total: ${importSummary.total}, Success: ${importSummary.success}, Failed: ${importSummary.failed}</small><br>
                   <small>Import results file downloaded. Page will refresh to show updated data.</small>`);
        } else {
          resultsDiv.removeClass('alert-danger').addClass('alert-success')
            .html(`<strong>Import Completed!</strong><br>
                   <small>Import results file downloaded. Page will refresh to show updated data.</small>`);
        }
        resultsDiv.show();

        $('#importDomainBtn').hide();

        setTimeout(() => {
          window.location.reload();
        }, 2000);
      },
      error: function(xhr, status, error) {
        $('#domainImportProgress .progress-bar').css('width', '100%').text('Import Failed');
        extractImportErrorMessage(nativeXhr || xhr).then(function(msg) {
          $('#domainImportResults').removeClass('alert-success').addClass('alert-danger')
            .html('<strong>Import Error!</strong><br>' + msg)
            .show();
        });
      },
      complete: function() {
        $('#importDomainBtn').prop('disabled', false);
        setTimeout(() => {
          $('#domainImportProgress').hide();
        }, 2000);
      }
    });
  });

  // Reset import modal when closed
  $('#importDomainModal').on('hidden.bs.modal', function() {
    $('#importDomainForm')[0].reset();
    selectedDomainFile = null;
    $('#validateDomainBtn').prop('disabled', true);
    $('#importDomainBtn').hide();
    $('#domainImportProgress').hide();
    $('#domainImportResults').hide();
    $('.progress-bar').css('width', '0%').text('');
  });
});

function loadFilterExistingValues() {
  console.log('Loading existing filter values...');
  
  // Get filter data from hidden div
  const filterDataEl = document.getElementById('filter-domain-data');
  if (!filterDataEl) {
    console.log('Filter data element not found');
    return;
  }
  
  try {
    const filterTags = JSON.parse(filterDataEl.dataset.tags || '[]');
    const filterSystems = JSON.parse(filterDataEl.dataset.systems || '[]');
    const filterStatus = JSON.parse(filterDataEl.dataset.status || '""');
    
    console.log('Filter data:', { filterTags, filterSystems, filterStatus });
    
    // Clear existing options first to avoid duplicates
