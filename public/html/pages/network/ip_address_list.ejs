      resultsDiv.removeClass('alert-danger').addClass('alert-success')
        .html(`<strong>Import Completed!</strong><br>
               <small>Import results file downloaded. Page will refresh to show updated data.</small>`);
      resultsDiv.show();
      
      // Hide import button
      $('#importIpBtn').hide();
      
      // Refresh page after 2 seconds
      setTimeout(() => {
        window.location.reload();
      }, 2000);
    },
    error: function(xhr, status, error) {
      console.error('Import error:', xhr.responseText);
      console.error('Status:', xhr.status);
      console.error('Error:', error);
      
      $('#ipImportProgress .progress-bar').css('width', '100%').text('Import Failed');
