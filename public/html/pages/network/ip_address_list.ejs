<link rel="stylesheet" href="/css/custom.css">

<%
// Helper function to build pagination URL with all query parameters
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Add page
  params.set('page', targetPage);
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add pageSize if exists
  if (typeof pageSize !== 'undefined' && pageSize) {
    params.set('pageSize', pageSize);
  }
  
  // Add status filter if exists
  if (typeof filterStatus !== 'undefined' && filterStatus) {
    params.set('status', filterStatus);
  }
  
  // Add tags filter if exists
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => {
      params.append('tags[]', tag.id);
    });
  }
  
  // Add systems filter if exists
  if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) {
    filterSystems.forEach(system => {
      params.append('systems[]', system.id);
    });
  }
  
  // Add contacts filter if exists
  if (typeof filterContacts !== 'undefined' && filterContacts && filterContacts.length > 0) {
    filterContacts.forEach(contact => {
      params.append('contacts[]', contact.id);
    });
  }
  
  return '?' + params.toString();
}

// Helper function to build export URL with all query parameters
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Add search if exists
  if (typeof search !== 'undefined' && search) {
    params.set('search', search);
  }
  
  // Add status filter if exists
  if (typeof filterStatus !== 'undefined' && filterStatus) {
    params.set('status', filterStatus);
  }
  
  // Add tags filter if exists
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => {
      params.append('tags[]', tag.id);
    });
  }
  
  // Add systems filter if exists
  if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) {
    filterSystems.forEach(system => {
      params.append('systems[]', system.id);
    });
  }
  
  // Add contacts filter if exists
  if (typeof filterContacts !== 'undefined' && filterContacts && filterContacts.length > 0) {
    filterContacts.forEach(contact => {
      params.append('contacts[]', contact.id);
    });
  }
  
  return '/network/ip-address/export' + (params.toString() ? '?' + params.toString() : '');
}
%>

<!-- Content Header -->
<div class="app-content-header">
<div class="container-fluid">
    <div class="row">
    <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">IP Address List</li>
        </ol>
        </div>
        </div>
      </div>
    </div>
  
<!-- Main content -->
<div class="app-content">
  <div class="container-fluid">
  <!-- Search and Page Size Row -->
  <div class="row mb-3">
    <div class="col-12">
      <div class="d-flex justify-content-end align-items-center gap-2">
        <form class="d-flex align-items-center gap-2" role="search" method="get" action="/network/ip-address">
          <!-- Hidden inputs to preserve filter values -->
          <input type="hidden" name="page" value="1">
          <% if (typeof filterStatus !== 'undefined' && filterStatus) { %>
            <input type="hidden" name="status" value="<%= filterStatus %>">
      <% } %>
          <% if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) { %>
            <% filterTags.forEach(function(tag) { %>
              <input type="hidden" name="tags[]" value="<%= tag.id %>">
            <% }); %>
          <% } %>
          <% if (typeof filterSystems !== 'undefined' && filterSystems && filterSystems.length > 0) { %>
            <% filterSystems.forEach(function(system) { %>
              <input type="hidden" name="systems[]" value="<%= system.id %>">
            <% }); %>
          <% } %>
          <% if (typeof filterContacts !== 'undefined' && filterContacts && filterContacts.length > 0) { %>
            <% filterContacts.forEach(function(contact) { %>
              <input type="hidden" name="contacts[]" value="<%= contact.id %>">
            <% }); %>
          <% } %>
          
          <div class="input-group input-group-sm" style="width: 250px;">
            <input class="form-control form-control-sm" type="search" name="search" placeholder="Search IP or Description..." aria-label="Search" value="<%= typeof search !== 'undefined' ? search : '' %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit" id="searchBtn"><i class="bi bi-search"></i></button>
            </div>
          <div class="d-flex align-items-center gap-1">
            <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
            <select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()" style="width: 80px;">
              <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>><%= size %></option>
                    <% }) %>
                  </select>
                </div>
              </form>
            </div>
          </div>
        </div>

    <!-- Action Buttons -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <% if (hasPermission && hasPermission('network.create')) { %>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addIpModal">
              <i class="bi bi-plus"></i> Add IP Address
              </button>
        <% } %>
      <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#filterIpModal">
        <i class="bi bi-funnel"></i> Filter
      </button>
          <% if (hasPermission && hasPermission('network.read')) { %>
            <a href="<%= buildExportUrl() %>" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> Export
            </a>
          <% } %>
          <% if (hasPermission && hasPermission('network.create')) { %>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#importIpModal">
              <i class="bi bi-upload"></i> Import IP
            </button>
          <% } %>
      </div>
              </div>
                  </div>

  <!-- Filter values for JS (an toàn cho EJS strict, giống System List) -->
  <div id="filter-ip-data"
        data-tags='<%= JSON.stringify(filterTags || []) %>'
        data-systems='<%= JSON.stringify(filterSystems || []) %>'
    data-contacts='<%= JSON.stringify(filterContacts || []) %>'
    data-status='<%= JSON.stringify(filterStatus || '') %>' style="display:none"></div>

  <!-- Flash Messages -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
      <i class="bi bi-check-circle me-2"></i><%= successMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
      <script>
      // Auto-hide success message after 5 seconds
            setTimeout(function() {
        const alert = document.getElementById('successAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 5000);
      </script>
  <% } %>
  
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <script>
      // Auto-hide error message after 8 seconds (longer for errors)
      setTimeout(function() {
        const alert = document.getElementById('errorAlert');
        if (alert) {
          const bsAlert = new bootstrap.Alert(alert);
          bsAlert.close();
        }
      }, 8000);
    </script>
  <% } %>

  <!-- IP Address List Table -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title mb-0">IP Address List</h3>
        </div>
        <div class="card-body table-responsive" style="overflow-x: auto;">
          <table class="table table-hover" id="ipTable">
            <thead>
              <tr>
                <th>No.</th>
                <th>IP Address</th>
                <th>Description</th>
                <th>Server/Device</th>
                <th>Status</th>
                <th>Tags</th>
                <th>Systems</th>
                <th>Contacts</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (ipList && ipList.length > 0) { %>
                <% ipList.forEach(function(ip, idx) { %>
                  <tr>
                    <td><%= (page - 1) * pageSize + idx + 1 %></td>
                    <td><%= ip.ip_address %></td>
                    <td>
                      <%
                        const description = ip.description || '-';
                        const cleanDescription = description.trim();
                        const shortDescription = cleanDescription.length > 50 ? cleanDescription.substring(0, 50) + '…' : cleanDescription;
                      %>
                      <span class="description-hover" data-description="<%= cleanDescription.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>" style="white-space: pre-line; cursor: help; position: relative; word-break: break-word;"><%= shortDescription %></span>
                    </td>
                    <td>
                      <% if (ip.server_name || ip.device_name) { %>
                        <div class="fw-bold">
                          <% if (ip.server_name) { %>
                            <a href="/server/server/list?page=1&search=<%= encodeURIComponent(ip.server_name) %>" class="text-decoration-none" target="_blank"><%= ip.server_name %></a>
                          <% } %>
                          <% if (ip.server_name && ip.device_name) { %> / <% } %>
                          <% if (ip.device_name) { %>
                            <a href="/device/device?page=1&search=<%= encodeURIComponent(ip.device_name) %>" class="text-decoration-none" target="_blank"><%= ip.device_name %></a>
                          <% } %>
                        </div>
                        <% if (ip.server_name && ip.device_name) { %>
                          <small class="text-muted">Server / Device</small>
                        <% } else if (ip.server_name) { %>
                          <small class="text-muted">Server</small>
                        <% } else { %>
                          <small class="text-muted">Device</small>
                        <% } %>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><span class="badge bg-<%= ip.status === 'active' ? 'success' : 'secondary' %>"><%= ip.status %></span></td>
                    <td>
                      <% if (ip.tags && ip.tags.length > 0) { %>
                        <% ip.tags.forEach(function(tag) { %>
                          <span class="badge bg-primary me-1"><%= typeof tag === 'string' ? tag : tag.name %></span>
                          <% }) %>
                      <% } else { %>
                        <span class="text-muted">No tags</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (ip.systems && ip.systems.length > 0) { %>
                        <% ip.systems.forEach(function(system) { %>
                          <span class="badge bg-info me-1"><%= typeof system === 'string' ? system : system.name %></span>
                          <% }) %>
                      <% } else { %>
                        <span class="text-muted">No systems</span>
                            <% } %>
                    </td>
                    <td>
                              <% if (ip.contacts && ip.contacts.length > 0) { %>
                        <% ip.contacts.forEach(function(contact) { %>
                          <span class="badge bg-warning me-1"><%= typeof contact === 'string' ? contact : (contact.name || contact.email) %></span>
                          <% }) %>
                      <% } else { %>
                                <span class="text-muted">No contacts</span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <button type="button" class="btn btn-info btn-sm" title="Show" onclick="showIpDetail('<%= ip.id %>')" data-ip='<%= JSON.stringify(ip) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('network.update')) { %>
                      <button type="button" class="btn btn-warning btn-sm" title="Edit" 
                              data-bs-toggle="modal" data-bs-target="#editIpModal"
                              data-ip-id="<%= ip.id %>"
                              data-ip-address="<%= ip.ip_address %>"
                              data-description="<%= ip.description || '' %>"
                              data-status="<%= ip.status %>"
                              data-tags="<%= JSON.stringify(ip.tags || []) %>"
                              data-systems="<%= JSON.stringify(ip.systems || []) %>"
                              data-contacts="<%= JSON.stringify(ip.contacts || []) %>">
                        <i class="bi bi-pencil"></i>
                      </button>
                              <% } %>
                      <% if (hasPermission('network.delete')) { %>
                      <form action="/network/ip-address/<%= ip.id %>?_method=DELETE" method="POST" style="display:inline" onsubmit="return confirmDeleteIp(this, '<%= ip.ip_address %>')">
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                              <% } %>
                    </td>
                  </tr>
                <% }) %>
                              <% } else { %>
                <tr><td colspan="9" class="text-center">No data</td></tr>
                              <% } %>
            </tbody>
          </table>
                        </div>
        <div class="card-footer clearfix">
          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <% 
                // Calculate pagination range like system list
                const ipStartItem = (page - 1) * pageSize + 1;
                const ipEndItem = Math.min(page * pageSize, totalCount || 0);
                const ipStartPage = Math.max(1, page - 2);
                const ipEndPage = Math.min(totalPages, page + 2);
              %>
              <span>Showing <%= ipStartItem %> - <%= ipEndItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> IP addresses</span>
            </div>
            <ul class="pagination pagination-sm m-0 float-end">
              <% 
                function buildIpFilterQuery() {
                  let params = [];
                  if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                  if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                  if (typeof filterTags !== 'undefined' && filterTags.length) filterTags.forEach(function(tag) { params.push('tags[]=' + encodeURIComponent(tag.id || tag)); });
                  if (typeof filterStatus !== 'undefined' && filterStatus) params.push('status=' + encodeURIComponent(filterStatus));
                  if (typeof filterSystems !== 'undefined' && filterSystems.length) filterSystems.forEach(function(system) { params.push('systems[]=' + encodeURIComponent(system.id || system)); });
                  if (typeof filterContacts !== 'undefined' && filterContacts.length) filterContacts.forEach(function(contact) { params.push('contacts[]=' + encodeURIComponent(contact.id || contact)); });
                  return params.join('&');
                }
                const ipFilterQuery = buildIpFilterQuery();
              %>
              <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page - 1 %><%= ipFilterQuery ? '&' + ipFilterQuery : '' %>" tabindex="-1">Previous</a>
              </li>
              <% if (ipStartPage > 1) { %>
                <li class="page-item"><a class="page-link" href="?page=1<%= ipFilterQuery ? '&' + ipFilterQuery : '' %>">1</a></li>
                <% if (ipStartPage > 2) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% } %>
              <% } %>
              <% for (let i = ipStartPage; i <= ipEndPage; i++) { %>
                <li class="page-item <%= i === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= i %><%= ipFilterQuery ? '&' + ipFilterQuery : '' %>"><%= i %></a></li>
              <% } %>
              <% if (ipEndPage < totalPages) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= ipFilterQuery ? '&' + ipFilterQuery : '' %>"><%= totalPages %></a></li>
              <% } %>
              <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= page + 1 %><%= ipFilterQuery ? '&' + ipFilterQuery : '' %>">Next</a>
              </li>
            </ul>
          </div>
        </div>
                  </div>
    </div>
  </div>
</div>

<!-- Add IP Modal -->
<div class="modal fade" id="addIpModal" tabindex="-1" aria-labelledby="addIpModalLabel">
  <div class="modal-dialog modal-lg">
                      <div class="modal-content">
      <form id="addIpForm" method="POST" action="/network/ip-address">
                        <div class="modal-header">
          <h5 class="modal-title" id="addIpModalLabel">Add IP Address</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label for="ipAddress" class="form-label">IP Address(es) <span class="text-danger">*</span></label>
              <small class="form-text text-muted">Enter multiple IP addresses separated by commas</small>
              <div class="position-relative">
                <input type="text" class="form-control" id="ipAddress" name="address" required placeholder="192.168.1.1, 192.168.1.2, 10.0.0.1">
                <div class="position-absolute top-50 end-0 translate-middle-y me-3" id="ipValidationIcon" style="display: none; pointer-events: none;">
                  <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                </div>
                            </div>
              <div class="invalid-feedback" id="ipAddressError"></div>
              <div class="valid-feedback" id="ipAddressSuccess" style="display: none;">
                <!-- Success message removed - only show green checkmark icon -->
              </div>
              <div class="text-danger small mt-1" id="ipAddressExists" style="display: none;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i><span id="ipExistsMessage"></span>
              </div>
            </div>
            <div class="col-12">
              <label for="ipDescription" class="form-label">Description</label>
              <textarea class="form-control" id="ipDescription" name="description" rows="3"></textarea>
                            </div>
            <div class="col-12">
              <label for="ipStatus" class="form-label">Status</label>
              <select class="form-select" id="ipStatus" name="status">
                <% if (typeof ipStatusOptions !== 'undefined' && ipStatusOptions.length > 0) { %>
                  <% ipStatusOptions.forEach(function(option) { %>
                    <option value="<%= option.value %>" <%= option.value === 'active' ? 'selected' : '' %>><%= option.label %></option>
                  <% }); %>
                              <% } else { %>
                  <option value="active" selected>Active</option>
                  <option value="inactive">Inactive</option>
                  <option value="reserved">Reserved</option>
                              <% } %>
                              </select>
                            </div>
            <div class="col-12">
              <label for="ipTags" class="form-label">Tags</label>
              <select id="ipTags" name="tags[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
                            </div>
            <div class="col-12">
              <label for="ipSystems" class="form-label">Systems</label>
              <select id="ipSystems" name="systems[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
                            </div>
            <div class="col-12">
              <label for="ipContacts" class="form-label">Contacts</label>
              <select id="ipContacts" name="contacts[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
                            </div>
                          </div>
                        </div>
                        <div class="modal-footer d-flex justify-content-end">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add IP Address</button>
                        </div>
                        </form>
                      </div>
                    </div>
                  </div>

<!-- Edit IP Modal -->
