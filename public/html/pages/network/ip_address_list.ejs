function loadFilterExistingValues() {
  console.log('Loading existing filter values...');
  
  // Get filter data from hidden div
  const filterDataEl = document.getElementById('filter-ip-data');
  if (!filterDataEl) {
    console.log('Filter data element not found');
    return;
  }
  
  try {
    const filterTags = JSON.parse(filterDataEl.dataset.tags || '[]');
    const filterSystems = JSON.parse(filterDataEl.dataset.systems || '[]');
    const filterContacts = JSON.parse(filterDataEl.dataset.contacts || '[]');
    
    console.log('Filter data:', { filterTags, filterSystems, filterContacts });
    
    // Clear existing options first to avoid duplicates
    $('#filterIpTags').find('option').remove();
    $('#filterIpSystems').find('option').remove();
    $('#filterIpContacts').find('option').remove();
    
    // Load tags
    if (filterTags && filterTags.length > 0) {
      filterTags.forEach(tag => {
        const option = new Option(tag.name, tag.id, true, true);
        $('#filterIpTags').append(option);
      });
      $('#filterIpTags').trigger('change');
    }
    
    // Load systems
    if (filterSystems && filterSystems.length > 0) {
      filterSystems.forEach(system => {
        const option = new Option(system.name, system.id, true, true);
        $('#filterIpSystems').append(option);
      });
      $('#filterIpSystems').trigger('change');
    }
    
    // Load contacts
    if (filterContacts && filterContacts.length > 0) {
      filterContacts.forEach(contact => {
        const option = new Option(contact.name, contact.id, true, true);
        $('#filterIpContacts').append(option);
      });
      $('#filterIpContacts').trigger('change');
    }
    
  } catch (e) {
    console.error('Error loading filter values:', e);
  }
}

function loadEditExistingValues(tags, systems, contacts) {
  console.log('Loading existing values:', { tags, systems, contacts });

  // Load existing tags
  if (tags && tags.length > 0) {
    try {
      const tagArray = typeof tags === 'string' ? JSON.parse(tags) : tags;
      console.log('Parsed tags:', tagArray);
      
      // For Select2, we need to create option elements first
      const tagOptions = tagArray.map(tag => {
        const id = typeof tag === 'object' ? tag.id : tag;
        const text = typeof tag === 'object' ? (tag.name || tag.text) : tag;
        return new Option(text, id, true, true);
      });
      
      $('#editIpTags').append(tagOptions).trigger('change');
      console.log('Tags loaded successfully');
    } catch (e) {
      console.log('Error parsing tags:', e);
    }
  }

  // Load existing systems
  if (systems && systems.length > 0) {
    try {
      const systemArray = typeof systems === 'string' ? JSON.parse(systems) : systems;
      console.log('Parsed systems:', systemArray);
      
      const systemOptions = systemArray.map(system => {
        const id = typeof system === 'object' ? system.id : system;
        const text = typeof system === 'object' ? (system.name || system.text) : system;
        return new Option(text, id, true, true);
      });
      
      $('#editIpSystems').append(systemOptions).trigger('change');
      console.log('Systems loaded successfully');
    } catch (e) {
      console.log('Error parsing systems:', e);
    }
  }

  // Load existing contacts
  if (contacts && contacts.length > 0) {
    try {
      const contactArray = typeof contacts === 'string' ? JSON.parse(contacts) : contacts;
      console.log('Parsed contacts:', contactArray);
      
