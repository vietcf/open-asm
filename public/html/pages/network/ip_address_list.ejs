<script>
// Auto-open Add IP modal when add=1 parameter is present
document.addEventListener('DOMContentLoaded', function() {
  // Check if add=1 parameter exists in URL
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('add') === '1') {
    // Wait a bit for Bootstrap to be fully loaded
    setTimeout(function() {
      const addIpModal = new bootstrap.Modal(document.getElementById('addIpModal'));
      addIpModal.show();
      
      // Clean up URL by removing the add parameter
      urlParams.delete('add');
      const newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
      window.history.replaceState({}, '', newUrl);
    }, 100);
  }
});
</script>

