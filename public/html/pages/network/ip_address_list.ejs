        .html('<strong>Import Error!</strong><br>' + (xhr.responseJSON?.error || xhr.responseText || 'Unknown error occurred'))
        .show();
    },
    complete: function() {
      $('#importIpBtn').prop('disabled', false);
      setTimeout(() => {
        $('#ipImportProgress').hide();
      }, 2000);
    }
  });
});

