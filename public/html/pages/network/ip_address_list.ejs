<%
  const f = filter;
  const NONE_OPTION = { id: '__none__', text: t('(Not set)') };
  const activeFilterCount = [f.status.length, f.tags.length, f.systems.length, f.contacts.length, f.zone, f.environment, f.subnet_id].filter(Boolean).length;
  const COLUMNS = [
    { key: 'ip', label: 'IP Address', def: true, fixed: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'owners', label: 'Server/Device', def: true },
    { key: 'status', label: 'Status', def: true },
    { key: 'subnet', label: 'Subnet', def: true },
    { key: 'zone', label: 'Zone' },
    { key: 'environment', label: 'Environment' },
    { key: 'tags', label: 'Tags', def: true },
    { key: 'systems', label: 'Systems', def: true },
    { key: 'contacts', label: 'Contacts' },
    { key: 'updated', label: 'Updated' },
  ];
  const owners = (ip) => {
    const list = [
      ...ip.servers.map(o => ({ ...o, kind: 'Server', url: '/server/server?search=' + encodeURIComponent(o.name) })),
      ...ip.devices.map(o => ({ ...o, kind: 'Device', url: '/device/device?search=' + encodeURIComponent(o.name) })),
    ];
    return list.length ? list.map(o => `<div><a href="${o.url}">${ui.esc(o.name)}</a> <small class="text-secondary">${o.role === 'vip' ? t('VIP on') + ' ' : ''}${t(o.kind)}</small></div>`).join('') : ui.dash;
  };
  // VIP is a property of the IP (shared by the servers / devices holding it)
  const isVip = (ip) => [...ip.servers, ...ip.devices].some(o => o.role === 'vip');
  const cell = (ip, key) => ({
    ip: `<span class="font-monospace">${ui.esc(ip.ip_address)}</span>${isVip(ip) ? ' <span class="badge text-bg-warning">VIP</span>' : ''}`,
    description: ui.clip(ip.description),
    owners: owners(ip),
    status: ip.status ? ui.chips([ui.optionLabel(statusOptions, ip.status)]) : ui.dash,
    subnet: ip.subnet ? `<a href="/network/subnet-address?search=${encodeURIComponent(ip.subnet.address)}" class="font-monospace small">${ui.esc(ip.subnet.address)}</a>` : ui.dash,
    zone: ui.text(ip.subnet?.zone),
    environment: ui.text(ip.subnet?.environment),
    tags: ui.chips(ip.tags.map(x => x.name)),
    systems: ui.chips(ip.systems.map(x => x.name)),
    contacts: ui.chips(ip.contacts.map(x => x.name)),
    updated: ui.date(ip.updated_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Network' }, { label: 'IP Address' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/network/ip-address">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <% if (subnetFilter) { %><input type="hidden" name="subnet_id" value="<%= subnetFilter.id %>"><% } %>
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by IP, description, tag, contact, system...',
              filtersId: 'ipFilters', activeFilterCount,
              columns: { tableId: 'ipTable', storageKey: 'openasm.ipList.columns', list: COLUMNS },
              exportUrl: '/network/ip-address/export' + currentQuery,
              importModal: hasPermission('ip_address.create') ? 'ipImportModal' : null,
              addUrl: hasPermission('ip_address.create') ? '/network/ip-address/add' : null, addLabel: 'Add IP Address' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="ipFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label small"><%= t('Status') %></label>
                <select name="status" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options([NONE_OPTION, ...statusOptions], f.status, { all: true }) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Zone') %></label>
                <select name="zone" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(zoneOptions.map(z => ({ id: z, text: z })), f.zone) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Environment') %></label>
                <select name="environment" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(environmentOptions.map(z => ({ id: z, text: z })), f.environment) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(tagOptions, f.tags) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Systems') %></label>
                <select name="systems" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/system/api/system" data-ids-url="/system/api/system/ids" data-selected='<%= JSON.stringify(f.systems) %>'></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Contacts') %></label>
                <select name="contacts" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>" data-none-option="true"
                        data-ajax-url="/organize/api/contact" data-ids-url="/organize/api/contact/ids" data-selected='<%= JSON.stringify(f.contacts) %>'></select>
              </div>
            </div>
            <% if (subnetFilter) { %>
              <div class="mt-2 small"><%= t('Subnet') %>: <span class="font-monospace"><%= subnetFilter.address %></span>
                <a href="/network/ip-address" class="ms-1" title="<%= t('Remove') %>"><i class="bi bi-x-circle"></i></a></div>
            <% } %>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="ipTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (ipList.length) { %>
              <% ipList.forEach(function (ip, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"><%- cell(ip, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showIpDetail(this)" data-record='<%= JSON.stringify(ip) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('ip_address.create')) { %>
                        <a href="/network/ip-address/<%= ip.id %>/duplicate" class="btn btn-sm btn-outline-secondary" title="<%= t('Duplicate') %>"><i class="bi bi-copy"></i></a>
                      <% } %>
                      <% if (hasPermission('ip_address.update')) { %>
                        <a href="/network/ip-address/<%= ip.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('ip_address.delete')) { %>
                        <form action="/network/ip-address/<%= ip.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: ip.ip_address }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-hdd-network', message: 'No IP addresses found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/network/ip-address',
                      actionUrl: hasPermission('ip_address.create') ? '/network/ip-address/add' : null, actionLabel: 'Add IP Address' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: ipList.length, summary: 'Showing {1} - {2} of {3} IP addresses' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'ipDetailModal' }) %>
<% if (hasPermission('ip_address.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'ipImportModal', title: 'Import IP Addresses', baseUrl: '/network/ip-address',
        instructions: ['One IP address per row', 'Tags, contacts and systems must already exist', 'Existing IP addresses are skipped'] }) %>
<% } %>

<script>
  const IP_STATUS = <%- jsonSafe(statusOptions) %>;
  function showIpDetail(button) {
    const ip = DV.record(button);
    if (!ip) return;
    const owners = [].concat(
      (ip.servers || []).map((o) => ({ ...o, kind: 'Server', url: '/server/server?search=' + encodeURIComponent(o.name) })),
      (ip.devices || []).map((o) => ({ ...o, kind: 'Device', url: '/device/device?search=' + encodeURIComponent(o.name) }))
    );
    const ownerHtml = (list) => list.map((o) => '<div><a href="' + o.url + '">' + DV.esc(o.name) + '</a> <small class="text-secondary">' + DV.esc(t(o.kind)) + '</small></div>').join('');
    // the IP is the VIP: badge after the IP, its holders under "VIP on Server/Device"
    const primary = owners.filter((o) => o.role !== 'vip');
    const vip = owners.filter((o) => o.role === 'vip');
    let body = DV.section('Overview', DV.rows(
      DV.multiline(ip.description) ? DV.field('Description', DV.multiline(ip.description)) : '',
      DV.field('Status', DV.text(DV.optionLabel(IP_STATUS, ip.status)) || DV.EMPTY),
      primary.length || !vip.length ? DV.field('Server/Device', ownerHtml(primary)) : '',
      vip.length ? DV.field('VIP on Server/Device', ownerHtml(vip)) : ''
    ));
    // every subnet the IP lies in, smallest first; details on hover
    body += DV.section('Subnet', '<div id="ipSubnets" class="text-secondary small detail-pad">' + DV.esc(t('Loading...')) + '</div>');
    body += DV.section('Links', DV.rows(
      DV.field('Tags', DV.chips((ip.tags || []).map((x) => x.name))),
      DV.field('Systems', DV.linkChips(ip.systems || [], (s) => '/system/system?search=' + encodeURIComponent(s.name))),
      DV.field('Contacts', DV.contacts(ip.contacts || []))
    ));
    body += DV.meta(ip);
    DV.open('ipDetailModal', { title: ip.ip_address, titleExtra: vip.length ? ' <span class="badge text-bg-warning align-middle">VIP</span>' : '', body, recordId: ip.id });
    DV.load('/network/api/subnets/containing?ip=' + encodeURIComponent(ip.ip_address), document.getElementById('ipSubnets'), renderSubnets);
  }

  function renderSubnets(subnets) {
    if (!Array.isArray(subnets) || !subnets.length) return '<span class="text-secondary">' + DV.esc(t('Not in any subnet')) + '</span>';
    return '<div class="table-responsive"><table class="table table-sm align-middle detail-table mb-0"><thead><tr><th>' + DV.esc(t('Subnet')) + '</th><th>' + DV.esc(t('Description')) + '</th></tr></thead><tbody>' +
      subnets.map((s) => '<tr><td class="text-nowrap"><a href="/network/subnet-address?search=' + encodeURIComponent(s.address) + '" target="_blank" rel="noopener noreferrer" class="subnet-hover-link font-monospace" data-subnet-id="' + DV.esc(s.id) + '">' + DV.esc(s.address) + '</a></td>' +
        '<td>' + (s.description ? '<span class="detail-truncate" title="' + DV.esc(s.description) + '">' + DV.esc(s.description) + '</span>' : DV.EMPTY) + '</td></tr>').join('') +
      '</tbody></table></div>';
  }
</script>
