      $('#editIpContacts').append(contactOptions).trigger('change');
      console.log('Contacts loaded successfully');
    } catch (e) {
      console.log('Error parsing contacts:', e);
    }
  }
}

function isValidIP(ip) {
  const ipRegex = /^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
  return ipRegex.test(ip);
}

function checkMultipleIPsExist(ipList, inputElement, errorDiv) {
  console.log('=== Starting IP existence check ===');
  console.log('IPs to check:', ipList);
  
  // Check each IP one by one
  let checkedCount = 0;
  let existingIPs = [];
  
  ipList.forEach((ip, index) => {
    console.log(`Checking IP ${index + 1}/${ipList.length}: ${ip}`);
    
    $.ajax({
      url: '/network/api/ip-addresses',
      type: 'GET',
      data: { search: ip },
      success: function(data) {
        console.log(`✓ IP ${ip} check response:`, data);
        
        // Debug: Show structure of first item if exists
        if (data.length > 0) {
          console.log(`First item structure:`, data[0]);
          console.log(`Available fields:`, Object.keys(data[0]));
        }
        
        // Check if this specific IP already exists
        // Backend returns: { id: ..., text: ip_address }
        const existingIP = data.find(item => item.text === ip);
        console.log(`Checking if IP ${ip} exists in response:`, existingIP);
        console.log(`Available items in response:`, data.map(item => ({ id: item.id, text: item.text })));
        
        if (existingIP) {
          console.log(`✗ IP ${ip} already exists!`);
          existingIPs.push(ip);
        } else {
          console.log(`✓ IP ${ip} is available`);
        }
        
        checkedCount++;
        console.log(`Progress: ${checkedCount}/${ipList.length} IPs checked`);
        
        // When all IPs are checked
        if (checkedCount === ipList.length) {
          console.log('=== All IPs checked ===');
          console.log('Existing IPs:', existingIPs);
          
          if (existingIPs.length > 0) {
            console.log('❌ Some IPs already exist - showing error');
            inputElement.removeClass('is-valid').addClass('is-invalid');
            errorDiv.text(''); // Clear format error
            $('#ipValidationIcon').hide();
            $('#ipAddressSuccess').hide();
            $('#ipAddressExists').show();
            $('#ipExistsMessage').text(`IP addresses already exist: ${existingIPs.join(', ')}`);
    } else {
            console.log('✅ All IPs are available - showing success');
            inputElement.removeClass('is-invalid').addClass('is-valid');
            errorDiv.text(''); // Clear error message
            $('#ipValidationIcon').show();
            $('#ipAddressSuccess').show();
            $('#ipAddressExists').hide();
          }
        }
      },
      error: function(xhr, status, error) {
        console.error(`❌ Error checking IP ${ip}:`, error);
        checkedCount++;
        
        // When all IPs are checked (including errors)
        if (checkedCount === ipList.length) {
          console.log('=== All IPs checked (with errors) ===');
          if (existingIPs.length > 0) {
            inputElement.removeClass('is-valid').addClass('is-invalid');
            errorDiv.text(''); // Clear format error
            $('#ipValidationIcon').hide();
            $('#ipAddressSuccess').hide();
            $('#ipAddressExists').show();
            $('#ipExistsMessage').text(`IP addresses already exist: ${existingIPs.join(', ')}`);
    } else {
            // Don't show error for API failure, just remove validation
            inputElement.removeClass('is-invalid is-valid');
            errorDiv.text(''); // Clear any error message
            $('#ipValidationIcon').hide();
            $('#ipAddressSuccess').hide();
            $('#ipAddressExists').hide();
          }
        }
      }
            });
          });
}

        
