// Function to check if an IP is in a subnet (CIDR notation)
function isIPInSubnet(ipAddress, subnetCIDR) {
  try {
    const [subnetIP, prefixLength] = subnetCIDR.split('/');
    const prefix = parseInt(prefixLength);
    
    console.log('Checking IP:', ipAddress, 'in subnet:', subnetCIDR);
    console.log('Subnet IP:', subnetIP, 'Prefix:', prefix);
    
    // Convert IPs to numbers
    const ipParts = ipAddress.split('.');
    const subnetParts = subnetIP.split('.');
    
    if (ipParts.length !== 4 || subnetParts.length !== 4) {
      console.log('Invalid IP format');
      return false;
    }
    
    const ip = (parseInt(ipParts[0]) << 24) + (parseInt(ipParts[1]) << 16) + (parseInt(ipParts[2]) << 8) + parseInt(ipParts[3]);
    const subnet = (parseInt(subnetParts[0]) << 24) + (parseInt(subnetParts[1]) << 16) + (parseInt(subnetParts[2]) << 8) + parseInt(subnetParts[3]);
    
    const mask = (0xFFFFFFFF << (32 - prefix)) >>> 0;
    
    const result = (ip & mask) === (subnet & mask);
    console.log('IP number:', ip, 'Subnet number:', subnet, 'Mask:', mask, 'Result:', result);
    
    return result;
  } catch (error) {
    console.error('Error in isIPInSubnet:', error);
    return false;
  }
}

// Function to load subnet information for an IP address
function loadSubnetInfoForIP(ipAddress, contentElement) {
  console.log('Loading subnet info for IP:', ipAddress);
  
  // Make AJAX call to find subnet containing this IP
  $.ajax({
    url: '/network/api/subnet-for-ip/' + encodeURIComponent(ipAddress),
    method: 'GET',
    dataType: 'json'
  }).done(function(response) {
    console.log('Subnet response received:', response);
    
    if (response.found && response.subnet) {
      console.log('Found matching subnet:', response.subnet);
      updateSubnetInfoInModal(contentElement, response.subnet);
    } else {
      console.log('No matching subnet found');
      updateSubnetInfoInModal(contentElement, null);
    }
  }).fail(function(xhr, status, error) {
    console.error('Error loading subnet information:', status, error);
    console.error('Response:', xhr.responseText);
    
    // Fallback: try with sample data for testing
    console.log('Trying with sample subnet data...');
    const sampleSubnets = [
      { address: '10.1.0.0/16', zone: 'BACKBONE', environment: 'DEV' },
      { address: '192.168.1.0/24', zone: 'OFFICE', environment: 'PROD' },
      { address: '172.16.0.0/12', zone: 'DMZ', environment: 'UAT' }
    ];
    
    let matchingSubnet = null;
    for (let subnet of sampleSubnets) {
      if (isIPInSubnet(ipAddress, subnet.address)) {
        console.log('Found matching sample subnet:', subnet);
        matchingSubnet = subnet;
        break;
      }
    }
    
    updateSubnetInfoInModal(contentElement, matchingSubnet);
  });
}

// Function to update subnet information in the modal (as plain text, no badges)
function updateSubnetInfoInModal(contentElement, subnetInfo) {
  const currentHTML = contentElement.innerHTML;
  
  if (subnetInfo) {
    // Zone as plain text
    let zoneHTML = '<div class="mb-2"><strong>Zone:</strong> ';
    if (subnetInfo.zone && subnetInfo.zone.trim()) {
      zoneHTML += String(subnetInfo.zone).trim();
      } else {
      zoneHTML += '<span class="text-muted">N/A</span>';
    }
    zoneHTML += '</div>';
    
    // Environment as plain text
    let environmentHTML = '<div class="mb-2"><strong>Environment:</strong> ';
    if (subnetInfo.environment && subnetInfo.environment.trim()) {
      environmentHTML += String(subnetInfo.environment).trim();
    } else {
      environmentHTML += '<span class="text-muted">N/A</span>';
    }
    environmentHTML += '</div>';
    
    // Subnet as plain text
    let subnetHTML = '<div class="mb-2"><strong>Subnet:</strong> ' + String(subnetInfo.address).trim() + '</div>';
    
    // Replace loading states with actual data
    let updatedHTML = currentHTML.replace(
      '<div class="mb-2"><strong>Zone:</strong> <span class="text-muted">Loading...</span></div>',
      zoneHTML
    );
    updatedHTML = updatedHTML.replace(
      '<div class="mb-2"><strong>Environment:</strong> <span class="text-muted">Loading...</span></div>',
      environmentHTML
    );
    updatedHTML = updatedHTML.replace(
      '<div class="mb-2"><strong>Subnet:</strong> <span class="text-muted">Loading...</span></div>',
      subnetHTML
    );
    
    contentElement.innerHTML = updatedHTML;
  } else {
    // No matching subnet found
    let updatedHTML = currentHTML.replace(
      '<div class="mb-2"><strong>Zone:</strong> <span class="text-muted">Loading...</span></div>',
      '<div class="mb-2"><strong>Zone:</strong> <span class="text-muted">N/A</span></div>'
    );
    updatedHTML = updatedHTML.replace(
      '<div class="mb-2"><strong>Environment:</strong> <span class="text-muted">Loading...</span></div>',
      '<div class="mb-2"><strong>Environment:</strong> <span class="text-muted">N/A</span></div>'
    );
    updatedHTML = updatedHTML.replace(
      '<div class="mb-2"><strong>Subnet:</strong> <span class="text-muted">Loading...</span></div>',
      '<div class="mb-2"><strong>Subnet:</strong> <span class="text-muted">N/A</span></div>'
    );
    
    contentElement.innerHTML = updatedHTML;
  }
}

function showSubnetDetail(subnetId) {
  const buttons = document.querySelectorAll('button[data-subnet]');
  let targetButton = null;
  
  for (let button of buttons) {
    const data = button.getAttribute('data-subnet');
    if (data) {
      try {
        const subnet = JSON.parse(data);
        if (subnet.id == subnetId) {
          targetButton = button;
          break;
        }
      } catch (e) {
        console.error('Error parsing subnet data:', e);
      }
    }
  }
  
  if (!targetButton) {
    alert('Subnet data not found');
    return;
  }
  
  const subnetData = targetButton.getAttribute('data-subnet');
  let subnet;
  try {
    subnet = JSON.parse(subnetData);
  } catch (e) {
    alert('Error parsing subnet data: ' + e.message);
    return;
  }
  
  const modalElement = document.getElementById('subnetDetailModal');
  const modal = new bootstrap.Modal(modalElement);
  const content = document.getElementById('subnetDetailContent');
  
  let html = '<div class="card"><div class="card-body">';
  html += '<div class="mb-2"><strong>Subnet Address:</strong> ' + String(subnet.address || 'N/A').trim() + '</div>';
  html += '<div class="mb-2"><strong>Description:</strong> ' + String(subnet.description || 'N/A').trim() + '</div>';
  html += '<div class="mb-2"><strong>Record Type:</strong> ' + String(subnet.environment || 'A').trim() + '</div>';
  
  if (subnet.ip && subnet.zone) {
    html += '<div class="mb-2"><strong>IP Address:</strong> ' + String(subnet.zone).trim() + '</div>';
  }
  
  if (subnet.tags && subnet.tags.length > 0) {
    html += '<div class="mb-2"><strong>Tags:</strong><br>';
    subnet.tags.forEach(function(tag) {
      const tagValue = (typeof tag === 'string' ? tag : tag.name);
      html += '<span class="badge bg-primary me-1 mb-1">' + String(tagValue).trim() + '</span>';
    });
    html += '</div>';
  }
  
  if (subnet.systems && subnet.systems.length > 0) {
    html += '<div class="mb-2"><strong>Systems:</strong><ul class="mb-0">';
    subnet.systems.forEach(function(system) {
      const systemValue = (typeof system === 'string' ? system : system.name);
      const searchUrl = '/system/system?search=' + encodeURIComponent(systemValue) + '&pageSize=2';
      html += '<li><a href="' + searchUrl + '" class="text-primary text-decoration-underline">' + 
              String(systemValue).trim() + '</a></li>';
    });
    html += '</ul></div>';
  }
  
  if (subnet.contacts && subnet.contacts.length > 0) {
    html += '<div class="mb-2"><strong>Contacts:</strong><ul class="mb-0">';
    subnet.contacts.forEach(function(contact) {
      let contactName = '';
      let contactEmail = '';
      
      if (typeof contact === 'string') {
        contactName = contact;
        contactEmail = '';
  } else {
        contactName = contact.name || '';
        contactEmail = contact.email || '';
      }
      
      // Create short email (remove @subnet part)
      let shortEmail = '';
      if (contactEmail && contactEmail.includes('@')) {
        shortEmail = contactEmail.split('@')[0];
      }
      
      // Format: name (shortEmail) or just name if no email
      let displayText = contactName;
      if (shortEmail) {
        displayText += ' (' + shortEmail + ')';
      }
      
      // Create searchable link as simple text
      const searchUrl = '/organize/contact?search=' + encodeURIComponent(contactName);
      html += '<li><a href="' + searchUrl + '" class="text-primary text-decoration-underline">' + 
              String(displayText).trim() + '</a></li>';
    });
    html += '</ul></div>';
  }
  
  html += '</div></div>';
  content.innerHTML = html;
  modal.show();
}

// Import Subnet functionality
let selectedFile = null;

// Handle file selection
$(document).on('change', '#subnetImportFile', function() {
  selectedFile = this.files[0];
  if (selectedFile) {
    console.log('File selected:', selectedFile.name);
    $('#validateSubnetBtn').prop('disabled', false);
        } else {
    $('#validateSubnetBtn').prop('disabled', true);
    $('#importSubnetBtn').hide();
  }
});

// Handle validate button click
$(document).on('click', '#validateSubnetBtn', function() {
  if (!selectedFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedFile);
  
  // Show progress
  $('#subnetImportProgress').show();
  $('#subnetImportResults').text('Validating file...');
  $('.progress-bar').css('width', '30%');
  
  $.ajax({
    url: '/network/subnet-address/validate-import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      const xhr = new window.XMLHttpRequest();
      xhr.responseType = 'blob'; // Important for file download
      return xhr;
    },
    success: function(data, status, xhr) {
      $('.progress-bar').css('width', '100%');
      $('#subnetImportResults').text('Validation complete! Downloading results...');
      
      // Handle file download
      const contentType = xhr.getResponseHeader('Content-Type');
      const contentDisposition = xhr.getResponseHeader('Content-Disposition');
      
      if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
        // Create blob and download file
        const blob = new Blob([data], { type: contentType });
        const url = window.URL.createObjectURL(blob);
        
        // Extract filename from Content-Disposition header
        let filename = 'validation_results.xlsx';
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(/filename="(.+)"/);
          if (filenameMatch) {
            filename = filenameMatch[1];
          }
        }
        
        // Create download link
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Clean up
        window.URL.revokeObjectURL(url);
      }
      
      // Check validation results from header
      const validationSummary = xhr.getResponseHeader('X-Validation-Summary');
      if (validationSummary) {
        try {
          const summary = JSON.parse(validationSummary);
          const resultsDiv = $('#subnetImportResults');
          resultsDiv.removeClass('alert-danger').addClass('alert-success')
            .html(`<strong>Validation Complete!</strong><br>
                   <small>Total: ${summary.total}, Passed: ${summary.passed}, Failed: ${summary.failed}</small><br>
                   <small>Validation file downloaded. Review results before importing.</small>`);
          resultsDiv.show();
          
          // Show import button if validation passed
          if (summary.allPassed) {
            $('#importSubnetBtn').show();
          }
        } catch (e) {
          // Fallback if header parsing fails
          const resultsDiv = $('#subnetImportResults');
          resultsDiv.removeClass('alert-danger').addClass('alert-success')
            .html(`<strong>Validation Complete!</strong><br>
                   <small>Validation file downloaded. Review results before importing.</small>`);
          resultsDiv.show();
          $('#importSubnetBtn').show();
        }
      }
    },
    error: function(xhr, status, error) {
      console.error('Validation error:', xhr.responseText);
      console.error('Status:', xhr.status);
      console.error('Error:', error);
      
      $('.progress-bar').css('width', '100%').text('Validation Failed');
      $('#subnetImportResults').removeClass('alert-success').addClass('alert-danger')
        .html('<strong>Validation Error!</strong><br>' + (xhr.responseJSON?.error || xhr.responseText || 'Unknown error occurred'))
        .show();
      },
      complete: function() {
      $('#validateSubnetBtn').prop('disabled', false);
      setTimeout(() => {
        $('#subnetImportProgress').hide();
      }, 2000);
    }
  });
});

// Handle import button click
