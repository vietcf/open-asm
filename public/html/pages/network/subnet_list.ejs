// Global variables for IP pagination
let currentSubnetId = null;
let currentSubnetAddress = null;
let allIpAddresses = [];
let currentPage = 1;
const IP_PER_PAGE = 20;

// Renders a small donut chart of used vs. free IP capacity. totalIPs is the
// theoretical size of the /prefix (matches networkController.detailSubnet's
// own calculation) — not "usable host addresses", so it does not subtract
// the network/broadcast addresses for e.g. a /24.
function renderSubnetUsageChart(usedCount, subnetAddress) {
  const container = document.getElementById('subnetUsageChart');
  if (!container) return;

  const match = String(subnetAddress || '').match(/\/(\d{1,2})$/);
  if (!match) {
    container.innerHTML = '<div class="text-muted">Usage unavailable</div>';
    return;
  }
  const prefix = parseInt(match[1], 10);
  if (isNaN(prefix) || prefix < 0 || prefix > 32) {
    container.innerHTML = '<div class="text-muted">Usage unavailable</div>';
    return;
  }
  const totalIPs = Math.pow(2, 32 - prefix);
  const pct = totalIPs > 0 ? Math.min(100, Math.round((usedCount / totalIPs) * 100)) : 0;
  const freeCount = Math.max(0, totalIPs - usedCount);

  // Bootstrap success/warning/danger — same tiers as a disk/memory usage
  // gauge: comfortable, getting full, nearly exhausted.
  const statusColor = pct >= 90 ? '#dc3545' : (pct >= 70 ? '#fd7e14' : '#198754');

  const radius = 40;
  const circumference = 2 * Math.PI * radius;
  const dash = (pct / 100) * circumference;

  container.innerHTML = `
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <svg width="96" height="96" viewBox="0 0 96 96" role="img" aria-label="${pct} percent of subnet capacity used">
        <circle cx="48" cy="48" r="${radius}" fill="none" stroke="#e9ecef" stroke-width="10"></circle>
        <circle cx="48" cy="48" r="${radius}" fill="none" stroke="${statusColor}" stroke-width="10"
          stroke-linecap="round"
          stroke-dasharray="${dash} ${circumference - dash}"
          transform="rotate(-90 48 48)"></circle>
        <text x="48" y="46" text-anchor="middle" font-size="19" font-weight="700" fill="#212529">${pct}%</text>
        <text x="48" y="61" text-anchor="middle" font-size="9" fill="#6c757d">used</text>
      </svg>
      <div>
        <div><span class="badge rounded-pill" style="background-color:${statusColor};">&nbsp;</span> Used: <strong>${usedCount.toLocaleString()}</strong></div>
        <div><span class="badge rounded-pill bg-light border">&nbsp;</span> Free: <strong>${freeCount.toLocaleString()}</strong></div>
        <div class="text-muted small mt-1">Total capacity: ${totalIPs.toLocaleString()} addresses (/${prefix})</div>
      </div>
    </div>
  `;
}

// Function to load IP addresses for a subnet
function loadSubnetIpAddresses(subnetId, page = 1, subnetAddress) {
  currentSubnetId = subnetId;
  currentPage = page;
  if (subnetAddress !== undefined) {
    currentSubnetAddress = subnetAddress;
  }

  fetch(`/network/api/subnet/${subnetId}/ips`)
    .then(response => response.json())
    .then(data => {
      const ipListElement = document.getElementById('subnetIpList');
      if (data.success && data.data && data.data.length > 0) {
        allIpAddresses = data.data;
        displayIpAddresses(page);
      } else {
        allIpAddresses = [];
        ipListElement.innerHTML = '<div class="text-muted">No IP addresses found in this subnet.</div>';
      }
      renderSubnetUsageChart(allIpAddresses.length, currentSubnetAddress);
    })
    .catch(error => {
      console.error('Error loading subnet IP addresses:', error);
      const ipListElement = document.getElementById('subnetIpList');
      ipListElement.innerHTML = '<div class="text-danger">Error loading IP addresses.</div>';
      const chartElement = document.getElementById('subnetUsageChart');
      if (chartElement) chartElement.innerHTML = '<div class="text-danger">Usage unavailable.</div>';
    });
}

// Function to display IP addresses with pagination
function displayIpAddresses(page = 1) {
  const ipListElement = document.getElementById('subnetIpList');
  const startIndex = (page - 1) * IP_PER_PAGE;
  const endIndex = startIndex + IP_PER_PAGE;
  const currentPageData = allIpAddresses.slice(startIndex, endIndex);
  const totalPages = Math.ceil(allIpAddresses.length / IP_PER_PAGE);
  
  // Description column hidden below the sm breakpoint (~576px) so mobile
  // shows just the IP Address column instead of squeezing/scrolling.
  let html = '<div class="table-responsive"><table class="table table-sm table-striped">';
  html += '<thead><tr><th>IP Address</th><th class="d-none d-sm-table-cell">Description</th></tr></thead>';
  html += '<tbody>';

  currentPageData.forEach(function(ip) {
    const description = String(ip.description || 'N/A').trim();
    const truncatedDesc = description.length > 20 ? description.substring(0, 20) + '…' : description;

    html += '<tr>';
    html += '<td><a href="/network/ip-address?search=' + encodeURIComponent(ip.ip_address) + '" class="text-primary text-decoration-underline">' + String(ip.ip_address).trim() + '</a></td>';
    html += '<td class="d-none d-sm-table-cell">';
    // Same short-text + hover-tooltip pattern used for Description columns
    // elsewhere (Device/Domain/IP Address lists) — full text on hover
    // instead of a click-to-expand toggle.
    html += '<span data-bs-toggle="tooltip" data-bs-placement="top" title="' + escapeHtml(description) + '" style="cursor: help; word-break: break-word;">' + escapeHtml(truncatedDesc) + '</span>';
    html += '</td>';
    html += '</tr>';
  });

  html += '</tbody></table></div>';
  
  // Add pagination info and controls
  html += '<div class="d-flex justify-content-between align-items-center">';
  html += '<div class="text-muted small">';
  html += 'Showing ' + (startIndex + 1) + '-' + Math.min(endIndex, allIpAddresses.length) + ' of ' + allIpAddresses.length + ' IP addresses';
  html += '</div>';
  
  if (totalPages > 1) {
    html += '<div class="btn-group btn-group-sm" role="group">';
    
    // Previous button
    if (page > 1) {
      html += '<button type="button" class="btn btn-outline-secondary btn-sm" onclick="loadSubnetIpAddresses(' + currentSubnetId + ', ' + (page - 1) + ')">Previous</button>';
    }
    
    // Page numbers
    const startPage = Math.max(1, page - 2);
    const endPage = Math.min(totalPages, page + 2);
    
    for (let i = startPage; i <= endPage; i++) {
      const isActive = i === page ? 'btn-primary' : 'btn-outline-secondary';
      html += '<button type="button" class="btn ' + isActive + '" onclick="loadSubnetIpAddresses(' + currentSubnetId + ', ' + i + ')">' + i + '</button>';
    }
    
    // Next button
    if (page < totalPages) {
      html += '<button type="button" class="btn btn-outline-secondary btn-sm" onclick="loadSubnetIpAddresses(' + currentSubnetId + ', ' + (page + 1) + ')">Next</button>';
    }
    
    html += '</div>';
  }
  
  html += '</div>';
  
  ipListElement.innerHTML = html;

  // Dispose any tooltip instances from the previous render (pagination)
  // before creating new ones, so hidden/removed nodes don't leak instances.
  document.querySelectorAll('#subnetIpList [data-bs-toggle="tooltip"]').forEach(function(el) {
    const existing = bootstrap.Tooltip.getInstance(el);
    if (existing) existing.dispose();
  });
  document.querySelectorAll('#subnetIpList [data-bs-toggle="tooltip"]').forEach(function(el) {
    new bootstrap.Tooltip(el);
  });
}

function escapeHtml(str) {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// Function to download IP addresses list
function downloadSubnetIps(subnetId) {
  fetch(`/network/api/subnet/${subnetId}/ips`)
    .then(response => response.json())
    .then(data => {
      if (data.success && data.data && data.data.length > 0) {
        // Check if XLSX is available for Excel export
        if (typeof XLSX !== 'undefined') {
          // Create Excel workbook
          const workbook = XLSX.utils.book_new();
          
          // Prepare data for Excel
          const excelData = [
            ['IP Address', 'Description'] // Header row
          ];
          
          data.data.forEach(function(ip) {
            const ipAddress = String(ip.ip_address || '');
            const description = String(ip.description || '');
            
            excelData.push([ipAddress, description]);
          });
          
          // Create worksheet
          const worksheet = XLSX.utils.aoa_to_sheet(excelData);
          
          // Set column widths
          worksheet['!cols'] = [
            { width: 15 }, // IP Address column
            { width: 50 }  // Description column
          ];
          
          // Add worksheet to workbook
          XLSX.utils.book_append_sheet(workbook, worksheet, 'IP Addresses');
          
          // Generate Excel file and download
          const fileName = `subnet_ips_${subnetId}_${new Date().toISOString().split('T')[0]}.xlsx`;
          XLSX.writeFile(workbook, fileName);
        } else {
          // Fallback to CSV if XLSX is not available
          
          // Create CSV content
          let csvContent = 'IP Address,Description\n';
          
          data.data.forEach(function(ip) {
            const ipAddress = String(ip.ip_address || '').replace(/,/g, ';');
            const description = String(ip.description || '').replace(/,/g, ';').replace(/\n/g, ' ');
            
            csvContent += `"${ipAddress}","${description}"\n`;
          });
          
          // Create and download CSV file
          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          const link = document.createElement('a');
          const url = URL.createObjectURL(blob);
          link.setAttribute('href', url);
          link.setAttribute('download', `subnet_ips_${subnetId}_${new Date().toISOString().split('T')[0]}.csv`);
          link.style.visibility = 'hidden';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        }
      } else {
        alert('No IP addresses found in this subnet to download.');
      }
    })
    .catch(error => {
      console.error('Error downloading subnet IP addresses:', error);
      alert('Error downloading IP addresses list.');
    });
}

// Import Subnet functionality
let selectedFile = null;

// Handle file selection
$(document).on('change', '#subnetImportFile', function() {
  selectedFile = this.files[0];
  if (selectedFile) {
    $('#validateSubnetBtn').prop('disabled', false);
        } else {
    $('#validateSubnetBtn').prop('disabled', true);
    $('#importSubnetBtn').hide();
  }
});

// Handle validate button click
$(document).on('click', '#validateSubnetBtn', function() {
  if (!selectedFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedFile);
  
  // Show progress
  $('#subnetImportProgress').show();
  $('#subnetImportResults').text('Validating file...');
  $('.progress-bar').css('width', '30%');
  
  let nativeXhr;
  $.ajax({
    url: '/network/subnet-address/validate-import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      nativeXhr = new window.XMLHttpRequest();
      nativeXhr.responseType = 'blob'; // Important for file download
      return nativeXhr;
    },
    success: function(data, status, xhr) {
      $('.progress-bar').css('width', '100%');
      $('#subnetImportResults').text('Validation complete! Downloading results...');
      
      // Handle file download
      const contentType = xhr.getResponseHeader('Content-Type');
      const contentDisposition = xhr.getResponseHeader('Content-Disposition');
      
      if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
        // Create blob and download file
        const blob = new Blob([data], { type: contentType });
        const url = window.URL.createObjectURL(blob);
        
        // Extract filename from Content-Disposition header
        let filename = 'validation_results.xlsx';
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(/filename="(.+)"/);
          if (filenameMatch) {
            filename = filenameMatch[1];
          }
        }
        
        // Create download link
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Clean up
        window.URL.revokeObjectURL(url);
      }
      
      // Check validation results from header
      const validationSummary = xhr.getResponseHeader('X-Validation-Summary');
      if (validationSummary) {
        try {
          const summary = JSON.parse(validationSummary);
          const resultsDiv = $('#subnetImportResults');
          if (summary.allPassed) {
            resultsDiv.removeClass('alert-danger').addClass('alert-success')
              .html(`<strong>Validation Complete!</strong><br>
                     <small>Total: ${summary.total}, Passed: ${summary.passed}, Failed: ${summary.failed}</small><br>
                     <small>Validation file downloaded. Review results before importing.</small>`);
            $('#importSubnetBtn').show();
          } else {
            resultsDiv.removeClass('alert-success').addClass('alert-danger')
              .html(`<strong>Validation Failed!</strong><br>
                     <small>Total: ${summary.total}, Passed: ${summary.passed}, Failed: ${summary.failed}</small><br>
                     <small>Validation file downloaded. Please fix the errors before importing.</small>`);
          }
          resultsDiv.show();
        } catch (e) {
          // Fallback if header parsing fails
          const resultsDiv = $('#subnetImportResults');
          resultsDiv.removeClass('alert-danger').addClass('alert-success')
            .html(`<strong>Validation Complete!</strong><br>
                   <small>Validation file downloaded. Review results before importing.</small>`);
          resultsDiv.show();
          $('#importSubnetBtn').show();
        }
      }
    },
    error: function(xhr, status, error) {

      $('.progress-bar').css('width', '100%').text('Validation Failed');
      extractImportErrorMessage(nativeXhr || xhr).then(function(msg) {
        $('#subnetImportResults').removeClass('alert-success').addClass('alert-danger')
          .html('<strong>Validation Error!</strong><br>' + msg)
          .show();
      });
      },
      complete: function() {
      $('#validateSubnetBtn').prop('disabled', false);
      setTimeout(() => {
        $('#subnetImportProgress').hide();
      }, 2000);
    }
  });
});

// Handle import button click
$(document).on('click', '#importSubnetBtn', function() {
  if (!selectedFile) {
    alert('Please select a file first');
    return;
  }
  
  const formData = new FormData();
  formData.append('file', selectedFile);
  
  // Show progress
  $('#subnetImportProgress').show();
  $('#subnetImportResults').text('Importing subnets...');
  $('.progress-bar').css('width', '30%').text('Importing...');
  $('#importSubnetBtn').prop('disabled', true);
  
  let nativeXhr;
  $.ajax({
    url: '/network/subnet-address/import',
    type: 'POST',
    data: formData,
    processData: false,
    contentType: false,
    xhr: function() {
      nativeXhr = new window.XMLHttpRequest();
      nativeXhr.responseType = 'blob'; // Important for file download
      return nativeXhr;
    },
    success: function(data, status, xhr) {
      $('#subnetImportProgress .progress-bar').css('width', '100%').text('Import Complete');
      
      // Handle file download
      const contentType = xhr.getResponseHeader('Content-Type');
      const contentDisposition = xhr.getResponseHeader('Content-Disposition');
      
      if (contentType && contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
        // Create blob and download file
        const blob = new Blob([data], { type: contentType });
        const url = window.URL.createObjectURL(blob);
        
        // Extract filename from Content-Disposition header
        let filename = 'import_results.xlsx';
        if (contentDisposition) {
          const filenameMatch = contentDisposition.match(/filename="(.+)"/);
          if (filenameMatch) {
            filename = filenameMatch[1];
          }
        }
        
        // Create download link
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Clean up
        window.URL.revokeObjectURL(url);
      }
      
      // Show results - reflect actual success/failure counts, not just "it downloaded"
      const resultsDiv = $('#subnetImportResults');
      let importSummary = null;
      try {
        const summaryHeader = xhr.getResponseHeader('X-Import-Summary');
        if (summaryHeader) importSummary = JSON.parse(summaryHeader);
      } catch (e) {}

      if (importSummary && importSummary.failed > 0) {
        resultsDiv.removeClass('alert-success').addClass('alert-danger')
          .html(`<strong>Import Completed with Errors!</strong><br>
                 <small>Total: ${importSummary.total}, Success: ${importSummary.success}, Failed: ${importSummary.failed}</small><br>
                 <small>Import results file downloaded. Page will refresh to show updated data.</small>`);
      } else {
        resultsDiv.removeClass('alert-danger').addClass('alert-success')
          .html(`<strong>Import Completed!</strong><br>
                 <small>Import results file downloaded. Page will refresh to show updated data.</small>`);
      }
      resultsDiv.show();
      
      // Hide import button
      $('#importSubnetBtn').hide();
      
      // Refresh page after 2 seconds
      setTimeout(() => {
        window.location.reload();
      }, 2000);
    },
    error: function(xhr, status, error) {

      $('#subnetImportProgress .progress-bar').css('width', '100%').text('Import Failed');
      extractImportErrorMessage(nativeXhr || xhr).then(function(msg) {
        $('#subnetImportResults').removeClass('alert-success').addClass('alert-danger')
          .html('<strong>Import Error!</strong><br>' + msg)
          .show();
      });
    },
    complete: function() {
      $('#importSubnetBtn').prop('disabled', false);
      setTimeout(() => {
        $('#subnetImportProgress').hide();
      }, 2000);
    }
  });
});

