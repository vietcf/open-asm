    }
    
    // Load zone
    if (filterZone && filterZone.trim() !== '') {
      const zoneOption = new Option(filterZone, filterZone, true, true);
      $('#filterSubnetZone').append(zoneOption).trigger('change');
    }
    
    // Load environment
    if (filterEnvironment && filterEnvironment.trim() !== '') {
      const envOption = new Option(filterEnvironment, filterEnvironment, true, true);
      $('#filterSubnetEnvironment').append(envOption).trigger('change');
    }
    
  } catch (e) {
    console.error('Error loading filter values:', e);
  }
}

