  html += '<dt class="col-sm-4">Description</dt><dd class="col-sm-8"><pre class="mb-0" style="white-space: pre-wrap; font-family: inherit; background: none; border: none; padding: 0;">' + String(subnet.description || 'N/A').trim() + '</pre></dd>';
  html += '<dt class="col-sm-4">Zone</dt><dd class="col-sm-8">' + String(subnet.zone || 'N/A').trim() + '</dd>';
  html += '<dt class="col-sm-4">Environment</dt><dd class="col-sm-8">' + String(subnet.environment || 'N/A').trim() + '</dd>';

  if (subnet.tags && subnet.tags.length > 0) {
    html += '<dt class="col-sm-4">Tags</dt><dd class="col-sm-8">';
