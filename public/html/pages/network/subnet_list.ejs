function loadFilterExistingValues() {
  console.log('Loading existing filter values...');
  
  // Get filter data from hidden div
  const filterDataEl = document.getElementById('filter-subnet-data');
  if (!filterDataEl) {
    console.log('Filter data element not found');
    return;
  }
  
  try {
    const filterTags = JSON.parse(filterDataEl.dataset.tags || '[]');
    const filterZone = JSON.parse(filterDataEl.dataset.zone || '""');
    const filterEnvironment = JSON.parse(filterDataEl.dataset.environment || '""');
    
    console.log('Filter data:', { filterTags, filterZone, filterEnvironment });
    
    // Clear existing options first to avoid duplicates
    $('#filterSubnetTags').find('option').remove();
    $('#filterSubnetSystems').find('option').remove();
    $('#filterSubnetContacts').find('option').remove();
    $('#filterSubnetIpId').find('option').remove();
    
    // Load tags
    if (filterTags && filterTags.length > 0) {
      filterTags.forEach(tag => {
        const option = new Option(tag.name, tag.id, true, true);
        $('#filterSubnetTags').append(option);
      });
      $('#filterSubnetTags').trigger('change');
    }
    
    // Load systems
    if (filterSystems && filterSystems.length > 0) {
      filterSystems.forEach(system => {
        const option = new Option(system.name, system.id, true, true);
        $('#filterSubnetSystems').append(option);
      });
      $('#filterSubnetSystems').trigger('change');
    }
    
    // Load contacts
    if (filterContacts && filterContacts.length > 0) {
      filterContacts.forEach(contact => {
        const option = new Option(contact.name, contact.id, true, true);
        $('#filterSubnetContacts').append(option);
      });
      $('#filterSubnetContacts').trigger('change');
    }
    
    // Load IP addresses
    if (filterIpAddresses && filterIpAddresses.length > 0) {
      filterIpAddresses.forEach(ip => {
        const option = new Option(ip.ip_address, ip.id, true, true);
        $('#filterSubnetIpId').append(option);
      });
      $('#filterSubnetIpId').trigger('change');
    }
    
  } catch (e) {
    console.error('Error loading filter values:', e);
  }
}

function loadEditExistingValues(tags, systems, contacts, ipId, ipAddress) {
  console.log('Loading existing values:', { tags, systems, contacts, ipId, ipAddress });

  // Load existing IP
  if (ipId && ipAddress) {
    const option = new Option(ipAddress, ipId, true, true);
    $('#editSubnetIpId').append(option).trigger('change');
  }

  // Load existing tags
      if (tags && tags.length > 0) {
    try {
        const tagArray = typeof tags === 'string' ? JSON.parse(tags) : tags;
      console.log('Parsed tags:', tagArray);
      
      // For Select2, we need to create option elements first
        const tagOptions = tagArray.map(tag => {
          const id = typeof tag === 'object' ? tag.id : tag;
          const text = typeof tag === 'object' ? (tag.name || tag.text) : tag;
          return new Option(text, id, true, true);
        });
      
        $('#editSubnetTags').append(tagOptions).trigger('change');
      console.log('Tags loaded successfully');
    } catch (e) {
      console.log('Error parsing tags:', e);
    }
  }

  // Load existing systems
  if (systems && systems.length > 0) {
    try {
      const systemArray = typeof systems === 'string' ? JSON.parse(systems) : systems;
      console.log('Parsed systems:', systemArray);
      
      const systemOptions = systemArray.map(system => {
        const id = typeof system === 'object' ? system.id : system;
        const text = typeof system === 'object' ? (system.name || system.text) : system;
        return new Option(text, id, true, true);
      });
      
      $('#editSubnetSystems').append(systemOptions).trigger('change');
      console.log('Systems loaded successfully');
    } catch (e) {
      console.log('Error parsing systems:', e);
    }
  }

  // Load existing contacts
  if (contacts && contacts.length > 0) {
    try {
      const contactArray = typeof contacts === 'string' ? JSON.parse(contacts) : contacts;
      console.log('Parsed contacts:', contactArray);
      
      const contactOptions = contactArray.map(contact => {
        const id = typeof contact === 'object' ? contact.id : contact;
        const text = typeof contact === 'object' ? (contact.name || contact.email || contact.text) : contact;
        return new Option(text, id, true, true);
      });
      
      $('#editSubnetContacts').append(contactOptions).trigger('change');
      console.log('Contacts loaded successfully');
    } catch (e) {
      console.log('Error parsing contacts:', e);
    }
  }
}

function isValidIP(ip) {
  const ipRegex = /^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
  return ipRegex.test(ip);
}

function checkMultipleIPsExist(ipList, inputElement, errorDiv) {
  console.log('=== Starting IP existence check ===');
  console.log('IPs to check:', ipList);
  
  // Check each IP one by one
  let checkedCount = 0;
  let existingIPs = [];
  
  ipList.forEach((ip, index) => {
    console.log(`Checking IP ${index + 1}/${ipList.length}: ${ip}`);
    
    $.ajax({
      url: '/network/api/ip-addresses',
      type: 'GET',
      data: { search: ip },
      success: function(data) {
        console.log(`✓ IP ${ip} check response:`, data);
        
        // Debug: Show structure of first item if exists
        if (data.length > 0) {
          console.log(`First item structure:`, data[0]);
          console.log(`Available fields:`, Object.keys(data[0]));
        }
        
        // Check if this specific IP already exists
        // Backend returns: { id: ..., text: ip_address }
        const existingIP = data.find(item => item.text === ip);
        console.log(`Checking if IP ${ip} exists in response:`, existingIP);
        console.log(`Available items in response:`, data.map(item => ({ id: item.id, text: item.text })));
        
        if (existingIP) {
          console.log(`✗ IP ${ip} already exists!`);
          existingIPs.push(ip);
      } else {
          console.log(`✓ IP ${ip} is available`);
        }
        
        checkedCount++;
        console.log(`Progress: ${checkedCount}/${ipList.length} IPs checked`);
        
        // When all IPs are checked
        if (checkedCount === ipList.length) {
          console.log('=== All IPs checked ===');
          console.log('Existing IPs:', existingIPs);
          
