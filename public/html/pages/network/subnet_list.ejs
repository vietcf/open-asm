<%
  const f = filter;
  const NONE_OPTION = { id: '__none__', text: t('(Not set)') };
  const asOptions = (values) => [NONE_OPTION, ...values.map(v => ({ id: v, text: v }))];
  const activeFilterCount = [f.tags.length, f.zone, f.environment].filter(Boolean).length;
  const COLUMNS = [
    { key: 'address', label: 'Subnet Address', def: true, fixed: true },
    { key: 'description', label: 'Description', def: true },
    { key: 'zone', label: 'Zone', def: true },
    { key: 'environment', label: 'Environment', def: true },
    { key: 'gateway', label: 'Gateway', def: true },
    { key: 'usage', label: 'IP Addresses', def: true },
    { key: 'tags', label: 'Tags', def: true },
    { key: 'updated', label: 'Updated' },
  ];
  // usable addresses of an IPv4 prefix
  const capacity = (s) => { const p = Number(String(s.address).split('/')[1]); return p >= 0 && p <= 32 ? 2 ** (32 - p) : 0; };
  const usage = (s) => {
    const total = capacity(s);
    const pct = total ? Math.min(100, Math.round(s.ip_count / total * 100)) : 0;
    return `<a href="/network/ip-address?subnet_id=${s.id}" class="text-decoration-none" title="${t('View IP addresses')}"><span class="badge tag">${s.ip_count}</span></a>` +
      ` <small class="text-secondary">/ ${total.toLocaleString('en')} (${pct}%)</small>`;
  };
  const cell = (s, key) => ({
    address: `<span class="font-monospace">${ui.esc(s.address)}</span>`,
    description: ui.clip(s.description),
    zone: ui.text(s.zone),
    environment: ui.text(s.environment),
    gateway: s.gateway_ip_address ? ui.mono(s.gateway_ip_address) : ui.dash,
    usage: usage(s),
    tags: ui.chips(s.tags.map(x => x.name)),
    updated: ui.date(s.updated_at),
  })[key];
%>
<%- include('../../partials/ui/page_header', { breadcrumbs: [{ label: 'Network' }, { label: 'Subnet Address' }] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>

    <div class="card list-card">
      <form class="list-filter-form" method="get" action="/network/subnet-address">
        <input type="hidden" name="pageSize" value="<%= pageSize %>">
        <%- include('../../partials/ui/list_toolbar', {
              search, searchPlaceholder: 'Search by subnet, IP, description, zone...',
              filtersId: 'subnetFilters', activeFilterCount,
              columns: { tableId: 'subnetTable', storageKey: 'openasm.subnetList.columns', list: COLUMNS },
              exportUrl: '/network/subnet-address/export' + currentQuery,
              importModal: hasPermission('subnet.create') ? 'subnetImportModal' : null,
              addUrl: hasPermission('subnet.create') ? '/network/subnet-address/add' : null, addLabel: 'Add Subnet' }) %>
        <div class="collapse<%= activeFilterCount ? ' show' : '' %>" id="subnetFilters">
          <div class="list-filters">
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label small"><%= t('Zone') %></label>
                <select name="zone" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(asOptions(zoneOptions), f.zone) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Environment') %></label>
                <select name="environment" class="form-select js-filter" data-placeholder="<%= t('All') %>"><option value=""></option><%- ui.options(asOptions(environmentOptions), f.environment) %></select>
              </div>
              <div class="col-md-4">
                <label class="form-label small"><%= t('Tags') %></label>
                <select name="tags" class="form-select js-filter" multiple data-placeholder="<%= t('All') %>"><%- ui.options(tagOptions, f.tags) %></select>
              </div>
            </div>
            <% if (activeFilterCount) { %>
              <div class="mt-2 text-end"><a href="#" class="small" data-clear-filters><i class="bi bi-x-circle me-1"></i><%= t('Clear All Filters') %></a></div>
            <% } %>
          </div>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-hover align-middle table-stack" id="subnetTable">
          <thead>
            <tr>
              <th class="col-index">#</th>
              <% COLUMNS.forEach(function (c) { %><th data-col="<%= c.key %>"><%= t(c.label) %></th><% }) %>
              <th class="col-actions"><%= t('Actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (subnetList.length) { %>
              <% subnetList.forEach(function (s, idx) { %>
                <tr>
                  <td class="col-index"><%= (page - 1) * pageSize + idx + 1 %></td>
                  <% COLUMNS.forEach(function (c) { %><td data-col="<%= c.key %>" data-label="<%= t(c.label) %>"><%- cell(s, c.key) %></td><% }) %>
                  <td class="col-actions">
                    <div class="row-actions">
                      <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('Detail') %>" onclick="showSubnetDetail(this)" data-record='<%= JSON.stringify({ ...s, capacity: capacity(s) }) %>'><i class="bi bi-eye"></i></button>
                      <% if (hasPermission('subnet.update')) { %>
                        <a href="/network/subnet-address/<%= s.id %>/edit" class="btn btn-sm btn-outline-secondary" title="<%= t('Edit') %>"><i class="bi bi-pencil"></i></a>
                      <% } %>
                      <% if (hasPermission('subnet.delete')) { %>
                        <form action="/network/subnet-address/<%= s.id %>/delete" method="POST" data-confirm="<%= t('Delete {1}?', { 1: s.address }) %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary btn-delete" title="<%= t('Delete') %>"><i class="bi bi-trash"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="<%= COLUMNS.length + 2 %>">
                <%- include('../../partials/ui/empty_state', { icon: 'bi-diagram-2', message: 'No subnets found', filtered: activeFilterCount > 0 || !!search, clearUrl: '/network/subnet-address',
                      actionUrl: hasPermission('subnet.create') ? '/network/subnet-address/add' : null, actionLabel: 'Add Subnet' }) %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../../partials/ui/pagination', { page, totalPages, totalCount, pageSize, count: subnetList.length, summary: 'Showing {1} - {2} of {3} subnets' }) %>
    </div>
  </div>
</div>

<%- include('../../partials/ui/detail_modal', { id: 'subnetDetailModal' }) %>
<% if (hasPermission('subnet.create')) { %>
  <%- include('../../partials/ui/import_modal', { id: 'subnetImportModal', title: 'Import Subnets', baseUrl: '/network/subnet-address',
        instructions: ['One subnet per row in CIDR format (e.g. 192.168.1.0/24)', 'Tags must already exist', 'Existing subnets are skipped'] }) %>
<% } %>

<script>
  function showSubnetDetail(button) {
    const s = DV.record(button);
    if (!s) return;
    const pct = s.capacity ? Math.min(100, Math.round(s.ip_count / s.capacity * 100)) : 0;
    const usage = '<div class="d-flex align-items-center gap-2"><div class="progress flex-grow-1" style="height:8px" role="progressbar" aria-valuenow="' + pct + '" aria-valuemin="0" aria-valuemax="100">' +
      '<div class="progress-bar" style="width:' + pct + '%"></div></div><span class="small text-nowrap">' + s.ip_count + ' / ' + Number(s.capacity).toLocaleString('en') + ' (' + pct + '%)</span></div>';
    let body = DV.section('Overview', DV.rows(
      DV.multiline(s.description) ? DV.field('Description', DV.multiline(s.description)) : '',
      DV.field('Zone', DV.text(s.zone) || DV.EMPTY),
      DV.field('Environment', DV.text(s.environment) || DV.EMPTY),
      DV.field('Gateway', s.gateway_ip_address ? DV.ipLink(s.gateway_ip_address) : DV.EMPTY),
      DV.field('Tags', DV.chips((s.tags || []).map((x) => x.name)))
    ));
    body += DV.section('IP Addresses', DV.rows(
      DV.field('Usage', usage),
      DV.field('', '<a href="/network/ip-address?subnet_id=' + s.id + '"><i class="bi bi-list-ul me-1"></i>' + DV.esc(t('View IP addresses')) + '</a>' +
        ' &middot; <a href="/network/ip-address/export?subnet_id=' + s.id + '"><i class="bi bi-download me-1"></i>' + DV.esc(t('Export')) + '</a>')
    ));
    body += DV.meta(s);
    DV.open('subnetDetailModal', { title: s.address, body, recordId: s.id });
  }
</script>
