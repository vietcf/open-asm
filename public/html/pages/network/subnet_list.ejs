<link rel="stylesheet" href="/css/custom.css">

<!--
==========================================
SUBNET LIST PAGE - EJS TEMPLATE
==========================================
This template renders the subnet list page with search, filter, pagination,
and CRUD operations for subnet management.

Structure:
1. Helper Functions (EJS)
2. Page Header & Breadcrumb
3. Search & Filter Section
4. Action Buttons
5. Data Table
6. Pagination
7. Modals (Add, Edit, Detail, Filter, Import)
8. Styles & JavaScript
==========================================
-->

<%
// ==========================================
// HELPER FUNCTIONS
// ==========================================

/**
 * Build pagination URL with all query parameters
 * @param {number} targetPage - Target page number
 * @returns {string} - Complete URL with query parameters
 */
function buildPaginationUrl(targetPage) {
  const params = new URLSearchParams();
  
  // Core parameters
  params.set('page', targetPage);
  if (typeof search !== 'undefined' && search) params.set('search', search);
  if (typeof pageSize !== 'undefined' && pageSize) params.set('pageSize', pageSize);
  
  // Filter parameters
  if (typeof filterStatus !== 'undefined' && filterStatus) params.set('status', filterStatus);
  
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => params.append('tags[]', tag.id));
  }
  
  if (typeof filterZone !== 'undefined' && filterZone) params.set('zone', filterZone);
  if (typeof filterEnvironment !== 'undefined' && filterEnvironment) params.set('environment', filterEnvironment);
  
  return '?' + params.toString();
}

/**
 * Build export URL with all query parameters
 * @returns {string} - Complete export URL with query parameters
 */
function buildExportUrl() {
  const params = new URLSearchParams();
  
  // Core parameters
  if (typeof search !== 'undefined' && search) params.set('search', search);
  if (typeof filterStatus !== 'undefined' && filterStatus) params.set('status', filterStatus);
  
  // Filter parameters
  if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) {
    filterTags.forEach(tag => params.append('tags[]', tag.id));
  }
  
  if (typeof filterZone !== 'undefined' && filterZone) params.set('zone', filterZone);
  if (typeof filterEnvironment !== 'undefined' && filterEnvironment) params.set('environment', filterEnvironment);
  
  return '/network/subnet-address/export' + (params.toString() ? '?' + params.toString() : '');
}
%>

<!-- ==========================================
     PAGE HEADER & BREADCRUMB
     ========================================== -->
<div class="app-content-header">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Subnet List</li>
        </ol>
      </div>
    </div>
  </div>
</div>
  
<!-- ==========================================
     MAIN CONTENT AREA
     ========================================== -->
<div class="app-content">
  <div class="container-fluid">
    
    <!-- ==========================================
         SEARCH & FILTER SECTION
         ========================================== -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end align-items-center gap-2">
          <form class="d-flex align-items-center gap-2" role="search" method="get" action="/network/subnet-address">
            <!-- Hidden inputs to preserve filter values -->
            <input type="hidden" name="page" value="1">
            
            <!-- Filter Status -->
            <% if (typeof filterStatus !== 'undefined' && filterStatus) { %>
              <input type="hidden" name="status" value="<%= filterStatus %>">
            <% } %>
            
            <!-- Filter Tags -->
            <% if (typeof filterTags !== 'undefined' && filterTags && filterTags.length > 0) { %>
              <% filterTags.forEach(function(tag) { %>
                <input type="hidden" name="tags[]" value="<%= tag.id %>">
              <% }); %>
            <% } %>
            
            <!-- Filter Zone -->
            <% if (typeof filterZone !== 'undefined' && filterZone) { %>
              <input type="hidden" name="zone" value="<%= filterZone %>">
            <% } %>
            
            <!-- Filter Environment -->
            <% if (typeof filterEnvironment !== 'undefined' && filterEnvironment) { %>
              <input type="hidden" name="environment" value="<%= filterEnvironment %>">
            <% } %>
            
            
            <!-- Search Input -->
            <div class="input-group input-group-sm" style="width: 250px;">
              <input class="form-control form-control-sm" 
                     type="search" 
                     name="search" 
                     placeholder="Search Subnet or Description..." 
                     aria-label="Search" 
                     value="<%= typeof search !== 'undefined' ? search : '' %>">
              <button class="btn btn-outline-secondary btn-sm" type="submit">
                <i class="bi bi-search"></i>
              </button>
            </div>
            
            <!-- Page Size Selector -->
            <div class="d-flex align-items-center gap-1">
              <label class="form-label form-label-sm mb-0 text-muted">Show:</label>
              <select class="form-select form-select-sm" 
                      name="pageSize" 
                      onchange="this.form.submit()" 
                      style="width: 80px;">
                <% (pageSizeOptions || [10,20,50]).forEach(function(size) { %>
                  <option value="<%= size %>" <%= pageSize == size ? 'selected' : '' %>>
                    <%= size %>
                  </option>
                <% }) %>
              </select>
            </div>
          </form>
      </div>
    </div>
  </div>

    <!-- ==========================================
         ACTION BUTTONS
         ========================================== -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="d-flex justify-content-end gap-2">
          <!-- Add Subnet Button -->
          <% if (hasPermission && hasPermission('subnet.create')) { %>
            <button type="button" 
                    class="btn btn-primary btn-sm" 
                    data-bs-toggle="modal" 
                    data-bs-target="#addSubnetModal">
              <i class="bi bi-plus"></i> Add Subnet
            </button>
          <% } %>
          
          <!-- Filter Button -->
          <button type="button" 
                  class="btn btn-secondary btn-sm" 
                  data-bs-toggle="modal" 
                  data-bs-target="#filterSubnetModal">
            <i class="bi bi-funnel"></i> Filter
          </button>
          
          <!-- Export Button -->
          <% if (hasPermission && hasPermission('subnet.read')) { %>
            <a href="<%= buildExportUrl() %>" class="btn btn-info btn-sm">
              <i class="bi bi-download"></i> Export
            </a>
          <% } %>
          
          <!-- Import Subnet Button -->
          <% if (hasPermission && hasPermission('subnet.create')) { %>
            <button type="button" 
                    class="btn btn-success btn-sm" 
                    data-bs-toggle="modal" 
                    data-bs-target="#importSubnetModal">
              <i class="bi bi-upload"></i> Import Subnet
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ==========================================
         FILTER DATA FOR JAVASCRIPT
         ========================================== -->
    <div id="filter-subnet-data"
          data-tags='<%= JSON.stringify(filterTags || []) %>'
          data-zone='<%= JSON.stringify(filterZone || '') %>'
          data-environment='<%= JSON.stringify(filterEnvironment || '') %>' 
         style="display:none">
    </div>

    <!-- ==========================================
         FLASH MESSAGES
         ========================================== -->
    <!-- Success Message -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i><%= successMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
          const alert = document.getElementById('successAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 5000);
      </script>
    <% } %>
    
    <!-- Error Message -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i><%= errorMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      <script>
        // Auto-hide error message after 8 seconds (longer for errors)
        setTimeout(function() {
          const alert = document.getElementById('errorAlert');
          if (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
          }
        }, 8000);
      </script>
    <% } %>

    <!-- ==========================================
         DOMAIN LIST TABLE
         ========================================== -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title mb-0">Subnet List</h3>
          </div>
          <div class="card-body table-responsive" style="overflow-x: auto;">
            <table class="table table-hover" id="subnetTable">
              <thead>
                <tr>
                  <th>No.</th>
                  <th>Subnet Address</th>
                  <th>Description</th>
                  <th>Zone</th>
                  <th>Environment</th>
                  <th>Tags</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (subnetList && subnetList.length > 0) { %>
                  <% subnetList.forEach(function(subnet, idx) { %>
                    <tr>
                      <!-- Row Number -->
                      <td><%= (page - 1) * pageSize + idx + 1 %></td>
                      
                      <!-- Subnet Address -->
                      <td><strong><%= subnet.address %></strong></td>
                      
                      <!-- Description -->
                      <td>
                        <%
                          const description = subnet.description || '-';
                          const cleanDescription = description.trim();
                          const truncatedDesc = cleanDescription.length > 50 ? cleanDescription.substring(0, 50) + '…' : cleanDescription;
                        %>
                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="<%= cleanDescription %>" style="cursor: help; word-break: break-word;"><%= truncatedDesc %></span>
                      </td>
                      
                      <!-- Zone -->
                      <td>
                        <% if (subnet.zone) { %>
                          <span class="badge bg-primary"><%= subnet.zone %></span>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      
                      <!-- Environment -->
                      <td>
                        <% if (subnet.environment) { %>
                          <span class="badge bg-info"><%= subnet.environment %></span>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      
                      <!-- Tags -->
                      <td>
                        <% if (subnet.tags && subnet.tags.length > 0) { %>
                          <% subnet.tags.forEach(function(tag) { %>
                            <span class="badge bg-primary me-1">
                              <%= (typeof tag === 'string') ? tag : tag.name %>
                            </span>
                          <% }) %>
                        <% } else { %>
                          <span class="text-muted">No tags</span>
                        <% } %>
                      </td>
                      
                      
                      <!-- Actions -->
                      <td class="text-end">
                        <!-- View Button -->
                        <button type="button" 
                                class="btn btn-info btn-sm" 
                                title="Show" 
                                onclick="showSubnetDetail('<%= subnet.id %>')" 
                                data-subnet='<%= JSON.stringify(subnet) %>'>
                          <i class="bi bi-eye"></i>
                        </button>
                        
                        <!-- Edit Button -->
                        <% if (hasPermission('subnet.update')) { %>
                          <button type="button" class="btn btn-warning btn-sm" title="Edit" 
                                  data-bs-toggle="modal" data-bs-target="#editSubnetModal"
                                  data-subnet-id="<%= subnet.id %>"
                                  data-subnet="<%= subnet.address %>"
                                  data-description="<%= subnet.description || '' %>"
                                  data-zone="<%= subnet.zone || '' %>"
                                  data-environment="<%= subnet.environment || '' %>"
                                  data-tags="<%= JSON.stringify(subnet.tags || []) %>">
                            <i class="bi bi-pencil"></i>
                          </button>
                        <% } %>
                        
                        <!-- Delete Button -->
                        <% if (hasPermission('subnet.delete')) { %>
                          <form action="/network/subnet-address/<%= subnet.id %>?_method=DELETE" 
                                method="POST" 
                                style="display:inline" 
                                onsubmit="return confirmDeleteSubnet(this, '<%= subnet.address %>')">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center">No data</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <!-- ==========================================
               PAGINATION
               ========================================== -->
          <div class="card-footer clearfix">
            <div class="d-flex justify-content-between align-items-center px-3 py-2">
              <!-- Pagination Info -->
              <div>
                <% 
                  // Calculate pagination range
                  const startItem = (page - 1) * pageSize + 1;
                  const endItem = Math.min(page * pageSize, totalCount || 0);
                  const startPage = Math.max(1, page - 2);
                  const endPage = Math.min(totalPages, page + 2);
                %>
                <span>Showing <%= startItem %> - <%= endItem %> of <%= typeof totalCount !== 'undefined' ? totalCount : 0 %> subnets</span>
              </div>
              
              <!-- Pagination Controls -->
              <ul class="pagination pagination-sm m-0 float-end">
                <% 
                  // Build filter query for pagination links
                  function buildSubnetFilterQuery() {
                    let params = [];
                    if (typeof search !== 'undefined' && search) params.push('search=' + encodeURIComponent(search));
                    if (typeof pageSize !== 'undefined' && pageSize) params.push('pageSize=' + encodeURIComponent(pageSize));
                    if (typeof filterTags !== 'undefined' && filterTags.length) filterTags.forEach(function(tag) { params.push('tags[]=' + encodeURIComponent(tag.id || tag)); });
                    if (typeof filterStatus !== 'undefined' && filterStatus) params.push('status=' + encodeURIComponent(filterStatus));
                    if (typeof filterZone !== 'undefined' && filterZone) params.push('zone=' + encodeURIComponent(filterZone));
                    if (typeof filterEnvironment !== 'undefined' && filterEnvironment) params.push('environment=' + encodeURIComponent(filterEnvironment));
                    return params.join('&');
                  }
                  const subnetFilterQuery = buildSubnetFilterQuery();
                %>
                
                <!-- Previous Button -->
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" 
                     href="?page=<%= page - 1 %><%= subnetFilterQuery ? '&' + subnetFilterQuery : '' %>" 
                     tabindex="-1">Previous</a>
                </li>
                
                <!-- First Page -->
                <% if (startPage > 1) { %>
                  <li class="page-item">
                    <a class="page-link" 
                       href="?page=1<%= subnetFilterQuery ? '&' + subnetFilterQuery : '' %>">1</a>
                  </li>
                  <% if (startPage > 2) { %>
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                  <% } %>
                <% } %>
                
                <!-- Page Numbers -->
                <% for (let i = startPage; i <= endPage; i++) { %>
                  <li class="page-item <%= (i === page) ? 'active' : '' %>">
                    <a class="page-link" 
                       href="?page=<%= i %><%= subnetFilterQuery ? '&' + subnetFilterQuery : '' %>">
                      <%= i %>
                    </a>
                  </li>
                <% } %>
                
                <!-- Last Page -->
                <% if (endPage < totalPages) { %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                  <li class="page-item">
                    <a class="page-link" 
                       href="?page=<%= totalPages %><%= subnetFilterQuery ? '&' + subnetFilterQuery : '' %>">
                      <%= totalPages %>
                    </a>
                  </li>
                <% } %>
                
                <!-- Next Button -->
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" 
                     href="?page=<%= page + 1 %><%= subnetFilterQuery ? '&' + subnetFilterQuery : '' %>">Next</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================
     MODALS SECTION
     ========================================== -->

<!-- ==========================================
     ADD SUBNET MODAL
     ========================================== -->
<div class="modal fade" id="addSubnetModal" tabindex="-1" aria-labelledby="addSubnetModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addSubnetModalLabel">Add Subnet</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="addSubnetForm" action="/network/subnet-address" method="POST">
            <div class="mb-3">
              <label for="subnetAddress" class="form-label">Subnet Address <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="subnetAddress" name="address" placeholder="Subnet Address (e.g. 192.168.1.0/24)" required>
              <div class="invalid-feedback" id="subnetAddressError"></div>
              <div class="valid-feedback" id="subnetAddressSuccess"></div>
            </div>
            <div class="mb-3">
              <label for="subnetDescription" class="form-label">Description</label>
              <textarea class="form-control" id="subnetDescription" name="description" placeholder="Description" rows="4"></textarea>
                            </div>
            <div class="mb-3">
              <label for="subnetZone" class="form-label">Zone</label>
              <select class="form-control" id="subnetZone" name="zone" data-allow-custom="true"></select>
                            </div>
            <div class="mb-3">
              <label for="subnetEnvironment" class="form-label">Environment</label>
              <select class="form-control" id="subnetEnvironment" name="environment" data-allow-custom="true"></select>
                            </div>
            <div class="mb-3">
              <label for="addSubnetTags" class="form-label">Tags</label>
              <select id="addSubnetTags" name="tags[]" class="form-control" multiple></select>
            </div>
          </form>
          </div>
        <div class="modal-footer d-flex justify-content-end">
          <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm" form="addSubnetForm">Add Subnet</button>
        </div>
    </div>
  </div>
</div>

<!-- ==========================================
     EDIT SUBNET MODAL
     ========================================== -->
<div class="modal fade" id="editSubnetModal" tabindex="-1" aria-labelledby="editSubnetModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="editSubnetForm" method="POST" action="">
        <input type="hidden" name="page" value="<%= page %>">
        <div class="modal-header">
          <h5 class="modal-title" id="editSubnetModalLabel">Edit Subnet</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <!-- Subnet Address (Read-only) -->
            <div class="col-12">
              <label for="editSubnetName" class="form-label">Subnet Address <span class="text-danger">*</span></label>
              <input type="text" 
                     class="form-control" 
                     id="editSubnetName" 
                     name="subnet" 
                     readonly>
              <small class="form-text text-muted">Subnet address cannot be changed</small>
                </div>
            
            <!-- Description -->
            <div class="col-12">
              <label for="editSubnetDescription" class="form-label">Description</label>
              <textarea class="form-control"
                        id="editSubnetDescription"
                        name="description"
                        rows="3"
                        placeholder="Enter subnet description"></textarea>
            </div>
            
            <!-- Zone -->
            <div class="col-12">
              <label for="editSubnetZone" class="form-label">Zone</label>
              <select class="form-select" id="editSubnetZone" name="zone"></select>
            </div>
            
            <!-- Environment -->
            <div class="col-12">
              <label for="editSubnetEnvironment" class="form-label">Environment</label>
              <select id="editSubnetEnvironment" name="environment" class="form-select">
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
            <!-- Tags -->
            <div class="col-12">
              <label for="editSubnetTags" class="form-label">Tags</label>
              <select id="editSubnetTags" name="tags[]" class="form-select" multiple>
                <!-- Options will be loaded via AJAX -->
              </select>
            </div>
            
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Update Subnet</button>
        </div>
      </form>
    </div>
  </div>
</div>
        
<!-- ==========================================
     DOMAIN DETAIL MODAL
     ========================================== -->
<div class="modal fade" id="subnetDetailModal" tabindex="-1" aria-labelledby="subnetDetailModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="subnetDetailModalLabel">Subnet Detail</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
      <div class="modal-body" id="subnetDetailContent">
        <!-- Content will be loaded here -->
                  </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
                  </div>
                  
<!-- ==========================================
     FILTER SUBNET MODAL
     ========================================== -->
<div class="modal fade" id="filterSubnetModal" tabindex="-1" aria-labelledby="filterSubnetModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filterSubnetModalLabel">Filter Subnets</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="GET" action="/network/subnet-address" id="filterSubnetForm">
        <input type="hidden" name="page" value="1">
        <input type="hidden" name="pageSize" value="<%= typeof pageSize !== 'undefined' ? pageSize : 10 %>">
        
        <!-- Preserve current search term -->
        <% if (typeof search !== 'undefined' && search) { %>
          <input type="hidden" name="search" value="<%= search %>">
        <% } %>
        <div class="modal-body">
          <div class="row g-2">
            <!-- Zone Filter -->
            <div class="col-12 mb-2">
              <label for="filterSubnetZone" class="form-label">Zone</label>
              <select class="form-control" id="filterSubnetZone" name="zone">
                <option value="">All Zones</option>
              </select>
                  </div>
                  
            <!-- Environment Filter -->
            <div class="col-12 mb-2">
              <label for="filterSubnetEnvironment" class="form-label">Environment</label>
              <select class="form-control" id="filterSubnetEnvironment" name="environment">
                <option value="">All Environments</option>
              </select>
                  </div>
                  
            <!-- Tags Filter -->
            <div class="col-12 mb-2">
              <label class="form-label">Tags</label>
              <select id="filterSubnetTags" name="tags[]" class="form-control" multiple></select>
                  </div>
            
                </div>
                </div>
        <div class="modal-footer d-flex justify-content-between">
          <button type="button" class="btn btn-outline-danger" id="clearFilterBtnSubnet">Clear All Filters</button>
          <div>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Apply Filters</button>
              </div>
        </div>
      </form>
    </div>
          </div>
        </div>
        
<!-- ==========================================
     IMPORT SUBNET MODAL
     ========================================== -->
<div class="modal fade" id="importSubnetModal" tabindex="-1" aria-labelledby="importSubnetModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importSubnetModalLabel">Import Subnets</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
      <div class="modal-body">
        <form id="importSubnetForm" enctype="multipart/form-data">
          <!-- File Selection -->
          <div class="mb-3">
            <label for="subnetImportFile" class="form-label">Select File <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="file" 
                     class="form-control" 
                     id="subnetImportFile" 
                     name="file" 
                     accept=".csv,.xlsx,.xls" 
                     required>
              <a href="/network/subnet-address/template" class="btn btn-outline-info" download>
                <i class="bi bi-download"></i> Download Template
              </a>
            </div>
            <div class="form-text">Supported formats: CSV, Excel (.xlsx, .xls). Maximum file size: 10MB</div>
          </div>
          
          <!-- Import Instructions -->
          <div class="mb-3">
            <div class="alert alert-info">
              <h6><i class="bi bi-info-circle"></i> Import Instructions:</h6>
              <ul class="mb-0">
                <li>Click "Download Template" to get the Excel template with correct format</li>
                <li>Fill the template with your subnet data</li>
