    // Remove previous validation classes
    input.removeClass('is-valid is-invalid');
    errorDiv.text('');
    successDiv.text('');
    
    if (!subnetInput) {
      return;
    }
    
    // Validate format first
    const subnetRegex = /^\d{1,3}(\.\d{1,3}){3}\/\d{1,2}$/;
    if (!subnetRegex.test(subnetInput)) {
      input.addClass('is-invalid');
      errorDiv.text('Invalid subnet format. Please use format like 192.168.1.0/24');
      return;
    }
    
    // Validate IP address parts
    const [ipPart, cidrPart] = subnetInput.split('/');
    const ipParts = ipPart.split('.');
    const cidr = parseInt(cidrPart);
    
    // Check IP address validity
    let isValidIP = true;
    for (let part of ipParts) {
      const num = parseInt(part);
      if (isNaN(num) || num < 0 || num > 255) {
        isValidIP = false;
        break;
      }
    }
    
    if (!isValidIP) {
      input.addClass('is-invalid');
      errorDiv.text('Invalid IP address. Each octet must be between 0-255');
      return;
    }
    
    // Check CIDR validity
    if (isNaN(cidr) || cidr < 0 || cidr > 32) {
      input.addClass('is-invalid');
      errorDiv.text('Invalid CIDR. Must be between 0-32');
      return;
