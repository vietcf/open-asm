<%#
  Add / Edit Service Mapping.  mode: 'add' | 'edit', vs, copiedFrom (source name when duplicating), providerOptions, protocolOptions,
  directionOptions, scopeOptions, accessOptions, statusOptions,
  selected: { ip, domain, system [{id, text}], members [{id (ip_address_id), text, port, status}] }
  Provider, IP address, domain and backend IPs accept new values (typed); new IPs / domains are
  created in their inventories on save. Choosing a domain fills an empty IP with the domain's IP.
%>
<% const isEdit = mode === 'edit'; const v = vs || {}; const sel = selected || {};
   const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
   const accessMode = v.access_mode || 'full'; %>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'Network' }, { label: 'Service Mapping', href: '/network/service-mapping' }, { label: isEdit ? 'Edit Service Mapping' : 'Add Service Mapping' }
] }) %>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>
    <form id="smForm" class="card form-card" method="POST" action="<%= isEdit ? '/network/service-mapping/' + v.id + '/edit' : '/network/service-mapping/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit Service Mapping' : 'Add Service Mapping') %></h3>
      </div>
      <div class="card-body">
        <%- include('../../partials/ui/copied_from', { copiedFrom: locals.copiedFrom, hint: 'Enter the new port (and name, if needed).' }) %>
        <section class="form-section">
          <h4 class="form-section-title"><%= t('General information') %></h4>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-name"><%= t('Name') %></label>
              <input type="text" id="f-name" name="name" data-unique="service_mapping.name" data-unique-exclude="<%= v.id || '' %>" class="form-control" value="<%= v.name || '' %>" maxlength="255" placeholder="<%= t('Auto-generated from domain:port if empty') %>">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-system"><%= t('System') %></label>
              <select id="f-system" name="system_id" class="form-select js-select" data-ajax-url="/system/api/system"
                      data-placeholder="<%= t('Select system') %>" data-selected="<%= JSON.stringify(sel.system || []) %>"></select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="f-direction"><%= t('Direction') %> <span class="text-danger">*</span></label>
              <select id="f-direction" name="direction" class="form-select" required>
                <% directionOptions.forEach(function (d) { %>
                  <option value="<%= d %>" <%= (v.direction || 'inbound') === d ? 'selected' : '' %>><%= t(cap(d)) %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="f-scope"><%= t('Scope') %> <span class="text-danger">*</span></label>
              <select id="f-scope" name="scope" class="form-select" required>
                <% scopeOptions.forEach(function (s) { %>
                  <option value="<%= s %>" <%= (v.scope || 'public') === s ? 'selected' : '' %>><%= t(cap(s)) %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-domain"><%= t('Domain') %></label>
              <select id="f-domain" name="domain" class="form-select js-select" data-tags="true" data-ajax-url="/network/api/domain"
                      data-placeholder="<%= t('Select or type a domain, e.g. app.example.com') %>" data-selected="<%= JSON.stringify(sel.domain || []) %>"></select>
            </div>
            <%# In the order of the traffic, one group per line (w-100 breaks): who may connect (enforced by
                the provider or at the NAT IP), then provider - port - protocol, then IP - port - protocol %>
            <div class="w-100 mt-0" aria-hidden="true"></div>
            <div class="col-md-3">
              <label class="form-label" for="f-access"><%= t('Access') %></label>
              <select id="f-access" name="access_mode" class="form-select">
                <% accessOptions.forEach(function (a) { %>
                  <option value="<%= a %>" <%= accessMode === a ? 'selected' : '' %>><%= t(a === 'full' ? 'Full (any source)' : 'Limited IPs') %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-9" id="f-allowed-wrap"<%- accessMode === 'limited' ? '' : ' hidden' %>>
              <label class="form-label" for="f-allowed"><%= t('Allowed IPs') %></label>
              <textarea id="f-allowed" name="allowed_ips" class="form-control font-monospace" rows="2"
                        placeholder="<%= t('IP or CIDR, comma or one per line, e.g. 198.51.100.0/24') %>"><%= (v.allowed_ips || []).join('\n') %></textarea>
            </div>
            <div class="w-100 mt-0" aria-hidden="true"></div>
            <div class="col-md-6">
              <label class="form-label" for="f-provider"><%= t('Provider / Channel') %></label>
              <select id="f-provider" name="provider" class="form-select js-select"
                      data-placeholder="<%= t('CDN/WAF (Akamai, Cloudflare) or private channel (VPN, MPLS)') %>">
                <option value=""></option>
                <%- ui.options(providerOptions, v.provider) %>
              </select>
              <div class="form-text"><%= t('List configured in System Configuration > Network') %></div>
            </div>
            <div class="col-md-3 col-6">
              <label class="form-label" for="f-provider-port"><%= t('Provider port') %></label>
              <input type="number" id="f-provider-port" name="provider_port" class="form-control" value="<%= v.provider_port || '' %>" min="1" max="65535" placeholder="443">
            </div>
            <div class="col-md-3 col-6">
              <label class="form-label" for="f-provider-protocol"><%= t('Provider protocol') %></label>
              <select id="f-provider-protocol" name="provider_protocol" class="form-select">
                <option value=""></option>
                <% (protocolOptions || []).forEach(function (p) { %>
                  <option value="<%= p %>" <%= v.provider_protocol === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
            </div>
            <div class="w-100 mt-0" aria-hidden="true"></div>
            <div class="col-md-6">
              <label class="form-label" for="f-ip"><%= t('IP Address') %> <span class="text-danger">*</span></label>
              <select id="f-ip" name="ip_address" class="form-select js-select" data-tags="true" data-ajax-url="/network/api/ip-addresses/search-all"
                      data-placeholder="<%= t('Public / NAT / VIP / destination IP') %>" data-selected="<%= JSON.stringify(sel.ip || []) %>" required></select>
            </div>
            <div class="col-md-3 col-6">
              <label class="form-label" for="f-port"><%= t('Port') %> <span class="text-danger">*</span></label>
              <input type="number" id="f-port" name="port" class="form-control" value="<%= v.port || '' %>" min="1" max="65535" placeholder="443" required>
            </div>
            <div class="col-md-3 col-6">
              <label class="form-label" for="f-protocol"><%= t('Protocol') %> <span class="text-danger">*</span></label>
              <select id="f-protocol" name="protocol" class="form-select" required>
                <% (protocolOptions || []).forEach(function (p) { %>
                  <option value="<%= p %>" <%= (v.protocol || 'HTTPS') === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="f-description"><%= t('Description') %></label>
              <textarea id="f-description" name="description" class="form-control" rows="3" placeholder="<%= t('Enter description') %>"><%= v.description || '' %></textarea>
            </div>
          </div>
        </section>

        <section class="form-section" data-repeater id="smMembers">
          <h4 class="form-section-title"><%= t('Backend IPs') %></h4>
          <p class="text-body-secondary small mb-2" id="f-members-hint"></p>
          <div class="vstack gap-2" data-repeater-rows>
            <% (sel.members || []).forEach(function (m) { %>
              <div class="row g-2 align-items-start">
                <div class="col-md-6">
                  <select name="member_ip" class="form-select js-select" data-tags="true" data-ajax-url="/network/api/ip-addresses/search-all" data-placeholder="<%= t('Select backend IP') %>"
                          data-selected="<%= JSON.stringify([{ id: m.id, text: m.text }]) %>"></select>
                </div>
                <div class="col-md-2 col-5">
                  <input type="number" name="member_port" class="form-control" value="<%= m.port || '' %>" min="1" max="65535" placeholder="<%= t('Port') %>">
                </div>
                <div class="col-md-3 col-5">
                  <select name="member_status" class="form-select">
                    <% statusOptions.forEach(function (s) { %>
                      <option value="<%= s %>" <%= (m.status || 'active') === s ? 'selected' : '' %>><%= t(cap(s)) %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-1 col-2">
                  <button type="button" class="btn btn-outline-secondary w-100" data-repeater-remove title="<%= t('Remove') %>"><i class="bi bi-x-lg"></i></button>
                </div>
              </div>
            <% }) %>
          </div>
          <template data-repeater-template>
            <div class="row g-2 align-items-start">
              <div class="col-md-6">
                <select name="member_ip" class="form-select js-select" data-tags="true" data-ajax-url="/network/api/ip-addresses/search-all" data-placeholder="<%= t('Select backend IP') %>"></select>
              </div>
              <div class="col-md-2 col-5">
                <input type="number" name="member_port" class="form-control" min="1" max="65535" placeholder="<%= t('Port') %>">
              </div>
              <div class="col-md-3 col-5">
                <select name="member_status" class="form-select">
                  <% statusOptions.forEach(function (s) { %>
                    <option value="<%= s %>"><%= t(cap(s)) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-1 col-2">
                <button type="button" class="btn btn-outline-secondary w-100" data-repeater-remove title="<%= t('Remove') %>"><i class="bi bi-x-lg"></i></button>
              </div>
            </div>
          </template>
          <div class="mt-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-repeater-add><i class="bi bi-plus-lg"></i> <%= t('Add backend IP') %></button>
          </div>
        </section>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/network/service-mapping', submitLabel: isEdit ? 'Save Changes' : 'Add Service Mapping', record: v }) %>
    </form>
  </div>
</div>

<script>
  (function () {
    const access = document.getElementById('f-access');
    const wrap = document.getElementById('f-allowed-wrap');
    const direction = document.getElementById('f-direction');
    const hint = document.getElementById('f-members-hint');
    function sync() {
      const limited = access.value === 'limited';
      wrap.hidden = !limited;
      hint.textContent = direction.value === 'outbound'
        ? t('Internal servers that open the connection (source). IP / Port above is the destination.')
        : t('Backend servers that receive the traffic, with their internal port.');
    }
    // A chosen domain with a known IP fills the IP field when it is still empty
    $('#f-domain').on('select2:select', function (e) {
      const d = e.params.data;
      const $ip = $('#f-ip');
      if (!d.ip_id || $ip.val()) return;
      $ip.append(new Option(d.ip_address, d.ip_id, true, true)).trigger('change');
    });
    access.addEventListener('change', sync);
    direction.addEventListener('change', sync);
    sync();
  })();
</script>
