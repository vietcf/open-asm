<%#
  Add / Edit Service Mapping.  mode: 'add' | 'edit', vs, copiedFrom (source name when duplicating), flows [{id, label, icon, path}],
  providerOptions, partnerOptions, protocolOptions, accessOptions, statusOptions,
  selected: { ip, domain, system [{id, text}], partners [{address, partner, port, protocol, domain}], members [{id (ip_address_id), text, port, status}] }
  Partner IPs are picked from the IP inventory (the address is the value); one partner per row.
  The flow (direction-scope) comes right after name and system; it decides which parts show, their order (the traffic's)
  and their labels; IPs and the domain are picked from their inventories (never created here). Outbound flows: sources without port, one NAT / egress IP, each partner IP with its own port / protocol
  (and a free-text domain for internet connectivity).
%>
<% const isEdit = mode === 'edit'; const v = vs || {}; const sel = selected || {};
   const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
   const flow = (v.direction || 'inbound') + '-' + (v.scope || 'public');
   const accessMode = v.access_mode || 'full';
   const partnerRow = function (p) { p = p || {}; return { address: p.address || '', partner: p.partner || '', port: p.port || '', protocol: p.protocol || '', domain: p.domain || '' }; };
   // one partner IP row (one line): IP from the IP inventory, port / protocol (outbound), domain (internet connectivity), partner
   const partnerCells = function (r) {
     return '<div class="col-md-3"><select name="partner_ip" class="form-select js-select" data-ajax-url="/network/api/ip-addresses/search-all?value=address" data-placeholder="' + ui.esc(t('Select an IP from the IP inventory')) + '"' +
         ' data-selected="' + ui.esc(JSON.stringify(r.address ? [{ id: r.address, text: r.address }] : [])) + '" aria-label="' + ui.esc(t('IP')) + '"></select></div>' +
       '<div class="col-md-1 col-6 sm-port" data-flows="outbound-private outbound-public"><input type="number" name="partner_port" class="form-control" value="' + ui.esc(r.port) + '" min="1" max="65535" placeholder="' + ui.esc(t('Port')) + '"></div>' +
       '<div class="col-md-2 col-6" data-flows="outbound-private outbound-public"><select name="partner_protocol" class="form-select" aria-label="' + ui.esc(t('Protocol')) + '"><option value="">' + ui.esc(t('Protocol')) + '</option>' +
         (protocolOptions || []).map(function (pr) { return '<option value="' + ui.esc(pr) + '"' + (r.protocol === pr ? ' selected' : '') + '>' + ui.esc(pr) + '</option>'; }).join('') + '</select></div>' +
       '<div class="col-md-2" data-flows="outbound-public"><input type="text" name="partner_domain" class="form-control font-monospace" value="' + ui.esc(r.domain) + '" maxlength="253" placeholder="' + ui.esc(t('Domain (optional)')) + '"></div>' +
       // pick a partner, or type a name (kept on this row only)
       '<div class="col-md min-w-0"><select name="partner_name" class="form-select js-select" data-tags="true" data-placeholder="' + ui.esc(t('Pick or type a partner')) + '"><option value=""></option>' +
         ui.options(partnerOptions, r.partner ? [r.partner] : []) + '</select></div>' +
       '<div class="col-md-auto"><button type="button" class="btn btn-outline-secondary w-100" data-repeater-remove title="' + ui.esc(t('Remove')) + '"><i class="bi bi-x-lg"></i></button></div>';
   }; %>
<%- include('../../partials/ui/page_header', { breadcrumbs: [
  { label: 'Network' }, { label: 'Service Mapping', href: '/network/service-mapping' }, { label: isEdit ? 'Edit Service Mapping' : 'Add Service Mapping' }
] }) %>
<style>
  .sm-flow-pick .btn-check + label { text-align: left; height: 100%; }
  #smPartners .sm-port { min-width: 6.5rem; }
  #smPartners .min-w-0 { min-width: 0; }
  .sm-flow-pick .sm-flow-path { font-size: .75rem; color: var(--bs-secondary-color); }
  .btn-check:checked + label .sm-flow-path { color: inherit; opacity: .85; }
  /* parts are reordered per flow (flex order) and some are hidden: every shown part gets the same
     separator, instead of the DOM-order ".form-section + .form-section" rule */
  #smParts { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1.25rem; }
  #smParts > .form-section { border-top: 1px solid var(--bs-border-color); padding-top: 1.25rem; margin-top: 0; }
</style>

<div class="app-content">
  <div class="container-fluid">
    <%- include('../../partials/ui/flash') %>
    <form id="smForm" class="card form-card" method="POST" action="<%= isEdit ? '/network/service-mapping/' + v.id + '/edit' : '/network/service-mapping/add' %>">
      <div class="card-header form-card-header">
        <h3 class="card-title mb-0"><%= t(isEdit ? 'Edit Service Mapping' : 'Add Service Mapping') %></h3>
      </div>
      <div class="card-body">
        <%- include('../../partials/ui/copied_from', { copiedFrom: locals.copiedFrom, hint: 'Enter the new port (and name, if needed).' }) %>
        <section class="form-section">
          <h4 class="form-section-title"><%= t('General information') %></h4>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="f-name"><%= t('Name') %></label>
              <input type="text" id="f-name" name="name" data-unique="service_mapping.name" data-unique-exclude="<%= v.id || '' %>" class="form-control" value="<%= v.name || '' %>" maxlength="255" placeholder="<%= t('Auto-generated from domain:port if empty') %>">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="f-system"><%= t('System') %></label>
              <select id="f-system" name="system_id" class="form-select js-select" data-ajax-url="/system/api/system"
                      data-placeholder="<%= t('Select system') %>" data-selected="<%= JSON.stringify(sel.system || []) %>"></select>
            </div>
            <div class="col-12">
              <label class="form-label"><%= t('Flow') %> <span class="text-danger">*</span></label>
              <%# one row per direction %>
              <% [['inbound', 'Inbound', 'bi-box-arrow-in-down-right'], ['outbound', 'Outbound', 'bi-box-arrow-up-right']].forEach(function (dir) { %>
                <div class="small text-secondary fw-medium mt-2 mb-1"><i class="bi <%= dir[2] %> me-1"></i><%= t(dir[1]) %></div>
                <div class="row g-2 sm-flow-pick">
                  <% flows.filter(function (f) { return f.id.startsWith(dir[0] + '-'); }).forEach(function (f) { %>
                    <div class="col-md-4">
                      <input type="radio" class="btn-check" name="flow" id="flow-<%= f.id %>" value="<%= f.id %>" <%= flow === f.id ? 'checked' : '' %> autocomplete="off">
                      <label class="btn btn-outline-primary w-100" for="flow-<%= f.id %>">
                        <div class="fw-medium"><i class="bi <%= f.icon %> me-1"></i><%= t(f.label) %></div>
                        <div class="sm-flow-path"><%= t(f.path) %></div>
                      </label>
                    </div>
                  <% }) %>
                </div>
              <% }) %>
            </div>
          </div>
        </section>

        <%# Parts in the order of the traffic: data-flows = the flows showing it, data-order = its place per flow %>
        <div id="smParts">
          <%# --- partner IPs: allowed sources (inbound) or destinations with their own port / protocol (outbound) --- %>
          <section class="form-section mb-0" id="part-partners" data-flows="inbound-public inbound-private outbound-private outbound-public"
                   data-order='{"inbound-public":3,"inbound-private":1,"outbound-private":4,"outbound-public":3}'>
            <h4 class="form-section-title" data-cdn-label="<%= t('Who may connect (limited on the CDN)') %>" data-fw-label="<%= t('Who may connect (limited on the FW)') %>" data-label='{"inbound-public":"<%= t('Who may connect (limited on the CDN)') %>","inbound-private":"<%= t('Partner VPN IPs (source)') %>","outbound-private":"<%= t('Partner IPs (destination)') %>","outbound-public":"<%= t('Internet destinations') %>"}'></h4>
            <div class="row g-3 mb-2" id="f-access-wrap">
              <div class="col-md-4">
                <label class="form-label" for="f-access"><%= t('Access') %></label>
                <select id="f-access" name="access_mode" class="form-select">
                  <% accessOptions.forEach(function (a) { %>
                    <option value="<%= a %>" <%= accessMode === a ? 'selected' : '' %>><%= t(a === 'full' ? 'Internet-wide (any source)' : 'Limited to partner IPs') %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div data-repeater id="smPartners">
              <p class="text-body-secondary small mb-2" data-label='{"inbound-public":"<%= t('One partner IP per row (no CIDR range), with the partner name.') %>","inbound-private":"<%= t('One partner IP per row (no CIDR range), with the partner name.') %>","outbound-private":"<%= t('One partner IP per row with its own port and protocol (no CIDR range).') %>","outbound-public":"<%= t('One destination IP per row with its domain (optional), port and protocol (no CIDR range).') %>"}'></p>
              <div class="vstack gap-2" data-repeater-rows>
                <% (sel.partners || []).forEach(function (p) { %>
                  <div class="row g-2 align-items-start flex-md-nowrap"><%- partnerCells(partnerRow(p)) %></div>
                <% }) %>
              </div>
              <template data-repeater-template>
                <div class="row g-2 align-items-start flex-md-nowrap"><%- partnerCells(partnerRow({})) %></div>
              </template>
              <div class="mt-2"><button type="button" class="btn btn-outline-primary btn-sm" data-repeater-add><i class="bi bi-plus-lg"></i> <%= t('Add partner IP') %></button></div>
              <div class="form-text"><%= t('Partner IPs are picked from the IP inventory (add them there first). Pick a partner or type its name (configured partners are in System Configuration > Network).') %></div>
            </div>
          </section>

          <%# --- domain of the public / internal exposure (outbound destinations carry their own) --- %>
          <section class="form-section mb-0" data-flows="inbound-public inbound-internal" data-order='{"inbound-public":1,"inbound-internal":1}'>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="f-domain"><%= t('Domain (optional)') %></label>
                <select id="f-domain" name="domain" class="form-select js-select" data-ajax-url="/network/api/domain"
                        data-placeholder="<%= t('Select a domain from the domain inventory') %>" data-selected="<%= JSON.stringify(sel.domain || []) %>"></select>
              </div>
            </div>
          </section>

          <%# --- provider / channel: CDN (public exposure, with its own port / protocol), VPN / lease line (private flows) --- %>
          <section class="form-section mb-0" data-flows="inbound-public inbound-private outbound-private" data-order='{"inbound-public":2,"inbound-private":2,"outbound-private":3}'>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="f-provider" data-label='{"inbound-public":"<%= t('CDN / WAF (optional)') %>","inbound-private":"<%= t('VPN / Lease line') %>","outbound-private":"<%= t('VPN / Lease line') %>"}'></label>
                <select id="f-provider" name="provider" class="form-select js-select" data-placeholder="<%= t('CDN/WAF (Akamai, Cloudflare) or private channel (VPN, MPLS)') %>">
                  <option value=""></option>
                  <%- ui.options(providerOptions, v.provider) %>
                </select>
                <div class="form-text"><%= t('List configured in System Configuration > Network') %></div>
              </div>
              <%# a CDN listens on its own port / protocol; a VPN / lease line only carries the traffic to the NAT IP:port %>
              <div class="col-md-3 col-6" data-flows="inbound-public">
                <label class="form-label" for="f-provider-port"><%= t('Provider port') %></label>
                <input type="number" id="f-provider-port" name="provider_port" class="form-control" value="<%= v.provider_port || '' %>" min="1" max="65535" placeholder="443">
              </div>
              <div class="col-md-3 col-6" data-flows="inbound-public">
                <label class="form-label" for="f-provider-protocol"><%= t('Provider protocol') %></label>
                <select id="f-provider-protocol" name="provider_protocol" class="form-select">
                  <option value=""></option>
                  <% (protocolOptions || []).forEach(function (p) { %><option value="<%= p %>" <%= v.provider_protocol === p ? 'selected' : '' %>><%= p %></option><% }) %>
                </select>
              </div>
            </div>
          </section>

          <%# --- our IP (public / NAT service / NAT / egress, on its FW / LB device); inbound: its port / protocol --- %>
          <section class="form-section mb-0" data-flows="inbound-public inbound-internal inbound-private outbound-private outbound-public" data-order='{"inbound-public":4,"inbound-internal":2,"inbound-private":3,"outbound-private":2,"outbound-public":2}'>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="f-ip"><span data-label='{"inbound-public":"<%= t('Public IP') %>","inbound-internal":"<%= t('IP') %>","inbound-private":"<%= t('NAT service IP') %>","outbound-private":"<%= t('NAT IP') %>","outbound-public":"<%= t('Egress public IP') %>"}'></span> <span class="text-danger">*</span></label>
                <select id="f-ip" name="ip_address" class="form-select js-select" data-ajax-url="/network/api/ip-addresses/search-all"
                        data-placeholder="<%= t('Select an IP from the IP inventory') %>" data-selected="<%= JSON.stringify(sel.ip || []) %>"></select>
              </div>
              <div class="w-100 mt-0" aria-hidden="true"></div>
              <div class="col-md-3 col-6" data-flows="inbound-public inbound-internal inbound-private">
                <label class="form-label" for="f-port"><%= t('Port') %> <span class="text-danger">*</span></label>
                <input type="number" id="f-port" name="port" class="form-control" value="<%= v.port || '' %>" min="1" max="65535" placeholder="443" data-inbound-required>
              </div>
              <div class="col-md-3 col-6" data-flows="inbound-public inbound-internal inbound-private">
                <label class="form-label" for="f-protocol"><%= t('Protocol') %> <span class="text-danger">*</span></label>
                <select id="f-protocol" name="protocol" class="form-select" data-inbound-required>
                  <% (protocolOptions || []).forEach(function (p) { %><option value="<%= p %>" <%= (v.protocol || 'HTTPS') === p ? 'selected' : '' %>><%= p %></option><% }) %>
                </select>
              </div>
            </div>
          </section>

          <%# --- public exposure: optional NAT of the public IP to a private IP (e.g. a VIP on the LB) --- %>
          <section class="form-section mb-0" data-flows="inbound-public" data-order='{"inbound-public":5}'>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="f-nat-ip"><%= t('NAT to a private IP (optional)') %></label>
                <select id="f-nat-ip" name="nat_ip" class="form-select js-select" data-ajax-url="/network/api/ip-addresses/search-all"
                        data-placeholder="<%= t('Select an IP from the IP inventory') %>" data-selected="<%= JSON.stringify(sel.natIp || []) %>"></select>
                <div class="form-text"><%= t('Public IP → NAT → this private IP (e.g. a VIP on the LB) → backends') %></div>
              </div>
              <div class="col-md-3 col-6">
                <label class="form-label" for="f-nat-port"><%= t('Private port') %></label>
                <input type="number" id="f-nat-port" name="nat_port" class="form-control" value="<%= v.nat_port || '' %>" min="1" max="65535" placeholder="<%= t('Same as the public port') %>">
              </div>
            </div>
          </section>

          <%# --- members: backends with their port / protocol (inbound) or internal source IPs without port (outbound) --- %>
          <section class="form-section mb-0" data-repeater id="smMembers" data-flows="inbound-public inbound-internal inbound-private outbound-private outbound-public"
                   data-order='{"inbound-public":6,"inbound-internal":3,"inbound-private":4,"outbound-private":1,"outbound-public":1}'>
            <h4 class="form-section-title" data-label='{"inbound-public":"<%= t('Backend IPs') %>","inbound-internal":"<%= t('Backend IPs') %>","inbound-private":"<%= t('Backend IPs') %>","outbound-private":"<%= t('Internal IPs (source)') %>","outbound-public":"<%= t('Internal IPs (source)') %>"}'></h4>
            <div class="vstack gap-2" data-repeater-rows>
              <% (sel.members || []).forEach(function (m) { %>
                <div class="row g-2 align-items-start">
                  <div class="col-md-5">
                    <select name="member_ip" class="form-select js-select" data-ajax-url="/network/api/ip-addresses/search-all" data-placeholder="<%= t('Select IP') %>"
                            data-selected="<%= JSON.stringify([{ id: m.id, text: m.text }]) %>"></select>
                  </div>
                  <div class="col-md-2 col-4" data-flows="inbound-public inbound-internal inbound-private"><input type="number" name="member_port" class="form-control" value="<%= m.port || '' %>" min="1" max="65535" placeholder="<%= t('Port') %>"></div>
                  <div class="col-md-2 col-4" data-flows="inbound-public inbound-internal inbound-private">
                    <select name="member_protocol" class="form-select" aria-label="<%= t('Protocol') %>"><option value=""><%= t('Protocol') %></option><% (protocolOptions || []).forEach(function (p) { %><option value="<%= p %>" <%= m.protocol === p ? 'selected' : '' %>><%= p %></option><% }) %></select>
                  </div>
                  <div class="col-md-2 col-4">
                    <select name="member_status" class="form-select">
                      <% statusOptions.forEach(function (s) { %><option value="<%= s %>" <%= (m.status || 'active') === s ? 'selected' : '' %>><%= t(cap(s)) %></option><% }) %>
                    </select>
                  </div>
                  <div class="col-md-1 col-2"><button type="button" class="btn btn-outline-secondary w-100" data-repeater-remove title="<%= t('Remove') %>"><i class="bi bi-x-lg"></i></button></div>
                </div>
              <% }) %>
            </div>
            <template data-repeater-template>
              <div class="row g-2 align-items-start">
                <div class="col-md-5"><select name="member_ip" class="form-select js-select" data-ajax-url="/network/api/ip-addresses/search-all" data-placeholder="<%= t('Select IP') %>"></select></div>
                <div class="col-md-2 col-4" data-flows="inbound-public inbound-internal inbound-private"><input type="number" name="member_port" class="form-control" min="1" max="65535" placeholder="<%= t('Port') %>"></div>
                <div class="col-md-2 col-4" data-flows="inbound-public inbound-internal inbound-private">
                  <select name="member_protocol" class="form-select" aria-label="<%= t('Protocol') %>"><option value=""><%= t('Protocol') %></option><% (protocolOptions || []).forEach(function (p) { %><option value="<%= p %>"><%= p %></option><% }) %></select>
                </div>
                <div class="col-md-2 col-4">
                  <select name="member_status" class="form-select"><% statusOptions.forEach(function (s) { %><option value="<%= s %>"><%= t(cap(s)) %></option><% }) %></select>
                </div>
                <div class="col-md-1 col-2"><button type="button" class="btn btn-outline-secondary w-100" data-repeater-remove title="<%= t('Remove') %>"><i class="bi bi-x-lg"></i></button></div>
              </div>
            </template>
            <div class="mt-2"><button type="button" class="btn btn-outline-primary btn-sm" data-repeater-add><i class="bi bi-plus-lg"></i> <%= t('Add IP') %></button></div>
          </section>

          <section class="form-section mb-0" style="order: 99">
            <label class="form-label" for="f-description"><%= t('Description') %></label>
            <textarea id="f-description" name="description" class="form-control" rows="3" placeholder="<%= t('Enter description') %>"><%= v.description || '' %></textarea>
          </section>
        </div>
      </div>
      <%- include('../../partials/ui/form_actions', { cancelUrl: '/network/service-mapping', submitLabel: isEdit ? 'Save Changes' : 'Add Service Mapping', record: v }) %>
    </form>
  </div>
</div>

<script>
  (function () {
    const form = document.getElementById('smForm');
    const access = document.getElementById('f-access');
    const partnerList = document.getElementById('smPartners');
    const flowOf = () => (form.querySelector('input[name="flow"]:checked') || {}).value || 'inbound-public';
    function sync() {
      const flow = flowOf();
      const inbound = flow.startsWith('inbound');
      // parts (and fields, rows added later included) of this flow, in its order, with its labels
      form.querySelectorAll('[data-flows]').forEach((el) => { el.hidden = !el.dataset.flows.split(' ').includes(flow); });
      form.querySelectorAll('[data-order]').forEach((el) => { const o = JSON.parse(el.dataset.order); if (o[flow] !== undefined) el.style.order = o[flow]; });
      form.querySelectorAll('[data-label]').forEach((el) => { const l = JSON.parse(el.dataset.label); if (l[flow]) el.textContent = l[flow]; });
      // public exposure: the partner IPs are limited on the CDN, or on the FW without a CDN
      const allowTitle = form.querySelector('[data-cdn-label]');
      if (flow === 'inbound-public') allowTitle.textContent = $('#f-provider').val() ? allowTitle.dataset.cdnLabel : allowTitle.dataset.fwLabel;
      // Public exposure: Internet-wide or limited to partner IPs (on the CDN); private inbound is always limited to its partners
      document.getElementById('f-access-wrap').hidden = flow !== 'inbound-public';
      partnerList.hidden = flow === 'inbound-public' && access.value !== 'limited';
      // the mapping's port / protocol are inbound only (outbound ones are on each partner IP)
      form.querySelectorAll('[data-inbound-required]').forEach((el) => { el.required = inbound; });
    }
    // A chosen domain with a known IP fills an empty public IP (public exposure)
    $('#f-domain').on('select2:select', function (e) {
      const d = e.params.data;
      const $ip = $('#f-ip');
      if (flowOf() !== 'inbound-public' || !d.ip_id || $ip.val()) return;
      $ip.append(new Option(d.ip_address, d.ip_id, true, true)).trigger('change');
    });
    form.querySelectorAll('input[name="flow"]').forEach((r) => r.addEventListener('change', sync));
    access.addEventListener('change', sync);
    $('#f-provider').on('change', sync);
    // a row just added follows the flow too
    form.addEventListener('click', (e) => { if (e.target.closest('[data-repeater-add]')) setTimeout(sync); });
    sync();
  })();
</script>
