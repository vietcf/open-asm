<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t(title || 'Dashboard') %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  
  <!-- CSS Links - AdminLTE 4 Standard Order -->
  <link rel="stylesheet" href="/css/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/overlayscrollbars.min.css">
  <link rel="stylesheet" href="/css/source-sans-3.css">
  <link rel="stylesheet" href="/css/select2.min.css">
  <link rel="stylesheet" href="/css/select2-bootstrap-5-theme.min.css">
  <link rel="stylesheet" href="<%= asset(cssPath + 'adminlte.css') %>" />
  <link rel="stylesheet" href="<%= asset('/css/custom.css') %>">
  
  <!-- Load jQuery first -->
  <script src="/js/jquery-3.6.0.min.js"></script>
  <!-- Translations for page scripts: window.t('Delete') -->
  <script src="<%= i18nScript %>"></script>

</head>
<body class="layout-fixed sidebar-expand-lg sidebar-open">
  <!--begin::App Wrapper-->
  <div class="app-wrapper">
    <!--begin::Header-->
    <nav class="app-header navbar navbar-expand bg-body">
      <!--begin::Container-->
      <div class="container-fluid">
        <!--begin::Start Navbar Links-->
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
              <i class="bi bi-list"></i>
            </a>
          </li>
          <li class="nav-item d-none d-md-block">
            <a href="/" class="nav-link"><%= t('Home') %></a>
          </li>
        </ul>
        <!--end::Start Navbar Links-->

        <!--begin::End Navbar Links-->
        <ul class="navbar-nav ms-auto">
          <!--begin::Language Switcher-->
          <%- include('../partials/language_switcher') %>
          <!--end::Language Switcher-->
          <!--begin::User Account Menu-->
          <li class="nav-item dropdown">
            <a class="nav-link d-flex align-items-center" data-bs-toggle="dropdown" href="#" id="userDropdown" role="button" aria-expanded="false">
              <img src="<%= typeof userAvatar !== 'undefined' ? userAvatar : (imgPath + 'avatar.png') %>" alt="<%= t('User Avatar') %>" class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover;">
              <span class="d-none d-md-inline"><%= typeof user !== 'undefined' && user && user.username ? user.username : t('User') %></span>
              <i class="bi bi-caret-down ms-1"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" style="min-width: 200px;">
              <!--begin::User Header-->
              <li class="dropdown-header bg-light border-bottom">
                <div class="d-flex align-items-center">
                  <img src="<%= typeof userAvatar !== 'undefined' ? userAvatar : (imgPath + 'avatar.png') %>" alt="<%= t('User Avatar') %>" class="rounded-circle me-3" style="width:40px;height:40px;object-fit:cover;">
                  <div>
                    <div class="fw-bold text-dark"><%= typeof user !== 'undefined' && user && user.username ? user.username : t('User') %></div>
                    <small class="text-muted"><%= t('Administrator') %></small>
                  </div>
                </div>
              </li>
              <!--end::User Header-->

              <!--begin::Menu Items-->
              <li><hr class="dropdown-divider my-1"></li>
              <% if (!locals.user || user.auth_source !== 'ldap') { %>
              <li>
                <a class="dropdown-item d-flex align-items-center py-2" href="/change-password">
                  <i class="bi bi-key me-3 text-primary"></i>
                  <span><%= t('Change Password') %></span>
                </a>
              </li>
              <% } %>
              <li>
                <a class="dropdown-item d-flex align-items-center py-2" href="/logout">
                  <i class="bi bi-box-arrow-right me-3 text-danger"></i>
                  <span><%= t('Logout') %></span>
                </a>
              </li>
              <!--end::Menu Items-->
            </ul>
          </li>
          <!--end::User Account Menu-->
        </ul>
        <!--end::End Navbar Links-->
      </div>
      <!--end::Container-->
    </nav>
    <!--end::Header-->
    
    <!--begin::Sidebar-->
    <%- include('sidebar', { siteName: typeof siteName !== 'undefined' ? siteName : '' }) %>
    
    <!--begin::App Main-->
    <main class="app-main">
      <%- body %>
    </main>
    <!--end::App Main-->
    
    <!--begin::Footer-->
    <footer class="app-footer">
      <div class="container-fluid">
        <div class="row">
          <div class="col-md-6">
            <div class="text-muted">
              <i class="fas fa-copyright"></i> 2024 <strong>Open ASM</strong>. <%= t('All rights reserved.') %>
            </div>
          </div>
          <div class="col-md-6 text-end">
            <div class="text-muted">
              <small><%= t('Made by') %> <strong>Toan Nguyen</strong></small>
            </div>
          </div>
        </div>
    </div>
    </footer>
    <!--end::Footer-->
  </div>
  <!--end::App Wrapper-->
  
  <!--begin::Required Scripts-->
  <script src="/js/select2.min.js"></script>
  <script src="/js/bootstrap.bundle.min.js"></script>
  <script src="<%= jsPath %>adminlte.min.js" crossorigin="anonymous"></script>
  <script src="<%= asset(jsPath + 'custom.js') %>" crossorigin="anonymous"></script>
  <script src="<%= asset('/js/list-filters.js') %>"></script>
  <%# shared UI kit: list columns, detail modals, forms, confirmations %>
  <script src="<%= asset('/js/list-columns.js') %>"></script>
  <script src="<%= asset('/js/detail-view.js') %>"></script>
  <script src="<%= asset('/js/form-kit.js') %>"></script>
  <script src="<%= asset('/js/ui-kit.js') %>"></script>
  <script src="<%= asset('/js/import-kit.js') %>"></script>

</body>
</html>
