# ========================================
# 🤖 AGENTS API TESTS
# ========================================
# ✅ Uses centralized environment variables from .vscode/settings.json
# Variables: {{baseUrl}}, {{apiVersion}}, {{username}}, {{password}}
# Environment: development (change in VS Code status bar)
# ========================================

### 0. Login to get JWT Token (Run this first!)
# @name agentAuth
POST {{baseUrl}}/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### 1. Get All Agents
GET {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}

### 2. Create Agent
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Test Agent",
  "version": "1.0.0",
  "description": "Test agent for API testing"
}

### 3. Create Agent (Minimal)
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Minimal Agent"
}

### 4. Create Agent (Duplicate Name - Should Fail)
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Test Agent",
  "version": "2.0.0"
}

### 5. Create Agent (Missing Name - Should Fail)
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "version": "1.0.0",
  "description": "Missing name"
}

### 6. Create Agent (Empty Name - Should Fail)
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "",
  "version": "1.0.0"
}

### 7. Get Agent by ID
GET {{baseUrl}}/{{apiVersion}}/agents/10
Authorization: Bearer {{agentAuth.response.body.token}}

### 8. Get Non-existent Agent (Should Fail)
GET {{baseUrl}}/{{apiVersion}}/agents/99999
Authorization: Bearer {{agentAuth.response.body.token}}

### 9. Update Agent (Full Update)
PUT {{baseUrl}}/{{apiVersion}}/agents/10
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Updated Test Agent",
  "version": "2.0.0",
  "description": "Updated description"
}

### 10. Update Agent (Partial Update - Name Only)
PUT {{baseUrl}}/{{apiVersion}}/agents/10
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Partially Updated Agent"
}

### 11. Update Agent (Partial Update - Version Only)
PUT {{baseUrl}}/{{apiVersion}}/agents/10
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "version": "3.0.0"
}

### 12. Update Agent (Partial Update - Description Only)
PUT {{baseUrl}}/{{apiVersion}}/agents/10
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "description": "Only description updated"
}

### 13. Update Agent (Empty Body - Should Return Current Agent)
PUT {{baseUrl}}/{{apiVersion}}/agents/1
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{}

### 14. Update Agent (Empty Name - Should Fail)
PUT {{baseUrl}}/{{apiVersion}}/agents/10
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": ""
}

### 15. Update Non-existent Agent (Should Fail)
PUT {{baseUrl}}/{{apiVersion}}/agents/99999
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Updated Name"
}

### 16. Find Agents by Exact Name
GET {{baseUrl}}/{{apiVersion}}/agents/find?name=Test Agent
Authorization: Bearer {{agentAuth.response.body.token}}

### 17. Find Agents by Exact Name (Case Insensitive)
GET {{baseUrl}}/{{apiVersion}}/agents/find?name=test agent
Authorization: Bearer {{agentAuth.response.body.token}}

### 18. Find Agents (Missing Name Parameter - Should Fail)
GET {{baseUrl}}/{{apiVersion}}/agents/find
Authorization: Bearer {{agentAuth.response.body.token}}

### 19. Find Agents (Empty Name Parameter - Should Fail)
GET {{baseUrl}}/{{apiVersion}}/agents/find?name=
Authorization: Bearer {{agentAuth.response.body.token}}

### 20. Find Non-existent Agent
GET {{baseUrl}}/{{apiVersion}}/agents/find?name=NonExistentAgent
Authorization: Bearer {{agentAuth.response.body.token}}

### 21. Delete Agent
DELETE {{baseUrl}}/{{apiVersion}}/agents/1
Authorization: Bearer {{agentAuth.response.body.token}}

### 22. Delete Non-existent Agent (Should Fail)
DELETE {{baseUrl}}/{{apiVersion}}/agents/99999
Authorization: Bearer {{agentAuth.response.body.token}}

### 23. Delete Agent in Use (Should Fail - if agent is referenced by servers)
DELETE {{baseUrl}}/{{apiVersion}}/agents/2
Authorization: Bearer {{agentAuth.response.body.token}}

### 24. Test Authentication (No Token - Should Fail)
GET {{baseUrl}}/{{apiVersion}}/agents

### 25. Test Authentication (Invalid Token - Should Fail)
GET {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer invalid_token

### 26. Test Content Type (Wrong Content Type - Should Fail)
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: text/plain

{
  "name": "Wrong Content Type"
}

### 27. Test Large Description
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Agent with Large Description",
  "version": "1.0.0",
  "description": "This is a very long description that tests the system's ability to handle large text fields. It contains multiple sentences and should be properly stored and retrieved without any issues. The description field should support long text content and maintain proper formatting when displayed."
}

### 28. Test Special Characters in Name
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Agent with Special Chars: @#$%^&*()",
  "version": "1.0.0",
  "description": "Testing special characters in agent name"
}

### 29. Test Unicode Characters
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Agent with Unicode: 测试代理",
  "version": "1.0.0",
  "description": "Testing Unicode characters in agent name and description"
}

### 30. Test Version Format Variations
POST {{baseUrl}}/{{apiVersion}}/agents
Authorization: Bearer {{agentAuth.response.body.token}}
Content-Type: application/json

{
  "name": "Version Test Agent",
  "version": "v1.2.3-beta.1+build.123",
  "description": "Testing various version formats"
}