### 61. Verify Create Response Includes Relationships
# @name verifyCreateResponse
POST {{baseUrl}}/{{apiVersion}}/ip-addresses
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{ipAuth.response.body.token}}

{
  "address": "192.168.1.199",
  "description": "Verify relationships in response",
  "status": "assigned",
  "tags": [1, 2],
  "contacts": [1],
  "systems": [1]
}
# Expected response should include:
# - Basic IP fields (id, ip_address, description, status)
# - tags array with full tag objects (id, name)
# - contacts array with full contact objects (id, name, email, phone)
# - systems array with full system objects (id, name, system_id)

### 62. Verify Update Response Includes Relationships
PUT {{baseUrl}}/{{apiVersion}}/ip-addresses/{{verifyCreateResponse.response.body.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{ipAuth.response.body.token}}

{
  "description": "Updated with new relationships",
  "tags": [3, 4],
  "contacts": [2, 3],
  "systems": [2]
}
# Expected response should include updated relationships

### 63. Verify Get By ID Response Structure
GET {{baseUrl}}/{{apiVersion}}/ip-addresses/{{verifyCreateResponse.response.body.id}}
Accept: application/json
Authorization: Bearer {{ipAuth.response.body.token}}
# Response structure should be consistent across all endpoints

### 64. Verify Find Response Structure
GET {{baseUrl}}/{{apiVersion}}/ip-addresses/find?address=192.168.1.199
Accept: application/json
Authorization: Bearer {{ipAuth.response.body.token}}
# Find response should match create/update response structure

# ========================================
# ✅ IP ADDRESSES API TEST CHECKLIST
# ========================================
# 
# BASIC CRUD OPERATIONS:
# ⏳ GET /api/v1/ip-addresses (get all IP addresses)
# ⏳ GET /api/v1/ip-addresses/:id (get IP address by ID)
# ⏳ POST /api/v1/ip-addresses (create new IP address)
# ⏳ PUT /api/v1/ip-addresses/:id (update IP address)
# ⏳ DELETE /api/v1/ip-addresses/:id (delete IP address)
#
# SEARCH & FIND:
# ⏳ GET /api/v1/ip-addresses/find?address=exact_ip (find by exact IP address)
# ⏳ GET /api/v1/ip-addresses?search=text (search by IP or description)
#
# FILTERING CAPABILITIES:
# ⏳ Filter by status (reserved, assigned, inactved)
# ⏳ Filter by tags (array of tag IDs)
# ⏳ Filter by contacts (array of contact IDs)
# ⏳ Filter by systems (array of system IDs)
# ⏳ Combined filters (status + tags + contacts + systems + search)
#
# PAGINATION:
# ⏳ Page number control (page parameter)
# ⏳ Page size control (pageSize parameter, default: 10)
# ⏳ Pagination with filters
#
# API STRUCTURE NOTES:
# ✅ Direct GET /api/v1/ip-addresses endpoint with advanced filtering
# ✅ Find endpoint requires 'address' parameter (exact match)
# ✅ Response uses data/total format
# ✅ /find endpoint properly placed BEFORE /:id (no routing conflicts)
# ✅ Complex relationships with tags, contacts, and systems
#
# FIELD VALIDATION:
# ⏳ Required fields: address (unique, valid IP format)
# ⏳ Optional fields: description, status, tags, contacts, systems
# ⏳ Status enum: reserved, assigned, inactved
# ⏳ Relationship validation (IDs must exist)
# ⏳ Partial update support (only provided fields updated)
#
# ERROR HANDLING:
# ⏳ 400 - Invalid data/missing address/invalid IP format/invalid status
# ⏳ 400 - Invalid relationship IDs (tags, contacts, systems)
# ⏳ 404 - IP address not found
# ⏳ 500 - Internal server error
#
# RELATIONSHIP MANAGEMENT:
# ⏳ Create with relationships (tags, contacts, systems)
# ⏳ Update relationships (add/remove/clear)
# ⏳ Filter by relationships
# ⏳ Validate relationship IDs exist
#
# SPECIAL CASES:
# ⏳ IPv4 and IPv6 address support
# ⏳ Edge case IP addresses (0.0.0.0, 255.255.255.255)
# ⏳ Status transitions (reserved → assigned → inactved)
# ⏳ Search case sensitivity
# ⏳ Empty result sets
# ⏳ Complex filter combinations
# ⏳ Pagination edge cases
# ⏳ Null vs empty array handling for relationships
#
# UNIQUE FEATURES:
# ⏳ Advanced filtering by multiple criteria
# ⏳ Relationship-based filtering
# ⏳ Full-text search in IP and description
# ⏳ Comprehensive pagination support
# ⏳ Status-based workflow management
#
# ========================================
# 🚫 IP DELETION BLOCKING TESTS
# ========================================

### 41. Create IP for Server Assignment Test
# @name createIpForServer
POST {{baseUrl}}/{{apiVersion}}/ip-addresses
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{ipAuth.response.body.token}}

{
  "address": "192.168.100.50",
  "description": "IP for server assignment test",
  "status": "available"
}

### 42. Create IP for Device Assignment Test
# @name createIpForDevice
POST {{baseUrl}}/{{apiVersion}}/ip-addresses
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{ipAuth.response.body.token}}

{
  "address": "192.168.100.51",
  "description": "IP for device assignment test",
  "status": "available"
}

### 43. Delete Available IP (Should succeed)
DELETE {{baseUrl}}/{{apiVersion}}/ip-addresses/22
Authorization: Bearer {{ipAuth.response.body.token}}

### 44. Try to Delete IP Assigned to Server (Should fail with 409)
# First, assign IP to a server manually in database or UI
# Then try to delete it - this should return 409 Conflict
DELETE {{baseUrl}}/{{apiVersion}}/ip-addresses/1
Authorization: Bearer {{ipAuth.response.body.token}}

### 45. Try to Delete IP Assigned to Device (Should fail with 409)
# First, assign IP to a device manually in database or UI
# Then try to delete it - this should return 409 Conflict
DELETE {{baseUrl}}/{{apiVersion}}/ip-addresses/2
Authorization: Bearer {{ipAuth.response.body.token}}

### 46. Try to Delete Non-existent IP (Should fail with 404)
DELETE {{baseUrl}}/{{apiVersion}}/ip-addresses/99999
Authorization: Bearer {{ipAuth.response.body.token}}

