### 30. Update Server (Full Update)
PUT {{baseUrl}}/servers/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Test Server 1",
  "os": 2,
  "status": "OFFLINE",
  "location": "DR",
  "type": "VIRTUAL-MACHINE",
  "managers": [2],
  "systems": [2],
  "agents": [2],
  "services": [2],
  "tags": [2],
  "ip_addresses": [12],
  "description": "Updated test server"
}

