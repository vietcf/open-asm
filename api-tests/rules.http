DELETE {{baseUrl}}/{{apiVersion}}/rules/4
Authorization: Bearer {{ruleAuth.response.body.token}}

### 16. Delete Non-existent Rule (404 test)
DELETE {{baseUrl}}/{{apiVersion}}/rules/99999
Authorization: Bearer {{ruleAuth.response.body.token}}

# ========================================
# 🔍 ADVANCED SEARCH TESTS
# ========================================

### 17. Search by Rule Name
GET {{baseUrl}}/{{apiVersion}}/rules?search=test-rule&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 18. Search by Source IP
GET {{baseUrl}}/{{apiVersion}}/rules?search=192.168.1&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 19. Search by Destination
GET {{baseUrl}}/{{apiVersion}}/rules?search=10.0.0&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 20. Search with Large Page Size (should be limited to max)
GET {{baseUrl}}/{{apiVersion}}/rules?page=1&pageSize=1000
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 21. Search with Invalid Page Number
GET {{baseUrl}}/{{apiVersion}}/rules?page=0&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 22. Search with Negative Page Size
GET {{baseUrl}}/{{apiVersion}}/rules?page=1&pageSize=-10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

