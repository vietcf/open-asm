# ========================================
# 🧪 EDGE CASE TESTS
# ========================================

### 29. Create Rule with Empty Strings
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "",
  "firewall_name": "USER",
  "src": "",
  "dst": "",
  "action": "ALLOW",
  "audit_batch": ""
}

### 30. Create Rule with Very Long Strings
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "very-long-rule-name-that-exceeds-normal-limits-and-should-be-tested-for-proper-validation-and-handling-by-the-system",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01",
  "description": "This is a very long description that might exceed normal limits and should be tested for proper validation and handling by the system. It contains multiple sentences and should test the system's ability to handle large text inputs properly."
}

### 31. Create Rule with Special Characters
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-special-chars-!@#$%^&*()",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01",
  "description": "Test with special chars: !@#$%^&*()_+-=[]{}|;':\",./<>?"
}

### 32. Create Rule with Unicode Characters
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-unicode-测试规则",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01",
  "description": "Test with Unicode: 测试规则 with emoji 🔥 and symbols ★"
}

# ========================================
# 📝 NOTES
# ========================================
# 
# Test Execution Order:
# 1. Run login first (test 0) to get JWT token
# 2. Run basic CRUD tests (1-4)
# 3. Run create tests (5-10)
# 4. Run update tests (11-14)
# 5. Run delete tests (15-16)
# 6. Run search tests (17-22)
# 7. Run authorization tests (23-25)
# 8. Run pagination tests (26-28)
# 9. Run edge case tests (29-32)
#
# Expected Results:
# - Tests 1-3, 5-6, 11, 15: Should return 200/201/204
# - Tests 4, 7-9, 12-13, 16, 20-22, 23-25, 29-32: Should return 400/401/404/409
# - Tests 10, 14: Should return 409 (duplicate)
# - Tests 17-19, 26-28: Should return 200 with paginated results
#
# Environment Variables Required:
# - baseUrl: Base URL of the API
# - apiVersion: API version (e.g., "api/v1")
# - username: Username for authentication
# - password: Password for authentication
#
# ========================================
