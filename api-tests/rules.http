# ========================================
# 🔥 FIREWALL RULES API TESTS
# ========================================
# ✅ Uses centralized environment variables from .vscode/settings.json
# Variables: {{baseUrl}}, {{apiVersion}}, {{username}}, {{password}}
# Environment: development (change in VS Code status bar)
# ========================================

### 0. Login to get JWT Token (Run this first!)
# @name ruleAuth
POST {{baseUrl}}/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

# ========================================
# 📋 BASIC RULE CRUD OPERATIONS
# ========================================

### 1. Get Configuration Values for Enum Fields
GET {{baseUrl}}/{{apiVersion}}/rules/config
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 2. Get All Rules (List with pagination)
GET {{baseUrl}}/{{apiVersion}}/rules?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 3. Search Rules by keyword
GET {{baseUrl}}/{{apiVersion}}/rules?search=rule1&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 4. Filter Rules by Firewall Name
GET {{baseUrl}}/{{apiVersion}}/rules?firewall_name=USER1&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 5. Filter Rules by Audit Batch
GET {{baseUrl}}/{{apiVersion}}/rules?audit_batch=2024-01&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 6. Filter Rules by Status
GET {{baseUrl}}/{{apiVersion}}/rules?status=ENABLE&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 7. Filter Rules by Violation Type
GET {{baseUrl}}/{{apiVersion}}/rules?violation_type=ANY&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 8. Filter Rules by Work Order
GET {{baseUrl}}/{{apiVersion}}/rules?work_order=WO-2024&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 9. Filter Rules by OU ID
GET {{baseUrl}}/{{apiVersion}}/rules?ou_id=1&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 10. Filter Rules by Contact IDs (array)
GET {{baseUrl}}/{{apiVersion}}/rules?contacts=1&contacts=2&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 11. Filter Rules by Tag IDs (array)
GET {{baseUrl}}/{{apiVersion}}/rules?tags=1&tags=2&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 12. Multiple Filters Combined
GET {{baseUrl}}/{{apiVersion}}/rules?firewall_name=USER&status=ENABLE&audit_batch=2024-01&page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 13. Get Rule by ID
GET {{baseUrl}}/{{apiVersion}}/rules/1
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

### 13. Get Non-existent Rule (404 test)
GET {{baseUrl}}/{{apiVersion}}/rules/99999
Accept: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

# ========================================
# ➕ CREATE RULE TESTS
# ========================================

### 14. Create Valid Rule (Minimal required fields)
# @name createRule
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-002",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01"
}

### 15. Create Rule with All Fields
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-full-001",
  "firewall_name": "SERVER",
  "src_zone": "internal",
  "src": "192.168.1.100",
  "src_detail": "Web server",
  "dst_zone": "external",
  "dst": "0.0.0.0/0",
  "dst_detail": "Internet",
  "services": "80,443",
  "application": "HTTP/HTTPS",
  "url": "https://example.com",
  "action": "ALLOW",
  "status": "ENABLE",
  "violation_type": "ANY",
  "violation_detail": "Test violation",
  "solution_proposal": "Allow web traffic",
  "solution_confirm": "Approved by security team",
  "ou_id": 1,
  "contacts": [1, 2],
  "tags": [1, 2],
  "audit_batch": "2024-01",
  "work_order": "WO-2024-001",
  "description": "Test rule for web traffic"
}

### 7. Create Rule with Invalid Firewall Name (400 test)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-invalid-001",
  "firewall_name": "INVALID_FIREWALL",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01"
}

### 8. Create Rule with Invalid Action (400 test)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-invalid-action-001",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "INVALID_ACTION",
  "audit_batch": "2024-01"
}

### 9. Create Rule with Missing Required Fields (400 test)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-missing-001",
  "firewall_name": "USER"
  // Missing src, dst, action, audit_batch
}

### 10. Create Rule with Empty Required Fields (400 test)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "",
  "firewall_name": "USER",
  "src": "",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01"
}

### 11. Create Rule with Field Length Exceeded (400 test)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "This is a very long rule name that exceeds the maximum allowed length of 255 characters and should cause a validation error when submitted to the API endpoint for creating firewall rules in the system",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01"
}

### 12. Create Rule with Invalid URL Format (400 test)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-invalid-url",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01",
  "url": "invalid-url-format"
}

### 13. Create Rule with Invalid Tag IDs (400 test)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-invalid-tags",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01",
  "tags": [99999, 99998]
}

### 14. Create Rule with Custom Audit Batch Format (Valid - no format restriction)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-custom-audit",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "Q1-2024-Batch-A"
}

### 15. Create Duplicate Rule (409 test - same rulename, firewall_name, audit_batch)
POST {{baseUrl}}/{{apiVersion}}/rules
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-003",
  "firewall_name": "USER",
  "src": "192.168.2.0/24",
  "dst": "10.0.0.0/8",
  "action": "DENY",
  "audit_batch": "2024-01"
}

# ========================================
# ✏️ UPDATE RULE TESTS
# ========================================

### 11. Update Rule (Valid update)
PUT {{baseUrl}}/{{apiVersion}}/rules/1
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{

  "audit_batch": "2024-01-updated-bay-api",
  "description": "Updated test rule with description"
}

### 13. Update Rule with Invalid Data (400 test)
PUT {{baseUrl}}/{{apiVersion}}/rules/{{createRule.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-001-updated",
  "firewall_name": "INVALID_FIREWALL",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "INVALID_ACTION",
  "audit_batch": "2024-01"
}

### 14. Update Rule with No Changes (Should keep old values)
PUT {{baseUrl}}/{{apiVersion}}/rules/{{createRule.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-001",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01"
}

### 15. Update Rule with Partial Changes (Only some fields)
PUT {{baseUrl}}/{{apiVersion}}/rules/{{createRule.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-001-partial-update",
  "status": "DISABLE",
  "description": "Partially updated rule"
}

### 16. Update Rule with Only Description (No required fields)
PUT {{baseUrl}}/{{apiVersion}}/rules/{{createRule.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "description": "Updated description only"
}

### 17. Update Non-existent Rule (404 test)
PUT {{baseUrl}}/{{apiVersion}}/rules/99999
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-404",
  "firewall_name": "USER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01"
}

### 17. Update Rule to Create Duplicate (409 test)
PUT {{baseUrl}}/{{apiVersion}}/rules/{{createRule.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{ruleAuth.response.body.token}}

{
  "rulename": "test-rule-full-001",
  "firewall_name": "SERVER",
  "src": "192.168.1.0/24",
  "dst": "10.0.0.0/8",
  "action": "ALLOW",
  "audit_batch": "2024-01"
}

