# ========================================
# 🔀 SERVICE MAPPINGS API TESTS
# ========================================
# ✅ Uses centralized environment variables from .vscode/settings.json
# Variables: {{baseUrl}}, {{apiVersion}}, {{username}}, {{password}}
#
# Integration flow (F5, Citrix ADC...): create / find the IP addresses,
# domain and system through their own APIs, then send their ids here.
# Re-sync: GET /service-mappings/find?name=... -> PUT if found, else POST.
# ========================================

### 0. Login to get JWT Token (Run this first!)
# @name smAuth
POST {{baseUrl}}/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### 1. Frontend IP (VIP) - find it, or create it with POST /ip-addresses
# @name vip
GET {{baseUrl}}/{{apiVersion}}/ip-addresses/find?address=203.0.113.50
Authorization: Bearer {{smAuth.response.body.token}}

### 2. Domain - create it (or GET /domains/find?name=)
# @name domain
POST {{baseUrl}}/{{apiVersion}}/domains
Content-Type: application/json
Authorization: Bearer {{smAuth.response.body.token}}

{
  "domain": "shop.example.com",
  "record_type": "A"
}

### 3. List service mappings (search / filters / pagination)
GET {{baseUrl}}/{{apiVersion}}/service-mappings?search=shop&page=1&pageSize=20
Authorization: Bearer {{smAuth.response.body.token}}

### 4. Find by exact name (integrations: update instead of create)
GET {{baseUrl}}/{{apiVersion}}/service-mappings/find?name=shop.example.com:443
Authorization: Bearer {{smAuth.response.body.token}}

### 5. Create a service mapping (ids from the calls above)
# @name createSm
POST {{baseUrl}}/{{apiVersion}}/service-mappings
Content-Type: application/json
Authorization: Bearer {{smAuth.response.body.token}}

{
  "name": "shop.example.com:443",
  "ip_address_id": 12,
  "port": 443,
  "protocol": "HTTPS",
  "domain_id": {{domain.response.body.id}},
  "provider": "Akamai",
  "direction": "inbound",
  "scope": "public",
  "access_mode": "full",
  "description": "Imported from F5 virtual server /Common/vs_shop_443",
  "members": [
    { "ip_address_id": 21, "port": 8443, "status": "active" },
    { "ip_address_id": 22, "port": 8443, "status": "inactive" }
  ]
}

### 6. Get by id
GET {{baseUrl}}/{{apiVersion}}/service-mappings/{{createSm.response.body.id}}
Authorization: Bearer {{smAuth.response.body.token}}

### 7. Partial update: only the fields sent change, "members" replaces every backend
PUT {{baseUrl}}/{{apiVersion}}/service-mappings/{{createSm.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{smAuth.response.body.token}}

{
  "members": [
    { "ip_address_id": 21, "port": 8443 }
  ]
}

### 8. Error: unknown id -> 400
POST {{baseUrl}}/{{apiVersion}}/service-mappings
Content-Type: application/json
Authorization: Bearer {{smAuth.response.body.token}}

{
  "ip_address_id": 999999,
  "port": 443
}

### 9. Delete
DELETE {{baseUrl}}/{{apiVersion}}/service-mappings/{{createSm.response.body.id}}
Authorization: Bearer {{smAuth.response.body.token}}
