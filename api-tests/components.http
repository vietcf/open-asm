### 32. Update Component (Duplicate Name in Same System - Should Fail - 409)
PUT {{baseUrl}}/{{apiVersion}}/components/{{createComponentComplete.response.body.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{componentAuth.response.body.token}}

{
  "name": "Renamed Test Component"
}

### 33. Update Non-existent Component (Should Fail - 404)
PUT {{baseUrl}}/{{apiVersion}}/components/99999
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{componentAuth.response.body.token}}

{
  "name": "Updated Name"
}

# ========================================
# 🔒 AUTH & CONTENT-TYPE TESTS
# ========================================

### 34. Test Authentication (No Token - Should Fail - 401)
GET {{baseUrl}}/{{apiVersion}}/components

### 35. Test Authentication (Invalid Token - Should Fail - 401)
GET {{baseUrl}}/{{apiVersion}}/components
Authorization: Bearer invalid_token

### 36. Test Content Type (Wrong Content Type - Should Fail)
POST {{baseUrl}}/{{apiVersion}}/components
Authorization: Bearer {{componentAuth.response.body.token}}
Content-Type: text/plain

{
  "system_id": 1,
  "name": "Wrong Content Type"
}

# ========================================
# 🧪 EDGE CASE TESTS
# ========================================

### 37. Create Component with Unicode Characters
POST {{baseUrl}}/{{apiVersion}}/components
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{componentAuth.response.body.token}}

{
  "system_id": 1,
  "name": "Component with Unicode: 测试组件",
  "description": "Testing Unicode characters in component name"
}

### 38. Create Component with Multiple FQDNs
POST {{baseUrl}}/{{apiVersion}}/components
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{componentAuth.response.body.token}}

{
  "system_id": 1,
  "name": "Component with Multiple FQDNs",
  "fqdn": ["a.test.local", "b.test.local", "c.test.local"]
}

### 39. Create Component with Empty Relationship Arrays
POST {{baseUrl}}/{{apiVersion}}/components
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{componentAuth.response.body.token}}

{
  "system_id": 1,
  "name": "Component with Empty Arrays",
  "contacts": [],
