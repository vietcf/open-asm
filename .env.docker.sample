# Open ASM - optional settings
# ---------------------------------------------------------------------------
# `docker compose up -d` needs no settings: the defaults are in
# docker/defaults.env. To change one, copy this file and keep only the lines
# you change:
#   cp .env.docker.sample .env.docker
# Everything else is set in the app (System Configuration).

# --- Database -----------------------------------------------------------------
# PostgreSQL in Docker (docker-compose.yml): only set a password, BEFORE the
# first start (the database is created once with it).
# POSTGRES_PASSWORD=change-me

# External PostgreSQL (docker-compose.external-db.yml): set all of them. The
# database must exist; it may be empty. Same host as Docker: host.docker.internal
# POSTGRES_HOST=10.0.0.5
# POSTGRES_PORT=5432
# POSTGRES_DB=openasm
# POSTGRES_USER=openasm
# POSTGRES_PASSWORD=change-me
# POSTGRES_SSL=false

# --- Initial administrator ------------------------------------------------------
# Created once, on the first start against an empty database. Empty password:
# a random one is written to data/initial-admin-password.txt. The first login
# always asks for a new password.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@localhost
# ADMIN_PASSWORD=

# --- Language -------------------------------------------------------------------
# UI language until a user picks one: en | vi
# DEFAULT_LANGUAGE=en

# --- Secrets / API tokens -------------------------------------------------------
# SESSION_SECRET / JWT_SECRET are generated on the first start and kept in
# data/secrets.env. Set them only to use your own values.
# SESSION_SECRET=
# JWT_SECRET=
# JWT_EXPIRES_IN=8h

# --- Sign-in lockout --------------------------------------------------------------
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCK_MINUTES=15

# --- LDAP / Active Directory (users set to "LDAP" in User Management) -----------
# LDAP_ENABLED=true
# LDAP_URL=ldaps://dc.yourcompany.local:636
# LDAP_DOMAIN=yourcompany.local
# false: accept an AD certificate from an internal CA without verifying it
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_TIMEOUT_MS=5000

# --- Uploaded files in S3 instead of ./public/uploads ----------------------------
# FILE_UPLOAD_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=
# AWS_S3_BASE_URL=https://your-bucket.s3.amazonaws.com

# --- Self-signed certificate ---------------------------------------------------------
# Name in the certificate generated on the first start when ./ssl is empty
# SSL_COMMON_NAME=asm.yourcompany.local
