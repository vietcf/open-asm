# ===========================================
# Open ASM - Docker Environment Configuration Sample
# ===========================================
# Copy this file to .env.docker and update the values according to your setup:
#   cp .env.docker.sample .env.docker
#
# For local (non-Docker) development, use .env.sample -> .env instead.

# ===========================================
# Application Configuration
# ===========================================
SITE_NAME="Open ASM"
ADMIN_EMAIL=admin@localhost

# Application environment variables
NODE_ENV=production
PORT=3000

# ===========================================
# Security Configuration
# ===========================================
# Session Security - CHANGE THIS, do not use the sample value in production!
SESSION_SECRET=change-me-to-a-long-random-string

# JWT Configuration
JWT_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=8h

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# Must be 'db' — the Postgres service name in docker-compose.yml, not localhost/127.0.0.1
POSTGRES_HOST=db
POSTGRES_DB=openasm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_PORT=5432
POSTGRES_SSL=false

# ===========================================
# File Upload Configuration
# ===========================================
# File upload driver: 'local' or 's3'
FILE_UPLOAD_DRIVER=local

# Directory for storing uploaded files (relative to project root or absolute)
UPLOADS_DIR=public/uploads

# ===========================================
# AWS S3 Configuration (Optional)
# ===========================================
# Only needed if FILE_UPLOAD_DRIVER=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_BASE_URL=https://your-bucket-name.s3.amazonaws.com

# ===========================================
# Database Backup Configuration
# ===========================================
# Backup frequency: daily, weekly, monthly
BACKUP_FREQUENCY=daily

# Number of backups to keep (default: 7)
BACKUP_RETENTION=7

# Backup directory (default: backups folder in app root)
# BACKUP_DIR=/path/to/backup/directory
