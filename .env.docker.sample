# ===========================================
# Open ASM - Docker Environment Configuration Sample
# ===========================================
# OPTIONAL. `docker compose up -d` works without any .env.docker: defaults
# come from docker/defaults.env. To change something, copy this file to
# .env.docker and keep only the lines you want to change:
#   cp .env.docker.sample .env.docker
# Set POSTGRES_PASSWORD / ADMIN_* BEFORE the first start: the database and
# the admin account are created once, from the values present at that time.
#
# For local (non-Docker) development, use .env.sample -> .env instead.

# ===========================================
# Application Configuration
# ===========================================
SITE_NAME="Open ASM"

# Initial administrator account — created ONCE, on the first start against an
# empty database (later changes to these values are ignored; change the
# password in the UI instead). The first login always forces a password change.
#   ADMIN_PASSWORD empty -> a random password is generated, saved to
#     data/initial-admin-password.txt and printed once in `docker compose logs app`
# Lost it? docker compose exec app npm run admin:reset-password
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# Application environment variables
NODE_ENV=production
PORT=3000

# Default UI language (en | vi). Users can switch with the VI/EN menu.
DEFAULT_LANGUAGE=en

# ===========================================
# Security Configuration
# ===========================================
# SESSION_SECRET / JWT_SECRET: leave commented out — they are generated on
# first start and kept in data/secrets.env. Set them only to use your own.
# SESSION_SECRET=a-long-random-string

# JWT_SECRET=another-long-random-string
JWT_EXPIRES_IN=8h

# ===========================================
# LDAP / Active Directory Configuration (Optional)
# ===========================================
# Only used for users whose account is set to "LDAP" auth in User Management.
# Users must be pre-created in the app (no auto-provisioning); the app
# username must match the user's AD sAMAccountName.
LDAP_ENABLED=false
# ldaps:// (port 636) recommended. Direct bind only, no service account needed.
LDAP_URL=ldaps://your-domain-controller:636
# Used to build the bind UPN as <username>@LDAP_DOMAIN
LDAP_DOMAIN=yourcompany.local
# Set to false if your AD uses a self-signed/internal CA cert and you don't
# want to import it — the connection stays encrypted but the server identity
# is not verified (acceptable only on a trusted internal network).
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Max time (ms) to wait for the AD server before treating it as unavailable
LDAP_TIMEOUT_MS=5000

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# Must be 'db' — the Postgres service name in docker-compose.yml, not localhost/127.0.0.1
POSTGRES_HOST=db
POSTGRES_DB=openasm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_PORT=5432
POSTGRES_SSL=false

# ===========================================
# File Upload Configuration
# ===========================================
# File upload driver: 'local' or 's3'
FILE_UPLOAD_DRIVER=local

# Directory for storing uploaded files (relative to project root or absolute)
UPLOADS_DIR=public/uploads

# ===========================================
# AWS S3 Configuration (Optional)
# ===========================================
# Only needed if FILE_UPLOAD_DRIVER=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_BASE_URL=https://your-bucket-name.s3.amazonaws.com

# ===========================================
# Database Backup Configuration
# ===========================================
# Backup directory (default: backups folder in app root). The schedule,
# hour and number of backups to keep are set in the app: System
# Configuration > Backup. (BACKUP_FREQUENCY / BACKUP_RETENTION are only read
# once, as the initial values of an install that already used them.)
# BACKUP_DIR=/path/to/backup/directory
