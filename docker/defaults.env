# Built-in defaults so `docker compose up -d` works with no configuration.
# DO NOT edit this file for your deployment: create .env.docker instead
# (cp .env.docker.sample .env.docker) — any variable set there overrides
# the value here.
#
# Not set here on purpose:
#   SESSION_SECRET / JWT_SECRET  generated on first start, kept in ./data/secrets.env
#   ADMIN_PASSWORD               generated on first start, see ./data/initial-admin-password.txt

SITE_NAME="Open ASM"
NODE_ENV=production
PORT=3000

# Database (the db service). Postgres is only reachable from the docker
# network and from 127.0.0.1 on the host, never from outside.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=openasm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=openasm-db-password
POSTGRES_SSL=false

JWT_EXPIRES_IN=8h

# Initial administrator (created once, on first start; forced password change)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost

LDAP_ENABLED=false
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT_MS=5000

FILE_UPLOAD_DRIVER=local
UPLOADS_DIR=public/uploads

BACKUP_FREQUENCY=daily
BACKUP_RETENTION=7
